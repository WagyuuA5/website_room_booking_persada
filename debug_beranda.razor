@page "/beranda"
@page "/user/beranda"
@using booking_room.Components.Models
@using booking_room.Components.Shared
@using booking_room.Services
@inject NavigationManager Navigation
@inject NotificationState NotificationState
@inject booking_room.Services.LoadingStateService LoadingState
@inject IToastService ToastService
@inject IModalService ModalService
@implements IDisposable

<PageTitle>Beranda — Persada Booking Ruangan</PageTitle>

@if (LoadingState.IsLoading)
{
    <div class="content-loading-shimmer" style="padding: 24px;">
        <div class="skeleton-banner" style="height: 60px; border-radius: 12px; margin-bottom: 20px;"></div>
        <div class="skeleton-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;">
            <div class="skeleton-card" style="height: 110px; border-radius: 16px;"></div>
            <div class="skeleton-card" style="height: 110px; border-radius: 16px;"></div>
            <div class="skeleton-card" style="height: 110px; border-radius: 16px;"></div>
            <div class="skeleton-card" style="height: 110px; border-radius: 16px;"></div>
        </div>
    </div>
}
else
{
    <div class="beranda-container content-fade-in">
        @if (NotificationState.CurrentBannerType != NotificationState.BannerType.None)
        {
            <NotificationBanner BannerType="@NotificationState.CurrentBannerType"
                                TargetTime="@NotificationState.NextBookingTime"
                                OnDismiss="DismissReminder"
                                OnCheckIn="HandleCheckInClick" />
        }

        <div class="hero-welcome-card">
            <div class="hero-text-content">
                <h1 class="hero-greeting">Selamat Datang, <span>@BookingDataStore.CurrentUser.FullName</span> 👋</h1>
                <p class="hero-subtext">Kelola reservasi ruangan kerja dan jadwal pertemuan Anda dengan mudah dan cepat.</p>
            </div>
            <div class="hero-quick-actions">
                <button class="btn-hero-action primary" @onclick='() => Navigation.NavigateTo("/bookings")'>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <span>Pesan Ruangan</span>
                </button>
                <button class="btn-hero-action secondary" @onclick='() => Navigation.NavigateTo("/status")'>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>Status Reservasi</span>
                </button>
            </div>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 24px;">
            <div class="stat-highlight-card card-tersedia-berikutnya" @onclick="() => _isAvailableRoomsOpen = true" style="cursor:pointer; background: var(--color-white); border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); padding: 20px;">
                <h4 style="margin:0 0 8px 0; color: var(--color-navy); font-weight:700;">Tersedia Berikutnya</h4>
                <p style="margin:0; font-size:14px; color: var(--color-neutral-600);">Lihat ruangan yang bisa langsung dipesan sekarang.</p>
            </div>
            <div class="stat-highlight-card card-menunggu-persetujuan" @onclick="() => _isPendingOpen = true" style="cursor:pointer; background: var(--color-white); border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); padding: 20px;">
                <h4 style="margin:0 0 8px 0; color: var(--color-warning); font-weight:700;">Menunggu Persetujuan</h4>
                <p style="margin:0; font-size:14px; color: var(--color-neutral-600);">2 reservasi Anda sedang menunggu konfirmasi admin.</p>
            </div>
        </div>


        <div class="stats-overview-grid">
            <div class="stat-card">
                <div class="stat-icon-wrap navy">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Total Ruangan</span>
                    <h3 class="stat-value">20</h3>
                    <span class="stat-hint positive">14 Tersedia Hari Ini</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon-wrap gold">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Pemesanan Aktif</span>
                    <h3 class="stat-value">3</h3>
                    <span class="stat-hint">1 Perlu Konfirmasi</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon-wrap green">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Tingkat Utilisasi</span>
                    <h3 class="stat-value">62%</h3>
                    <span class="stat-hint positive">↑ 8% minggu ini</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon-wrap purple">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Rekan Terhubung</span>
                    <h3 class="stat-value">48</h3>
                    <span class="stat-hint">Divisi IT & Eksekutif</span>
                </div>
            </div>
        </div>

        <div class="dashboard-main-columns">
            <div class="dashboard-card upcoming-card">
                <div class="dashboard-card-header">
                    <div>
                        <h2 class="card-title">Jadwal Pertemuan Mendatang</h2>
                        <p class="card-subtitle">Daftar agenda rapat dan reservasi terdekat Anda</p>
                    </div>
                    <button class="btn-card-more" @onclick='() => Navigation.NavigateTo("/status")'>
                        Lihat Semua
                    </button>
                </div>

                <div class="upcoming-items-list">
                    @foreach (var item in DashboardData.UpcomingBookings.Take(3))
                    {
                        <div class="upcoming-item-row" @onclick='() => Navigation.NavigateTo("/status")'>
                            <div class="item-time-box">
                                <span class="time-main">@(item.Date.Split(',').Length > 1 ? item.Date.Split(',')[1].Trim() : item.Date)</span>
                                <span class="time-sub">@item.TimeSlot</span>
                            </div>
                            <div class="item-divider-line"></div>
                            <div class="item-content-box">
                                <h4 class="item-title">@item.RoomName</h4>
                                <p class="item-purpose">@item.Location</p>
                                <div class="item-tags-row">
                                    <span class="tag-chip">@item.Category</span>
                                    <span class="tag-chip status-ok">Terkonfirmasi</span>
                                </div>
                            </div>
                            <div class="item-arrow">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="dashboard-card available-rooms-card">
                <div class="dashboard-card-header">
                    <div>
                        <h2 class="card-title">Rekomendasi Ruangan</h2>
                        <p class="card-subtitle">Ruangan siap pakai dengan fasilitas terbaik</p>
                    </div>
                    <button class="btn-card-more" @onclick='() => Navigation.NavigateTo("/bookings")'>
                        Katalog Ruangan
                    </button>
                </div>

                <div class="rooms-preview-grid">
                    @foreach (var r in DashboardData.AllRooms.Where(x => x.Status == "Tersedia").Take(3))
                    {
                        <div class="room-preview-item" @onclick='() => Navigation.NavigateTo("/bookings")'>
                            <div class="room-preview-avatar">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                            </div>
                            <div class="room-preview-info">
                                <h4 class="room-preview-name">@r.RoomName</h4>
                                <span class="room-preview-meta">@r.Floor • Kapasitas @r.Capacity Orang</span>
                            </div>
                            <button class="btn-room-quick-book" @onclick='() => Navigation.NavigateTo("/bookings")' @onclick:stopPropagation="true">
                                Pesan
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .beranda-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .hero-welcome-card {
        background: linear-gradient(135deg, #0F1F3D 0%, #1F5D9A 100%);
        border-radius: 20px;
        padding: 32px;
        color: #FFFFFF;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 10px 25px -5px rgba(15, 31, 61, 0.2);
    }
    .hero-greeting {
        font-size: 1.75rem;
        font-weight: 800;
        margin: 0 0 8px 0;
        letter-spacing: -0.02em;
    }
    .hero-greeting span { color: #F59E0B; }
    .hero-subtext {
        font-size: 0.9375rem;
        color: rgba(255, 255, 255, 0.8);
        margin: 0;
        max-width: 540px;
        line-height: 1.5;
    }
    .hero-quick-actions { display: flex; gap: 12px; }
    .btn-hero-action {
        height: 44px;
        padding: 0 20px;
        border-radius: 999px;
        font-size: 0.875rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .btn-hero-action.primary {
        background: #F59E0B;
        color: #0F1F3D;
        border: none;
    }
    .btn-hero-action.primary:hover {
        background: #D97706;
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(245, 158, 11, 0.4);
    }
    .btn-hero-action.secondary {
        background: rgba(255, 255, 255, 0.15);
        color: #FFFFFF;
        border: 1px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(8px);
    }
    .btn-hero-action.secondary:hover {
        background: rgba(255, 255, 255, 0.25);
        transform: translateY(-1px);
    }

    .stats-overview-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }
    .stat-card {
        background: var(--surface-card, #FFFFFF);
        border: 1.5px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 16px;
        padding: 20px;
        display: flex;
        gap: 16px;
        align-items: center;
        box-shadow: 0 2px 10px rgba(15, 31, 61, 0.03);
    }
    body.dark-mode .stat-card {
        background: #1C1C1E;
        border-color: rgba(255, 255, 255, 0.1);
    }
    .stat-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .stat-icon-wrap.navy { background: #EEF2FF; color: #1F5D9A; }
    .stat-icon-wrap.gold { background: #FEF3C7; color: #D97706; }
    .stat-icon-wrap.green { background: #DCFCE7; color: #16A34A; }
    .stat-icon-wrap.purple { background: #F3E8FF; color: #9333EA; }
    body.dark-mode .stat-icon-wrap.navy { background: rgba(31, 93, 154, 0.25); color: #93C5FD; }
    body.dark-mode .stat-icon-wrap.gold { background: rgba(245, 158, 11, 0.25); color: #FCD34D; }
    body.dark-mode .stat-icon-wrap.green { background: rgba(22, 163, 74, 0.25); color: #86EFAC; }
    body.dark-mode .stat-icon-wrap.purple { background: rgba(147, 51, 234, 0.25); color: #D8B4FE; }

    .stat-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--persada-text-secondary, #6B7280);
        display: block;
        margin-bottom: 2px;
    }
    .stat-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--persada-navy-900, #0F1F3D);
        margin: 0 0 2px 0;
    }
    body.dark-mode .stat-value { color: #F8FAFC; }
    .stat-hint {
        font-size: 0.6875rem;
        font-weight: 600;
        color: #6B7280;
    }
    .stat-hint.positive { color: #16A34A; }
    body.dark-mode .stat-hint.positive { color: #4ADE80; }

    .dashboard-main-columns {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 24px;
    }
    .dashboard-card {
        background: var(--surface-card, #FFFFFF);
        border: 1.5px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 20px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 16px rgba(15, 31, 61, 0.04);
    }
    body.dark-mode .dashboard-card {
        background: #1C1C1E;
        border-color: rgba(255, 255, 255, 0.1);
    }
    .dashboard-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }
    .card-title {
        font-size: 1.125rem;
        font-weight: 800;
        color: var(--persada-navy-900, #0F1F3D);
        margin: 0 0 4px 0;
    }
    body.dark-mode .card-title { color: #F8FAFC; }
    .card-subtitle {
        font-size: 0.8125rem;
        color: var(--persada-text-secondary, #6B7280);
        margin: 0;
    }
    .btn-card-more {
        background: transparent;
        border: 1px solid #E2E8F0;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        color: #1F5D9A;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .btn-card-more:hover {
        background: #EFF6FF;
        border-color: #BFDBFE;
    }
    body.dark-mode .btn-card-more {
        border-color: rgba(255, 255, 255, 0.15);
        color: #60A5FA;
    }

    .upcoming-items-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .upcoming-item-row {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 14px 16px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .upcoming-item-row:hover {
        border-color: #CBD5E1;
        background: #FFFFFF;
        box-shadow: 0 4px 12px rgba(15, 31, 61, 0.05);
        transform: translateY(-1px);
    }
    body.dark-mode .upcoming-item-row {
        background: rgba(15, 23, 42, 0.5);
        border-color: rgba(255, 255, 255, 0.08);
    }
    .item-time-box {
        display: flex;
        flex-direction: column;
        min-width: 100px;
    }
    .time-main {
        font-size: 0.8125rem;
        font-weight: 700;
        color: var(--persada-navy-900, #0F1F3D);
    }
    body.dark-mode .time-main { color: #F8FAFC; }
    .time-sub {
        font-size: 0.6875rem;
        color: #6B7280;
    }
    .item-divider-line {
        width: 1px;
        height: 36px;
        background: #E2E8F0;
    }
    body.dark-mode .item-divider-line { background: rgba(255, 255, 255, 0.1); }
    .item-content-box {
        flex: 1;
        min-width: 0;
    }
    .item-title {
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--persada-navy-900, #0F1F3D);
        margin: 0 0 2px 0;
    }
    body.dark-mode .item-title { color: #F8FAFC; }
    .item-purpose {
        font-size: 0.75rem;
        color: #6B7280;
        margin: 0 0 6px 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .item-tags-row { display: flex; gap: 6px; }
    .tag-chip {
        font-size: 0.625rem;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 999px;
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        color: #475569;
    }
    body.dark-mode .tag-chip {
        background: #1E293B;
        border-color: rgba(255, 255, 255, 0.1);
        color: #CBD5E1;
    }
    .tag-chip.status-ok {
        background: #DCFCE7;
        border-color: #BBF7D0;
        color: #15803D;
    }
    body.dark-mode .tag-chip.status-ok {
        background: rgba(22, 163, 74, 0.2);
        border-color: rgba(74, 222, 128, 0.3);
        color: #4ADE80;
    }
    .item-arrow { color: #9CA3AF; }

    .rooms-preview-grid {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .room-preview-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    body.dark-mode .room-preview-item {
        background: rgba(15, 23, 42, 0.5);
        border-color: rgba(255, 255, 255, 0.08);
    }
    .room-preview-item:hover {
        background: #EFF6FF;
        border-color: #BFDBFE;
    }
    .room-preview-avatar {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        color: #1F5D9A;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    body.dark-mode .room-preview-avatar {
        background: #1E293B;
        border-color: rgba(255, 255, 255, 0.1);
        color: #93C5FD;
    }
    .room-preview-info {
        flex: 1;
        min-width: 0;
    }
    .room-preview-name {
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--persada-navy-900, #0F1F3D);
        margin: 0;
    }
    body.dark-mode .room-preview-name { color: #F8FAFC; }
    .room-preview-meta {
        font-size: 0.72rem;
        color: #6B7280;
    }
    .btn-room-quick-book {
        padding: 6px 14px;
        border-radius: 999px;
        background: #1F5D9A;
        color: #FFFFFF;
        font-size: 0.75rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: background 0.15s ease;
    }
    .btn-room-quick-book:hover { background: #164879; }

    @@media (max-width: 1024px) {
        .stats-overview-grid { grid-template-columns: repeat(2, 1fr); }
        .dashboard-main-columns { grid-template-columns: 1fr; }
        .hero-welcome-card { flex-direction: column; gap: 20px; align-items: flex-start; }
    }
    @@media (max-width: 640px) {
        .stats-overview-grid { grid-template-columns: 1fr; }
    }
</style>

<!-- UI-09 Modal Tersedia -->
<AvailableRoomsModal Visible="_isAvailableRoomsOpen" VisibleChanged="v => _isAvailableRoomsOpen = v" />
<!-- UI-10 Modal Menunggu Persetujuan -->
<PendingApprovalsModal Visible="_isPendingOpen" VisibleChanged="v => _isPendingOpen = v" />


@code {
    private bool _isAvailableRoomsOpen;
    private bool _isPendingOpen;

    private bool _disposed;

    protected override void OnInitialized()
    {
        DashboardData.CurrentUserRole = "User";
        NotificationState.OnChange += SafeStateHasChanged;
        LoadingState.OnChange += SafeStateHasChanged;
    }

    private void SafeStateHasChanged()
    {
        if (_disposed) return;
        try
        {
            InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    public void Dispose()
    {
        _disposed = true;
        NotificationState.OnChange -= SafeStateHasChanged;
        LoadingState.OnChange -= SafeStateHasChanged;
    }

    private void DismissReminder()
    {
        NotificationState.DismissBanner();
    }

    private async Task HandleCheckInClick()
    {
        await ModalService.ShowAsync<CheckInCountdownCard>(new Dictionary<string, object>
        {
            { "RoomName", "Executive Boardroom A" },
            { "TimeSlot", "09:00 - 11:00" },
            { "Location", "Lantai 3, Sayap Utara" },
            { "Capacity", 15 }
        });
    }
}
