@namespace booking_room.Components.Shared

<AppModal Visible="@Visible" VisibleChanged="HandleVisibleChanged" Size="sm" ShowHeader="false" ShowFooter="false" NoPadding="true">
    <BodyContent>
        <div class="cbm-container">
            <!-- Icon -->
            <div class="cbm-icon-circle">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    <line x1="10" y1="11" x2="10" y2="17"></line>
                    <line x1="14" y1="11" x2="14" y2="17"></line>
                </svg>
            </div>

            <!-- Title & Warning -->
            <h3 class="cbm-title">@(string.IsNullOrEmpty(Title) ? "Batalkan Pemesanan Ini?" : Title)</h3>
            <p class="cbm-warning-text">
                @if (!string.IsNullOrEmpty(WarningMessage))
                {
                    @((MarkupString)WarningMessage)
                }
                else
                {
                    <span>Apakah Anda yakin ingin membatalkan permintaan pemesanan <strong>@(string.IsNullOrEmpty(RoomName) ? "Ruangan" : RoomName)</strong>@(string.IsNullOrEmpty(RequestId) ? "" : $" (#{RequestId})")?</span>
                }
                <span class="cbm-warning-badge">Tindakan ini tidak dapat dibatalkan.</span>
            </p>

            <!-- Textarea Group -->
            <div class="cbm-reason-group">
                <div class="cbm-label-row">
                    <label class="cbm-label" for="cancel-reason-textarea">ALASAN PEMBATALAN <span class="cbm-required-star">*</span></label>
                    <span class="cbm-char-count">@Reason.Length/200</span>
                </div>
                <textarea id="cancel-reason-textarea"
                          class="cbm-textarea"
                          rows="3"
                          maxlength="200"
                          placeholder="Contoh: Jadwal rapat berubah, ruangan tidak lagi dibutuhkan, dsb."
                          @bind="Reason"
                          @bind:event="oninput"></textarea>

                @if (string.IsNullOrWhiteSpace(Reason))
                {
                    <div class="cbm-validation-error">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span>Alasan pembatalan wajib diisi sebelum melanjutkan.</span>
                    </div>
                }
            </div>

            <!-- Footer Actions -->
            <div class="cbm-footer-actions">
                <AnimatedButton Text="Kembali" Variant="secondary" OnClick="Close" />
                <AnimatedButton Text="Ya, Batalkan Jadwal" Variant="danger" Disabled="@(string.IsNullOrWhiteSpace(Reason))" OnClick="Confirm" />
            </div>
        </div>
    </BodyContent>
</AppModal>

<style>
    .cbm-container {
        padding: 32px 28px 24px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        box-sizing: border-box;
    }
    .cbm-icon-circle {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #FEE2E2;
        color: #DC2626;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.15);
    }
    body.dark-mode .cbm-icon-circle {
        background: rgba(239, 68, 68, 0.18);
        color: #F87171;
    }
    .cbm-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: #0F172A;
        margin: 0 0 8px 0;
        letter-spacing: -0.01em;
    }
    body.dark-mode .cbm-title { color: #F8FAFC; }
    .cbm-warning-text {
        font-size: 0.875rem;
        color: #64748B;
        line-height: 1.5;
        margin: 0 0 20px 0;
        max-width: 360px;
    }
    body.dark-mode .cbm-warning-text { color: #94A3B8; }
    .cbm-warning-badge {
        display: block;
        color: #DC2626;
        font-weight: 700;
        margin-top: 6px;
    }
    body.dark-mode .cbm-warning-badge { color: #F87171; }
    .cbm-reason-group {
        width: 100%;
        text-align: left;
        margin-bottom: 24px;
    }
    .cbm-label-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }
    .cbm-label {
        font-size: 11px;
        font-weight: 700;
        color: #475569;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    body.dark-mode .cbm-label { color: #CBD5E1; }
    .cbm-required-star { color: #EF4444; font-weight: 800; }
    .cbm-char-count { font-size: 11px; color: #94A3B8; }
    .cbm-textarea {
        width: 100%;
        min-height: 84px;
        height: 90px;
        border-radius: 12px;
        border: 1.5px solid #CBD5E1;
        padding: 12px 14px;
        font-size: 13.5px;
        font-family: inherit;
        background: #FFFFFF;
        color: #0F172A;
        box-sizing: border-box;
        resize: none !important;
        overflow-y: auto !important;
        appearance: none !important;
        -webkit-appearance: none !important;
        transition: border-color 0.2s, box-shadow 0.2s;
        line-height: 1.45;
    }
    .cbm-textarea::-webkit-inner-spin-button,
    .cbm-textarea::-webkit-outer-spin-button {
        -webkit-appearance: none !important;
        margin: 0 !important;
        display: none !important;
    }
    .cbm-textarea:focus {
        border-color: #EF4444;
        outline: none;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15);
    }
    body.dark-mode .cbm-textarea {
        background: #1E293B;
        border-color: #334155;
        color: #F8FAFC;
    }
    .cbm-validation-error {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #DC2626;
        margin-top: 8px;
        background: #FEF2F2;
        padding: 6px 10px;
        border-radius: 8px;
        border: 1px solid #FEE2E2;
    }
    body.dark-mode .cbm-validation-error {
        background: rgba(239, 68, 68, 0.12);
        border-color: rgba(239, 68, 68, 0.2);
        color: #FCA5A5;
    }
    .cbm-footer-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        width: 100%;
    }
    .cbm-btn-close {
        padding: 10px 18px;
        font-size: 13.5px;
        border-radius: 999px;
    }
    .cbm-btn-confirm {
        padding: 10px 20px;
        font-size: 13.5px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? WarningMessage { get; set; }
    [Parameter] public string? RoomName { get; set; }
    [Parameter] public string? RequestId { get; set; }
    [Parameter] public EventCallback<string> OnConfirmCancel { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    public string Reason { get; set; } = "";

    protected override void OnParametersSet()
    {
        if (!Visible)
        {
            Reason = "";
        }
    }

    private async Task HandleVisibleChanged(bool value)
    {
        Visible = value;
        if (VisibleChanged.HasDelegate)
        {
            await VisibleChanged.InvokeAsync(value);
        }
    }

    private async Task Close()
    {
        Reason = "";
        await HandleVisibleChanged(false);
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task Confirm()
    {
        if (string.IsNullOrWhiteSpace(Reason)) return;
        var reasonToSubmit = Reason;
        Reason = "";
        await HandleVisibleChanged(false);
        if (OnConfirmCancel.HasDelegate)
        {
            await OnConfirmCancel.InvokeAsync(reasonToSubmit);
        }
    }
}
