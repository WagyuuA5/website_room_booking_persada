@using booking_room.Components.Models

<div class="modal-header-custom">
    <div class="modal-header-left">
        <div class="modal-header-icon icon-blue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="14" width="4" height="7" rx="1" fill="#1e40af"/>
                <rect x="8.5" y="10" width="4" height="11" rx="1" fill="#3b82f6"/>
                <rect x="14" y="6" width="4" height="15" rx="1" fill="#60a5fa"/>
                <path d="M2 21H23" stroke="#94a3b8" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
        </div>
        <div class="modal-header-info">
            <h3>Analitik Penggunaan Detail</h3>
            <p>Data periode: @SelectedPeriod</p>
        </div>
    </div>
</div>

<div class="modal-body-custom">
    <!-- Summary stats -->
    <div class="popup-stats-row">
        <div class="popup-stat-card stat-green popup-stat-card-hover">
            <div class="popup-stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
            <div class="popup-stat-value">@_animatedTotalHours</div>
            <div class="popup-stat-label">Total Jam</div>
        </div>
        <div class="popup-stat-card stat-red popup-stat-card-hover">
            <div class="popup-stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
            </div>
            <div class="popup-stat-value">@_animatedAvgUtilization%</div>
            <div class="popup-stat-label">Rata-rata</div>
        </div>
        <div class="popup-stat-card stat-blue popup-stat-card-hover">
            <div class="popup-stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
            </div>
            <div class="popup-stat-value">@_animatedRoomCount</div>
            <div class="popup-stat-label">Ruangan</div>
        </div>
    </div>

    <!-- Detailed analytics -->
    <div class="popup-scroll-area">
        <div class="popup-analytics-grid">
            @{ int rank = 0; }
            @foreach (var room in analyticsData.Rooms)
            {
                rank++;
                var maxHours = analyticsData.Rooms.Max(r => r.HoursUsed);
                var percentage = maxHours > 0 ? (double)room.HoursUsed / maxHours * 100 : 0;
                var barClass = rank switch
                {
                    1 => "bar-1",
                    2 => "bar-2",
                    3 => "bar-3",
                    4 => "bar-4",
                    _ => "bar-5"
                };
                var rankClass = rank switch
                {
                    1 => "rank-1",
                    2 => "rank-2",
                    3 => "rank-3",
                    4 => "rank-4",
                    _ => "rank-5"
                };

                <div class="popup-analytics-item">
                    <div class="popup-analytics-rank utilization-rank @rankClass">@rank</div>
                    <div class="popup-analytics-info">
                        <div class="popup-analytics-name">@room.RoomName</div>
                        <div class="popup-analytics-bar-container">
                            <div class="popup-analytics-bar-bg">
                                <div class="popup-analytics-bar-fill utilization-bar-fill @barClass" style="width: @(_barsAnimated ? percentage.ToString("0.0") : "0")%;"></div>
                            </div>
                        </div>
                    </div>
                    <div class="popup-analytics-value">@room.HoursUsed jam</div>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal-footer-custom">
    <button class="popup-btn popup-btn-secondary" @onclick="Close">Tutup</button>
</div>

<style>
    .popup-stat-card-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: default;
    }
    .popup-stat-card-hover:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(16,48,92,0.12);
    }
    .popup-stat-card.stat-blue {
        background: linear-gradient(135deg, #eff6ff, #bfdbfe);
    }
    .popup-stat-icon {
        position: absolute;
        top: 12px;
        right: 12px;
        opacity: 0.7;
    }
    .popup-stat-card {
        position: relative;
        overflow: hidden;
    }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string SelectedPeriod { get; set; } = "Minggu";

    private AnalyticsData analyticsData => DashboardData.GetAnalytics(SelectedPeriod);
    private int totalHours => analyticsData.Rooms.Sum(r => r.HoursUsed);
    private int avgUtilization => analyticsData.Rooms.Count > 0
        ? (int)Math.Round((double)analyticsData.Rooms.Average(r => r.HoursUsed) / analyticsData.Rooms.Max(r => r.HoursUsed) * 100)
        : 0;
    private int roomCount => analyticsData.Rooms.Count;

    private int _animatedTotalHours;
    private int _animatedAvgUtilization;
    private int _animatedRoomCount;
    private bool _barsAnimated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AnimateNumbers();
            await Task.Delay(100);
            _barsAnimated = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AnimateNumbers()
    {
        var duration = 800;
        var steps = 40;
        var delay = duration / steps;

        for (int i = 1; i <= steps; i++)
        {
            var progress = i / (double)steps;
            _animatedTotalHours = (int)Math.Round(totalHours * progress);
            _animatedAvgUtilization = (int)Math.Round(avgUtilization * progress);
            _animatedRoomCount = (int)Math.Round(roomCount * progress);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(delay);
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
