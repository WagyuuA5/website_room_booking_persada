@using booking_room.Components.Models
@using System.Globalization
@inject IJSRuntime JS

<div class="analytics-detail-body">
    <!-- Summary stats -->
    <div class="popup-stats-row">
        <div class="popup-stat-card stat-green popup-stat-card-hover">
            <div class="popup-stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
            <div class="popup-stat-value">@_animatedTotalHours</div>
            <div class="popup-stat-label">Total Jam</div>
        </div>
        <div class="popup-stat-card stat-red popup-stat-card-hover">
            <div class="popup-stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
            </div>
            <div class="popup-stat-value">@_animatedAvgUtilization%</div>
            <div class="popup-stat-label">Rata-rata</div>
        </div>
        <div class="popup-stat-card stat-blue popup-stat-card-hover">
            <div class="popup-stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
            </div>
            <div class="popup-stat-value">@_animatedRoomCount</div>
            <div class="popup-stat-label">Ruangan</div>
        </div>
    </div>

    <!-- Detailed analytics -->
    <div class="popup-scroll-area">
        <div class="popup-analytics-grid">
            @{ int rank = 0; }
            @foreach (var room in analyticsData.Rooms)
            {
                rank++;
                var maxHours = analyticsData.Rooms.Max(r => r.HoursUsed);
                var percentage = maxHours > 0 ? (double)room.HoursUsed / maxHours * 100 : 0;
                var barClass = rank switch
                {
                    1 => "bar-1",
                    2 => "bar-2",
                    3 => "bar-3",
                    4 => "bar-4",
                    _ => "bar-5"
                };
                var rankClass = rank switch
                {
                    1 => "rank-1",
                    2 => "rank-2",
                    3 => "rank-3",
                    4 => "rank-4",
                    _ => "rank-5"
                };

                <div class="popup-analytics-item">
                    <div class="popup-analytics-rank utilization-rank @rankClass">@rank</div>
                    <div class="popup-analytics-info">
                        <div class="popup-analytics-name">@room.RoomName</div>
                        <div class="popup-analytics-bar-container">
                            <div class="popup-analytics-bar-bg">
                                <div class="popup-analytics-bar-fill utilization-bar-fill @barClass" style="width: @(_barsAnimated ? percentage.ToString("0.0", CultureInfo.InvariantCulture) : "0")%;"></div>
                            </div>
                        </div>
                    </div>
                    <div class="popup-analytics-value">@room.HoursUsed jam</div>
                </div>
            }
        </div>

        <!-- Interactive Utilization Chart with scrub gesture and no Tren Penggunaan title -->
        <div class="popup-trend-chart">
            <UtilizationChart SelectedPeriod="@SelectedPeriod" />
        </div>
    </div>
</div>

<style>
    .analytics-detail-body {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .popup-stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .popup-stat-card {
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        padding: 16px 20px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        border: 1px solid rgba(226, 232, 240, 0.8);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .popup-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(15, 31, 61, 0.08);
    }

    .popup-stat-card.stat-green {
        background: linear-gradient(135deg, #F0FDF4, #DCFCE7);
        border-color: #BBF7D0;
    }

    .popup-stat-card.stat-red {
        background: linear-gradient(135deg, #FEF2F2, #FEE2E2);
        border-color: #FECACA;
    }

    .popup-stat-card.stat-blue {
        background: linear-gradient(135deg, #EFF6FF, #DBEAFE);
        border-color: #BFDBFE;
    }

    .popup-stat-icon {
        position: absolute;
        top: 14px;
        right: 14px;
        opacity: 0.85;
    }

    .popup-stat-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--persada-navy-900, #0F1F3D);
        line-height: 1.2;
    }

    .popup-stat-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #64748B;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 4px;
    }

    .popup-analytics-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .popup-analytics-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        background: #FFFFFF;
        border: 1px solid var(--divider-subtle, rgba(15, 23, 42, 0.08));
        border-radius: 12px;
    }

    .popup-analytics-rank {
        width: 24px;
        height: 24px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .rank-1 { background: #DBEAFE; color: #1E40AF; }
    .rank-2 { background: #E0E7FF; color: #3730A3; }
    .rank-3 { background: #EDE9FE; color: #5B21B6; }
    .rank-4 { background: #F1F5F9; color: #475569; }
    .rank-5 { background: #F8FAFC; color: #64748B; }

    .popup-analytics-info {
        flex: 1;
        min-width: 0;
    }

    .popup-analytics-name {
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--persada-navy-900, #0F1F3D);
        margin-bottom: 6px;
    }

    .popup-analytics-bar-bg {
        width: 100%;
        height: 8px;
        background: #E2E8F0;
        border-radius: 999px;
        overflow: hidden;
    }

    .popup-analytics-bar-fill {
        height: 100%;
        border-radius: 999px;
        transition: width 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .bar-1 { background: linear-gradient(90deg, #3B82F6, #2563EB); }
    .bar-2 { background: linear-gradient(90deg, #60A5FA, #3B82F6); }
    .bar-3 { background: linear-gradient(90deg, #818CF8, #6366F1); }
    .bar-4 { background: linear-gradient(90deg, #94A3B8, #64748B); }
    .bar-5 { background: linear-gradient(90deg, #CBD5E1, #94A3B8); }

    .popup-analytics-value {
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--persada-navy-900, #0F1F3D);
        white-space: nowrap;
    }

    .popup-trend-chart {
        margin-top: 12px;
    }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string SelectedPeriod { get; set; } = "Minggu";

    private AnalyticsData analyticsData => DashboardData.GetAnalytics(SelectedPeriod);
    private int totalHours => analyticsData.Rooms.Sum(r => r.HoursUsed);
    private int avgUtilization => analyticsData.Rooms.Count > 0
        ? (int)Math.Round((double)analyticsData.Rooms.Average(r => r.HoursUsed) / analyticsData.Rooms.Max(r => r.HoursUsed) * 100)
        : 0;
    private int roomCount => analyticsData.Rooms.Count;

    private int _animatedTotalHours;
    private int _animatedAvgUtilization;
    private int _animatedRoomCount;
    private bool _barsAnimated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AnimateNumbers();
            await Task.Delay(100);
            _barsAnimated = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AnimateNumbers()
    {
        var duration = 800;
        var steps = 40;
        var delay = duration / steps;

        for (int i = 1; i <= steps; i++)
        {
            var progress = i / (double)steps;
            _animatedTotalHours = (int)Math.Round(totalHours * progress);
            _animatedAvgUtilization = (int)Math.Round(avgUtilization * progress);
            _animatedRoomCount = (int)Math.Round(roomCount * progress);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(delay);
        }
    }

    private RenderFragment BuildTrendChart(ChartData chartData)
    {
        if (chartData == null || chartData.Labels == null || chartData.Datasets == null || chartData.Datasets.Length == 0)
            return @<text></text>;

        var primaryDataset = chartData.Datasets[0];
        var data = primaryDataset.Data;
        var labels = chartData.Labels;
        if (data == null || data.Length == 0)
            return @<text></text>;

        var width = 400;
        var height = 160;
        var paddingX = 20;
        var paddingY = 20;
        var chartW = width - paddingX * 2;
        var chartH = height - paddingY * 2;
        var max = data.Max();
        var min = data.Min();
        var range = max - min;
        if (range == 0) range = 1;

        var points = new List<string>();
        var circles = new List<string>();
        for (int i = 0; i < data.Length; i++)
        {
            var x = paddingX + (i / (double)(data.Length - 1)) * chartW;
            var y = paddingY + chartH - ((data[i] - min) / range) * chartH;
            
            var xStr = x.ToString("F1", CultureInfo.InvariantCulture);
            var yStr = y.ToString("F1", CultureInfo.InvariantCulture);
            
            points.Add($"{xStr},{yStr}");
            circles.Add($"<circle cx=\"{xStr}\" cy=\"{yStr}\" r=\"3\" fill=\"#3b82f6\" />");
        }

        var linePath = $"M {string.Join(" L ", points)}";
        var areaPath = $"{linePath} L {paddingX + chartW.ToString("F1", CultureInfo.InvariantCulture)},{paddingY + chartH.ToString("F1", CultureInfo.InvariantCulture)} L {paddingX.ToString("F1", CultureInfo.InvariantCulture)},{paddingY + chartH.ToString("F1", CultureInfo.InvariantCulture)} Z";

        return @<text>
            <!-- Grid lines -->
            <line x1="@paddingX" y1="@paddingY" x2="@(paddingX + chartW)" y2="@paddingY" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="4" />
            <line x1="@paddingX" y1="@(paddingY + chartH/2)" x2="@(paddingX + chartW)" y2="@(paddingY + chartH/2)" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="4" />
            <line x1="@paddingX" y1="@(paddingY + chartH)" x2="@(paddingX + chartW)" y2="@(paddingY + chartH)" stroke="#e2e8f0" stroke-width="1" />
            
            <path d="@areaPath" fill="url(#trendGradient)" />
            <path d="@linePath" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
            @foreach (var c in circles)
            {
                @((MarkupString)c)
            }
        </text>;
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
