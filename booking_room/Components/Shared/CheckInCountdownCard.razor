@implements IDisposable
@namespace booking_room.Components.Shared
@using System.Globalization
@using booking_room.Components.Models
@using booking_room.Services
@inject IToastService ToastService
@inject IModalService ModalService

<Modal Visible="true" ShowHeader="false" ShowFooter="false" LayoutMode="solid-card" Size="md" OnClose="HandleCancelClose">
    <BodyContent>
        <div class="checkin-confirmation-modal">
            <!-- Header avatar & info -->
    <div class="checkin-top-header">
                <div class="room-avatar">
                    <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=128&h=128&fit=crop" alt="Avatar Ruangan" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                    <div class="room-avatar-fallback">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    </div>
                </div>
                <h2 class="checkin-room-title">@RoomName</h2>
                <div class="checkin-status-pill">
                    <span class="status-pulse-dot"></span>
                    <span>CHECK-IN DIBUKA</span>
                </div>
            </div>

            <!-- Compact Countdown Ring -->
            <div class="countdown-ring-box">
                <svg viewBox="0 0 120 120" width="112" height="112" class="countdown-svg">
                    <circle cx="60" cy="60" r="50" fill="none" stroke="#F1F5F9" stroke-width="7" />
                    <circle cx="60" cy="60" r="50" fill="none" stroke="@RingColorClass" stroke-width="7"
                            stroke-linecap="round"
                            stroke-dasharray="314.15"
                            stroke-dashoffset="@((314.15 * (1 - (_remainingPercentage / 100))).ToString(CultureInfo.InvariantCulture))"
                            transform="rotate(-90 60 60)" 
                            class="countdown-ring @(_remainingPercentage < 20 ? "pulse-ring" : "")"
                            style="transition: stroke-dashoffset 1s linear, stroke 0.5s ease;" />
                </svg>
                <div class="countdown-text-box">
                    <span class="countdown-digits">@RemainingTimeFormatted</span>
                    <span class="countdown-subtext">Waktu Tersisa</span>
                </div>
            </div>

            <!-- Compact Info Grid -->
            <div class="checkin-meta-grid">
                <div class="checkin-meta-item">
                    <div class="meta-icon-wrap">
                        <InlineSvg Src="/icons/Icon_clndr.svg" Style="width: 16px; height: 16px; color: currentColor;" />
                    </div>
                    <div>
                        <div class="meta-label">WAKTU</div>
                        <div class="meta-value">@TimeSlot</div>
                    </div>
                </div>
                <div class="checkin-meta-item">
                    <div class="meta-icon-wrap">
                        <InlineSvg Src="/icons/icon_location.svg" Style="width: 16px; height: 16px; color: currentColor;" />
                    </div>
                    <div>
                        <div class="meta-label">LOKASI</div>
                        <div class="meta-value">@Location</div>
                    </div>
                </div>
                <div class="checkin-meta-item full-width">
                    <div class="meta-icon-wrap">
                        <InlineSvg Src="/icons/icon_group.svg" Style="width: 16px; height: 16px; color: currentColor;" />
                    </div>
                    <div>
                        <div class="meta-label">KAPASITAS</div>
                        <div class="meta-value">@Capacity peserta diperkirakan hadir</div>
                    </div>
                </div>
            </div>

            <!-- Primary Action Button: "Konfirmasi" -->
            <button @onclick="ConfirmCheckIn" class="btn-checkin-confirm">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="10" fill="currentColor" fill-opacity="0.2"/>
                    <path d="M8 12L11 15L16 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Konfirmasi
            </button>

            <!-- Secondary Actions Row (Neat side-by-side or stacked list with icons) -->
            <div class="checkin-secondary-actions">
                @if (!_hasExtended)
                {
                    <button @onclick="OpenExtendModal" class="btn-secondary-action btn-time-more" type="button">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>Saya butuh waktu tambahan</span>
                    </button>
                }
                <button @onclick="CancelBooking" class="btn-secondary-action btn-cancel-booking" type="button">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    <span>Batalkan pemesanan ini</span>
                </button>
            </div>
        </div>
    </BodyContent>
</Modal>

<style>
    .checkin-confirmation-modal {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 8px 4px;
        width: 100%;
        box-sizing: border-box;
    }

    .checkin-top-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 12px;
    }

    .room-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #E2E8F0;
        overflow: hidden;
        margin-bottom: 8px;
        border: 2px solid #FFFFFF;
        box-shadow: 0 4px 10px rgba(15, 31, 61, 0.12);
        position: relative;
    }

    .room-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .room-avatar-fallback {
        display: none;
        position: absolute;
        inset: 0;
        align-items: center;
        justify-content: center;
        background: #F1F5F9;
    }

    .checkin-room-title {
        color: var(--persada-navy-900, #0F1F3D);
        font-weight: 800;
        font-size: 1.25rem;
        margin: 0 0 6px 0;
        letter-spacing: -0.01em;
        text-align: center;
    }

    .checkin-status-pill {
        background: rgba(245, 158, 11, 0.12);
        padding: 4px 12px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.7rem;
        font-weight: 700;
        color: #B45309;
        letter-spacing: 0.05em;
    }

    .status-pulse-dot {
        width: 6px;
        height: 6px;
        background: var(--persada-yellow-500, #F59E0B);
        border-radius: 50%;
        display: inline-block;
    }

    .countdown-ring-box {
        position: relative;
        width: 112px;
        height: 112px;
        margin-bottom: 16px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .countdown-svg {
        position: absolute;
        top: 0;
        left: 0;
    }

    .countdown-text-box {
        z-index: 1;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .countdown-digits {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--persada-navy-900, #0F1F3D);
        line-height: 1;
    }

    .countdown-subtext {
        font-size: 0.7rem;
        color: #94A3B8;
        font-weight: 600;
        margin-top: 2px;
    }

    .checkin-meta-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        width: 100%;
        margin-bottom: 16px;
    }

    .checkin-meta-item {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        background: var(--surface-card, #FFFFFF);
        border: 1px solid var(--divider-subtle, rgba(15, 23, 42, 0.08));
        padding: 8px 12px;
        border-radius: 12px;
    }

    .checkin-meta-item.full-width {
        grid-column: 1 / -1;
    }

    .meta-icon-wrap {
        color: #64748B;
        margin-top: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .meta-label {
        font-size: 0.65rem;
        color: #94A3B8;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .meta-value {
        font-size: 0.8125rem;
        font-weight: 700;
        color: var(--persada-navy-900, #0F1F3D);
        margin-top: 1px;
    }

    .btn-checkin-confirm {
        width: 100%;
        padding: 12px;
        border-radius: 999px;
        border: none;
        background: var(--persada-yellow-500, #F59E0B);
        color: var(--persada-navy-900, #0F1F3D);
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-bottom: 12px;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.25);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-checkin-confirm:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(245, 158, 11, 0.35);
    }

    .checkin-secondary-actions {
        display: flex;
        gap: 8px;
        width: 100%;
        padding-top: 8px;
        border-top: 1px solid rgba(226, 232, 240, 0.6);
    }

    .btn-secondary-action {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: transparent;
        border-radius: 999px;
        height: 38px;
        font-weight: 600;
        font-size: 0.775rem;
        cursor: pointer;
        transition: all 0.2s ease;
        padding: 0 10px;
        white-space: nowrap;
    }

    .btn-time-more {
        border: 1px solid #CBD5E1;
        color: #475569;
    }

    .btn-time-more:hover {
        background: #F1F5F9;
        color: var(--persada-navy-900, #0F1F3D);
    }

    .btn-cancel-booking {
        border: 1px solid #FECACA;
        color: #DC2626;
    }

    .btn-cancel-booking:hover {
        background: #FEF2F2;
    }

    .pulse-ring {
        animation: pulseRing 1s infinite;
    }

    @@keyframes pulseRing {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }
</style>

@code {
    [Parameter] public string RoomName { get; set; } = "Alpha Boardroom";
    [Parameter] public string TimeSlot { get; set; } = "09:00 - 11:00";
    [Parameter] public string Location { get; set; } = "Lantai 2, Sayap A";
    [Parameter] public int Capacity { get; set; } = 12;
    [Parameter] public DateTime TargetTime { get; set; } = DateTime.Now.AddMinutes(15);

    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnAutoReleased { get; set; }

    private PeriodicTimer? _timer;
    private string RemainingTimeFormatted = "15:00";
    private double RemainingOffset = 0;
    private double _totalSeconds;
    private double _remainingPercentage = 100;

    private double RemainingPercentage => _remainingPercentage;

    private string RingColorClass => _remainingPercentage switch
    {
        > 50 => "#22C55E",
        >= 20 => "#F59E0B",
        _ => "#EF4444"
    };

    protected override void OnInitialized()
    {
        _totalSeconds = 15 * 60;
        UpdateCountdown();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await _timer.WaitForNextTickAsync())
            {
                UpdateCountdown();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void UpdateCountdown()
    {
        var remaining = TargetTime - DateTime.Now;
        if (remaining <= TimeSpan.Zero)
        {
            remaining = TimeSpan.Zero;
            _timer?.Dispose();
            InvokeAsync(() => OnAutoReleased.InvokeAsync());
        }

        RemainingTimeFormatted = remaining.ToString(@"mm\:ss");
        
        double progress = remaining.TotalSeconds / _totalSeconds;
        progress = Math.Max(0, Math.Min(1, progress));
        RemainingOffset = 326.7 * (1 - progress);
        _remainingPercentage = progress * 100;
    }

    private async Task ConfirmCheckIn()
    {
        _timer?.Dispose();
        if (OnConfirm.HasDelegate)
        {
            await OnConfirm.InvokeAsync();
        }
        else
        {
            await ModalService.ReplaceTopAsync(typeof(CheckInSuccessModal), new Dictionary<string, object>
            {
                { "Timestamp", DateTime.Now }
            });
        }
    }

    private bool _hasExtended = false;

    private async Task OpenExtendModal()
    {
        var parameters = new Dictionary<string, object>
        {
            { "RoomName", RoomName },
            { "OnRequestExtension", EventCallback.Factory.Create<string>(this, HandleRequestExtension) }
        };
        await ModalService.ShowAsync<RequestMoreTimeModal>(parameters);
    }

    private void HandleRequestExtension(string reason)
    {
        ExtendWindow();
        ToastService.Info("Waktu ditambah 10 menit");
    }

    private void ExtendWindow()
    {
        if (!_hasExtended)
        {
            TargetTime = TargetTime.AddMinutes(10);
            _totalSeconds += 10 * 60;
            _hasExtended = true;
            UpdateCountdown();
        }
    }

    private async Task CancelBooking()
    {
        var parameters = new Dictionary<string, object>
        {
            { "RoomName", RoomName },
            { "OnConfirmCancel", EventCallback.Factory.Create(this, HandleConfirmCancel) }
        };
        await ModalService.ShowAsync<CancelConfirmationModal>(parameters);
    }

    private async Task HandleConfirmCancel()
    {
        _timer?.Dispose();
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
        await ModalService.CloseTopAsync(ModalResult.Cancel());
    }

    private async Task HandleCancelClose()
    {
        _timer?.Dispose();
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
