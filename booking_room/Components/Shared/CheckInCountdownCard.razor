@implements IDisposable
@namespace booking_room.Components.Shared
@using System.Globalization
@using booking_room.Components.Models
@using booking_room.Services
@inject IToastService ToastService
@inject IModalService ModalService

<AppModal Visible="true" ShowHeader="false" ShowCloseButton="false" ShowFooter="false" LayoutMode="solid-card" Size="md" OnClose="HandleCancelClose">
    <BodyContent>
        @if (_isConfirmedSuccess)
        {
            <!-- CASE 8a: Tampilan Popup Sukses Konfirmasi Kehadiran -->
            <div class="checkin-success-view animate-fade-in">
                <div class="success-check-circle">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6L9 17l-5-5"/>
                    </svg>
                </div>
                <h2 class="checkin-success-title">Konfirmasi Kehadiran Berhasil</h2>
                <p class="checkin-success-desc">
                    Kehadiran Anda telah dikonfirmasi untuk rapat di <strong>@RoomName</strong>.
                </p>
                <div class="checkin-success-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>Dikonfirmasi pada @DateTime.Now.ToString("HH:mm") WIB</span>
                </div>
                <button type="button" class="btn-checkin-confirm" style="margin-top: 20px;" @onclick="DismissSuccess">
                    Selesai
                </button>
            </div>
        }
        else
        {
            <div class="checkin-confirmation-modal">
                <!-- Header avatar & info -->
                <div class="checkin-top-header">
                    <div class="room-avatar">
                        <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=128&h=128&fit=crop" alt="Avatar Ruangan" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                        <div class="room-avatar-fallback">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                        </div>
                    </div>
                    <h2 class="checkin-room-title">@RoomName</h2>
                    <div class="checkin-status-pill">
                        <span class="status-pulse-dot"></span>
                        <span>KONFIRMASI KEHADIRAN DIBUKA</span>
                    </div>
                </div>

                <!-- Modern Circular Countdown Ring (Case 7) -->
                <div class="countdown-ring-box">
                    <svg viewBox="0 0 120 120" width="112" height="112" class="countdown-svg">
                        <circle cx="60" cy="60" r="50" fill="none" stroke="#F1F5F9" stroke-width="7" />
                        <circle cx="60" cy="60" r="50" fill="none" stroke="@RingColorClass" stroke-width="7"
                                stroke-linecap="round"
                                stroke-dasharray="314.15"
                                stroke-dashoffset="@((314.15 * (1 - (_remainingPercentage / 100))).ToString(CultureInfo.InvariantCulture))"
                                transform="rotate(-90 60 60)" 
                                class="countdown-ring @(_remainingPercentage < 20 ? "pulse-ring" : "")"
                                style="transition: stroke-dashoffset 1s linear, stroke 0.5s ease;" />
                    </svg>
                    <div class="countdown-text-box">
                        <span class="countdown-digits">@RemainingTimeFormatted</span>
                        <span class="countdown-subtext">Waktu Tersisa</span>
                    </div>
                </div>

                <!-- Modern Refined Info Grid (Case 7) -->
                <div class="checkin-meta-grid">
                    <div class="checkin-meta-item">
                        <div class="meta-icon-wrap">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        </div>
                        <div>
                            <div class="meta-label">WAKTU</div>
                            <div class="meta-value">@TimeSlot</div>
                        </div>
                    </div>
                    <div class="checkin-meta-item">
                        <div class="meta-icon-wrap">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        </div>
                        <div>
                            <div class="meta-label">LOKASI</div>
                            <div class="meta-value">@Location</div>
                        </div>
                    </div>
                    <div class="checkin-meta-item full-width">
                        <div class="meta-icon-wrap">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        </div>
                        <div>
                            <div class="meta-label">KAPASITAS</div>
                            <div class="meta-value">@Capacity peserta diperkirakan hadir</div>
                        </div>
                    </div>
                </div>

                <!-- Primary Action Button: "Konfirmasi" (Pill 999px) -->
                <button @onclick="ConfirmCheckIn" class="btn-checkin-confirm" type="button">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="12" r="10" fill="currentColor" fill-opacity="0.2"/>
                        <path d="M8 12L11 15L16 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>Konfirmasi</span>
                </button>

                <!-- Secondary Actions Row: Pill Buttons with Clear Hierarchy (Case 7 & Case 8b, 8c) -->
                <div class="checkin-secondary-actions">
                    @if (_extensionCount < 2)
                    {
                        <button @onclick="RequestExtraTime" class="btn-secondary-action btn-time-more" type="button">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <span>Saya butuh waktu tambahan @(_extensionCount > 0 ? "(+10m)" : "")</span>
                        </button>
                    }
                    else
                    {
                        <div class="extension-limit-notice">
                            <span>Batas waktu tambahan maksimum (2x) telah tercapai</span>
                        </div>
                    }

                    <button @onclick="OpenCancelModal" class="btn-secondary-action btn-cancel-booking" type="button">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                        <span>Lepas / Batalkan Pemesanan</span>
                    </button>
                </div>
            </div>
        }
    </BodyContent>
</AppModal>

<!-- CASE 8c: Reuse Modal Konfirmasi Pembatalan (V49/V50) dengan Alasan Wajib -->
<CancelBookingModal Visible="@_showCancelModal"
                    VisibleChanged="@(v => _showCancelModal = v)"
                    OnClose="@(() => _showCancelModal = false)"
                    Title="Lepas / Batalkan Pemesanan?"
                    RoomName="@RoomName"
                    WarningMessage="@($"Apakah Anda yakin ingin melepas/membatalkan pemesanan <strong>{RoomName}</strong>? Ruangan akan dibebaskan untuk dipesan orang lain.")"
                    OnConfirmCancel="HandleConfirmReleaseWithReason" />

<style>
    .checkin-confirmation-modal {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 4px;
        gap: 16px;
    }

    /* CASE 8a: Success State Inside Modal */
    .checkin-success-view {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 24px 16px 8px;
        gap: 12px;
    }
    .success-check-circle {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: #DCFCE7;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(22, 163, 74, 0.2);
        animation: scaleIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    body.dark-mode .success-check-circle {
        background: rgba(34, 197, 94, 0.2);
    }
    .checkin-success-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: #0F172A;
        margin: 4px 0 0;
    }
    body.dark-mode .checkin-success-title { color: #F8FAFC; }
    .checkin-success-desc {
        font-size: 0.9rem;
        color: #64748B;
        line-height: 1.5;
        margin: 0;
        max-width: 320px;
    }
    body.dark-mode .checkin-success-desc { color: #94A3B8; }
    .checkin-success-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #F1F5F9;
        color: #475569;
        font-size: 0.8125rem;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 999px;
        margin-top: 4px;
    }
    body.dark-mode .checkin-success-badge {
        background: rgba(255, 255, 255, 0.08);
        color: #CBD5E1;
    }

    .checkin-top-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .room-avatar {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        overflow: hidden;
        border: 2px solid #E2E8F0;
        box-shadow: 0 4px 12px rgba(15, 31, 61, 0.08);
    }
    .room-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .room-avatar-fallback { width: 100%; height: 100%; display: none; align-items: center; justify-content: center; background: #F1F5F9; }

    .checkin-room-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--persada-navy-900, #0F1F3D);
        margin: 0;
    }
    body.dark-mode .checkin-room-title { color: #FFFFFF; }

    .checkin-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #DCFCE7;
        color: #15803D;
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        padding: 4px 12px;
        border-radius: 999px;
    }
    body.dark-mode .checkin-status-pill {
        background: rgba(22, 163, 74, 0.2);
        color: #4ADE80;
    }

    .status-pulse-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #16A34A;
        animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0% { transform: scale(0.95); opacity: 0.8; }
        50% { transform: scale(1.4); opacity: 1; }
        100% { transform: scale(0.95); opacity: 0.8; }
    }

    .countdown-ring-box {
        position: relative;
        width: 112px;
        height: 112px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 2px 0;
    }
    .countdown-svg { transform: rotate(-90deg); }
    .countdown-ring { transition: stroke-dashoffset 1s linear, stroke 0.5s ease; }
    .countdown-text-box {
        position: absolute;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .countdown-digits {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--persada-navy-900, #0F1F3D);
        line-height: 1.1;
    }
    body.dark-mode .countdown-digits { color: #FFFFFF; }
    .countdown-subtext {
        font-size: 0.625rem;
        font-weight: 600;
        color: #94A3B8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* CASE 7: Modern Refined Info Grid with 16px radius */
    .checkin-meta-grid {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 16px;
        padding: 14px;
        text-align: left;
    }
    body.dark-mode .checkin-meta-grid {
        background: rgba(15, 23, 42, 0.55);
        border-color: rgba(255, 255, 255, 0.08);
    }

    .checkin-meta-item {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .checkin-meta-item.full-width {
        grid-column: 1 / -1;
        border-top: 1px solid #E2E8F0;
        padding-top: 10px;
        margin-top: 2px;
    }
    body.dark-mode .checkin-meta-item.full-width { border-color: rgba(255, 255, 255, 0.08); }

    .meta-icon-wrap {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        color: #1F5D9A;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    body.dark-mode .meta-icon-wrap {
        background: #1E293B;
        border-color: rgba(255, 255, 255, 0.1);
        color: #93C5FD;
    }

    .meta-label {
        font-size: 0.625rem;
        font-weight: 700;
        color: #94A3B8;
        letter-spacing: 0.05em;
    }
    .meta-value {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--persada-navy-900, #0F1F3D);
    }
    body.dark-mode .meta-value { color: #F8FAFC; }

    /* CASE 7: Pill Primary Action Button */
    .btn-checkin-confirm {
        width: 100%;
        height: 46px;
        border-radius: 999px;
        background: #1F5D9A;
        color: #FFFFFF;
        font-size: 0.9375rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        box-shadow: 0 4px 14px rgba(31, 93, 154, 0.28);
    }
    .btn-checkin-confirm:hover {
        background: #164879;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(31, 93, 154, 0.35);
    }

    .checkin-secondary-actions {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    /* CASE 7: Pill Secondary Buttons with Clear Color Hierarchy */
    .btn-secondary-action {
        width: 100%;
        height: 40px;
        border-radius: 999px;
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.18s ease;
    }
    
    .btn-time-more {
        background: transparent;
        border: 1.5px solid #CBD5E1;
        color: #475569;
    }
    .btn-time-more:hover {
        background: #F1F5F9;
        border-color: #94A3B8;
        color: #0F1F3D;
    }
    body.dark-mode .btn-time-more {
        border-color: rgba(255, 255, 255, 0.18);
        color: #CBD5E1;
    }
    body.dark-mode .btn-time-more:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #FFFFFF;
    }

    /* CASE 7: Destructive Button Soft Red Tint Pill */
    .btn-cancel-booking {
        background: #FEF2F2;
        border: 1.5px solid #FECACA;
        color: #DC2626;
    }
    .btn-cancel-booking:hover {
        background: #FEE2E2;
        border-color: #F87171;
        color: #B91C1C;
    }
    body.dark-mode .btn-cancel-booking {
        background: rgba(239, 68, 68, 0.15);
        border-color: rgba(239, 68, 68, 0.3);
        color: #F87171;
    }
    body.dark-mode .btn-cancel-booking:hover {
        background: rgba(239, 68, 68, 0.25);
        border-color: rgba(239, 68, 68, 0.5);
        color: #FCA5A5;
    }

    .extension-limit-notice {
        font-size: 0.75rem;
        color: #94A3B8;
        padding: 4px;
    }
</style>

@code {
    [Parameter] public string RoomName { get; set; } = "Ruang Rapat Utama";
    [Parameter] public string TimeSlot { get; set; } = "10:00 - 11:30";
    [Parameter] public string Location { get; set; } = "Lantai 3, Gedung A";
    [Parameter] public int Capacity { get; set; } = 12;
    [Parameter] public DateTime TargetTime { get; set; } = DateTime.Now.AddMinutes(15);
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnAutoReleased { get; set; }

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private bool _disposed;
    private string RemainingTimeFormatted = "15:00";
    private double _remainingPercentage = 100;
    private double _totalSeconds = 15 * 60;
    private int _extensionCount = 0;
    private bool _isConfirmedSuccess = false;
    private bool _showCancelModal = false;

    private string RingColorClass => _remainingPercentage switch
    {
        > 50 => "#22C55E",
        >= 20 => "#F59E0B",
        _ => "#EF4444"
    };

    protected override void OnInitialized()
    {
        _totalSeconds = 15 * 60;
        UpdateCountdown();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed)
        {
            _cts = new CancellationTokenSource();
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            try
            {
                while (!_disposed && await _timer.WaitForNextTickAsync(_cts.Token))
                {
                    if (_disposed) break;
                    UpdateCountdown();
                    try
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                    catch (ObjectDisposedException) { break; }
                    catch (InvalidOperationException) { break; }
                }
            }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) { }
        }
    }

    private void UpdateCountdown()
    {
        var remaining = TargetTime - DateTime.Now;
        if (remaining <= TimeSpan.Zero)
        {
            remaining = TimeSpan.Zero;
            _timer?.Dispose();
            if (!_disposed)
            {
                try
                {
                    InvokeAsync(() => OnAutoReleased.InvokeAsync());
                }
                catch { }
            }
        }

        RemainingTimeFormatted = remaining.ToString(@"mm\:ss");
        double progress = remaining.TotalSeconds / _totalSeconds;
        progress = Math.Max(0, Math.Min(1, progress));
        _remainingPercentage = progress * 100;
    }

    // CASE 8a: Konfirmasi dengan Popup Sukses + Toast
    private async Task ConfirmCheckIn()
    {
        _timer?.Dispose();
        _cts?.Cancel();
        _isConfirmedSuccess = true;

        ToastService.Success("Konfirmasi Kehadiran Berhasil", $"Kehadiran Anda telah dikonfirmasi untuk rapat di {RoomName}.");

        if (OnConfirm.HasDelegate)
        {
            await OnConfirm.InvokeAsync();
        }

        // Auto close after 2.5 seconds
        _ = Task.Run(async () =>
        {
            await Task.Delay(2500);
            if (!_disposed)
            {
                await InvokeAsync(async () =>
                {
                    await DismissSuccess();
                });
            }
        });
    }

    private async Task DismissSuccess()
    {
        await ModalService.CloseTopAsync(ModalResult.Ok());
    }

    // CASE 8b: Perpanjangan Waktu Tanpa Reload/Error
    private void RequestExtraTime()
    {
        if (_extensionCount >= 2)
        {
            ToastService.Warning("Batas Maksimum", "Batas waktu tambahan konfirmasi kehadiran telah tercapai (maks. 2 kali).");
            return;
        }

        TargetTime = TargetTime.AddMinutes(10);
        _totalSeconds += 10 * 60;
        _extensionCount++;
        UpdateCountdown();

        ToastService.Info("Waktu Tambahan Diberikan", "Waktu konfirmasi kehadiran berhasil diperpanjang 10 menit.");
    }

    // CASE 8c: Buka Modal Pembatalan dengan Alasan Wajib (Reused CancelBookingModal)
    private void OpenCancelModal()
    {
        _showCancelModal = true;
    }

    private async Task HandleConfirmReleaseWithReason(string reason)
    {
        _timer?.Dispose();
        _cts?.Cancel();
        _showCancelModal = false;

        ToastService.Success("Pemesanan Dibatalkan", $"Pemesanan {RoomName} berhasil dibatalkan dan ruangan telah dilepas.");

        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
        await ModalService.CloseTopAsync(ModalResult.Cancel());
    }

    private async Task HandleCancelClose()
    {
        _timer?.Dispose();
        _cts?.Cancel();
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
    }
}
