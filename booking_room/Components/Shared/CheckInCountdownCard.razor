@implements IDisposable
@namespace booking_room.Components.Shared
@using System.Globalization
@using booking_room.Components.Models
@using booking_room.Services
@inject IToastService ToastService
@inject IModalService ModalService

<AppModal Visible="true" ShowHeader="false" ShowCloseButton="false" ShowFooter="false" LayoutMode="solid-card" Size="md" OnClose="HandleCancelClose">
    <BodyContent>
        @if (_isConfirmedSuccess)
        {
            <!-- CASE 8a: Tampilan Popup Sukses Konfirmasi Kehadiran -->
            <div class="checkin-success-view animate-fade-in">
                <div class="success-check-circle">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6L9 17l-5-5"/>
                    </svg>
                </div>
                <h2 class="checkin-success-title">Konfirmasi Kehadiran Berhasil</h2>
                <p class="checkin-success-desc">
                    Kehadiran Anda telah dikonfirmasi untuk rapat di <strong>@RoomName</strong>.
                </p>
                <div class="checkin-success-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>Dikonfirmasi pada @DateTime.Now.ToString("HH:mm") WIB</span>
                </div>
                <button type="button" class="btn-checkin-confirm" style="margin-top: 20px;" @onclick="DismissSuccess">
                    Selesai
                </button>
            </div>
        }
        else
        {
            <div class="modal-checkin">
                <div class="checkin-hero">
                    <img src="@(RoomDataProvider.GetRoomPhoto(PhotoUrl, RoomName))" class="checkin-hero-bg" alt="@RoomName" />
                    <div class="checkin-hero-overlay"></div>
                    <div class="checkin-hero-content">
                        <span class="badge-success-glass">
                            <span class="status-dot"></span> Konfirmasi Kehadiran Dibuka
                        </span>
                        <h3 class="checkin-room-name">@RoomName</h3>
                    </div>
                </div>

                <div class="checkin-timer-section">
                    <svg class="checkin-timer-ring" viewBox="0 0 100 100">
                        <circle cx="50" cy="50" r="44" fill="none" stroke="var(--color-border, #E2E8F0)" stroke-width="6" />
                        <circle cx="50" cy="50" r="44" fill="none" stroke="var(--color-success, #16A34A)" stroke-width="6"
                                stroke-linecap="round"
                                stroke-dasharray="276.5"
                                stroke-dashoffset="@GetTimerOffset()"
                                style="transition: stroke-dashoffset 1s linear;" />
                    </svg>
                    <div class="checkin-timer-text">
                        <span class="checkin-timer-value">@RemainingTimeFormatted</span>
                        <span class="text-caption">WAKTU TERSISA</span>
                    </div>
                </div>

                <div class="checkin-info-grid">
                    <div class="checkin-info-item">
                        <img src="/icon/Icon_clndr.svg" class="icon-sm" alt="" />
                        <div><span class="text-label-uppercase">Waktu</span><span class="text-body">@TimeSlot</span></div>
                    </div>
                    <div class="checkin-info-item">
                        <img src="/icon/icon_location.svg" class="icon-sm" alt="" />
                        <div><span class="text-label-uppercase">Lokasi</span><span class="text-body">@Location</span></div>
                    </div>
                    <div class="checkin-info-item checkin-info-item--full">
                        <img src="/icon/icon_group.svg" class="icon-sm" alt="" />
                        <div><span class="text-label-uppercase">Kapasitas</span><span class="text-body">@Capacity peserta diperkirakan hadir</span></div>
                    </div>
                </div>

                <div class="checkin-actions">
                    <button class="btn-primary-hero btn-full-width" @onclick="ConfirmCheckIn">
                        <img src="/icon/icon_check_circle.svg" class="icon-sm icon-white" alt="" /> Konfirmasi Kehadiran
                    </button>
                    @if (_extensionCount < 2)
                    {
                        <button class="btn-secondary-outline" @onclick="RequestExtraTime">
                            <img src="/icon/timer_dshbrd.svg" class="icon-sm" alt="" /> Saya Butuh Waktu Tambahan @(_extensionCount > 0 ? "(+10m)" : "")
                        </button>
                    }
                    else
                    {
                        <div class="extension-limit-notice">
                            <span>Batas waktu tambahan maksimum (2x) telah tercapai</span>
                        </div>
                    }
                    <button class="btn-text-danger" @onclick="OpenCancelModal">
                        Lepas / Batalkan Pemesanan
                    </button>
                </div>
            </div>
        }
    </BodyContent>
</AppModal>

<!-- CASE 8c: Reuse Modal Konfirmasi Pembatalan (V49/V50) dengan Alasan Wajib -->
<CancelBookingModal Visible="@_showCancelModal"
                    VisibleChanged="@(v => _showCancelModal = v)"
                    OnClose="@(() => _showCancelModal = false)"
                    Title="Lepas / Batalkan Pemesanan?"
                    RoomName="@RoomName"
                    WarningMessage="@($"Apakah Anda yakin ingin melepas/membatalkan pemesanan <strong>{RoomName}</strong>? Ruangan akan dibebaskan untuk dipesan orang lain.")"
                    OnConfirmCancel="HandleConfirmReleaseWithReason" />

<style>
    .checkin-confirmation-modal {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 4px;
        gap: 16px;
    }

    /* CASE 8a: Success State Inside Modal */
    .checkin-success-view {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 24px 16px 8px;
        gap: 12px;
    }
    .success-check-circle {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: #DCFCE7;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(22, 163, 74, 0.2);
        animation: scaleIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    body.dark-mode .success-check-circle {
        background: rgba(34, 197, 94, 0.2);
    }
    .checkin-success-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: #0F172A;
        margin: 4px 0 0;
    }
    body.dark-mode .checkin-success-title { color: #F8FAFC; }
    .checkin-success-desc {
        font-size: 0.9rem;
        color: #64748B;
        line-height: 1.5;
        margin: 0;
        max-width: 320px;
    }
    body.dark-mode .checkin-success-desc { color: #94A3B8; }
    .checkin-success-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #F1F5F9;
        color: #475569;
        font-size: 0.8125rem;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 999px;
        margin-top: 4px;
    }
    body.dark-mode .checkin-success-badge {
        background: rgba(255, 255, 255, 0.08);
        color: #CBD5E1;
    }

    /* CASE 4 (V65): Redesign Total Popup Konfirmasi Kehadiran */
    .modal-checkin {
        width: 100%;
    }
    .checkin-hero {
        position: relative;
        height: 120px;
        border-radius: 20px 20px 0 0;
        overflow: hidden;
        margin: -24px -28px 0 -28px; /* full-bleed di dalam modal padding standar */
    }
    .checkin-hero-bg { width: 100%; height: 100%; object-fit: cover; }
    .checkin-hero-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(180deg, rgba(15,23,42,0.1) 0%, rgba(15,23,42,0.75) 100%);
    }
    .checkin-hero-content {
        position: absolute; bottom: 16px; left: 20px; right: 20px;
        display: flex; flex-direction: column; gap: 6px;
        text-align: left;
    }
    .badge-success-glass {
        display: inline-flex; align-items: center; gap: 6px;
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.25);
        color: white; font-size: 11px; font-weight: 700;
        padding: 5px 12px; border-radius: 999px; width: fit-content;
        text-transform: uppercase; letter-spacing: 0.4px;
    }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; background: #4ADE80; box-shadow: 0 0 6px #4ADE80; }
    .checkin-room-name { color: white; font-size: 20px; font-weight: 700; margin: 0; }

    .checkin-timer-section {
        position: relative;
        width: 130px; height: 130px;
        margin: 24px auto 20px auto;
        display: flex; align-items: center; justify-content: center;
    }
    .checkin-timer-ring { width: 100%; height: 100%; transform: rotate(-90deg); }
    .checkin-timer-text {
        position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
        display: flex; flex-direction: column; align-items: center; gap: 2px;
    }
    .checkin-timer-value { font-size: 24px; font-weight: 700; color: var(--color-text-primary, #0F172A); font-variant-numeric: tabular-nums; }
    body.dark-mode .checkin-timer-value { color: #FFFFFF; }
    .text-caption { font-size: 10px; font-weight: 700; color: var(--color-text-secondary, #64748B); letter-spacing: 0.05em; }
    body.dark-mode .text-caption { color: #94A3B8; }

    .checkin-info-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
        background: var(--color-bg-page, #F8FAFC); border-radius: 14px; padding: 16px; margin-bottom: 20px;
        text-align: left;
    }
    body.dark-mode .checkin-info-grid {
        background: rgba(255, 255, 255, 0.04);
    }
    .checkin-info-item { display: flex; align-items: flex-start; gap: 10px; }
    .checkin-info-item--full { grid-column: 1 / -1; }
    .text-label-uppercase { font-size: 10px; font-weight: 700; color: var(--color-text-secondary, #64748B); text-transform: uppercase; display: block; margin-bottom: 2px; }
    body.dark-mode .text-label-uppercase { color: #94A3B8; }
    .text-body { font-size: 13px; font-weight: 600; color: var(--color-text-primary, #0F172A); display: block; }
    body.dark-mode .text-body { color: #F1F5F9; }

    .checkin-actions { display: flex; flex-direction: column; gap: 10px; }
    .btn-full-width { width: 100%; justify-content: center; }

    .btn-primary-hero {
        background: linear-gradient(135deg, #F5A623 0%, #D97706 100%);
        color: #FFFFFF;
        border: none;
        border-radius: 999px;
        padding: 12px 24px;
        font-weight: 600;
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(245, 166, 35, 0.3);
        transition: all 150ms ease-in-out;
    }
    .btn-primary-hero:hover {
        background: linear-gradient(135deg, #E59819 0%, #B45309 100%);
        box-shadow: 0 6px 18px rgba(245, 166, 35, 0.4);
        transform: translateY(-1px);
    }
    .btn-primary-hero:active {
        transform: translateY(0);
    }

    .btn-secondary-outline {
        width: 100%; background: white; border: 1px solid var(--color-border, #E2E8F0);
        border-radius: 999px; padding: 12px; font-weight: 600; font-size: 14px;
        display: flex; align-items: center; justify-content: center; gap: 8px;
        cursor: pointer; transition: background 150ms ease-in-out;
        color: var(--color-text-primary, #0F172A);
    }
    .btn-secondary-outline:hover { background: var(--color-bg-page, #F8FAFC); }
    body.dark-mode .btn-secondary-outline {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.12);
        color: #F8FAFC;
    }
    body.dark-mode .btn-secondary-outline:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    .btn-text-danger {
        background: none; border: none; color: var(--color-danger, #EF4444);
        font-size: 13px; font-weight: 600; padding: 8px; cursor: pointer;
        text-align: center;
    }
    .btn-text-danger:hover { text-decoration: underline; }

    .extension-limit-notice {
        font-size: 0.75rem;
        color: #94A3B8;
        padding: 4px;
        text-align: center;
    }
</style>

@code {
    [Parameter] public string RoomName { get; set; } = "Ruang Rapat Utama";
    [Parameter] public string TimeSlot { get; set; } = "10:00 - 11:30";
    [Parameter] public string Location { get; set; } = "Lantai 3, Gedung A";
    [Parameter] public int Capacity { get; set; } = 12;
    [Parameter] public string? PhotoUrl { get; set; }
    [Parameter] public DateTime TargetTime { get; set; } = DateTime.Now.AddMinutes(15);
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnAutoReleased { get; set; }

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private bool _disposed;
    private string RemainingTimeFormatted = "15:00";
    private double _remainingPercentage = 100;
    private double _totalSeconds = 15 * 60;
    private int _extensionCount = 0;
    private bool _isConfirmedSuccess = false;
    private bool _showCancelModal = false;

    private double GetTimerOffset()
    {
        const double circumference = 276.5; // 2 * PI * 44
        var totalSeconds = _totalSeconds;
        var remainingSeconds = Math.Max(0, (TargetTime - DateTime.Now).TotalSeconds);
        var progress = remainingSeconds / totalSeconds;
        progress = Math.Max(0, Math.Min(1, progress));
        return circumference * (1 - progress);
    }

    private string RingColorClass => _remainingPercentage switch
    {
        > 50 => "#22C55E",
        >= 20 => "#F59E0B",
        _ => "#EF4444"
    };

    protected override void OnInitialized()
    {
        _totalSeconds = 15 * 60;
        UpdateCountdown();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed)
        {
            _cts = new CancellationTokenSource();
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            try
            {
                while (!_disposed && await _timer.WaitForNextTickAsync(_cts.Token))
                {
                    if (_disposed) break;
                    UpdateCountdown();
                    try
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                    catch (ObjectDisposedException) { break; }
                    catch (InvalidOperationException) { break; }
                }
            }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) { }
        }
    }

    private void UpdateCountdown()
    {
        var remaining = TargetTime - DateTime.Now;
        if (remaining <= TimeSpan.Zero)
        {
            remaining = TimeSpan.Zero;
            _timer?.Dispose();
            if (!_disposed)
            {
                try
                {
                    InvokeAsync(() => OnAutoReleased.InvokeAsync());
                }
                catch { }
            }
        }

        RemainingTimeFormatted = remaining.ToString(@"mm\:ss");
        double progress = remaining.TotalSeconds / _totalSeconds;
        progress = Math.Max(0, Math.Min(1, progress));
        _remainingPercentage = progress * 100;
    }

    // CASE 8a: Konfirmasi dengan Popup Sukses + Toast
    private async Task ConfirmCheckIn()
    {
        _timer?.Dispose();
        _cts?.Cancel();
        _isConfirmedSuccess = true;

        ToastService.Success("Konfirmasi Kehadiran Berhasil", $"Kehadiran Anda telah dikonfirmasi untuk rapat di {RoomName}.");

        if (OnConfirm.HasDelegate)
        {
            await OnConfirm.InvokeAsync();
        }

        // Auto close after 2.5 seconds
        _ = Task.Run(async () =>
        {
            await Task.Delay(2500);
            if (!_disposed)
            {
                await InvokeAsync(async () =>
                {
                    await DismissSuccess();
                });
            }
        });
    }

    private async Task DismissSuccess()
    {
        await ModalService.CloseTopAsync(ModalResult.Ok());
    }

    // CASE 8b: Perpanjangan Waktu Tanpa Reload/Error
    private void RequestExtraTime()
    {
        if (_extensionCount >= 2)
        {
            ToastService.Warning("Batas Maksimum", "Batas waktu tambahan konfirmasi kehadiran telah tercapai (maks. 2 kali).");
            return;
        }

        TargetTime = TargetTime.AddMinutes(10);
        _totalSeconds += 10 * 60;
        _extensionCount++;
        UpdateCountdown();

        ToastService.Info("Waktu Tambahan Diberikan", "Waktu konfirmasi kehadiran berhasil diperpanjang 10 menit.");
    }

    // CASE 8c: Buka Modal Pembatalan dengan Alasan Wajib (Reused CancelBookingModal)
    private void OpenCancelModal()
    {
        _showCancelModal = true;
    }

    private async Task HandleConfirmReleaseWithReason(string reason)
    {
        _timer?.Dispose();
        _cts?.Cancel();
        _showCancelModal = false;

        ToastService.Success("Pemesanan Dibatalkan", $"Pemesanan {RoomName} berhasil dibatalkan dan ruangan telah dilepas.");

        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
        await ModalService.CloseTopAsync(ModalResult.Cancel());
    }

    private async Task HandleCancelClose()
    {
        _timer?.Dispose();
        _cts?.Cancel();
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
    }
}
