<div class="date-picker-popup">
    <div class="dp-header">
        <h3>Select Date Range</h3>
        <button class="dp-close" @onclick="OnClose">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
    </div>

    <div class="dp-body">
        <div class="dp-month-nav">
            <button class="dp-nav-btn" @onclick="PrevMonth">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <span class="dp-month-label">@currentDate.ToString("MMMM yyyy")</span>
            <button class="dp-nav-btn" @onclick="NextMonth">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
        </div>

        <div class="dp-day-headers">
            <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
        </div>

        <div class="dp-days-grid">
            @foreach (var day in CalendarDays)
            {
                var d = day;
                var isCurrentMonth = d.Month == currentDate.Month && d.Year == currentDate.Year;
                var isSelected = d == selectedStart || d == selectedEnd;
                var isInRange = selectedStart.HasValue && selectedEnd.HasValue && d > selectedStart && d < selectedEnd;
                var isToday = d == DateTime.Today;
                
                <button class="dp-day @(isCurrentMonth ? "" : "other-month") @(isSelected ? "selected" : "") @(isInRange ? "in-range" : "") @(isToday ? "today" : "")"
                        @onclick="() => SelectDay(d)">
                    @d.Day
                </button>
            }
        </div>

        <div class="dp-selected-range">
            @if (selectedStart.HasValue && selectedEnd.HasValue)
            {
                <span>@selectedStart.Value.ToString("MMM dd") — @selectedEnd.Value.ToString("MMM dd, yyyy")</span>
            }
            else if (selectedStart.HasValue)
            {
                <span>@selectedStart.Value.ToString("MMM dd, yyyy") — Select end date</span>
            }
            else
            {
                <span>Click to select start date</span>
            }
        </div>
    </div>

    <div class="dp-footer">
        <button class="dp-btn-reset" @onclick="Reset">Reset</button>
        <button class="dp-btn-apply" @onclick="Apply">Apply</button>
    </div>
</div>

<style>
    .date-picker-popup {
        width: 320px;
        background: #FFFFFF;
        border-radius: 16px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15);
        border: 1px solid #E5E7EB;
        font-family: 'Inter', sans-serif;
        overflow: hidden;
    }
    .dp-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid #F3F4F6;
    }
    .dp-header h3 {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
        color: #16305C;
    }
    .dp-close {
        background: none;
        border: none;
        color: #9CA3AF;
        cursor: pointer;
        padding: 4px;
        display: flex;
        border-radius: 50%;
    }
    .dp-close:hover { background-color: #F3F4F6; }
    .dp-body { padding: 16px 20px; }
    .dp-month-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }
    .dp-month-label {
        font-size: 15px;
        font-weight: 600;
        color: #16305C;
    }
    .dp-nav-btn {
        background: none;
        border: none;
        color: #6B7280;
        cursor: pointer;
        padding: 6px;
        border-radius: 8px;
        display: flex;
    }
    .dp-nav-btn:hover { background-color: #F3F4F6; }
    .dp-day-headers {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0;
        margin-bottom: 8px;
    }
    .dp-day-headers span {
        text-align: center;
        font-size: 12px;
        font-weight: 600;
        color: #9CA3AF;
        padding: 4px 0;
    }
    .dp-days-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 2px;
    }
    .dp-day {
        text-align: center;
        padding: 8px 0;
        border: none;
        background: none;
        font-size: 13px;
        color: #374151;
        cursor: pointer;
        border-radius: 8px;
        transition: background-color 0.15s;
        font-weight: 500;
    }
    .dp-day:hover:not(.other-month) { background-color: #EEF2FF; }
    .dp-day.other-month { color: #D1D5DB; }
    .dp-day.today { font-weight: 700; color: #16305C; border: 1px solid #16305C; }
    .dp-day.selected { background-color: #16305C; color: white; font-weight: 700; }
    .dp-day.in-range { background-color: #EEF2FF; color: #16305C; border-radius: 0; }
    .dp-selected-range {
        text-align: center;
        padding: 12px 0 4px 0;
        font-size: 13px;
        color: #6B7280;
        font-weight: 500;
    }
    .dp-footer {
        display: flex;
        justify-content: space-between;
        padding: 16px 20px;
        border-top: 1px solid #F3F4F6;
    }
    .dp-btn-reset {
        background: none;
        border: none;
        color: #6B7280;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
    }
    .dp-btn-reset:hover { color: #16305C; }
    .dp-btn-apply {
        background-color: #16305C;
        color: white;
        border: none;
        border-radius: 999px;
        padding: 8px 24px;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
    }
    .dp-btn-apply:hover { opacity: 0.9; }
</style>

@code {
    [Parameter] public EventCallback<string> OnApply { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private DateTime currentDate = DateTime.Today;
    private DateTime? selectedStart;
    private DateTime? selectedEnd;

    private List<DateTime> CalendarDays
    {
        get
        {
            var days = new List<DateTime>();
            var firstOfMonth = new DateTime(currentDate.Year, currentDate.Month, 1);
            var startDay = firstOfMonth.AddDays(-(int)firstOfMonth.DayOfWeek);
            for (int i = 0; i < 42; i++)
                days.Add(startDay.AddDays(i));
            return days;
        }
    }

    private void PrevMonth() => currentDate = currentDate.AddMonths(-1);
    private void NextMonth() => currentDate = currentDate.AddMonths(1);

    private void SelectDay(DateTime day)
    {
        if (!selectedStart.HasValue || (selectedStart.HasValue && selectedEnd.HasValue))
        {
            selectedStart = day;
            selectedEnd = null;
        }
        else
        {
            if (day < selectedStart.Value)
            {
                selectedEnd = selectedStart;
                selectedStart = day;
            }
            else
            {
                selectedEnd = day;
            }
        }
    }

    private void Reset()
    {
        selectedStart = null;
        selectedEnd = null;
    }

    private async Task Apply()
    {
        var range = "";
        if (selectedStart.HasValue && selectedEnd.HasValue)
            range = $"{selectedStart.Value:yyyy-MM-dd} to {selectedEnd.Value:yyyy-MM-dd}";
        await OnApply.InvokeAsync(range);
    }
}
