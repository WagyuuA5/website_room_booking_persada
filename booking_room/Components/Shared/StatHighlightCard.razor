@namespace booking_room.Components.Shared

<div class="stat-highlight-card @GetVariantClass() @(OnClick.HasDelegate ? "clickable" : "")" @onclick="HandleClick">
    <div class="stat-card-bg"></div>
    <div class="stat-card-inner">
        <div class="stat-card-header">
            @if (!string.IsNullOrEmpty(BadgeText))
            {
                <span class="stat-card-badge">@BadgeText</span>
            }
            @if (Icon != null)
            {
                <div class="stat-card-icon-wrap">
                    @Icon
                </div>
            }
        </div>

        <div class="stat-card-body">
            <div class="stat-card-main-info">
                @if (!string.IsNullOrEmpty(Title))
                {
                    <div class="stat-card-title">@Title</div>
                }
                @if (!string.IsNullOrEmpty(Value))
                {
                    <div class="stat-card-value">@Value</div>
                }
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <div class="stat-card-subtitle">@Subtitle</div>
                }
            </div>

            @if (CustomBody != null)
            {
                @CustomBody
            }
        </div>

        @if (!string.IsNullOrEmpty(ButtonText) || ShowArrow)
        {
            <div class="stat-card-footer">
                @if (!string.IsNullOrEmpty(ButtonText))
                {
                    <button class="btn-stat-action" type="button" @onclick="HandleClick" @onclick:stopPropagation="true">
                        @ButtonText
                    </button>
                }
                @if (ShowArrow)
                {
                    <div class="stat-card-arrow">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 18l6-6-6-6" />
                        </svg>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .stat-highlight-card {
        position: relative;
        background: var(--persada-white, #FFFFFF);
        border: 1px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: var(--radius-card, 16px);
        padding: 24px;
        box-shadow: var(--shadow-card);
        overflow: hidden;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 160px;
    }

    .stat-highlight-card.clickable {
        cursor: pointer;
    }

    .stat-highlight-card.clickable:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-card-hover);
        border-color: #CBD5E1;
    }

    .stat-card-inner {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        height: 100%;
        justify-content: space-between;
        gap: 16px;
    }

    .stat-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stat-card-badge {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: var(--radius-pill, 999px);
    }

    .stat-card-icon-wrap {
        width: 44px;
        height: 44px;
        border-radius: var(--radius-md, 12px);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .stat-card-body {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .stat-card-title {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-brand-text-muted, #6B7280);
    }

    .stat-card-value {
        font-size: 1.875rem;
        font-weight: 800;
        color: var(--color-brand-navy, #0F1F3D);
        line-height: 1.2;
    }

    .stat-card-subtitle {
        font-size: 0.8125rem;
        color: var(--color-brand-text-muted, #6B7280);
        margin-top: 2px;
    }

    .stat-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
    }

    .btn-stat-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 18px;
        font-size: 0.875rem;
        font-weight: 600;
        border-radius: var(--radius-pill, 999px);
        border: none;
        cursor: pointer;
        transition: all 0.2s;
    }

    .stat-card-arrow {
        color: #9CA3AF;
        transition: transform 0.2s;
    }

    .stat-highlight-card.clickable:hover .stat-card-arrow {
        transform: translateX(4px);
        color: var(--color-brand-navy, #0F1F3D);
    }

    /* --- Varian Success (Pemesanan Instan) --- */
    .stat-variant-success {
        border-left: 4px solid #10B981;
    }
    .stat-variant-success .stat-card-badge {
        background-color: #E7F8EF;
        color: #16A34A;
    }
    .stat-variant-success .stat-card-icon-wrap {
        background-color: #E7F8EF;
        color: #10B981;
    }
    .stat-variant-success .btn-stat-action {
        background-color: var(--persada-yellow-500, #F59E0B);
        color: var(--persada-navy-900, #0F1F3D);
    }
    .stat-variant-success .btn-stat-action:hover {
        background-color: #E8930A;
    }

    /* --- Varian Warning (Persetujuan Tertunda) --- */
    .stat-variant-warning {
        border-left: 4px solid var(--persada-yellow-500, #F59E0B);
    }
    .stat-variant-warning .stat-card-badge {
        background-color: #FFF4E5;
        color: #D97706;
    }
    .stat-variant-warning .stat-card-icon-wrap {
        background-color: #FFF4E5;
        color: #D97706;
    }
    .stat-variant-warning .btn-stat-action {
        background-color: #FFF4E5;
        color: #D97706;
    }
    .stat-variant-warning .btn-stat-action:hover {
        background-color: #FDE68A;
    }

    /* --- Varian Info --- */
    .stat-variant-info {
        border-left: 4px solid var(--color-brand-blue, #1F5D9A);
    }
    .stat-variant-info .stat-card-badge {
        background-color: #E8ECFB;
        color: #1F5D9A;
    }
    .stat-variant-info .stat-card-icon-wrap {
        background-color: #E8ECFB;
        color: #1F5D9A;
    }
</style>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string BadgeText { get; set; } = string.Empty;
    [Parameter] public string ButtonText { get; set; } = string.Empty;
    [Parameter] public string Variant { get; set; } = "info"; // success, warning, info
    [Parameter] public bool ShowArrow { get; set; } = false;
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? CustomBody { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string GetVariantClass() => Variant switch
    {
        "success" => "stat-variant-success",
        "warning" => "stat-variant-warning",
        _ => "stat-variant-info"
    };

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }
}
