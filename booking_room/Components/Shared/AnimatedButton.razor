@namespace booking_room.Components.Shared

<button class="animated-btn animated-btn--@Variant app-btn app-btn--@Variant @Class"
        type="@(string.IsNullOrEmpty(Type) ? "button" : Type)"
        style="@Style"
        disabled="@Disabled"
        @onclick="OnClick">
    <span class="animated-btn__label-default app-btn__label">@Text</span>
</button>

@code {
    [Parameter] public string Text { get; set; } = "Button";
    [Parameter] public string Variant { get; set; } = "primary"; // primary | secondary | danger | blue
    [Parameter] public string? IconPath { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string? Type { get; set; } = "button";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
}
