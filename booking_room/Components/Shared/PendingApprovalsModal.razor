@namespace booking_room.Components.Shared
@using booking_room.Components.Models
@inject NavigationManager Navigation

<Modal Visible="@Visible" VisibleChanged="HandleVisibleChanged" Title="Persetujuan Tertunda" LayoutMode="list" Size="md" ShowCloseButton="true" OnClose="OnClose">
    <HeaderContent>
        <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
            <div>
                <h3 style="margin: 0; font-size: 1.15rem; font-weight: 800; color: var(--color-brand-navy, #0F1F3D);">Persetujuan Tertunda</h3>
                <p style="margin: 4px 0 0 0; font-size: 0.8125rem; color: var(--color-brand-text-muted, #6B7280);">Tinjau permintaan pemesanan terbaru Anda.</p>
            </div>
            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; background: #FEF3C7; color: #F2B705; font-size: 0.75rem; font-weight: 700;">
                <span style="width: 6px; height: 6px; border-radius: 50%; background: #F2B705;"></span>
                @PendingCount Menunggu
            </span>
        </div>
    </HeaderContent>
    <BodyContent>
        <div class="pending-approvals-list">
            @foreach (var item in PendingItems)
            {
                <div class="pending-approval-item">
                    <div class="pending-approval-icon @item.ColorClass">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="@item.IconPath" fill="currentColor" stroke="none"/>
                        </svg>
                    </div>
                    <div class="pending-approval-content">
                        <div class="pending-approval-room">@item.RoomName</div>
                        <div class="pending-approval-meta">
                            <span>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                @item.DateStr
                            </span>
                            <span>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                @item.TimeStr
                            </span>
                        </div>
                        <div class="pending-approval-requested">Oleh @item.RequestedBy</div>
                    </div>
                    <div class="pending-approval-actions">
                        <span class="pending-badge-pill">
                            <span class="pending-badge-dot"></span>
                            Menunggu
                        </span>
                        <button class="btn-approve-sm" @onclick="() => ApproveItem(item)">Setujui</button>
                        <button class="btn-reject-sm" @onclick="() => ShowRejectModal(item)">Tolak</button>
                    </div>
                </div>
            }
        </div>
    </BodyContent>
    <FooterContent>
        <div style="display: flex; gap: 12px; width: 100%;">
            <button class="btn-modal-outline" style="flex: 1;" @onclick="HandleClose">Tutup</button>
            <button class="btn-modal-primary" style="flex: 1;" @onclick="ViewAllDetails">
                Lihat Semua Detail
            </button>
        </div>
    </FooterContent>
</Modal>

@if (_rejectingItem != null)
{
    <Modal Visible="true" VisibleChanged="HandleRejectVisibleChanged" Title="Tolak Persetujuan" LayoutMode="alert" Size="sm" ShowCloseButton="false" OnClose="CloseRejectModal">
        <BodyContent>
            <div style="display: flex; flex-direction: column; gap: 16px;">
                <p style="margin: 0; font-size: 0.875rem; color: var(--color-brand-text-muted, #6B7280);">Berikan alasan penolakan untuk <strong>@_rejectingItem.RoomName</strong>.</p>
                <textarea class="form-textarea-reason" @bind="_rejectReason" placeholder="Alasan penolakan..." rows="3"></textarea>
            </div>
        </BodyContent>
        <FooterContent>
            <div style="display: flex; gap: 8px; justify-content: flex-end;">
                <button class="btn-modal-outline" @onclick="HandleCloseReject">Batal</button>
                <button class="btn-modal-primary" style="background: #E5484D; border-color: #E5484D;" @onclick="ConfirmReject" disabled="@string.IsNullOrWhiteSpace(_rejectReason)">Tolak</button>
            </div>
        </FooterContent>
    </Modal>
}

<style>
    .pending-approvals-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .pending-approval-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
        background: #F8FAFC;
        border: 1px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 16px;
        transition: all 0.2s ease;
    }

    .pending-approval-item:hover {
        border-color: #CBD5E1;
        box-shadow: 0 2px 8px rgba(15, 31, 61, 0.04);
    }

    .pending-approval-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .icon-blue { background: #DBEAFE; color: #2563EB; }
    .icon-purple { background: #EDE9FE; color: #7C3AED; }
    .icon-light-blue { background: #E0F2FE; color: #0284C7; }

    .pending-approval-content {
        flex: 1;
        min-width: 0;
    }

    .pending-approval-room {
        font-weight: 700;
        font-size: 0.9375rem;
        color: var(--color-brand-navy, #0F1B3D);
        margin-bottom: 4px;
    }

    .pending-approval-meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: 0.8rem;
        color: var(--color-brand-text-muted, #6B7280);
    }

    .pending-approval-meta span {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .pending-approval-requested {
        font-size: 0.75rem;
        color: #94a3b8;
        margin-top: 4px;
    }

    .pending-approval-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        flex-shrink: 0;
    }

    .pending-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 999px;
        background: #FEF3C7;
        color: #F2B705;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .pending-badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #F2B705;
    }

    .btn-approve-sm {
        padding: 6px 14px;
        border-radius: 999px;
        border: none;
        background: #1AA262;
        color: white;
        font-weight: 700;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-approve-sm:hover {
        background: #158A50;
        transform: translateY(-1px);
    }

    .btn-reject-sm {
        padding: 6px 14px;
        border-radius: 999px;
        border: 1px solid #FECACA;
        background: white;
        color: #E5484D;
        font-weight: 700;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-reject-sm:hover {
        background: #FEF2F2;
    }

    .form-textarea-reason {
        width: 100%;
        padding: 12px;
        border: 1.5px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 12px;
        font-size: 0.875rem;
        font-family: 'Inter', sans-serif;
        resize: vertical;
        box-sizing: border-box;
        outline: none;
    }

    .form-textarea-reason:focus {
        border-color: var(--color-brand-gold-500, #F5B301);
        box-shadow: 0 0 0 3px rgba(245, 179, 1, 0.15);
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private PendingApprovalItemCustom? _rejectingItem = null;
    private string _rejectReason = "";

    private record PendingApprovalItemCustom(string RoomName, string RequestedBy, string DateStr, string TimeStr, string ColorClass, string IconPath);

    private List<PendingApprovalItemCustom> PendingItems = new()
    {
        new("Executive Boardroom A", "J. Smith", "14 Agustus 2026", "10:00 - 12:00", "icon-blue", "M19 2H5C3.9 2 3 2.9 3 4V20C3 21.1 3.9 22 5 22H19C20.1 22 21 21.1 21 20V4C21 2.9 20.1 2 19 2ZM15 20H9V12H15V20Z"),
        new("Studio 4 (Webinar)", "A. Chen", "15 Agustus 2026", "14:30 - 16:00", "icon-purple", "M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"),
        new("Training Ruangan C", "M. Davis", "16 Agustus 2026", "09:00 - 17:00", "icon-light-blue", "M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z")
    };

    private int PendingCount => PendingItems.Count;

    private async Task ApproveItem(PendingApprovalItemCustom item)
    {
        PendingItems.Remove(item);
        StateHasChanged();
    }

    private void ShowRejectModal(PendingApprovalItemCustom item)
    {
        _rejectingItem = item;
        _rejectReason = "";
    }

    private void CloseRejectModal()
    {
        _rejectingItem = null;
        _rejectReason = "";
    }

    private async Task ConfirmReject()
    {
        if (_rejectingItem != null && !string.IsNullOrWhiteSpace(_rejectReason))
        {
            PendingItems.Remove(_rejectingItem);
            _rejectingItem = null;
            _rejectReason = "";
            StateHasChanged();
        }
    }

    private async Task ViewAllDetails()
    {
        await OnClose.InvokeAsync();
        Navigation.NavigateTo("/status");
    }

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleVisibleChanged(bool visible)
    {
        if (!visible)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleRejectVisibleChanged(bool visible)
    {
        if (!visible)
        {
            CloseRejectModal();
        }
    }

    private async Task HandleCloseReject()
    {
        CloseRejectModal();
    }
}
