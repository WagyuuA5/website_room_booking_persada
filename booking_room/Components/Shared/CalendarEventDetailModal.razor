@namespace booking_room.Components.Shared
@using booking_room.Services
@using booking_room.Components.Models
@inject NavigationManager Navigation
@inject IToastService ToastService

@if (Visible && EventItem != null)
{
    var room = RoomDataProvider.GetRoomById(EventItem.RoomId);

    <AppModal Visible="@Visible" VisibleChanged="HandleVisibleChanged" Size="lg" Title="@EventItem.ActivityTitle" Subtitle="@($"{EventItem.RoomName} • Lantai {room?.Floor ?? "1"}")" ShowFooter="true">
        <ChildContent>
            <div class="calendar-detail-body">
                <!-- Status & Recurrence Bar -->
                <div class="detail-header-status-bar">
                    <span class="status-badge-pill status-@EventItem.Status.ToLower()">
                        @GetStatusLabel(EventItem.Status)
                    </span>

                    <span class="recurrence-badge">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="17 1 21 5 17 9"></polyline>
                            <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
                            <polyline points="7 23 3 19 7 15"></polyline>
                            <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
                        </svg>
                        <span>@GetRecurrenceLabel(EventItem)</span>
                    </span>

                    @if (EventItem.IsStarred)
                    {
                        <span class="star-indicator" title="Ditandai Bintang">? Ditandai Bintang</span>
                    }
                </div>

                <!-- Info Grid -->
                <div class="detail-info-grid">
                    <!-- Left: Waktu & Pemesan -->
                    <div class="info-card">
                        <h4 class="info-section-title">WAKTU & JADWAL</h4>
                        <div class="info-row">
                            <div class="info-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            </div>
                            <div class="info-text">
                                <div class="info-label">Tanggal Rapat</div>
                                <div class="info-val">@EventItem.SpecificDate.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))</div>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            </div>
                            <div class="info-text">
                                <div class="info-label">Durasi Waktu</div>
                                <div class="info-val">@EventItem.StartTime.ToString(@"hh\:mm") - @EventItem.EndTime.ToString(@"hh\:mm") WIB</div>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Data Pemesan -->
                    <div class="info-card">
                        <h4 class="info-section-title">DATA PEMESAN</h4>
                        <div class="info-row">
                            <div class="info-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                            <div class="info-text">
                                <div class="info-label">Nama Pemesan</div>
                                <div class="info-val">@EventItem.BookerName</div>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/></svg>
                            </div>
                            <div class="info-text">
                                <div class="info-label">Divisi</div>
                                <div class="info-val">@EventItem.Division</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Room Specifications (CASE 7: Large Banner) -->
                <div class="room-spec-card">
                    <div class="room-spec-banner-hero">
                        <img src="@RoomDataProvider.GetRoomPhoto(room?.PhotoUrl, EventItem.RoomId)" alt="@EventItem.RoomName" class="room-spec-banner-img" />
                        <span class="room-spec-capacity-badge">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <span>Kapasitas @(room?.Capacity ?? 10) Orang</span>
                        </span>
                    </div>
                    <div class="room-spec-info-body">
                        <h4 class="room-spec-name">@EventItem.RoomName</h4>
                        <div class="room-spec-sub">Lantai @(room?.Floor ?? "1"), Gedung Persada HQ</div>
                        <p class="room-spec-desc">@(room?.Description ?? "Ruang pertemuan modern dengan fasilitas lengkap.")</p>
                        <div class="room-spec-amenities-row">
                            @if (room?.Amenities != null && room.Amenities.Any())
                            {
                                @foreach (var am in room.Amenities)
                                {
                                    <span class="spec-amenity-chip">@am</span>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Peserta yang Diundang (CASE 1: Clickable chips) -->
                <div class="detail-section">
                    <h4 class="info-section-title">PESERTA YANG DIUNDANG (@(EventItem.Attendees.Count))</h4>
                    @if (EventItem.Attendees.Any())
                    {
                        <div class="attendees-list">
                            @foreach (var attendee in EventItem.Attendees)
                            {
                                <div class="attendee-chip clickable" @onclick="() => OpenParticipantDetail(attendee)" title="Klik untuk melihat profil identitas @attendee">
                                    <div class="attendee-avatar">@(attendee.Length >= 2 ? attendee.Substring(0, 2).ToUpper() : "P")</div>
                                    <span>@attendee</span>
                                    <svg class="chip-info-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted-empty">Tidak ada peserta eksternal terdaftar.</div>
                    }
                </div>

                <!-- Permintaan Fasilitas Tambahan (CASE 2: Direct routing with highlight) -->
                @if (!string.IsNullOrEmpty(EventItem.AdditionalFacilities))
                {
                    <div class="facility-notice-box">
                        <div class="facility-notice-left">
                            <div class="facility-notice-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                            </div>
                            <div>
                                <div class="facility-notice-title">Fasilitas Tambahan Diajukan</div>
                                <div class="facility-notice-text">@EventItem.AdditionalFacilities</div>
                            </div>
                        </div>
                        <button type="button" class="btn-goto-facilities" @onclick="NavigateToFacilities">
                            Lihat di Permintaan Fasilitas &rarr;
                        </button>
                    </div>
                }
            </div>
        </ChildContent>

        <FooterContent>
            <div class="modal-footer-flex">
                <button type="button" class="btn-modal-close" @onclick="Close">Tutup</button>

                @if (BookingPolicy.CanModifyBooking(EventItem.Status) || BookingPolicy.CanCancelBooking(EventItem.Status))
                {
                    <div class="modal-action-btns">
                        @if (BookingPolicy.CanModifyBooking(EventItem.Status))
                        {
                            <button type="button" class="btn-modal-modify" @onclick="HandleModify">
                                Ubah Jadwal
                            </button>
                        }
                        @if (BookingPolicy.CanCancelBooking(EventItem.Status))
                        {
                            <button type="button" class="btn-modal-cancel" @onclick="HandleCancel">
                                Batalkan Pemesanan
                            </button>
                        }
                    </div>
                }
            </div>
        </FooterContent>
    </AppModal>

    <!-- CASE 1: Participant Identity Detail Popup -->
    <ParticipantDetailModal @bind-Visible="_isParticipantModalOpen" ParticipantName="@_selectedParticipantName" />
}

<style>
    .calendar-detail-body {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 4px 0;
    }

    .detail-header-status-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .status-badge-pill {
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .status-mybooking { background: #0F1F3D; color: #FFFFFF; }
    .status-reserved { background: #E2E8F0; color: #334155; }
    .status-pending { background: #FEF3C7; color: #92400E; border: 1px dashed #F59E0B; }
    .status-maintenance { background: #FEE2E2; color: #DC2626; }

    .recurrence-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        background: #F1F5F9;
        color: #475569;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
    }
    body.dark-mode .recurrence-badge { background: #334155; color: #CBD5E1; }

    .star-indicator {
        font-size: 11px;
        font-weight: 700;
        color: #D97706;
        background: #FEF3C7;
        padding: 4px 10px;
        border-radius: 999px;
    }

    .detail-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    @@media (max-width: 640px) {
        .detail-info-grid { grid-template-columns: 1fr; }
    }

    .info-card {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 12px 14px;
    }
    body.dark-mode .info-card { background: #1E293B; border-color: #334155; }

    .info-section-title {
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: #64748B;
        margin: 0 0 10px 0;
        text-transform: uppercase;
    }

    .info-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 8px;
    }
    .info-row:last-child { margin-bottom: 0; }

    .info-icon {
        color: #1F5D9A;
        margin-top: 2px;
        flex-shrink: 0;
    }

    .info-label { font-size: 11px; color: #64748B; }
    .info-val { font-size: 13px; font-weight: 600; color: #0F172A; }
    body.dark-mode .info-val { color: #F8FAFC; }

    .room-spec-card {
        background: #FFFFFF;
        border: 1.5px solid #E2E8F0;
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    body.dark-mode .room-spec-card { background: #1E293B; border-color: #334155; }

    .room-spec-banner-hero {
        position: relative;
        width: 100%;
        height: 180px;
        overflow: hidden;
        background: #0F172A;
    }

    .room-spec-banner-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        transition: transform 0.3s ease;
    }
    .room-spec-card:hover .room-spec-banner-img {
        transform: scale(1.02);
    }

    .room-spec-capacity-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.75);
        color: #FFFFFF;
        font-size: 11px;
        font-weight: 700;
        backdrop-filter: blur(8px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    .room-spec-info-body {
        padding: 14px 16px 16px;
    }

    .room-spec-name { font-size: 16px; font-weight: 800; margin: 0; color: #0F172A; }
    body.dark-mode .room-spec-name { color: #F8FAFC; }
    .room-spec-sub { font-size: 12px; color: #64748B; font-weight: 600; margin-top: 3px; }
    .room-spec-desc { font-size: 12px; color: #64748B; margin: 6px 0 0 0; line-height: 1.45; }
    body.dark-mode .room-spec-desc { color: #94A3B8; }

    .room-spec-amenities-row {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px dashed #E2E8F0;
    }
    body.dark-mode .room-spec-amenities-row { border-color: #334155; }

    .spec-amenity-chip {
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        background: #F1F5F9;
        color: #334155;
        border-radius: 6px;
    }
    body.dark-mode .spec-amenity-chip { background: #334155; color: #CBD5E1; }

    .detail-section {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .attendees-list {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .attendee-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        color: #334155;
        transition: all 0.15s ease;
    }
    body.dark-mode .attendee-chip { background: #1E293B; border-color: #334155; color: #E2E8F0; }

    .attendee-chip.clickable {
        cursor: pointer;
    }
    .attendee-chip.clickable:hover {
        background: #FEF3C7;
        border-color: #F59E0B;
        color: #92400E;
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(245, 158, 11, 0.2);
    }
    body.dark-mode .attendee-chip.clickable:hover {
        background: rgba(245, 158, 11, 0.15);
        border-color: #F59E0B;
        color: #FDE68A;
    }
    .chip-info-icon {
        color: #94A3B8;
        transition: color 0.15s;
    }
    .attendee-chip:hover .chip-info-icon {
        color: #D97706;
    }

    .attendee-avatar {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #1F5D9A;
        color: #FFFFFF;
        font-size: 9px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .facility-notice-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        background: #FEF3C7;
        border: 1px solid #FDE68A;
        border-radius: 12px;
    }
    body.dark-mode .facility-notice-box { background: rgba(217, 119, 6, 0.15); border-color: rgba(217, 119, 6, 0.3); }

    .facility-notice-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .facility-notice-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #F59E0B;
        color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .facility-notice-title { font-size: 12px; font-weight: 700; color: #92400E; }
    body.dark-mode .facility-notice-title { color: #FBBF24; }
    .facility-notice-text { font-size: 12px; color: #78350F; margin-top: 1px; }
    body.dark-mode .facility-notice-text { color: #FDE68A; }

    .btn-goto-facilities {
        background: #FFFFFF;
        border: 1px solid #F59E0B;
        color: #B45309;
        font-size: 11.5px;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 999px;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
    }
    .btn-goto-facilities:hover {
        background: #F59E0B;
        color: #FFFFFF;
    }

    /* Modal Footer */
    .modal-footer-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        gap: 12px;
    }

    .btn-modal-close {
        padding: 8px 18px;
        border-radius: 999px;
        border: 1.5px solid #CBD5E1;
        background: transparent;
        color: #475569;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.15s;
    }
    .btn-modal-close:hover { background: #F1F5F9; color: #0F172A; }

    .modal-action-btns {
        display: flex;
        gap: 8px;
    }

    .btn-modal-modify {
        padding: 8px 18px;
        border-radius: 999px;
        border: 1.5px solid #F59E0B;
        background: transparent;
        color: #B45309;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.15s;
    }
    .btn-modal-modify:hover {
        background: #FEF3C7;
    }

    .btn-modal-cancel {
        padding: 8px 18px;
        border-radius: 999px;
        border: 1.5px solid #EF4444;
        background: #FEE2E2;
        color: #DC2626;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.15s;
    }
    .btn-modal-cancel:hover {
        background: #EF4444;
        color: #FFFFFF;
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public CalendarEventItem? EventItem { get; set; }
    [Parameter] public EventCallback<CalendarEventItem> OnCancelBooking { get; set; }
    [Parameter] public EventCallback<CalendarEventItem> OnModifyBooking { get; set; }

    private bool _isParticipantModalOpen = false;
    private string? _selectedParticipantName;

    private void OpenParticipantDetail(string name)
    {
        _selectedParticipantName = name;
        _isParticipantModalOpen = true;
    }

    private async Task HandleVisibleChanged(bool val)
    {
        Visible = val;
        await VisibleChanged.InvokeAsync(val);
    }

    private async Task Close()
    {
        await HandleVisibleChanged(false);
    }

    private async Task NavigateToFacilities()
    {
        await Close();
        var roomName = Uri.EscapeDataString(EventItem?.RoomName ?? "");
        Navigation.NavigateTo($"/pemesanan?tab=fasilitas&highlightRoom={roomName}");
    }

    private async Task HandleCancel()
    {
        if (EventItem != null && OnCancelBooking.HasDelegate)
        {
            await OnCancelBooking.InvokeAsync(EventItem);
        }
        await Close();
    }

    private async Task HandleModify()
    {
        if (EventItem != null && OnModifyBooking.HasDelegate)
        {
            await OnModifyBooking.InvokeAsync(EventItem);
        }
        await Close();
    }

    private string GetStatusLabel(string status) => status switch
    {
        "MyBooking" => "Booking Saya",
        "Reserved" => "Dipesan",
        "Pending" => "Menunggu Persetujuan",
        "Maintenance" => "Perawatan",
        _ => status
    };

    private string GetRecurrenceLabel(CalendarEventItem ev)
    {
        if (!ev.IsRecurring) return "Sekali Saja";
        if (ev.RecurrenceType == "Daily") return "Berulang Setiap Hari Kerja";
        var dayName = ev.RecurrenceDay switch
        {
            DayOfWeek.Monday => "Senin",
            DayOfWeek.Tuesday => "Selasa",
            DayOfWeek.Wednesday => "Rabu",
            DayOfWeek.Thursday => "Kamis",
            DayOfWeek.Friday => "Jumat",
            DayOfWeek.Saturday => "Sabtu",
            DayOfWeek.Sunday => "Minggu",
            _ => "Minggu"
        };
        var endText = ev.RecurrenceEndDate.HasValue ? $" (sampai {ev.RecurrenceEndDate.Value:dd MMM yyyy})" : "";
        return $"Berulang Setiap {dayName}{endText}";
    }
}
