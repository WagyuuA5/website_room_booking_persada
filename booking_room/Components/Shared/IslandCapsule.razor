@namespace booking_room.Components.Shared
@inject IJSRuntime JS
@implements IDisposable

<div class="island-container @(IsToast ? "island-toast-mode" : "") @Class" style="@Style">
    <div class="island-capsule @(IsExpanded ? "island-expanded" : "island-compact") @GetAccentClass()"
         @onclick="ToggleExpand"
         role="@(Clickable ? "button" : null)"
         tabindex="@(Clickable ? 0 : -1)">
        
        <!-- Ambient subtle glow -->
        <div class="island-ambient-glow" style="@GetGlowStyle()"></div>

        <!-- Inner Content Area with physical spring morph -->
        <div class="island-content-wrapper">
            @if (IsExpanded)
            {
                <div class="island-expanded-view animate-fade-scale-in">
                    @if (ExpandedContent != null)
                    {
                        @ExpandedContent
                    }
                    else
                    {
                        <div class="island-default-expanded">
                            <div class="island-expanded-top">
                                <div class="island-indicator-dot" style="@GetDotStyle()"></div>
                                <span class="island-expanded-title">@Title</span>
                                @if (ShowCloseButton)
                                {
                                    <button class="island-close-btn" @onclick="HandleClose" @onclick:stopPropagation="true" type="button" aria-label="Tutup">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                        </svg>
                                    </button>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(Subtitle))
                            {
                                <div class="island-expanded-subtitle">@Subtitle</div>
                            }
                            @if (ChildContent != null)
                            {
                                <div class="island-expanded-body">
                                    @ChildContent
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="island-compact-view animate-fade-scale-in">
                    @if (CompactContent != null)
                    {
                        @CompactContent
                    }
                    else
                    {
                        <div class="island-default-compact">
                            <div class="island-indicator-dot pulse" style="@GetDotStyle()"></div>
                            <span class="island-compact-text">@(string.IsNullOrEmpty(CompactText) ? Title : CompactText)</span>
                            @if (!string.IsNullOrEmpty(BadgeText))
                            {
                                <span class="island-compact-badge">@BadgeText</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .island-container {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        perspective: 1000px;
    }

    .island-container.island-toast-mode {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2000;
        pointer-events: auto;
    }

    .island-capsule {
        position: relative;
        background-color: var(--island-bg, #0B0B0C);
        color: #FFFFFF;
        border: 1px solid var(--island-border, rgba(255, 255, 255, 0.12));
        box-shadow: var(--island-shadow);
        overflow: hidden;
        user-select: none;
        transition: all var(--island-duration-expand, 380ms) var(--island-spring, cubic-bezier(0.34, 1.56, 0.64, 1));
        will-change: width, height, border-radius, transform;
    }

    .island-capsule.island-compact {
        border-radius: var(--island-radius-compact, 999px);
        padding: 6px 16px;
        min-height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .island-capsule.island-compact:hover {
        transform: scale(1.03);
        border-color: rgba(255, 255, 255, 0.25);
    }

    .island-capsule.island-expanded {
        border-radius: var(--island-radius-expanded, 28px);
        padding: 20px 24px;
        min-width: 320px;
        max-width: 580px;
        background-color: var(--island-bg-elevated, #141416);
    }

    .island-ambient-glow {
        position: absolute;
        inset: -10px;
        border-radius: inherit;
        opacity: 0.15;
        filter: blur(12px);
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .island-content-wrapper {
        position: relative;
        z-index: 2;
        width: 100%;
    }

    /* --- Compact Layout --- */
    .island-default-compact {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        white-space: nowrap;
    }

    .island-indicator-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .island-indicator-dot.pulse {
        animation: islandDotPulse 2s infinite ease-in-out;
    }

    .island-compact-badge {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.15);
        color: #F3F4F6;
    }

    /* --- Expanded Layout --- */
    .island-default-expanded {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .island-expanded-top {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .island-expanded-title {
        font-size: 1rem;
        font-weight: 700;
        color: #FFFFFF;
        flex: 1;
    }

    .island-expanded-subtitle {
        font-size: 0.85rem;
        color: #9CA3AF;
        line-height: 1.4;
    }

    .island-expanded-body {
        margin-top: 8px;
    }

    .island-close-btn {
        background: rgba(255, 255, 255, 0.1);
        border: none;
        color: #9CA3AF;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .island-close-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        color: #FFFFFF;
    }

    /* Animations */
    .animate-fade-scale-in {
        animation: islandFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes islandFadeIn {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes islandDotPulse {
        0% { transform: scale(0.95); opacity: 0.8; }
        50% { transform: scale(1.3); opacity: 1; filter: drop-shadow(0 0 4px currentColor); }
        100% { transform: scale(0.95); opacity: 0.8; }
    }
</style>

@code {
    [Parameter] public string State { get; set; } = "compact"; // compact | expanded
    [Parameter] public bool IsExpanded { get; set; } = false;
    [Parameter] public EventCallback<bool> IsExpandedChanged { get; set; }
    [Parameter] public string AccentColor { get; set; } = "#10B981"; // Status color
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string CompactText { get; set; } = string.Empty;
    [Parameter] public string BadgeText { get; set; } = string.Empty;
    [Parameter] public bool Clickable { get; set; } = true;
    [Parameter] public bool ShowCloseButton { get; set; } = false;
    [Parameter] public bool IsToast { get; set; } = false;
    [Parameter] public int AutoDismissMs { get; set; } = 0;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    [Parameter] public RenderFragment? CompactContent { get; set; }
    [Parameter] public RenderFragment? ExpandedContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _dismissTimer;

    protected override void OnParametersSet()
    {
        if (State == "expanded")
        {
            IsExpanded = true;
        }

        if (AutoDismissMs > 0 && _dismissTimer == null)
        {
            _dismissTimer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(HandleClose);
            }, null, AutoDismissMs, System.Threading.Timeout.Infinite);
        }
    }

    private string GetAccentClass() => string.Empty;

    private string GetDotStyle() => $"background-color: {AccentColor}; color: {AccentColor};";

    private string GetGlowStyle() => $"background: radial-gradient(circle, {AccentColor} 0%, transparent 70%);";

    private async Task ToggleExpand()
    {
        if (!Clickable) return;
        IsExpanded = !IsExpanded;
        State = IsExpanded ? "expanded" : "compact";
        await IsExpandedChanged.InvokeAsync(IsExpanded);
    }

    private async Task HandleClose()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    public void Dispose()
    {
        _dismissTimer?.Dispose();
    }
}
