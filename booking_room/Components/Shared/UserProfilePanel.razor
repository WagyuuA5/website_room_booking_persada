@using booking_room.Services
@using booking_room.Components.Models
@inject NavigationManager Navigation

@if (Visible)
{
    <div class="profile-dropdown-overlay" @onclick="ClosePanel">
        <div class="profile-dropdown-panel" @onclick:stopPropagation="true">
            <div class="profile-dropdown-header">
                <div class="profile-dropdown-pill">profil</div>
                <div class="profile-dropdown-subtitle">Data identitas @BookingDataStore.CurrentUser.FullName</div>
            </div>

            <div class="profile-dropdown-avatar-section">
                <div class="profile-dropdown-avatar-wrapper">
                    @if (!string.IsNullOrEmpty(BookingDataStore.CurrentUser.PhotoUrl))
                    {
                        <img src="@BookingDataStore.CurrentUser.PhotoUrl" alt="Avatar" class="profile-dropdown-avatar" />
                    }
                    else
                    {
                        <div class="profile-dropdown-avatar-initials">@BookingDataStore.CurrentUser.Initials</div>
                    }
                    <button class="profile-dropdown-cam-btn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                    </button>
                </div>
                <div class="profile-dropdown-help-text">KETUK FOTO UNTUK GANTI</div>
            </div>

            <div class="profile-dropdown-cards-grid">
                <div class="profile-dropdown-card">
                    <div class="profile-dropdown-card-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    </div>
                    <div class="profile-dropdown-card-content">
                        <div class="profile-dropdown-card-label">NAMA LENGKAP</div>
                        <div class="profile-dropdown-card-value">@BookingDataStore.CurrentUser.FullName</div>
                    </div>
                </div>

                <div class="profile-dropdown-card">
                    <div class="profile-dropdown-card-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    </div>
                    <div class="profile-dropdown-card-content">
                        <div class="profile-dropdown-card-label">EMAIL</div>
                        <div class="profile-dropdown-card-value">@BookingDataStore.CurrentUser.Email</div>
                    </div>
                </div>

                <div class="profile-dropdown-card">
                    <div class="profile-dropdown-card-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    </div>
                    <div class="profile-dropdown-card-content">
                        <div class="profile-dropdown-card-label">NOMOR TELEPON</div>
                        <div class="profile-dropdown-card-value">@BookingDataStore.CurrentUser.Phone</div>
                    </div>
                </div>

                <div class="profile-dropdown-card">
                    <div class="profile-dropdown-card-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    </div>
                    <div class="profile-dropdown-card-content">
                        <div class="profile-dropdown-card-label">JABATAN & DEPARTEMEN</div>
                        <div class="profile-dropdown-card-value">@BookingDataStore.CurrentUser.JobTitle - @BookingDataStore.CurrentUser.Department</div>
                    </div>
                </div>

                <div class="profile-dropdown-card">
                    <div class="profile-dropdown-card-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div class="profile-dropdown-card-content">
                        <div class="profile-dropdown-card-label">LOKASI KANTOR</div>
                        <div class="profile-dropdown-card-value">@BookingDataStore.CurrentUser.OfficeLocation</div>
                    </div>
                </div>

                <div class="profile-dropdown-card">
                    <div class="profile-dropdown-card-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    </div>
                    <div class="profile-dropdown-card-content">
                        <div class="profile-dropdown-card-label">RIWAYAT LOGIN TERAKHIR</div>
                        <div class="profile-dropdown-card-value">@BookingDataStore.CurrentUser.LastLogin</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task ClosePanel() => await OnClose.InvokeAsync();
}
