@using booking_room.Services
@inject NavigationManager Navigation
@inject INotificationService NotificationService

@if (Visible)
{
    <div class="profile-panel-overlay" @onclick="ClosePanel">
        <div class="profile-panel" @onclick:stopPropagation="true">
            <!-- User Identity Section -->
            <div class="profile-panel-user">
                <div class="profile-panel-avatar-wrap">
                    <img src="https://ui-avatars.com/api/?name=Admin+User&background=0f1f3d&color=fff&size=80" 
                         alt="Avatar Pengguna" class="profile-panel-avatar" />
                    <span class="profile-panel-status-dot"></span>
                </div>
                <div class="profile-panel-user-info">
                    <div class="profile-panel-name">Admin User</div>
                    <div class="profile-panel-role">
                        <span class="profile-panel-role-badge">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none">
                                <path d="M12 2L3 7v10l9 5 9-5V7L12 2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                            </svg>
                            Administrator
                        </span>
                    </div>
                    <div class="profile-panel-email">admin@padamanagement.id</div>
                </div>
            </div>

            <!-- Stats Row -->
            <div class="profile-panel-stats">
                <div class="profile-stat-item">
                    <div class="profile-stat-value">@NotificationService.UnreadCount</div>
                    <div class="profile-stat-label">Notifikasi</div>
                </div>
                <div class="profile-stat-divider"></div>
                <div class="profile-stat-item">
                    <div class="profile-stat-value">8</div>
                    <div class="profile-stat-label">Booking Aktif</div>
                </div>
                <div class="profile-stat-divider"></div>
                <div class="profile-stat-item">
                    <div class="profile-stat-value">24</div>
                    <div class="profile-stat-label">Total Bulan</div>
                </div>
            </div>

            <div class="profile-panel-divider"></div>

            <!-- Navigation Menu -->
            <nav class="profile-panel-menu">
                <button class="profile-menu-item" @onclick="GoToProfile">
                    <div class="profile-menu-icon icon-blue">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/>
                            <path d="M4 20c0-4 3.58-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="profile-menu-text">
                        <span class="profile-menu-label">Profil Saya</span>
                        <span class="profile-menu-desc">Kelola informasi akun</span>
                    </div>
                    <svg class="profile-menu-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none">
                        <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>

                <button class="profile-menu-item" @onclick="GoToHistory">
                    <div class="profile-menu-icon icon-green">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm.5 5v6l5.25 3.15-.75 1.23L11 13.5V7h1.5z" fill="currentColor"/>
                        </svg>
                    </div>
                    <div class="profile-menu-text">
                        <span class="profile-menu-label">Riwayat Booking</span>
                        <span class="profile-menu-desc">Lihat semua pemesanan</span>
                    </div>
                    <svg class="profile-menu-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none">
                        <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>

                <button class="profile-menu-item" @onclick="GoToSettings">
                    <div class="profile-menu-icon icon-amber">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <path d="M12 15a3 3 0 100-6 3 3 0 000 6z" stroke="currentColor" stroke-width="2"/>
                            <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z" stroke="currentColor" stroke-width="2"/>
                        </svg>
                    </div>
                    <div class="profile-menu-text">
                        <span class="profile-menu-label">Pengaturan</span>
                        <span class="profile-menu-desc">Preferensi & konfigurasi</span>
                    </div>
                    <svg class="profile-menu-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none">
                        <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            </nav>

            <div class="profile-panel-divider"></div>

            <!-- Logout -->
            <div class="profile-panel-footer">
                <button class="profile-logout-btn" @onclick="HandleLogout">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <polyline points="16 17 21 12 16 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <line x1="21" y1="12" x2="9" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Keluar dari Akun
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task ClosePanel() => await OnClose.InvokeAsync();

    private async Task GoToProfile()
    {
        await ClosePanel();
        Navigation.NavigateTo("/profil");
    }

    private async Task GoToHistory()
    {
        await ClosePanel();
        Navigation.NavigateTo("/history");
    }

    private async Task GoToSettings()
    {
        await ClosePanel();
        Navigation.NavigateTo("/pengaturan");
    }

    private async Task HandleLogout()
    {
        await ClosePanel();
        // TODO: Implement actual logout logic
        Navigation.NavigateTo("/");
    }
}
