<div class="auto-release-modal">
    <div class="auto-release-icon-container">
        <div class="auto-release-icon-bg">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
    </div>
    
    <div class="auto-release-content">
        <h2 class="auto-release-title">Booking Auto-Released</h2>
        <h3 class="auto-release-subtitle">@RoomName</h3>
        
        <p class="auto-release-message">
            This booking has been automatically released because the check-in window has expired. The room is now available for others to book.
        </p>
    </div>

    <div class="auto-release-footer">
        <button class="btn-book-another" @onclick="HandleBookAnother">Book Another Room</button>
        <button class="btn-close-alert" @onclick="OnClose">Close</button>
    </div>
</div>

@code {
    [Parameter] public string RoomName { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnBookAnother { get; set; }

    private async Task HandleBookAnother()
    {
        await OnClose.InvokeAsync();
        await OnBookAnother.InvokeAsync();
    }
}
