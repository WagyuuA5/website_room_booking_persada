@using booking_room.Components.Models
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="pending-approval-body">
    @if (_isLoading)
    {
        <div class="skeleton-popup-list">
            @for (int i = 0; i < 3; i++)
            {
                <div class="skeleton-popup-item">
                    <div class="skeleton-shimmer skeleton-icon"></div>
                    <div class="skeleton-popup-content">
                        <div class="skeleton-shimmer skeleton-title"></div>
                        <div class="skeleton-shimmer skeleton-text short"></div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
    <div class="pending-list">
        @foreach (var item in PendingItems)
        {
            <div class="pending-item" style="cursor: default;">
                <div class="pending-icon-wrap @item.ColorClass">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="@item.IconPath" fill="currentColor"/>
                    </svg>
                </div>
                <div class="pending-content">
                    <div class="pending-room-name">@item.RoomName</div>
                    <div class="pending-meta">
                        <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z" fill="currentColor"/></svg> @item.DateStr</span>
                        <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="currentColor"/></svg> @item.TimeStr</span>
                    </div>
                    <div class="pending-meta" style="margin-top: 4px;">
                        <span style="color: #64748b;">Oleh @item.RequestedBy</span>
                    </div>
                </div>
                <div class="pending-status-wrap" style="flex-direction: column; gap: 6px;">
                    <span class="pending-badge">
                        <span class="dot"></span> Menunggu
                    </span>
                    <div class="pending-actions" style="display: flex; gap: 6px;">
                        <button class="btn-approve" @onclick="() => ApproveItem(item)">Setujui</button>
                        <button class="btn-reject" @onclick="() => ShowRejectModal(item)">Tolak</button>
                    </div>
                </div>
            </div>
        }
    </div>
    }
</div>

<!-- Reject Modal -->
@if (_rejectingItem != null)
{
    <AppModal Visible="true" VisibleChanged="VisibleChanged" OnClose="CloseRejectModal" ShowCloseButton="false">
        <HeaderContent>
            <div style="display: flex; align-items: center; gap: 10px;">
                <div class="modal-header-icon icon-amber">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" fill="#D97706"/>
                    </svg>
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: var(--text-navy);">Tolak Persetujuan</h3>
                    <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: #64748b;">Berikan alasan penolakan untuk @_rejectingItem.RoomName</p>
                </div>
            </div>
        </HeaderContent>
        <BodyContent>
            <textarea class="reject-reason-input" @bind="_rejectReason" placeholder="Alasan penolakan..." rows="3"></textarea>
        </BodyContent>
        <FooterContent>
            <div style="display: flex; gap: 8px; justify-content: flex-end;">
                <button class="popup-footer-btn btn-close-gray" @onclick="CloseRejectModal">Batal</button>
                <button class="popup-footer-btn btn-reject-confirm" @onclick="ConfirmReject" disabled="@string.IsNullOrWhiteSpace(_rejectReason)">Tolak</button>
            </div>
        </FooterContent>
    </AppModal>
}

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _isLoading = true;
    private PendingApprovalItemCustom? _rejectingItem = null;
    private string _rejectReason = "";

    protected override void OnInitialized()
    {
        _isLoading = false;
    }

    private record PendingApprovalItemCustom(string RoomName, string RequestedBy, string DateStr, string TimeStr, string ColorClass, string IconPath);

    private List<PendingApprovalItemCustom> PendingItems = new()
    {
        new("Executive Boardroom A", "J. Smith", "14 Agustus 2026", "10:00 - 12:00", "icon-blue", "M19 2H5C3.9 2 3 2.9 3 4V20C3 21.1 3.9 22 5 22H19C20.1 22 21 21.1 21 20V4C21 2.9 20.1 2 19 2ZM15 20H9V12H15V20Z"),
        new("Studio 4 (Webinar)", "A. Chen", "15 Agustus 2026", "14:30 - 16:00", "icon-purple", "M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"),
        new("Training Ruangan C", "M. Davis", "16 Agustus 2026", "09:00 - 17:00", "icon-light-blue", "M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z")
    };

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task ApproveItem(PendingApprovalItemCustom item)
    {
        PendingItems.Remove(item);
        DashboardData.PendingApprovals = PendingItems.Count;
        StateHasChanged();
    }

    private void ShowRejectModal(PendingApprovalItemCustom item)
    {
        _rejectingItem = item;
        _rejectReason = "";
    }

    private void CloseRejectModal()
    {
        _rejectingItem = null;
        _rejectReason = "";
    }

    private async Task ConfirmReject()
    {
        if (_rejectingItem != null && !string.IsNullOrWhiteSpace(_rejectReason))
        {
            PendingItems.Remove(_rejectingItem);
            DashboardData.PendingApprovals = PendingItems.Count;
            _rejectingItem = null;
            _rejectReason = "";
            StateHasChanged();
        }
    }

    private async Task ViewDetail(PendingApprovalItemCustom item)
    {
        // Implementation for view detail
    }

    private async Task ViewAll()
    {
        await OnClose.InvokeAsync();
        Navigation.NavigateTo("/status");
    }

    private Task VisibleChanged(bool visible)
    {
        if (!visible)
        {
            CloseRejectModal();
        }
        return Task.CompletedTask;
    }
}

<style>
    .pending-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .pending-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
        background: var(--surface-card, #FFFFFF);
        border: 1px solid var(--divider-subtle, rgba(15, 23, 42, 0.08));
        border-radius: 12px;
        transition: all 0.2s;
    }

    .pending-item:hover {
        border-color: #CBD5E1;
    }

    .pending-icon-wrap {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .icon-blue { background: #DBEAFE; color: #2563EB; }
    .icon-purple { background: #EDE9FE; color: #7C3AED; }
    .icon-light-blue { background: #E0F2FE; color: #0284C7; }

    .pending-content {
        flex: 1;
        min-width: 0;
    }

    .pending-room-name {
        font-weight: 700;
        font-size: 0.95rem;
        color: #1D1D1F;
        margin-bottom: 4px;
    }

    .pending-meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: 0.8rem;
        color: #64748b;
    }

    .pending-meta span {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .pending-status-wrap {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        flex-shrink: 0;
    }

    .pending-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        color: #D97706;
        background: #FEF3C7;
        padding: 4px 10px;
        border-radius: 999px;
    }

    .pending-badge .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #F59E0B;
    }

    .pending-req-by {
        font-size: 0.7rem;
        color: #94a3b8;
    }

    .pending-actions {
        display: flex;
        gap: 6px;
    }

    .btn-approve {
        padding: 6px 14px;
        border-radius: 999px;
        border: none;
        background: linear-gradient(135deg, #10B981, #059669);
        color: white;
        font-weight: 700;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 2px 6px rgba(16, 185, 129, 0.25);
    }

    .btn-approve:hover {
        box-shadow: 0 4px 10px rgba(16, 185, 129, 0.4);
        transform: translateY(-1px);
    }

    .btn-reject {
        padding: 6px 14px;
        border-radius: 999px;
        border: 1px solid #FECACA;
        background: white;
        color: #DC2626;
        font-weight: 700;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-reject:hover {
        background: #FEF2F2;
    }

    .reject-reason-input {
        width: 100%;
        padding: 12px;
        border: 1.5px solid #E5E7EB;
        border-radius: 12px;
        font-size: 0.9rem;
        font-family: 'Inter', sans-serif;
        resize: vertical;
        box-sizing: border-box;
    }

    .reject-reason-input:focus {
        outline: none;
        border-color: #1F5D9A;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
    }

    .btn-reject-confirm {
        padding: 10px 20px;
        border-radius: 999px;
        border: none;
        background: linear-gradient(135deg, #EF4444, #DC2626);
        color: white;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 2px 8px rgba(239, 68, 68, 0.25);
    }

    .btn-reject-confirm:hover:not(:disabled) {
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
        transform: translateY(-1px);
    }

    .btn-reject-confirm:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>
