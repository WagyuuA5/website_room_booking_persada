@using booking_room.Components.Models

<div class="map-container">
    <!-- Floor Selector -->
    <div class="map-floor-tabs">
        @foreach (var floor in _floors)
        {
            <button class="map-floor-btn @(_selectedFloor == floor ? "active" : "")"
                    @onclick="() => _selectedFloor = floor">
                @floor
            </button>
        }
    </div>

    <!-- SVG Floor Plan -->
    <div class="map-canvas">
        <svg viewBox="0 0 800 500" class="floor-plan-svg" xmlns="http://www.w3.org/2000/svg">
            <!-- Building outline -->
            <rect x="40" y="40" width="720" height="420" rx="12" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="1.5"/>

            <!-- Corridor -->
            <rect x="40" y="220" width="720" height="60" fill="#F1F5F9" stroke="#E2E8F0" stroke-width="1"/>
            <text x="400" y="254" text-anchor="middle" fill="#94A3B8" font-size="11" font-weight="600" letter-spacing="0.15em">KORIDOR UTAMA</text>

            <!-- Room cells -->
            @{ int idx = 0; }
            @foreach (var room in _floorRooms)
            {
                var (x, y, w, h) = GetRoomPosition(idx, _floorRooms.Count);
                var fillColor = room.Status switch
                {
                    "available" => "#DCFCE7",
                    "booked" => "#FEE2E2",
                    _ => "#F1F5F9"
                };
                var strokeColor = room.Status switch
                {
                    "available" => "#86EFAC",
                    "booked" => "#FECACA",
                    _ => "#CBD5E1"
                };
                var textColor = room.Status switch
                {
                    "available" => "#166534",
                    "booked" => "#991B1B",
                    _ => "#64748B"
                };
                var statusText = room.Status switch
                {
                    "available" => "Tersedia",
                    "booked" => "Dipesan",
                    _ => "Tidak Tersedia"
                };

                <g class="map-room-group" @onclick="() => OnRoomClick.InvokeAsync(room)" style="cursor: pointer;">
                    <rect x="@x.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                          y="@y.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                          width="@w.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                          height="@h.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                          rx="8" fill="@fillColor" stroke="@strokeColor" stroke-width="1.5"/>
                    <!-- Room name -->
                    <text x="@((x + w / 2).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                          y="@((y + h / 2 - 8).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                          text-anchor="middle" fill="@textColor" font-size="12" font-weight="700">
                        @TruncateName(room.Name, 18)
                    </text>
                    <!-- Capacity -->
                    <text x="@((x + w / 2).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                          y="@((y + h / 2 + 8).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                          text-anchor="middle" fill="@textColor" font-size="9" font-weight="500" opacity="0.7">
                        @room.Capacity orang
                    </text>
                    <!-- Status pill -->
                    <rect x="@((x + w / 2 - 30).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                          y="@((y + h / 2 + 16).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                          width="60" height="16" rx="8" fill="@strokeColor" opacity="0.5"/>
                    <text x="@((x + w / 2).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                          y="@((y + h / 2 + 27).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                          text-anchor="middle" fill="@textColor" font-size="8" font-weight="700">
                        @statusText
                    </text>
                </g>
                idx++;
            }

            <!-- Amenities markers -->
            <g opacity="0.5">
                <rect x="680" y="60" width="60" height="40" rx="6" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="1"/>
                <text x="710" y="84" text-anchor="middle" fill="#3B82F6" font-size="8" font-weight="600">WC</text>
            </g>
            <g opacity="0.5">
                <rect x="680" y="400" width="60" height="40" rx="6" fill="#FEF3C7" stroke="#FDE68A" stroke-width="1"/>
                <text x="710" y="424" text-anchor="middle" fill="#B45309" font-size="8" font-weight="600">LIFT</text>
            </g>
        </svg>
    </div>

    <!-- Legend -->
    <div class="map-legend">
        <div class="map-legend-item"><span class="map-legend-dot" style="background: #DCFCE7; border: 1px solid #86EFAC;"></span> Tersedia</div>
        <div class="map-legend-item"><span class="map-legend-dot" style="background: #FEE2E2; border: 1px solid #FECACA;"></span> Dipesan</div>
        <div class="map-legend-item"><span class="map-legend-dot" style="background: #F1F5F9; border: 1px solid #CBD5E1;"></span> Tidak Tersedia</div>
    </div>
</div>

<style>
    .map-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .map-floor-tabs {
        display: flex;
        justify-content: center;
        gap: 8px;
    }
    .map-floor-btn {
        background: white;
        border: 1px solid #E2E8F0;
        padding: 8px 20px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748B;
        cursor: pointer;
        transition: all 0.2s;
    }
    .map-floor-btn.active {
        background: var(--persada-navy-900, #16305C);
        color: white;
        border-color: var(--persada-navy-900, #16305C);
    }
    .map-floor-btn:hover:not(.active) {
        background: #F1F5F9;
    }
    .map-canvas {
        background: white;
        border: 1px solid #E2E8F0;
        border-radius: 16px;
        padding: 16px;
        overflow: hidden;
    }
    .floor-plan-svg {
        width: 100%;
        height: auto;
        max-height: 460px;
    }
    .map-room-group rect {
        transition: all 0.2s;
    }
    .map-room-group:hover rect:first-child {
        filter: brightness(0.95);
        stroke-width: 2.5;
    }
    .map-legend {
        display: flex;
        justify-content: center;
        gap: 24px;
        padding: 8px 0;
    }
    .map-legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748B;
    }
    .map-legend-dot {
        width: 14px;
        height: 14px;
        border-radius: 4px;
    }
</style>

@code {
    [Parameter] public List<RoomItem> Rooms { get; set; } = new();
    [Parameter] public EventCallback<RoomItem> OnRoomClick { get; set; }

    private string _selectedFloor = "Lantai 1";
    private string[] _floors = { "Lantai 1", "Lantai 2", "Lantai 3", "Lantai 4" };

    private List<RoomItem> _floorRooms => Rooms.Where(r => r.Floor == _selectedFloor).ToList();

    private (int x, int y, int w, int h) GetRoomPosition(int index, int total)
    {
        // Layout rooms in two rows: top row and bottom row, separated by corridor
        int roomW = 160;
        int roomH = 140;
        int gap = 20;
        int startX = 60;

        bool topRow = index % 2 == 0;
        int col = index / 2;

        int x = startX + col * (roomW + gap);
        int y = topRow ? 60 : 300;

        // Wrap if too far right
        if (x + roomW > 740)
        {
            col = 0;
            x = startX;
            y = topRow ? 60 : 300;
        }

        return (x, y, roomW, roomH);
    }

    private string TruncateName(string name, int maxLen)
    {
        return name.Length <= maxLen ? name : name[..(maxLen - 2)] + "…";
    }
}
