@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private bool IsEnabled { get; set; } = false;

    private async Task Toggle2FA()
    {
        IsEnabled = !IsEnabled;
        // Implement logic
    }
}

<div>
    <h3 class="modal-title">Autentikasi Dua Faktor (2FA)</h3>
    <p class="modal-subtitle">Tingkatkan keamanan akun Anda dengan menambahkan lapisan keamanan ekstra.</p>

    <div class="settings-card">
        <div class="settings-info">
            <div class="settings-title">Status 2FA</div>
            <div class="settings-desc">Saat ini @(IsEnabled ? "aktif" : "tidak aktif")</div>
        </div>
        <button class="btn @(IsEnabled ? "btn-danger" : "btn-primary")" @onclick="Toggle2FA">
            @(IsEnabled ? "Nonaktifkan" : "Aktifkan")
        </button>
    </div>
    
    <div class="modal-actions">
        <button class="btn btn-secondary" @onclick="OnClose">Tutup</button>
    </div>
</div>

<style>
    .modal-title { font-size: 1.25rem; font-weight: 600; color: #16305C; margin-bottom: 0.5rem; }
    .modal-subtitle { font-size: 0.875rem; color: #6B7280; margin-bottom: 1.5rem; }
    .settings-card { display: flex; justify-content: space-between; align-items: center; padding: 1rem; border: 1px solid #E5E7EB; border-radius: 14px; margin-bottom: 1rem; }
    .settings-title { font-weight: 500; color: #16305C; }
    .settings-desc { font-size: 0.875rem; color: #6B7280; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 2rem; }
    .btn { padding: 0.5rem 1rem; border-radius: 999px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: none; transition: background-color 0.2s; }
    .btn-secondary { background-color: #F3F4F6; color: #374151; }
    .btn-secondary:hover { background-color: #E5E7EB; }
    .btn-primary { background-color: #16305C; color: white; }
    .btn-primary:hover { background-color: #0F2346; }
    .btn-danger { background-color: #FEE2E2; color: #DC2626; }
    .btn-danger:hover { background-color: #FECACA; }
</style>
