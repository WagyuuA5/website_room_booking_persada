@namespace booking_room.Components.Shared
@using booking_room.Components.Models
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@implements IDisposable

<AppModal Visible="@Visible" Size="md" Title="Profil Akun" ShowCloseButton="true" OnClose="CloseModal">
    <BodyContent>
        <div class="user-profile-modal-content">
            <!-- Header Profil -->
            <div class="profile-header-card">
                <div class="profile-avatar-wrap">
                    @if (!string.IsNullOrEmpty(UserProfile.PhotoUrl))
                    {
                        <img src="@UserProfile.PhotoUrl" class="profile-avatar-img" alt="@UserProfile.Name" />
                    }
                    else
                    {
                        <div class="profile-avatar-initials">@UserProfile.Initials</div>
                    }
                    <label class="avatar-upload-btn" title="Unggah Foto Baru">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                            <circle cx="12" cy="13" r="4"></circle>
                        </svg>
                        <InputFile OnChange="HandleFileSelected" accept="image/png,image/jpeg,image/webp" style="display: none;" />
                    </label>
                </div>

                <div class="profile-info-wrap">
                    <h3 class="profile-name">@UserProfile.FullName</h3>
                    <p class="profile-role">@UserProfile.JobTitle • @UserProfile.Department</p>
                    <span class="profile-status-badge">🟢 Akun Aktif</span>
                </div>
            </div>

            @if (_uploadError)
            {
                <div class="upload-error-banner">
                    <span>@_uploadErrorMessage</span>
                </div>
            }

            <!-- Data Diri Form -->
            <div class="profile-details-grid">
                <div class="profile-detail-item">
                    <label>EMAIL PERUSAHAAN</label>
                    <div class="detail-value-row">
                        <span>@UserProfile.Email</span>
                    </div>
                </div>
                <div class="profile-detail-item">
                    <label>NOMOR TELEPON</label>
                    <div class="detail-value-row">
                        <span>@UserProfile.Phone</span>
                    </div>
                </div>
                <div class="profile-detail-item">
                    <label>LOKASI KERJA</label>
                    <div class="detail-value-row">
                        <span>@UserProfile.OfficeLocation</span>
                    </div>
                </div>
                <div class="profile-detail-item">
                    <label>TERAKHIR LOGIN</label>
                    <div class="detail-value-row">
                        <span>@UserProfile.LastLogin</span>
                    </div>
                </div>
            </div>
        </div>
    </BodyContent>
</AppModal>

<style>
    .user-profile-modal-content {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .profile-header-card {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px;
        background: #F8FAFC;
        border: 1.5px solid #E2E8F0;
        border-radius: 16px;
    }
    body.dark-mode .profile-header-card {
        background: rgba(15, 23, 42, 0.5);
        border-color: rgba(255, 255, 255, 0.08);
    }

    .profile-avatar-wrap {
        position: relative;
        width: 64px;
        height: 64px;
    }
    .profile-avatar-img {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        object-fit: cover;
    }
    .profile-avatar-initials {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #1F5D9A;
        color: #FFFFFF;
        font-size: 1.5rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .avatar-upload-btn {
        position: absolute;
        bottom: -2px;
        right: -2px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #F59E0B;
        color: #0F1F3D;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 2px solid #FFFFFF;
    }

    .profile-name {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--persada-navy-900, #0F1F3D);
        margin: 0 0 2px 0;
    }
    body.dark-mode .profile-name { color: #F8FAFC; }
    .profile-role {
        font-size: 0.8125rem;
        color: var(--persada-text-secondary, #6B7280);
        margin: 0 0 6px 0;
    }
    .profile-status-badge {
        font-size: 0.6875rem;
        font-weight: 700;
        color: #16A34A;
        background: #DCFCE7;
        padding: 2px 8px;
        border-radius: 999px;
    }

    .upload-error-banner {
        background: #FEE2E2;
        color: #DC2626;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .profile-details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }
    .profile-detail-item {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 10px 12px;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    body.dark-mode .profile-detail-item {
        background: rgba(15, 23, 42, 0.4);
        border-color: rgba(255, 255, 255, 0.08);
    }
    .profile-detail-item label {
        font-size: 0.625rem;
        font-weight: 700;
        color: #94A3B8;
        letter-spacing: 0.05em;
    }
    .profile-detail-item span {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--persada-navy-900, #0F1F3D);
    }
    body.dark-mode .profile-detail-item span { color: #F8FAFC; }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private UserProfileData UserProfile = BookingDataStore.CurrentUser;
    private bool _uploadError = false;
    private string _uploadErrorMessage = "";
    private bool _disposed;
    private CancellationTokenSource? _cts;

    private async Task CloseModal()
    {
        if (VisibleChanged.HasDelegate)
        {
            await VisibleChanged.InvokeAsync(false);
        }
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (!file.ContentType.StartsWith("image/"))
        {
            _uploadError = true;
            _uploadErrorMessage = "Format file harus JPG, PNG, atau WEBP";
            TriggerErrorReset();
            return;
        }

        if (file.Size > 5 * 1024 * 1024)
        {
            _uploadError = true;
            _uploadErrorMessage = "Ukuran file maksimal 5MB";
            TriggerErrorReset();
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            var dataUrl = $"data:{file.ContentType};base64,{base64}";

            UserProfile = UserProfile with { PhotoUrl = dataUrl };
            BookingDataStore.CurrentUser.PhotoUrl = dataUrl;
            _uploadError = false;
        }
        catch { }
    }

    private void TriggerErrorReset()
    {
        if (_disposed) return;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(3000, token);
                if (!_disposed && !token.IsCancellationRequested)
                {
                    _uploadError = false;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { }
        });
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
