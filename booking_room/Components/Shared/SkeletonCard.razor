@namespace booking_room.Components.Shared

<div class="skeleton-card-container @Class" style="@Style">
    <div class="skeleton-card-header">
        <SkeletonBlock Width="40px" Height="40px" Shape="circle" />
        <div style="flex: 1; display: flex; flex-direction: column; gap: 6px;">
            <SkeletonBlock Width="60%" Height="14px" Shape="text" />
            <SkeletonBlock Width="40%" Height="10px" Shape="text" />
        </div>
    </div>
    <div class="skeleton-card-body" style="margin-top: 16px; display: flex; flex-direction: column; gap: 8px;">
        <SkeletonBlock Width="100%" Height="12px" Shape="text" />
        <SkeletonBlock Width="85%" Height="12px" Shape="text" />
        <SkeletonBlock Width="70%" Height="12px" Shape="text" />
    </div>
</div>

<style>
    .skeleton-card-container {
        background: var(--surface-card, #FFFFFF);
        border: 1px solid var(--color-border, #E5E7EB);
        border-radius: var(--persada-border-radius-card, 16px);
        padding: 20px;
        box-shadow: var(--shadow-sm);
        box-sizing: border-box;
    }

    body.dark-mode .skeleton-card-container {
        background: #131E32;
        border-color: rgba(255, 255, 255, 0.1);
    }

    .skeleton-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
    }
</style>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
}
