@using booking_room.Components.Models

<div class="rcv-container">
    <div class="rcv-header">
        <div class="rcv-header-left">
            <h2 class="rcv-title">Jadwal Ruangan</h2>
            <div class="rcv-date-picker">
                <input type="date" @bind="SelectedDate" @bind:after="OnDateChanged" class="rcv-date-input" />
            </div>
        </div>
        <div class="rcv-header-right">
            <div class="rcv-view-toggle">
                <button class="rcv-toggle-btn @(CurrentView == "Harian" ? "active" : "")" @onclick='() => SetView("Harian")'>Harian</button>
                <button class="rcv-toggle-btn @(CurrentView == "Mingguan" ? "active" : "")" @onclick='() => SetView("Mingguan")'>Mingguan</button>
            </div>
            <div class="rcv-legend">
                <div class="rcv-legend-item"><span class="rcv-dot self"></span> Pemesanan Anda</div>
                <div class="rcv-legend-item"><span class="rcv-dot other"></span> Pemesanan Lain</div>
            </div>
        </div>
    </div>

    <div class="rcv-grid-wrapper">
        @if (CurrentView == "Harian")
        {
            <div class="rcv-grid daily">
                <div class="rcv-grid-corner">Ruangan</div>
                @foreach (var hour in _hours)
                {
                    <div class="rcv-grid-header">@hour</div>
                }

                @foreach (var room in Rooms)
                {
                    <div class="rcv-grid-row-header">
                        <div class="rcv-room-name">@room.Name</div>
                        <div class="rcv-room-cap">@room.Capacity Orang</div>
                    </div>
                    @foreach (var hour in _hours)
                    {
                        var cellClass = "rcv-cell";
                        var content = "";
                        var title = "";
                        
                        // Fake logic for demo
                        if (room.Status == "booked" && hour == "10:00")
                        {
                            cellClass += " other-booking";
                            content = "Dipesan";
                            title = "Dipesan oleh divisi lain";
                        }
                        
                        <div class="@cellClass" title="@title">
                            @if (!string.IsNullOrEmpty(content))
                            {
                                <div class="rcv-event">@content</div>
                            }
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="rcv-grid weekly">
                <div class="rcv-grid-corner">Ruangan</div>
                @foreach (var day in _days)
                {
                    <div class="rcv-grid-header">@day</div>
                }

                @foreach (var room in Rooms)
                {
                    <div class="rcv-grid-row-header">
                        <div class="rcv-room-name">@room.Name</div>
                        <div class="rcv-room-cap">@room.Capacity Orang</div>
                    </div>
                    @foreach (var day in _days)
                    {
                        var cellClass = "rcv-cell";
                        var content = "";
                        
                        // Fake logic for demo
                        if (room.Status == "booked" && day == "Selasa")
                        {
                            cellClass += " other-booking";
                            content = "09:00 - 11:00";
                        }
                        else if (room.Id == "1" && day == "Kamis")
                        {
                            cellClass += " self-booking";
                            content = "14:00 - 15:00";
                        }
                        
                        <div class="@cellClass">
                            @if (!string.IsNullOrEmpty(content))
                            {
                                <div class="rcv-event">@content</div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

<style>
    .rcv-container {
        background: #fff;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        border: 1px solid #e2e8f0;
        font-family: 'Inter', sans-serif;
    }
    .rcv-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 16px;
    }
    .rcv-header-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .rcv-title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 700;
        color: #0f172a;
    }
    .rcv-date-input {
        padding: 6px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 0.875rem;
        color: #334155;
    }
    .rcv-header-right {
        display: flex;
        align-items: center;
        gap: 24px;
    }
    .rcv-view-toggle {
        display: flex;
        background: #f1f5f9;
        border-radius: 8px;
        padding: 4px;
    }
    .rcv-toggle-btn {
        background: transparent;
        border: none;
        padding: 6px 12px;
        border-radius: 4px;
        font-size: 0.875rem;
        font-weight: 600;
        color: #64748b;
        cursor: pointer;
        transition: all 0.2s;
    }
    .rcv-toggle-btn.active {
        background: #fff;
        color: #0f172a;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    .rcv-legend {
        display: flex;
        gap: 12px;
        font-size: 0.8rem;
        font-weight: 500;
        color: #64748b;
    }
    .rcv-legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .rcv-dot {
        width: 10px;
        height: 10px;
        border-radius: 2px;
    }
    .rcv-dot.self { background: #dbeafe; border: 1px solid #bfdbfe; }
    .rcv-dot.other { background: #fef3c7; border: 1px solid #fde68a; }

    .rcv-grid-wrapper {
        overflow-x: auto;
    }
    
    .rcv-grid {
        display: grid;
        border-top: 1px solid #e2e8f0;
        border-left: 1px solid #e2e8f0;
        min-width: 800px;
    }
    .rcv-grid.daily {
        grid-template-columns: 200px repeat(9, 1fr);
    }
    .rcv-grid.weekly {
        grid-template-columns: 200px repeat(5, 1fr);
    }
    
    .rcv-grid-corner, .rcv-grid-header, .rcv-grid-row-header, .rcv-cell {
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        padding: 12px;
    }
    
    .rcv-grid-corner {
        background: #f8fafc;
        font-weight: 600;
        font-size: 0.875rem;
        color: #475569;
        display: flex;
        align-items: center;
    }
    
    .rcv-grid-header {
        background: #f8fafc;
        font-weight: 600;
        font-size: 0.875rem;
        color: #475569;
        text-align: center;
    }
    
    .rcv-grid-row-header {
        background: #fff;
    }
    .rcv-room-name {
        font-weight: 700;
        font-size: 0.9rem;
        color: #0f172a;
        margin-bottom: 4px;
    }
    .rcv-room-cap {
        font-size: 0.75rem;
        color: #64748b;
    }
    
    .rcv-cell {
        background: #fff;
        position: relative;
    }
    
    .rcv-event {
        border-radius: 4px;
        padding: 4px 8px;
        font-size: 0.75rem;
        font-weight: 600;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }
    
    .rcv-cell.other-booking .rcv-event {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
    }
    
    .rcv-cell.self-booking .rcv-event {
        background: #dbeafe;
        color: #1e40af;
        border: 1px solid #bfdbfe;
    }
</style>

@code {
    [Parameter]
    public List<RoomItem> Rooms { get; set; } = new();

    private string CurrentView { get; set; } = "Mingguan";
    private DateTime SelectedDate { get; set; } = DateTime.Today;

    private readonly string[] _hours = { "08:00", "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00" };
    private readonly string[] _days = { "Senin", "Selasa", "Rabu", "Kamis", "Jumat" };

    private void SetView(string view)
    {
        CurrentView = view;
    }

    private void OnDateChanged()
    {
        // Logic when date changes
    }
}
