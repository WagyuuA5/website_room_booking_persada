@namespace booking_room.Components.Shared
@using System.Globalization
@inject booking_room.Services.IToastService ToastService

<div class="user-trend-card">
    <div class="user-trend-header">
        <div>
            <h3 class="trend-title">Tren Pemesanan Saya</h3>
            <p class="trend-subtitle">Jumlah pemesanan ruangan 6 bulan terakhir</p>
        </div>
        <button type="button" class="btn-export-pill" @onclick="ExportData">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Ekspor</span>
        </button>
    </div>

    <div class="user-trend-chart-box" 
         @onmousemove="HandleMouseMove" 
         @onmouseleave="() => _activePoint = null">
        
        <svg viewBox="0 0 600 240" class="trend-svg" preserveAspectRatio="none">
            <defs>
                <linearGradient id="userOrangeGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#F5A623" stop-opacity="0.35" />
                    <stop offset="80%" stop-color="#F5A623" stop-opacity="0.05" />
                    <stop offset="100%" stop-color="#F5A623" stop-opacity="0.00" />
                </linearGradient>
            </defs>

            <!-- Grid Horizontal Putus-putus -->
            <line x1="20" y1="35" x2="580" y2="35" stroke="var(--color-neutral-200, #E8E8ED)" stroke-width="1.2" stroke-dasharray="4 4" />
            <line x1="20" y1="105" x2="580" y2="105" stroke="var(--color-neutral-200, #E8E8ED)" stroke-width="1.2" stroke-dasharray="4 4" />
            <line x1="20" y1="175" x2="580" y2="175" stroke="var(--color-neutral-200, #E8E8ED)" stroke-width="1.2" stroke-dasharray="4 4" />

            <!-- Area Gradient Fade In -->
            <path d="@_areaPath" fill="url(#userOrangeGradient)" class="trend-area-fill" />

            <!-- Line Stroke with Draw-In Animation -->
            <path d="@_linePath" fill="none" stroke="#F5A623" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" class="trend-line-draw" />

            <!-- Titik Data Staggered -->
            @for (int i = 0; i < _chartPoints.Count; i++)
            {
                var pt = _chartPoints[i];
                var delay = (i * 80) + "ms";
                <circle cx="@pt.X.ToString("F1", CultureInfo.InvariantCulture)"
                        cy="@pt.Y.ToString("F1", CultureInfo.InvariantCulture)"
                        r="@(_activePoint == pt ? "7" : "5")"
                        fill="@(_activePoint == pt ? "#D97706" : "#F5A623")"
                        stroke="#FFFFFF"
                        stroke-width="2.5"
                        style="animation-delay: @delay;"
                        class="trend-point-circle @(_activePoint == pt ? "active-circle" : "")">
                </circle>
            }

            @if (_activePoint != null)
            {
                <line x1="@_activePoint.X.ToString("F1", CultureInfo.InvariantCulture)" 
                      y1="20" 
                      x2="@_activePoint.X.ToString("F1", CultureInfo.InvariantCulture)" 
                      y2="190" 
                      stroke="#F5A623" 
                      stroke-width="1.5" 
                      stroke-dasharray="3 3" />
            }
        </svg>

        <!-- Tooltip Gelap (DS-02) -->
        @if (_activePoint != null)
        {
            <div class="trend-dark-tooltip" style="left: @((_activePoint.X / 600.0 * 100).ToString("F1", CultureInfo.InvariantCulture))%;">
                <div class="tooltip-month">@_activePoint.Label</div>
                <div class="tooltip-body">Pemesanan: <strong>@_activePoint.Value</strong></div>
            </div>
        }

        <!-- Sumbu X: Singkatan Bulan (Mei, Jun, Jul, Ags, Sep, Okt) -->
        <div class="trend-months-row">
            @foreach (var pt in _chartPoints)
            {
                <span class="month-label @(_activePoint == pt ? "active-month" : "")">@pt.Label</span>
            }
        </div>
    </div>
</div>

<style>
    .user-trend-card {
        background: var(--color-white, #FFFFFF);
        border: 1px solid var(--color-neutral-200, #E8E8ED);
        border-radius: var(--radius-md, 14px);
        padding: 24px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.02);
        margin-top: 20px;
    }
    body.dark-mode .user-trend-card {
        background: var(--color-neutral-900, #1D1D1F);
        border-color: rgba(255,255,255,0.1);
    }

    .user-trend-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }
    .trend-title {
        font-size: var(--fs-h3, 20px);
        font-weight: var(--fw-bold, 700);
        color: var(--color-navy, #0F172A);
        margin: 0 0 4px 0;
    }
    body.dark-mode .trend-title { color: var(--color-white, #FFFFFF); }

    .trend-subtitle {
        font-size: var(--fs-sm, 14px);
        color: var(--color-neutral-600, #6E6E73);
        margin: 0;
    }

    .btn-export-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        background: #EFF6FF;
        color: #2563EB;
        border: 1px solid #BFDBFE;
        border-radius: var(--radius-full, 999px);
        font-size: var(--fs-xs, 12px);
        font-weight: var(--fw-semibold, 600);
        cursor: pointer;
        transition: var(--motion-fast);
    }
    .btn-export-pill:hover {
        background: #DBEAFE;
    }
    body.dark-mode .btn-export-pill {
        background: rgba(37, 99, 235, 0.2);
        color: #93C5FD;
        border-color: rgba(147, 197, 253, 0.3);
    }

    .user-trend-chart-box {
        position: relative;
        width: 100%;
        cursor: crosshair;
    }
    .trend-svg {
        width: 100%;
        height: 220px;
        overflow: visible;
    }

    /* DS-02: Animasi Draw-In Stroke */
    .trend-line-draw {
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
        animation: drawLine var(--motion-chart, 900ms) cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @@keyframes drawLine {
        to { stroke-dashoffset: 0; }
    }

    /* Area Gradient Fade In */
    .trend-area-fill {
        opacity: 0;
        animation: fadeArea 500ms ease-out 600ms forwards;
    }
    @@keyframes fadeArea {
        to { opacity: 1; }
    }

    /* Staggered Circles */
    .trend-point-circle {
        opacity: 0;
        transform-origin: center;
        animation: scaleCircle 300ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    @@keyframes scaleCircle {
        from { opacity: 0; transform: scale(0); }
        to { opacity: 1; transform: scale(1); }
    }

    /* Tooltip Gelap */
    .trend-dark-tooltip {
        position: absolute;
        top: 0;
        transform: translateX(-50%);
        background: var(--color-navy, #0F172A);
        color: var(--color-white, #FFFFFF);
        padding: 6px 12px;
        border-radius: var(--radius-sm, 8px);
        font-size: var(--fs-xs, 12px);
        box-shadow: 0 4px 14px rgba(0,0,0,0.25);
        pointer-events: none;
        z-index: 10;
        text-align: center;
        white-space: nowrap;
    }
    .trend-dark-tooltip::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 50%;
        transform: translateX(-50%);
        border-left: 4px solid transparent;
        border-right: 4px solid transparent;
        border-top: 4px solid var(--color-navy, #0F172A);
    }
    .tooltip-month { font-weight: var(--fw-bold, 700); margin-bottom: 2px; }
    .tooltip-body strong { color: var(--color-primary, #F5A623); }

    .trend-months-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 20px 0;
        font-size: var(--fs-xs, 12px);
        font-weight: var(--fw-semibold, 600);
        color: var(--color-neutral-400, #86868B);
    }
    .month-label { text-align: center; min-width: 32px; }
    .active-month { color: var(--color-primary, #F5A623); font-weight: var(--fw-bold, 700); }
</style>

@code {
    private record TrendPoint(double X, double Y, string Label, int Value);
    private List<TrendPoint> _chartPoints = new();
    private string _linePath = "";
    private string _areaPath = "";
    private TrendPoint? _activePoint = null;

    protected override void OnInitialized()
    {
        ComputeTrendData();
    }

    private void ComputeTrendData()
    {
        _chartPoints.Clear();

        // 6 Bulan: Mei, Jun, Jul, Ags, Sep, Okt (DS-02)
        var months = new[] { "Mei", "Jun", "Jul", "Ags", "Sep", "Okt" };
        var values = new[] { 4, 8, 5, 12, 9, 15 };

        double width = 600;
        double height = 240;
        double padLeft = 40;
        double padRight = 40;
        double padTop = 35;
        double padBottom = 45;

        double chartW = width - (padLeft + padRight);
        double chartH = height - (padTop + padBottom);

        double maxVal = values.Max();
        double minVal = 0;
        double valRange = maxVal - minVal;
        if (valRange == 0) valRange = 1;

        for (int i = 0; i < values.Length; i++)
        {
            double x = padLeft + (i / (double)(values.Length - 1)) * chartW;
            double norm = (values[i] - minVal) / valRange;
            double y = (padTop + chartH) - (norm * chartH);

            _chartPoints.Add(new TrendPoint(x, y, months[i], values[i]));
        }

        if (_chartPoints.Count > 0)
        {
            var sb = new System.Text.StringBuilder();
            sb.Append($"M {_chartPoints[0].X.ToString("F1", CultureInfo.InvariantCulture)},{_chartPoints[0].Y.ToString("F1", CultureInfo.InvariantCulture)}");
            
            for (int i = 0; i < _chartPoints.Count - 1; i++)
            {
                var p0 = i > 0 ? _chartPoints[i - 1] : _chartPoints[i];
                var p1 = _chartPoints[i];
                var p2 = _chartPoints[i + 1];
                var p3 = i < _chartPoints.Count - 2 ? _chartPoints[i + 2] : p2;

                var cp1x = p1.X + (p2.X - p0.X) / 6.0;
                var cp1y = p1.Y + (p2.Y - p0.Y) / 6.0;
                var cp2x = p2.X - (p3.X - p1.X) / 6.0;
                var cp2y = p2.Y - (p3.Y - p1.Y) / 6.0;

                sb.Append($" C {cp1x.ToString("F1", CultureInfo.InvariantCulture)},{cp1y.ToString("F1", CultureInfo.InvariantCulture)} " +
                          $"{cp2x.ToString("F1", CultureInfo.InvariantCulture)},{cp2y.ToString("F1", CultureInfo.InvariantCulture)} " +
                          $"{p2.X.ToString("F1", CultureInfo.InvariantCulture)},{p2.Y.ToString("F1", CultureInfo.InvariantCulture)}");
            }
            _linePath = sb.ToString();

            var firstX = _chartPoints[0].X.ToString("F1", CultureInfo.InvariantCulture);
            var lastX = _chartPoints[^1].X.ToString("F1", CultureInfo.InvariantCulture);
            var bottomY = (padTop + chartH).ToString("F1", CultureInfo.InvariantCulture);

            _areaPath = $"{_linePath} L {lastX},{bottomY} L {firstX},{bottomY} Z";
        }
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        if (!_chartPoints.Any()) return;
        TrendPoint? nearest = null;
        double minDistance = double.MaxValue;

        foreach (var pt in _chartPoints)
        {
            double dist = Math.Abs(pt.X - e.OffsetX);
            if (dist < minDistance)
            {
                minDistance = dist;
                nearest = pt;
            }
        }
        _activePoint = nearest;
    }

    private void ExportData()
    {
        ToastService.Success("Ekspor Berhasil", "Data tren pemesanan berhasil diekspor.");
    }
}
