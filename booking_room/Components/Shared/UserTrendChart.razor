@namespace booking_room.Components.Shared
@using booking_room.Components.Models
@using System.Globalization
@inject IJSRuntime JS

<div class="user-trend-card">
    <div class="user-trend-header">
        <div class="user-trend-title-wrap">
            <h3 class="user-trend-title">Tren Pemesanan Saya</h3>
            <p class="user-trend-subtitle">Frekuensi reservasi ruangan yang Anda lakukan per bulan</p>
        </div>
        <div class="user-trend-actions">
            <button class="btn-export-pill" @onclick="HandleExport" type="button" title="Ekspor data tren">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Ekspor
            </button>
        </div>
    </div>

    <div class="user-trend-chart-box" 
         @onmousemove="HandleMouseMove" 
         @onmouseleave="HandleMouseLeave"
         @ontouchmove="HandleTouchMove"
         @ontouchend="HandleTouchEnd">
        <svg viewBox="0 0 600 260" class="user-trend-svg" preserveAspectRatio="none">
            <defs>
                <linearGradient id="userOrangeGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.38" />
                    <stop offset="70%" stop-color="#F59E0B" stop-opacity="0.10" />
                    <stop offset="100%" stop-color="#F59E0B" stop-opacity="0.00" />
                </linearGradient>
            </defs>

            <!-- 3 Horizontal dashed grid lines -->
            <line x1="15" y1="35" x2="585" y2="35" class="chart-grid-line" stroke-width="1.2" stroke-dasharray="5 5" />
            <line x1="15" y1="125" x2="585" y2="125" class="chart-grid-line" stroke-width="1.2" stroke-dasharray="5 5" />
            <line x1="15" y1="215" x2="585" y2="215" class="chart-grid-line" stroke-width="1.2" stroke-dasharray="5 5" />

            <!-- Area fill with fade-in animation -->
            <path d="@_areaPath" fill="url(#userOrangeGradient)" class="user-trend-area" />

            <!-- Line stroke with draw-in animation -->
            <path d="@_linePath" fill="none" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" class="user-trend-line" />

            <!-- Circular data points with staggered scale-in -->
            @for (int i = 0; i < _chartPoints.Count; i++)
            {
                var pt = _chartPoints[i];
                var delay = (0.7 + i * 0.07).ToString("F2", CultureInfo.InvariantCulture);
                <circle cx="@pt.X.ToString("F1", CultureInfo.InvariantCulture)"
                        cy="@pt.Y.ToString("F1", CultureInfo.InvariantCulture)"
                        r="@(_activePoint == pt ? "7.5" : "5")"
                        fill="@(_activePoint == pt ? "#D97706" : "#F59E0B")"
                        stroke="#FFFFFF"
                        stroke-width="2.5"
                        style="animation-delay: @(delay)s;"
                        class="user-trend-point @(_activePoint == pt ? "active-dot" : "")">
                </circle>
            }

            <!-- Active point guide line -->
            @if (_activePoint != null)
            {
                <line x1="@_activePoint.X.ToString("F1", CultureInfo.InvariantCulture)" 
                      y1="20" 
                      x2="@_activePoint.X.ToString("F1", CultureInfo.InvariantCulture)" 
                      y2="230" 
                      stroke="#F59E0B" 
                      stroke-width="1.5" 
                      stroke-dasharray="3 3" />
                
                <circle cx="@_activePoint.X.ToString("F1", CultureInfo.InvariantCulture)"
                        cy="@_activePoint.Y.ToString("F1", CultureInfo.InvariantCulture)"
                        r="8.5"
                        fill="#D97706"
                        stroke="#FFFFFF"
                        stroke-width="3" />
            }
        </svg>

        <!-- Tooltip gelap dengan arrow -->
        @if (_activePoint != null)
        {
            <div class="user-trend-tooltip" style="left: @((_activePoint.X / 600.0 * 100).ToString("F1", CultureInfo.InvariantCulture))%;">
                <div class="tooltip-month">@_activePoint.Label</div>
                <div class="tooltip-count">Pemesanan: <strong>@_activePoint.Value</strong></div>
            </div>
        }

        <!-- X-Axis Labels -->
        <div class="user-trend-labels">
            @foreach (var pt in _chartPoints)
            {
                <span class="user-trend-x-label @(_activePoint == pt ? "active" : "")">@pt.Label</span>
            }
        </div>
    </div>
</div>

<style>
    .user-trend-card {
        background: var(--persada-white, #FFFFFF);
        border: 1px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: var(--persada-border-radius-card, 20px);
        padding: 24px;
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        gap: 16px;
        box-sizing: border-box;
    }

    .user-trend-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 12px;
    }

    .user-trend-title {
        font-size: var(--fs-h2, 20px);
        font-weight: 700;
        color: var(--persada-text-primary, #0F1F3D);
        margin: 0 0 4px 0;
    }

    .user-trend-subtitle {
        font-size: 0.8125rem;
        color: var(--persada-text-secondary, #6B7280);
        margin: 0;
    }

    .btn-export-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: #E8F0FE;
        color: #1F5D9A;
        border: none;
        border-radius: 999px;
        padding: 6px 14px;
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-export-pill:hover {
        background-color: #D2E3FC;
        transform: translateY(-1px);
    }

    body.dark-mode .btn-export-pill {
        background-color: rgba(31, 93, 154, 0.3);
        color: #93C5FD;
    }

    body.dark-mode .btn-export-pill:hover {
        background-color: rgba(31, 93, 154, 0.45);
    }

    .user-trend-chart-box {
        position: relative;
        width: 100%;
        cursor: crosshair;
        touch-action: pan-y;
    }

    .user-trend-svg {
        width: 100%;
        height: 240px;
        overflow: visible;
    }

    .chart-grid-line {
        stroke: #E2E8F0;
    }

    body.dark-mode .chart-grid-line {
        stroke: rgba(255, 255, 255, 0.08);
    }

    /* DS-02 Stroke Draw-in animation */
    .user-trend-line {
        stroke-dasharray: 2000;
        stroke-dashoffset: 2000;
        animation: drawTrendLine 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .user-trend-area {
        opacity: 0;
        animation: fadeInTrendArea 0.6s ease-out 0.75s forwards;
    }

    .user-trend-point {
        opacity: 0;
        transform-origin: center;
        animation: scaleInTrendPoint 0.3s ease-out forwards;
        transition: r 0.2s ease, fill 0.2s ease;
    }

    @@keyframes drawTrendLine {
        to {
            stroke-dashoffset: 0;
        }
    }

    @@keyframes fadeInTrendArea {
        to {
            opacity: 1;
        }
    }

    @@keyframes scaleInTrendPoint {
        from {
            opacity: 0;
            transform: scale(0);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .user-trend-tooltip {
        position: absolute;
        top: 6px;
        transform: translateX(-50%);
        background: var(--persada-navy-900, #0F1F3D);
        color: #FFFFFF;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.75rem;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.3);
        pointer-events: none;
        z-index: 10;
        text-align: center;
        white-space: nowrap;
        animation: tooltipPop 0.15s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .user-trend-tooltip::after {
        content: '';
        position: absolute;
        bottom: -5px;
        left: 50%;
        transform: translateX(-50%);
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
        border-top: 5px solid var(--persada-navy-900, #0F1F3D);
    }

    .tooltip-month {
        font-weight: 700;
        color: #F8FAFC;
        font-size: 0.75rem;
        margin-bottom: 2px;
    }

    .tooltip-count {
        font-size: 0.725rem;
        color: #FCD34D;
    }

    .user-trend-labels {
        display: flex;
        justify-content: space-between;
        padding: 8px 15px 0;
        font-size: 0.75rem;
        font-weight: 600;
        color: #94A3B8;
    }

    .user-trend-x-label {
        text-align: center;
        min-width: 30px;
        transition: color 0.2s ease, font-weight 0.2s ease;
    }

    .user-trend-x-label.active {
        color: #F59E0B;
        font-weight: 700;
    }

    @@media (max-width: 640px) {
        .user-trend-card {
            padding: 16px;
        }
        .user-trend-svg {
            height: 180px;
        }
        .user-trend-labels {
            font-size: 0.6875rem;
        }
    }
</style>

@code {
    private record ChartPoint(double X, double Y, string Label, int Value);
    private List<ChartPoint> _chartPoints = new();
    private string _linePath = "";
    private string _areaPath = "";
    private ChartPoint? _activePoint = null;

    protected override void OnInitialized()
    {
        CalculateUserData();
    }

    private void CalculateUserData()
    {
        _chartPoints.Clear();

        // 6 Bulan Terakhir: Mei, Jun, Jul, Ags, Sep, Okt (sesuai acuan admin)
        var months = new[] { "Mei", "Jun", "Jul", "Ags", "Sep", "Okt" };
        var counts = new[] { 4, 8, 3, 11, 7, 14 }; // Data tren bulanan dinamis

        double width = 600;
        double height = 260;
        double padLeft = 35;
        double padRight = 35;
        double padTop = 35;
        double padBottom = 35;

        double chartW = width - (padLeft + padRight);
        double chartH = height - (padTop + padBottom);

        double maxVal = counts.Max();
        double minVal = 0; // Baseline at zero
        double valRange = maxVal - minVal;
        if (valRange == 0) valRange = 1;

        for (int i = 0; i < counts.Length; i++)
        {
            double x = padLeft + (i / (double)(counts.Length - 1)) * chartW;
            double norm = (counts[i] - minVal) / valRange;
            double y = (padTop + chartH) - (norm * chartH);

            _chartPoints.Add(new ChartPoint(x, y, months[i], counts[i]));
        }

        if (_chartPoints.Count > 0)
        {
            var sb = new System.Text.StringBuilder();
            sb.Append($"M {_chartPoints[0].X.ToString("F1", CultureInfo.InvariantCulture)},{_chartPoints[0].Y.ToString("F1", CultureInfo.InvariantCulture)}");
            
            for (int i = 0; i < _chartPoints.Count - 1; i++)
            {
                var p0 = i > 0 ? _chartPoints[i - 1] : _chartPoints[i];
                var p1 = _chartPoints[i];
                var p2 = _chartPoints[i + 1];
                var p3 = i < _chartPoints.Count - 2 ? _chartPoints[i + 2] : p2;

                var cp1x = p1.X + (p2.X - p0.X) / 6.0;
                var cp1y = p1.Y + (p2.Y - p0.Y) / 6.0;

                var cp2x = p2.X - (p3.X - p1.X) / 6.0;
                var cp2y = p2.Y - (p3.Y - p1.Y) / 6.0;

                sb.Append($" C {cp1x.ToString("F1", CultureInfo.InvariantCulture)},{cp1y.ToString("F1", CultureInfo.InvariantCulture)} " +
                          $"{cp2x.ToString("F1", CultureInfo.InvariantCulture)},{cp2y.ToString("F1", CultureInfo.InvariantCulture)} " +
                          $"{p2.X.ToString("F1", CultureInfo.InvariantCulture)},{p2.Y.ToString("F1", CultureInfo.InvariantCulture)}");
            }
            _linePath = sb.ToString();

            var firstX = _chartPoints[0].X.ToString("F1", CultureInfo.InvariantCulture);
            var lastX = _chartPoints[^1].X.ToString("F1", CultureInfo.InvariantCulture);
            var bottomY = (padTop + chartH).ToString("F1", CultureInfo.InvariantCulture);

            _areaPath = $"{_linePath} L {lastX},{bottomY} L {firstX},{bottomY} Z";
        }
    }

    private void HandleMouseMove(MouseEventArgs e) => UpdateNearestPoint(e.OffsetX);
    private void HandleMouseLeave() => _activePoint = null;

    private void HandleTouchMove(TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            UpdateNearestPoint(e.Touches[0].ClientX);
        }
    }

    private void HandleTouchEnd() => _activePoint = null;

    private void UpdateNearestPoint(double coordX)
    {
        if (!_chartPoints.Any()) return;

        ChartPoint? nearest = null;
        double minDistance = double.MaxValue;

        foreach (var pt in _chartPoints)
        {
            double dist = Math.Abs(pt.X - coordX);
            if (dist < minDistance)
            {
                minDistance = dist;
                nearest = pt;
            }
        }

        _activePoint = nearest;
    }

    private async Task HandleExport()
    {
        try
        {
            var csv = "Bulan,Jumlah_Pemesanan\n" + string.Join("\n", _chartPoints.Select(p => $"{p.Label},{p.Value}"));
            await JS.InvokeVoidAsync("alert", "Data tren pemesanan berhasil diekspor (CSV siap diunduh).");
        }
        catch { }
    }
}

