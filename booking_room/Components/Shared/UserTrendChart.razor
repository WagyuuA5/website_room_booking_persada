@namespace booking_room.Components.Shared
@using System.Globalization
@using ApexCharts
@inject booking_room.Services.IToastService ToastService

<div class="user-trend-card">
    <div class="user-trend-header">
        <div>
            <h3 class="trend-title">Tren Pemesanan Ruangan Saya</h3>
            <p class="trend-subtitle">Statistik frekuensi dan utilisasi reservasi ruangan kerja Anda</p>
        </div>
        <div class="trend-header-actions">
            <div class="trend-period-tabs">
                <button type="button" class="trend-tab-btn @(_selectedPeriod == "6m" ? "active" : "")" @onclick='() => SetPeriod("6m")'>6 Bulan</button>
                <button type="button" class="trend-tab-btn @(_selectedPeriod == "1y" ? "active" : "")" @onclick='() => SetPeriod("1y")'>Tahun Ini</button>
            </div>
            <button type="button" class="btn-export-pill" @onclick="ExportData">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Ekspor Data</span>
            </button>
        </div>
    </div>

    <!-- KPI Summary Pills -->
    <div class="trend-kpi-grid">
        <div class="trend-kpi-item">
            <span class="trend-kpi-label">TOTAL PEMESANAN</span>
            <div class="trend-kpi-value-row">
                <span class="trend-kpi-num">@TotalBookings Sesi</span>
                <span class="trend-kpi-badge positive">+14% YoY</span>
            </div>
        </div>
        <div class="trend-kpi-item">
            <span class="trend-kpi-label">RATA-RATA BULANAN</span>
            <div class="trend-kpi-value-row">
                <span class="trend-kpi-num">@AverageBookings Sesi/Bln</span>
                <span class="trend-kpi-badge neutral">Stabil</span>
            </div>
        </div>
        <div class="trend-kpi-item">
            <span class="trend-kpi-label">RUANGAN FAVORIT</span>
            <div class="trend-kpi-value-row">
                <span class="trend-kpi-num-text">Focus Room Alpha</span>
            </div>
        </div>
        <div class="trend-kpi-item">
            <span class="trend-kpi-label">STATUS TINGKAT KEHADIRAN</span>
            <div class="trend-kpi-value-row">
                <span class="trend-kpi-num">96.4%</span>
                <span class="trend-kpi-badge positive">Tepat Waktu</span>
            </div>
        </div>
    </div>

    <div class="user-trend-chart-box" style="min-height: 250px;">
        <ApexChart TItem="TrendPoint"
                   Options="options"
                   Height="@("250")">
            
            <ApexPointSeries TItem="TrendPoint"
                             Items="_chartPoints"
                             Name="Pemesanan"
                             SeriesType="SeriesType.Area"
                             XValue="e => e.Month"
                             YAggregate="e => e.Sum(e => e.Value)" />
        </ApexChart>
    </div>
</div>

<style>
    .user-trend-card {
        background: var(--color-white, #FFFFFF);
        border: 1px solid var(--color-neutral-200, #E8E8ED);
        border-radius: var(--radius-md, 14px);
        padding: 24px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.02);
        margin-top: 20px;
    }
    body.dark-mode .user-trend-card {
        background: var(--color-neutral-900, #1D1D1F);
        border-color: rgba(255,255,255,0.1);
    }

    .user-trend-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 20px;
    }
    .trend-title {
        font-size: var(--fs-h3, 20px);
        font-weight: var(--fw-bold, 700);
        color: var(--color-navy, #0F172A);
        margin: 0 0 4px 0;
    }
    body.dark-mode .trend-title { color: var(--color-white, #FFFFFF); }

    .trend-subtitle {
        font-size: var(--fs-sm, 14px);
        color: var(--color-neutral-600, #6E6E73);
        margin: 0;
    }

    .trend-header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .trend-period-tabs {
        display: flex;
        background: #F1F5F9;
        border-radius: 999px;
        padding: 3px;
        gap: 2px;
    }
    body.dark-mode .trend-period-tabs { background: #1E293B; }

    .trend-tab-btn {
        border: none;
        background: transparent;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        color: #64748B;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .trend-tab-btn.active {
        background: #FFFFFF;
        color: #0F172A;
        font-weight: 700;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    }
    body.dark-mode .trend-tab-btn.active {
        background: #334155;
        color: #F8FAFC;
    }

    .btn-export-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        background: #EFF6FF;
        color: #2563EB;
        border: 1px solid #BFDBFE;
        border-radius: var(--radius-full, 999px);
        font-size: var(--fs-xs, 12px);
        font-weight: var(--fw-semibold, 600);
        cursor: pointer;
        transition: var(--motion-fast);
    }
    .btn-export-pill:hover {
        background: #DBEAFE;
    }
    body.dark-mode .btn-export-pill {
        background: rgba(37, 99, 235, 0.2);
        color: #93C5FD;
        border-color: rgba(147, 197, 253, 0.3);
    }

    /* KPI Summary Pills */
    .trend-kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 14px;
        margin-bottom: 24px;
    }
    .trend-kpi-item {
        background: #F8FAFC;
        border: 1.5px solid #E2E8F0;
        border-radius: 12px;
        padding: 12px 16px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    body.dark-mode .trend-kpi-item {
        background: rgba(15, 23, 42, 0.4);
        border-color: rgba(255, 255, 255, 0.08);
    }
    .trend-kpi-label {
        font-size: 10.5px;
        font-weight: 700;
        color: #64748B;
        letter-spacing: 0.04em;
    }
    body.dark-mode .trend-kpi-label { color: #94A3B8; }
    .trend-kpi-value-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .trend-kpi-num {
        font-size: 1.15rem;
        font-weight: 800;
        color: #0F172A;
    }
    body.dark-mode .trend-kpi-num { color: #F8FAFC; }
    .trend-kpi-num-text {
        font-size: 0.95rem;
        font-weight: 800;
        color: #1F5D9A;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    body.dark-mode .trend-kpi-num-text { color: #60A5FA; }
    .trend-kpi-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 999px;
    }
    .trend-kpi-badge.positive {
        background: #DCFCE7;
        color: #166534;
    }
    .trend-kpi-badge.neutral {
        background: #E2E8F0;
        color: #475569;
    }

    .user-trend-chart-box {
        position: relative;
        width: 100%;
    }
</style>

@code {
    private record TrendPoint(int Year, int MonthNumber, string Month, int Value);
    private List<TrendPoint> _chartPoints = new();
    private ApexChartOptions<TrendPoint> options = new();
    private string _selectedPeriod = "6m";

    private int TotalBookings => _chartPoints.Sum(p => p.Value);
    private double AverageBookings => _chartPoints.Any() ? Math.Round((double)TotalBookings / _chartPoints.Count, 1) : 0;

    protected override void OnInitialized()
    {
        SetPeriod("6m");
    }

    private void SetPeriod(string period)
    {
        _selectedPeriod = period;
        List<TrendPoint> rawData;
        if (period == "1y")
        {
            rawData = new List<TrendPoint>
            {
                new TrendPoint(2026, 1, "Jan", 6),
                new TrendPoint(2026, 2, "Feb", 5),
                new TrendPoint(2026, 3, "Mar", 9),
                new TrendPoint(2026, 4, "Apr", 7),
                new TrendPoint(2026, 5, "Mei", 4),
                new TrendPoint(2026, 6, "Jun", 8),
                new TrendPoint(2026, 7, "Jul", 5),
                new TrendPoint(2026, 8, "Ags", 12),
                new TrendPoint(2026, 9, "Sep", 9),
                new TrendPoint(2026, 10, "Okt", 15)
            };
        }
        else
        {
            rawData = new List<TrendPoint>
            {
                new TrendPoint(2026, 5, "Mei", 4),
                new TrendPoint(2026, 6, "Jun", 8),
                new TrendPoint(2026, 7, "Jul", 5),
                new TrendPoint(2026, 8, "Ags", 12),
                new TrendPoint(2026, 9, "Sep", 9),
                new TrendPoint(2026, 10, "Okt", 15)
            };
        }

        // KRONOLOGIS PALING LAMA KE PALING BARU (kiri ke kanan)
        _chartPoints = rawData.OrderBy(x => x.Year).ThenBy(x => x.MonthNumber).ToList();
        Console.WriteLine($"[UserTrendChart] Points (Chronological): {string.Join(" -> ", _chartPoints.Select(p => $"{p.Month}:{p.Value}"))}");

        options = new ApexChartOptions<TrendPoint>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Animations = new Animations { Enabled = true, Easing = Easing.Easeinout, Speed = 800 }
            },
            Colors = new List<string> { "#F5A623" },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 3 },
            DataLabels = new DataLabels { Enabled = false },
            Xaxis = new XAxis 
            { 
                Labels = new XAxisLabels 
                { 
                    Style = new AxisLabelStyle { Colors = "#86868B", FontWeight = "600" } 
                } 
            },
            Grid = new Grid { StrokeDashArray = 4, BorderColor = "#E8E8ED" },
            Fill = new Fill 
            { 
                Type = new List<FillType> { FillType.Gradient }, 
                Gradient = new FillGradient 
                { 
                    ShadeIntensity = 1, 
                    OpacityFrom = 0.35, 
                    OpacityTo = 0, 
                    Stops = new List<double> { 0, 100 } 
                } 
            },
            Tooltip = new Tooltip
            {
                Theme = Mode.Dark
            }
        };
    }

    private void ExportData()
    {
        ToastService.Success("Ekspor Berhasil", "Data tren pemesanan berhasil diekspor.");
    }
}
