@namespace booking_room.Components.Shared
@using System.Globalization
@using ApexCharts
@inject booking_room.Services.IToastService ToastService

<div class="user-trend-card">
    <div class="user-trend-header">
        <div>
            <h3 class="trend-title">Tren Pemesanan Saya</h3>
            <p class="trend-subtitle">Jumlah pemesanan ruangan 6 bulan terakhir</p>
        </div>
        <button type="button" class="btn-export-pill" @onclick="ExportData">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Ekspor</span>
        </button>
    </div>

    <div class="user-trend-chart-box" style="min-height: 250px;">
        <ApexChart TItem="TrendPoint"
                   Options="options"
                   Height="@("250")">
            
            <ApexPointSeries TItem="TrendPoint"
                             Items="_chartPoints"
                             Name="Pemesanan"
                             SeriesType="SeriesType.Area"
                             XValue="e => e.Month"
                             YAggregate="e => e.Sum(e => e.Value)"
                             OrderBy="e => e.X" />
        </ApexChart>
    </div>
</div>

<style>
    .user-trend-card {
        background: var(--color-white, #FFFFFF);
        border: 1px solid var(--color-neutral-200, #E8E8ED);
        border-radius: var(--radius-md, 14px);
        padding: 24px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.02);
        margin-top: 20px;
    }
    body.dark-mode .user-trend-card {
        background: var(--color-neutral-900, #1D1D1F);
        border-color: rgba(255,255,255,0.1);
    }

    .user-trend-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }
    .trend-title {
        font-size: var(--fs-h3, 20px);
        font-weight: var(--fw-bold, 700);
        color: var(--color-navy, #0F172A);
        margin: 0 0 4px 0;
    }
    body.dark-mode .trend-title { color: var(--color-white, #FFFFFF); }

    .trend-subtitle {
        font-size: var(--fs-sm, 14px);
        color: var(--color-neutral-600, #6E6E73);
        margin: 0;
    }

    .btn-export-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        background: #EFF6FF;
        color: #2563EB;
        border: 1px solid #BFDBFE;
        border-radius: var(--radius-full, 999px);
        font-size: var(--fs-xs, 12px);
        font-weight: var(--fw-semibold, 600);
        cursor: pointer;
        transition: var(--motion-fast);
    }
    .btn-export-pill:hover {
        background: #DBEAFE;
    }
    body.dark-mode .btn-export-pill {
        background: rgba(37, 99, 235, 0.2);
        color: #93C5FD;
        border-color: rgba(147, 197, 253, 0.3);
    }

    .user-trend-chart-box {
        position: relative;
        width: 100%;
    }
</style>

@code {
    private record TrendPoint(int X, string Month, int Value);
    private List<TrendPoint> _chartPoints = new();
    private ApexChartOptions<TrendPoint> options = new();

    protected override void OnInitialized()
    {
        _chartPoints = new List<TrendPoint>
        {
            new TrendPoint(1, "Mei", 4),
            new TrendPoint(2, "Jun", 8),
            new TrendPoint(3, "Jul", 5),
            new TrendPoint(4, "Ags", 12),
            new TrendPoint(5, "Sep", 9),
            new TrendPoint(6, "Okt", 15)
        };

        options = new ApexChartOptions<TrendPoint>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Animations = new Animations { Enabled = true, Easing = Easing.Easeinout, Speed = 800 }
            },
            Colors = new List<string> { "#F5A623" },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 3 },
            DataLabels = new DataLabels { Enabled = false },
            Xaxis = new XAxis 
            { 
                Labels = new XAxisLabels 
                { 
                    Style = new AxisLabelStyle { Colors = "#86868B", FontWeight = "600" } 
                } 
            },
            Grid = new Grid { StrokeDashArray = 4, BorderColor = "#E8E8ED" },
            Fill = new Fill 
            { 
                Type = new List<FillType> { FillType.Gradient }, 
                Gradient = new FillGradient 
                { 
                    ShadeIntensity = 1, 
                    OpacityFrom = 0.35, 
                    OpacityTo = 0, 
                    Stops = new List<double> { 0, 100 } 
                } 
            },
            Tooltip = new Tooltip
            {
                Theme = Mode.Dark
            }
        };
    }

    private void ExportData()
    {
        ToastService.Success("Ekspor Berhasil", "Data tren pemesanan berhasil diekspor.");
    }
}
