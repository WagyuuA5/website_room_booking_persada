<style>
    .active-sessions-wrapper {
        display: flex;
        flex-direction: column;
        max-width: 520px; 
        width: 100%;
        margin: 0 auto;
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        max-height: 88vh;
        box-shadow: 0 4px 24px rgba(16,48,92,0.08);
        font-family: 'Inter', sans-serif;
    }
    .modal-header-section {
        padding: 24px 24px 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        background: #fff;
        position: sticky;
        top: 0;
        z-index: 10;
        border-bottom: 1px solid #E5E7EB;
    }
    .modal-title {
        color: #16305C;
        font-weight: 700;
        font-size: 1.25rem;
        margin: 0 0 4px 0;
    }
    .modal-subtitle {
        color: #6B7280;
        font-size: 0.875rem;
        margin: 0;
    }
    .btn-close {
        background: transparent;
        border: none;
        color: #9CA3AF;
        cursor: pointer;
        padding: 4px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .btn-close:hover {
        background: #F3F4F6;
        color: #4B5563;
    }
    .modal-body-section {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .modal-footer-section {
        padding: 16px 24px;
        background: #fff;
        border-top: 1px solid #E5E7EB;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        position: sticky;
        bottom: 0;
        z-index: 10;
    }
    .session-list { display: flex; flex-direction: column; gap: 1rem; }
    .session-item { display: flex; align-items: center; gap: 1rem; padding: 1rem; border: 1px solid #E5E7EB; border-radius: 14px; }
    .session-icon { font-size: 1.5rem; }
    .session-details { flex: 1; }
    .session-device { font-weight: 500; color: #16305C; display: flex; align-items: center; gap: 0.5rem; }
    .session-meta { font-size: 0.75rem; color: #6B7280; margin-top: 0.25rem; }
    .badge { padding: 0.125rem 0.5rem; border-radius: 999px; font-size: 0.75rem; font-weight: 500; }
    .badge-success { background-color: #D1FAE5; color: #059669; }
    .btn-text { background: none; border: none; font-size: 0.875rem; font-weight: 500; cursor: pointer; padding: 0; }
    .text-danger { color: #DC2626; }
    .text-danger:hover { text-decoration: underline; }
    
    .btn-pill {
        border-radius: 999px;
        padding: 8px 20px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        border: none;
    }
    .btn-secondary { background-color: #F3F4F6; color: #374151; }
    .btn-secondary:hover { background-color: #E5E7EB; }
</style>

<div class="active-sessions-wrapper">
    <div class="modal-header-section">
        <div>
            <h3 class="modal-title">Sesi Aktif</h3>
            <p class="modal-subtitle">Kelola perangkat yang saat ini masuk ke akun Anda.</p>
        </div>
        <button class="btn-close" @onclick="OnClose">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6L18 18"/></svg>
        </button>
    </div>

    <div class="modal-body-section">
        <div class="session-list">
            <div class="session-item">
                <div class="session-icon">💻</div>
                <div class="session-details">
                    <div class="session-device">Windows PC - Chrome <span class="badge badge-success">Saat Ini</span></div>
                    <div class="session-meta">Jakarta, Indonesia • Aktif sekarang</div>
                </div>
            </div>
            <div class="session-item">
                <div class="session-icon">📱</div>
                <div class="session-details">
                    <div class="session-device">iPhone 13 - Safari</div>
                    <div class="session-meta">Bandung, Indonesia • 2 jam yang lalu</div>
                </div>
                <button class="btn-text text-danger">Keluar</button>
            </div>
        </div>
    </div>

    <div class="modal-footer-section">
        <button class="btn-pill btn-secondary" @onclick="OnClose">Tutup</button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
}
