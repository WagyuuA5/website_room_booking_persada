<AppModal Visible="true" Size="md" ShowCloseButton="false" OnClose="HandleClose">
    <BodyContent>
        <div class="invitation-modal-v2">
    <div class="invitation-header-v2">
        <div class="header-title-v2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Undangan
        </div>
    </div>
    <div class="invitation-body-v2">
        <h2 class="meeting-title-v2">@Agenda</h2>
        <div class="invited-by-v2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Diundang oleh @InviterName
        </div>

        <div class="info-card-v2">
            <div class="info-row-v2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                @DateString
            </div>
            <div class="info-row-v2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                @TimeSlot
            </div>
            <div class="info-row-v2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                @Location - @RoomName
            </div>
        </div>
    </div>

    <div class="invitation-footer-v2" style="margin-top: 24px;">
        <button class="btn-primary-app" style="width:100%;" @onclick='() => HandleRsvp("Accept")'>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Terima
        </button>
        <div class="footer-actions-row">
            <button class="btn-secondary-app" style="flex:1;" @onclick='() => HandleRsvp("Maybe")'>Mungkin</button>
            <button class="btn-tertiary-app" style="flex:1;" @onclick='() => HandleRsvp("Decline")'>Tolak</button>
        </div>
    </div>

    <style>
        .invitation-modal-v2 {
            width: 400px;
            background: #FFFFFF;
            border-radius: 24px;
            overflow: hidden;
    font-family: 'Inter', sans-serif;
        }
        .invitation-header-v2 {
            background-color: #16305C;
            color: white;
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .header-title-v2 {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 16px;
        }
        .modal-close-btn-white {
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.7);
            cursor: pointer;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: background-color 0.2s, color 0.2s;
        }
        .modal-close-btn-white:hover {
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
        }
        .invitation-body-v2 {
            padding: 24px 20px;
        }
        .meeting-title-v2 {
            color: #16305C;
            font-size: 24px;
            font-weight: 700;
            margin: 0 0 8px 0;
            line-height: 1.2;
        }
        .invited-by-v2 {
            color: #6B7280;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 24px;
        }
        .info-card-v2 {
            background: #F3F4F6;
            border-radius: 14px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .info-row-v2 {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #16305C;
            font-weight: 600;
            font-size: 14px;
        }
        .info-row-v2 svg {
            color: #6B7280;
        }
        .invitation-footer-v2 {
            padding: 0 20px 24px 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .btn-accept-v2 {
            background-color: #EAB63C;
            color: #16305C;
            border: none;
            border-radius: 999px;
            padding: 10px 12px;
            height: 42px;
            font-weight: 700;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            cursor: pointer;
            width: 100%;
            transition: opacity 0.2s;
            margin-bottom: 12px;
            white-space: nowrap;
        }
        .btn-accept-v2:hover {
            opacity: 0.9;
        }
        .footer-actions-row {
            display: flex;
            gap: 12px;
            width: 100%;
        }
        .btn-maybe-v2 {
            flex: 1;
            background: white;
            border: 1px solid #E5E7EB;
            color: #16305C;
            border-radius: 999px;
            padding: 10px 12px;
            height: 42px;
            font-weight: 600;
            font-size: 0.875rem;
            cursor: pointer;
            transition: background-color 0.2s;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .btn-maybe-v2:hover {
            background-color: #F9FAFB;
        }
        .btn-decline-v2 {
            flex: 1;
            background: none;
            border: 1px solid transparent;
            color: #6B7280;
            border-radius: 999px;
            padding: 10px 12px;
            height: 42px;
            font-weight: 600;
            font-size: 0.875rem;
            cursor: pointer;
            transition: color 0.2s;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .btn-decline-v2:hover {
            color: #16305C;
        }
    </style>
        </div>
    </BodyContent>
</AppModal>

@code {
    [Parameter] public string RoomName { get; set; } = "Alpha Boardroom";
    [Parameter] public string InviterName { get; set; } = "Andi Setiawan";
    [Parameter] public string TimeSlot { get; set; } = "09:00 - 11:00";
    [Parameter] public string Location { get; set; } = "Lantai 3, Sayap Utara, Persada HQ";
    [Parameter] public string DateString { get; set; } = "24/10/2023";
    [Parameter] public int Capacity { get; set; } = 20;
    [Parameter] public string Agenda { get; set; } = "Sinkronisasi Strategi Q3";
    
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnRsvp { get; set; }

    private async Task HandleClose() { if (OnClose.HasDelegate) { await OnClose.InvokeAsync(); } }
    private async Task HandleRsvp(string status)
    {
        await OnRsvp.InvokeAsync(status);
        await OnClose.InvokeAsync();
    }
}



