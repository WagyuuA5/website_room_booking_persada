<div class="invitation-modal">
    <div class="invitation-header">
        <div class="invitation-icon-container">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" fill="#f59e0b"/></svg>
            <span class="notification-dot"></span>
        </div>
        <div class="invitation-header-text">
            <h2>Invitation</h2>
            <p>@RoomName</p>
        </div>
        <button class="modal-close-btn" @onclick="OnClose">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
    </div>

    <div class="invitation-body">
        <div class="invitation-main-info">
            <strong>@InviterName</strong> has invited you to join a meeting
        </div>

        <div class="invitation-details-grid">
            <div class="detail-item">
                <div class="detail-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                <div>
                    <div class="detail-label">Time</div>
                    <div class="detail-value">@TimeSlot</div>
                </div>
            </div>
            <div class="detail-item">
                <div class="detail-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                <div>
                    <div class="detail-label">Location</div>
                    <div class="detail-value">@Location</div>
                </div>
            </div>
            <div class="detail-item">
                <div class="detail-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                <div>
                    <div class="detail-label">Date</div>
                    <div class="detail-value">@DateString</div>
                </div>
            </div>
            <div class="detail-item">
                <div class="detail-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 7a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                <div>
                    <div class="detail-label">Capacity</div>
                    <div class="detail-value">@Capacity participants expected</div>
                </div>
            </div>
        </div>

        <div class="invitation-notes">
            <h4 class="notes-label">Agenda/Notes</h4>
            <div class="notes-box">
                @Agenda
            </div>
        </div>
    </div>

    <div class="invitation-footer">
        <button class="btn-decline" @onclick='() => HandleRsvp("Decline")'>Decline</button>
        <button class="btn-maybe" @onclick='() => HandleRsvp("Maybe")'>Maybe</button>
        <button class="btn-accept" @onclick='() => HandleRsvp("Accept")'>Accept</button>
    </div>
</div>

@code {
    [Parameter] public string RoomName { get; set; } = "Boardroom A";
    [Parameter] public string InviterName { get; set; } = "Budi Santoso";
    [Parameter] public string TimeSlot { get; set; } = "10:00 - 11:30 AM";
    [Parameter] public string Location { get; set; } = "Floor 3, Wing B";
    [Parameter] public string DateString { get; set; } = "15 Aug 2026";
    [Parameter] public int Capacity { get; set; } = 20;
    [Parameter] public string Agenda { get; set; } = "Quarterly business review and Q3 planning session.";
    
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnRsvp { get; set; }

    private async Task HandleRsvp(string status)
    {
        await OnRsvp.InvokeAsync(status);
        await OnClose.InvokeAsync();
    }
}
