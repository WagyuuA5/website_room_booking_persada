@namespace booking_room.Components.Shared
@using booking_room.Components.Models
@using booking_room.Services
@using System.Globalization
@inject IModalService ModalService

<ModalBase Visible="true" Size="lg" ShowCloseButton="true" OnClose="Close">
    <HeaderContent>
        <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: #DBEAFE; display: flex; align-items: center; justify-content: center; color: #1E40AF;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="14" width="4" height="7" rx="1" fill="#1e40af"/>
                        <rect x="8.5" y="10" width="4" height="11" rx="1" fill="#3b82f6"/>
                        <rect x="14" y="6" width="4" height="15" rx="1" fill="#60a5fa"/>
                        <path d="M2 21H23" stroke="#94a3b8" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: var(--persada-navy-900, #0F1F3D);">Analitik Penggunaan Detail</h3>
                    <p style="margin: 2px 0 0 0; font-size: 0.85rem; color: #64748B;">Data periode: @SelectedPeriod @(string.IsNullOrEmpty(HighlightRoom) ? "" : $"• {HighlightRoom}")</p>
                </div>
            </div>
        </div>
    </HeaderContent>
    <ChildContent>
        <AnalyticsDetailPopup SelectedPeriod="@SelectedPeriod" OnClose="Close" />
    </ChildContent>
    <FooterContent>
        <button class="btn-modal-outline" style="padding: 10px 24px; border-radius: 999px; font-weight: 600; cursor: pointer; border: 1px solid #CBD5E1; background: transparent; color: #475569;" @onclick="Close">
            Tutup
        </button>
    </FooterContent>
</ModalBase>

@code {
    [Parameter] public string SelectedPeriod { get; set; } = "Minggu";
    [Parameter] public string? HighlightRoom { get; set; }

    private void Close()
    {
        ModalService.Close(ModalResult.Ok());
    }
}
