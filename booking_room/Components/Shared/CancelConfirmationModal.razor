<div class="cancel-confirmation-modal">
    <div class="cancel-header">
        <div class="header-icon bg-red-light">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="header-text">
            <h2>Batalkan Pemesanan</h2>
            <p>@RoomName</p>
        </div>
    </div>

    <div class="cancel-body">
        <p>Apakah Anda yakin ingin membatalkan pemesanan ruangan ini? Tindakan ini tidak dapat dibatalkan.</p>
    </div>

    <div class="cancel-footer">
        <button class="btn-keep" @onclick="OnKeep">Tidak, Tetap Simpan</button>
        <button class="btn-confirm-cancel" @onclick="OnConfirmCancel">Ya, Batalkan</button>
    </div>
</div>

@code {
    [Parameter] public string RoomName { get; set; } = "";
    [Parameter] public EventCallback OnKeep { get; set; }
    [Parameter] public EventCallback OnConfirmCancel { get; set; }
}
