@namespace booking_room.Components.Shared
@using booking_room.Components.Models
@using booking_room.Services
@inject NavigationManager Navigation
@inject IModalService ModalService

<AppModal Visible="@Visible" Title="Ruangan Tersedia" Size="lg" ShowCloseButton="true" OnClose="Close">
    <BodyContent>
        <div class="available-rooms-modal">
            <div class="filter-pills-row">
                <button class="filter-pill @(_filterPeriod == "Today" ? "active" : "")" @onclick="SetFilterToday">
                    Hari Ini
                </button>
                <button class="filter-pill @(_filterPeriod == "Any" ? "active" : "")" @onclick="SetFilterAny">
                    Kapasitas Apa Pun
                </button>
            </div>

            <div class="rooms-list-grid">
                @foreach (var room in FilteredRooms)
                {
                    <div class="room-item-card" @onclick="() => SelectRoom(room)">
                        <div class="room-avatar-img">
                            <img src="@room.PhotoUrl" alt="@room.Name" />
                        </div>
                        <div class="room-item-info">
                            <h4 class="room-item-title">@room.Name</h4>
                            <span class="room-item-meta">@room.Floor • Kapasitas @room.Capacity Orang</span>
                            <div class="room-item-amenities">
                                @foreach (var a in room.Amenities)
                                {
                                    <span class="amenity-tag">@a</span>
                                }
                            </div>
                        </div>
                        <button class="btn-book-action" @onclick="() => SelectRoom(room)" @onclick:stopPropagation="true">
                            Pesan Sekarang
                        </button>
                    </div>
                }
            </div>
        </div>
    </BodyContent>
</AppModal>

<style>
    .available-rooms-modal {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .filter-pills-row {
        display: flex;
        gap: 8px;
    }
    .filter-pill {
        padding: 6px 14px;
        border-radius: 999px;
        background: #F1F5F9;
        border: 1px solid #CBD5E1;
        font-size: 0.75rem;
        font-weight: 600;
        color: #475569;
        cursor: pointer;
    }
    .filter-pill.active {
        background: #1F5D9A;
        color: #FFFFFF;
        border-color: #1F5D9A;
    }
    .rooms-list-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-height: 400px;
        overflow-y: auto;
    }
    .room-item-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    body.dark-mode .room-item-card {
        background: rgba(15, 23, 42, 0.4);
        border-color: rgba(255, 255, 255, 0.08);
    }
    .room-item-card:hover {
        background: #EFF6FF;
        border-color: #BFDBFE;
    }
    .room-avatar-img {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        overflow: hidden;
    }
    .room-avatar-img img { width: 100%; height: 100%; object-fit: cover; }
    .room-item-info { flex: 1; min-width: 0; }
    .room-item-title {
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--persada-navy-900, #0F1F3D);
        margin: 0 0 2px 0;
    }
    body.dark-mode .room-item-title { color: #F8FAFC; }
    .room-item-meta {
        font-size: 0.72rem;
        color: #6B7280;
    }
    .room-item-amenities {
        display: flex;
        gap: 4px;
        margin-top: 4px;
    }
    .amenity-tag {
        font-size: 0.625rem;
        padding: 1px 6px;
        border-radius: 4px;
        background: #E2E8F0;
        color: #334155;
    }
    body.dark-mode .amenity-tag {
        background: #334155;
        color: #CBD5E1;
    }
    .btn-book-action {
        padding: 8px 16px;
        border-radius: 999px;
        background: #1F5D9A;
        color: #FFFFFF;
        font-size: 0.75rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string _filterPeriod = "Today";

    private readonly List<RoomItem> _allRooms = new()
    {
        new("1", "Executive Boardroom A", 12, "Ruang rapat eksekutif premium.", "available", new() { "AC", "Proyektor" }, "Lantai 3", "https://images.unsplash.com/photo-1517502884422-41eaead166d4?w=400&q=80"),
        new("2", "Huddle Space C", 6, "Ruang kolaborasi kecil.", "available", new() { "AC" }, "Lantai 1", "https://images.unsplash.com/photo-1556761175-5973dc0f32b7?w=400&q=80"),
        new("3", "Focus Room Alpha", 4, "Ruang sunyi.", "available", new() { "AC" }, "Lantai 1", "https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=400&q=80")
    };

    private IEnumerable<RoomItem> FilteredRooms => _allRooms.Where(r => r.Status == "available");

    private void SetFilterToday() => _filterPeriod = "Today";
    private void SetFilterAny() => _filterPeriod = "Any";

    private async Task SelectRoom(RoomItem room)
    {
        await OnClose.InvokeAsync();
        Navigation.NavigateTo($"/bookings");
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
        await ModalService.CloseTopAsync(ModalResult.Cancel());
    }
}


