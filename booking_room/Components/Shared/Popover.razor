@namespace booking_room.Components.Shared
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Visible)
{
    <!-- Backdrop transparan untuk menangkap klik di luar -->
    <div class="popover-backdrop" @onclick="CloseAsync"></div>

    <div class="popover-container @Class" style="@GetPositionStyle()">
        <div class="popover-card" @onclick:stopPropagation="true">
            @if (ShowHeader && (HeaderContent != null || !string.IsNullOrEmpty(Title)))
            {
                <div class="popover-header">
                    @if (HeaderContent != null)
                    {
                        @HeaderContent
                    }
                    else
                    {
                        <h4 class="popover-title">@Title</h4>
                    }

                </div>
            }

            <div class="popover-body">
                @if (BodyContent != null)
                {
                    @BodyContent
                }
                else if (ChildContent != null)
                {
                    @ChildContent
                }
            </div>

            @if (ShowFooter && FooterContent != null)
            {
                <div class="popover-footer">
                    @FooterContent
                </div>
            }
        </div>
    </div>
}

<style>
    .popover-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1040;
        background: transparent;
    }

    .popover-container {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        z-index: 1050;
        width: 380px;
        max-width: calc(100vw - 32px);
        animation: popoverSlideDown 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .popover-card {
        background: rgba(255, 255, 255, 0.90);
        -webkit-backdrop-filter: blur(16px) saturate(180%);
        backdrop-filter: blur(16px) saturate(180%);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: var(--persada-border-radius-card, 20px);
        box-shadow: 0 12px 36px rgba(15, 23, 42, 0.16);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        max-height: calc(85vh - 60px);
    }

    .popover-header {
        position: sticky;
        top: 0;
        z-index: 5;
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(226, 232, 240, 0.6);
        flex-shrink: 0;
    }

    .popover-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-brand-navy, #0F1F3D);
    }

    .popover-close-btn {
        background: none;
        border: none;
        padding: 4px;
        color: #9CA3AF;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .popover-close-btn:hover {
        background-color: #F3F4F6;
        color: #111827;
    }

    .popover-body {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 0;
    }

    .popover-footer {
        position: sticky;
        bottom: 0;
        z-index: 5;
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        padding: 12px 20px;
        border-top: 1px solid rgba(226, 232, 240, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    @@keyframes popoverSlideDown {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Width { get; set; } = "380px";
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowFooter { get; set; } = true;
    [Parameter] public bool ShowCloseButton { get; set; } = false;
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? BodyContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private readonly string _popoverId = "popover_" + Guid.NewGuid().ToString("N");
    private DotNetObjectReference<Popover>? _dotNetRef;
    private bool _listenerRegistered = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_listenerRegistered)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("popoverHelper.registerScrollClose", _popoverId, _dotNetRef);
                _listenerRegistered = true;
            }
            catch { }
        }
        else if (!Visible && _listenerRegistered)
        {
            await UnregisterListenerAsync();
        }
    }

    [JSInvokable]
    public async Task OnWindowScrolled()
    {
        if (Visible)
        {
            await CloseAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetPositionStyle() => $"width: {Width};";

    private async Task CloseAsync()
    {
        await UnregisterListenerAsync();
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task UnregisterListenerAsync()
    {
        if (_listenerRegistered)
        {
            _listenerRegistered = false;
            try
            {
                await JS.InvokeVoidAsync("popoverHelper.unregisterScrollClose", _popoverId);
            }
            catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        await UnregisterListenerAsync();
        _dotNetRef?.Dispose();
    }
}
