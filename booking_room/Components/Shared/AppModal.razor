@namespace booking_room.Components.Shared
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Visible)
{
    <div class="modal-backdrop-overlay @(LockBackdrop ? "backdrop-locked" : "") animate-fade-in" 
         @onclick="HandleOverlayClick"
         tabindex="-1">
        
        <div class="modal-surface-container size-@Size mode-@LayoutMode @Class animate-scale-up" 
             @onclick:stopPropagation="true"
             role="dialog" 
             aria-modal="true"
             aria-labelledby="@(string.IsNullOrEmpty(Title) ? null : "modal-title-heading")">
            
            @if (ShowCloseButton)
            {
                <button type="button" class="modal-close-icon-btn" @onclick="CloseAsync" aria-label="Tutup dialog">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            }

            @if (ShowHeader && (HeaderContent != null || !string.IsNullOrEmpty(Title)))
            {
                <div class="modal-header-zone">
                    @if (HeaderContent != null)
                    {
                        @HeaderContent
                    }
                    else
                    {
                        <div class="modal-default-header">
                            <h3 id="modal-title-heading" class="modal-heading-text">@Title</h3>
                        </div>
                    }
                </div>
            }

            <div class="modal-body-zone @(NoPadding ? "no-padding" : "")">
                @if (BodyContent != null)
                {
                    @BodyContent
                }
                else if (ChildContent != null)
                {
                    @ChildContent
                }
            </div>

            @if (ShowFooter && FooterContent != null)
            {
                <div class="modal-footer-zone">
                    @FooterContent
                </div>
            }
        </div>
    </div>
}

<style>
    .modal-backdrop-overlay {
        position: fixed;
        inset: 0;
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        padding: 16px;
        overflow-y: auto;
    }

    .modal-surface-container {
        position: relative;
        width: 100%;
        background-color: var(--surface-card, #FFFFFF);
        border: 1px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: var(--radius-card, 20px);
        box-shadow: 0 20px 40px -8px rgba(15, 31, 61, 0.15), 0 0 1px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        max-height: calc(100vh - 48px);
        overflow: hidden;
    }
    body.dark-mode .modal-surface-container {
        background-color: #1C1C1E;
        border-color: rgba(255, 255, 255, 0.12);
        color: #F8FAFC;
    }

    .modal-surface-container.size-sm { max-width: 420px; }
    .modal-surface-container.size-md { max-width: 580px; }
    .modal-surface-container.size-lg { max-width: 840px; }
    .modal-surface-container.size-xl { max-width: 1040px; }

    .modal-close-icon-btn {
        position: absolute;
        top: 16px;
        right: 16px;
        z-index: 20;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #F1F5F9;
        border: 1px solid #E2E8F0;
        border-radius: 50%;
        color: #64748B;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    body.dark-mode .modal-close-icon-btn {
        background-color: #2C2C2E;
        border-color: rgba(255, 255, 255, 0.1);
        color: #CBD5E1;
    }
    .modal-close-icon-btn:hover {
        background-color: #E2E8F0;
        color: #0F1F3D;
        transform: scale(1.05);
    }

    .modal-header-zone {
        padding: 20px 24px;
        border-bottom: 1px solid var(--divider-subtle, #F1F5F9);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    body.dark-mode .modal-header-zone {
        border-color: rgba(255, 255, 255, 0.08);
    }

    .modal-heading-text {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--persada-navy-900, #0F1F3D);
        margin: 0;
        letter-spacing: -0.01em;
    }
    body.dark-mode .modal-heading-text {
        color: #F8FAFC;
    }

    .modal-body-zone {
        padding: 24px;
        overflow-y: auto;
        flex: 1 1 auto;
    }
    .modal-body-zone.no-padding {
        padding: 0;
    }

    .modal-footer-zone {
        padding: 16px 24px;
        border-top: 1px solid var(--divider-subtle, #F1F5F9);
        background-color: #F8FAFC;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        border-bottom-left-radius: inherit;
        border-bottom-right-radius: inherit;
    }
    body.dark-mode .modal-footer-zone {
        background-color: #161618;
        border-color: rgba(255, 255, 255, 0.08);
    }

    .animate-fade-in {
        animation: modalFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .animate-scale-up {
        animation: modalScaleUp 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes modalFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @@keyframes modalScaleUp {
        from { opacity: 0; transform: scale(0.96) translateY(8px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; } = false;
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public string LayoutMode { get; set; } = "standard";
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowFooter { get; set; } = true;
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public bool LockBackdrop { get; set; } = false;
    [Parameter] public bool NoPadding { get; set; } = false;
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? BodyContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private DotNetObjectReference<AppModal>? _dotNetReference;
    private bool _disposed;

    private async Task HandleOverlayClick()
    {
        if (!LockBackdrop)
        {
            await CloseAsync();
        }
    }

    private async Task CloseAsync()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Visible)
        {
            try
            {
                _dotNetReference ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("registerEscapeKey", _dotNetReference);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task OnEscapePressed()
    {
        if (_disposed) return;
        try
        {
            if (Visible && !LockBackdrop)
            {
                await CloseAsync();
                if (!_disposed) await InvokeAsync(StateHasChanged);
            }
        }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _dotNetReference?.Dispose();
        await Task.CompletedTask;
    }
}
