@namespace booking_room.Components.Shared
@inject IJSRuntime JS

@if (Visible)
{
    <div class="modal-backdrop-overlay animate-fade-in" style="@(ZIndex.HasValue ? $"z-index: {ZIndex.Value};" : "")" @onclick="HandleOverlayClick">
        <div class="modal-surface-container size-@Size animate-scale-up @Class" @onclick:stopPropagation="true">
            
            @if (ShowHeader)
            {
                <div class="modal-header-zone">
                    @if (HeaderContent != null)
                    {
                        @HeaderContent
                    }
                    else
                    {
                        <div style="display: flex; align-items: center; gap: 16px;">
                            @if (IconContent != null)
                            {
                                <div class="modal-header-icon-box">
                                    @IconContent
                                </div>
                            }
                            <div>
                                @if (!string.IsNullOrEmpty(Title))
                                {
                                    <h3 class="modal-heading-text">@Title</h3>
                                }
                                @if (!string.IsNullOrEmpty(Subtitle))
                                {
                                    <p class="modal-subtitle-text">@Subtitle</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="modal-body-zone @(NoPadding ? "no-padding" : "")">
                @if (BodyContent != null)
                {
                    @BodyContent
                }
                else if (ChildContent != null)
                {
                    @ChildContent
                }
            </div>

            @if (ShowFooter && FooterContent != null)
            {
                <div class="modal-footer-zone">
                    @FooterContent
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; } = false;
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public int? ZIndex { get; set; }
    [Parameter] public string LayoutMode { get; set; } = "standard";
    [Parameter] public string? Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public Microsoft.AspNetCore.Components.RenderFragment? IconContent { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowFooter { get; set; } = true;
    [Parameter] public bool ShowCloseButton { get; set; } = false;
    [Parameter] public bool LockBackdrop { get; set; } = false;
    [Parameter] public bool NoPadding { get; set; } = false;
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? BodyContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private DotNetObjectReference<AppModal>? _dotNetReference;
    private bool _disposed;

    private async Task HandleOverlayClick()
    {
        if (!LockBackdrop)
        {
            await CloseAsync();
        }
    }

    private async Task CloseAsync()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Visible)
        {
            try
            {
                _dotNetReference ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("registerEscapeKey", _dotNetReference);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task OnEscapePressed()
    {
        if (_disposed) return;
        try
        {
            if (Visible && !LockBackdrop)
            {
                await CloseAsync();
                if (!_disposed) await InvokeAsync(StateHasChanged);
            }
        }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _dotNetReference?.Dispose();
        await Task.CompletedTask;
    }
}
