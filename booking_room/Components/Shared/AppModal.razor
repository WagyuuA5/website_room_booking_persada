@namespace booking_room.Components.Shared
@inject IJSRuntime JS
@inject booking_room.Services.ModalStateService ModalState

@if (UseQueue && ModalState.ActiveModal?.Key != ModalKey)
{
    return;
}

@if (Visible)
{
    <Modal Visible="true"
           VisibleChanged="HandleVisibleChanged"
           Title="@Title"
           Subtitle="@Subtitle"
           Size="@GetModalSize()"
           LayoutMode="@LayoutMode"
           DialogClass="@DialogClass"
           ShowCloseButton="@ShowCloseButton"
           ShowHeader="@ShowHeader"
           ShowFooter="@ShowFooter"
           OnClose="CloseAsync">
        <HeaderContent>
            @HeaderContent
        </HeaderContent>
        <BodyContent>
            @if (BodyContent != null)
            {
                @BodyContent
            }
            else if (ChildContent != null)
            {
                @ChildContent
            }
        </BodyContent>
        <FooterContent>
            @FooterContent
        </FooterContent>
    </Modal>
}

@code {
    [Parameter] public string ModalKey { get; set; } = "";
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string Size { get; set; } = "md"; // sm, default, md, lg, xl, auto
    [Parameter] public string LayoutMode { get; set; } = "form"; // form, list, split-detail, alert, invitation, solid-card
    [Parameter] public string DialogClass { get; set; } = "";
    [Parameter] public bool UseQueue { get; set; } = false;
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? BodyContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowFooter { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _enqueued;
    private bool? _pendingLock;

    protected override void OnInitialized()
    {
        if (UseQueue)
        {
            ModalState.OnChange += StateHasChanged;
        }
    }

    protected override void OnParametersSet()
    {
        if (UseQueue)
        {
            if (Visible && !_enqueued)
            {
                _enqueued = true;
                ModalState.Enqueue(new booking_room.Services.ModalRequest { Key = ModalKey });
            }

            if (ModalState.ActiveModal?.Key == ModalKey && _enqueued)
            {
                if (!_pendingLock.HasValue)
                {
                    _pendingLock = true;
                }
            }
            else if (ModalState.ActiveModal?.Key != ModalKey && _pendingLock == true)
            {
                _pendingLock = false;
            }
        }
    }

    private string GetModalSize() => Size switch
    {
        "sm" => "sm",
        "lg" => "lg",
        "xl" => "xl",
        _ => "md"
    };

    private async Task HandleVisibleChanged(bool isVisible)
    {
        if (!isVisible)
        {
            await CloseAsync();
        }
    }

    private async Task CloseAsync()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        _enqueued = false;
        _pendingLock = false;

        if (UseQueue)
        {
            ModalState.CloseActive();
        }

        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (UseQueue)
        {
            ModalState.OnChange -= StateHasChanged;
        }

        if (Visible)
        {
            try
            {
                await JS.InvokeVoidAsync("modalHelper.unlockBodyScroll");
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
