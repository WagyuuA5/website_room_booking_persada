@namespace booking_room.Components.Shared
@inject IJSRuntime JS

@if (Visible)
{
    <div class="app-modal-overlay" @onclick="HandleOverlayClick">
        <div class="app-modal-container" @onclick:stopPropagation="true" role="dialog" aria-modal="true" style="@(ComputedMaxWidth > 0 ? $"max-width: {ComputedMaxWidth}px" : "")">
            @if (ShowCloseButton)
            {
                <button class="app-modal-close" @onclick="CloseAsync" aria-label="Tutup popup">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            }

            @if (HeaderContent != null)
            {
                <div class="app-modal-header">
                    @HeaderContent
                </div>
            }
            else if (!string.IsNullOrEmpty(Title))
            {
                <div class="app-modal-header" style="display: flex; align-items: flex-start; gap: 16px;">
                    @if (IconContent != null)
                    {
                        <div class="app-modal-header-icon" style="flex-shrink: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #E0F2FE; color: #0EA5E9; border-radius: 12px;">
                            @IconContent
                        </div>
                    }
                    <div style="flex: 1; padding-top: 2px;">
                        <h2 class="app-modal-title" style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #0F1F3D;">@Title</h2>
                        @if (!string.IsNullOrEmpty(Subtitle))
                        {
                            <p class="app-modal-subtitle" style="margin: 4px 0 0 0; font-size: 0.875rem; color: #6B7280; line-height: 1.4;">@Subtitle</p>
                        }
                    </div>
                </div>
            }

            <div class="app-modal-body">
                @if (BodyContent != null)
                {
                    @BodyContent
                }
                else
                {
                    @ChildContent
                }
            </div>

            @if (FooterContent != null)
            {
                <div class="app-modal-footer">
                    @FooterContent
                </div>
            }
        </div>
    </div>
}

<style>
    /* Overlay Backdrop with fallback */
    .app-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: var(--overlay-color);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        /* Fallback for backdrop-filter is just the background color above */
        backdrop-filter: blur(var(--overlay-blur));
        -webkit-backdrop-filter: blur(var(--overlay-blur));
        
        /* Animation fade */
        animation: fadeInOverlay 0.25s ease-out forwards;
    }

    .app-modal-container {
        background-color: var(--color-surface-alt);
        border-radius: var(--radius-modal);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 480px; /* Default max-width, can be overridden */
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        
        /* Animation scale */
        animation: scaleInModal 0.25s ease-out forwards;
        transform: scale(0.95);
        opacity: 0;
    }

    @@keyframes fadeInOverlay {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes scaleInModal {
        from {
            transform: scale(0.95);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .app-modal-close {
        position: absolute;
        top: 20px;
        right: 20px;
        background: none;
        border: none;
        color: var(--color-text-secondary);
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: background-color 0.15s, color 0.15s;
        z-index: 10;
    }

    .app-modal-close:hover {
        background-color: var(--color-surface);
        color: var(--color-text-primary);
    }

    .app-modal-header {
        padding: var(--space-modal-padding) var(--space-modal-padding) 0 var(--space-modal-padding);
        flex-shrink: 0;
    }

    .app-modal-body {
        padding: var(--space-modal-padding);
        overflow-y: auto;
        flex: 1 1 auto;
    }

    /* Remove top padding from body if header is present and padded */
    .app-modal-header + .app-modal-body {
        padding-top: var(--space-section-gap);
    }

    .app-modal-footer {
        padding: var(--space-section-gap) var(--space-modal-padding) var(--space-modal-padding) var(--space-modal-padding);
        background-color: var(--color-surface-alt);
        border-top: 1px solid var(--color-border);
        flex-shrink: 0;
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? IconContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? BodyContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public bool LockBackdrop { get; set; } = false;
    [Parameter] public int MaxWidth { get; set; } = 480;
    [Parameter] public string Size { get; set; } = "md"; // Maps to MaxWidth if MaxWidth is 480
    [Parameter] public string LayoutMode { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    private int ComputedMaxWidth
    {
        get
        {
            if (MaxWidth != 480) return MaxWidth;
            return Size switch
            {
                "sm" => 400,
                "md" => 480,
                "lg" => 640,
                "xl" => 800,
                _ => 480
            };
        }
    }

    private async Task HandleOverlayClick()
    {
        if (!LockBackdrop)
        {
            await CloseAsync();
        }
    }

    private async Task CloseAsync()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var dotNetReference = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("registerEscapeKey", dotNetReference);
            }
            catch (Exception) { /* Ignored if JS not ready or missing */ }
        }
    }

    [JSInvokable]
    public async Task OnEscapePressed()
    {
        if (Visible && !LockBackdrop)
        {
            await CloseAsync();
            StateHasChanged();
        }
    }
}


