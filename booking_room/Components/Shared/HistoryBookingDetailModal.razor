@namespace booking_room.Components.Shared
@using booking_room.Components.Models
@using booking_room.Services

<AppModal Visible="@Visible" VisibleChanged="HandleVisibleChanged" Size="md" ShowHeader="true" Title="Detail Riwayat" Subtitle="Informasi pemesanan ruangan" ShowFooter="false" NoPadding="true">
    <IconContent>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
    </IconContent>
    <BodyContent>
        <div class="history-detail-modal">
            <!-- 1. Foto ruangan besar memenuhi lebar bagian atas modal & bisa diklik (V46) -->
            <div class="history-detail-photo-wrap clickable" @onclick="OpenRoomDetail" role="button" tabindex="0" title="Klik foto untuk melihat Detail Ruangan">
                <img src="@(string.IsNullOrEmpty(Booking?.PhotoUrl) ? "https://images.unsplash.com/photo-1497215842964-222b430dc094?auto=format&fit=crop&w=800&q=80" : Booking.PhotoUrl)" 
                     alt="@Booking?.RoomName" 
                     class="history-detail-photo"
                     onerror="this.src='https://images.unsplash.com/photo-1497215842964-222b430dc094?auto=format&fit=crop&w=800&q=80'" />
                <div class="history-photo-overlay">
                    <div class="history-overlay-badge">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <span>Lihat Detail Ruangan</span>
                    </div>
                </div>
            </div>

            <div class="history-detail-body">
                <!-- 3. Baris judul: Nama ruangan sejajar dengan badge status (tanpa tombol Detail Ruangan) -->
                <div class="history-detail-title-row">
                    <div>
                        <h2 class="history-detail-room-name">@Booking?.RoomName</h2>
                        <div class="history-detail-location">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span>@(string.IsNullOrEmpty(Booking?.Floor) ? "Lantai 4, Sayap Timur, Persada HQ" : Booking.Floor)</span>
                        </div>
                    </div>
                    <div class="history-title-actions">
                        <span class="history-status-pill @GetStatusBadgeClass(Booking?.Status)">
                            <div class="status-dot"></div>
                            @GetStatusLabel(Booking?.Status)
                        </span>
                    </div>
                </div>

                <!-- 5. Tiga baris info dengan background rounded -->
                <div class="history-detail-info-rows">
                    <!-- TANGGAL -->
                    <div class="info-rounded-box">
                        <div class="info-icon-circle">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                        </div>
                        <div class="info-text-col">
                            <span class="info-label-caps">TANGGAL</span>
                            <span class="info-val-bold">@(string.IsNullOrEmpty(Booking?.Date) ? "12 Mei 2024" : Booking.Date)</span>
                        </div>
                    </div>

                    <!-- WAKTU -->
                    <div class="info-rounded-box">
                        <div class="info-icon-circle">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                        <div class="info-text-col">
                            <span class="info-label-caps">WAKTU</span>
                            <span class="info-val-bold">@(string.IsNullOrEmpty(Booking?.TimeSlot) ? "09:00 - 11:30" : Booking.TimeSlot)</span>
                        </div>
                    </div>

                    <!-- PESERTA -->
                    <div class="info-rounded-box">
                        <div class="info-icon-circle">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <div class="info-text-col">
                            <span class="info-label-caps">PESERTA</span>
                            <span class="info-val-bold">@((Booking != null ? Booking.Attendees : 12)) Peserta</span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Booking?.Purpose))
                {
                    <div class="history-detail-purpose">
                        <label class="info-label-caps">TUJUAN RAPAT</label>
                        <p class="purpose-text">@Booking.Purpose</p>
                    </div>
                }
            </div>

            <!-- Footer: HANYA berisi tombol 'Tutup' full-width (SOP Riwayat V46) -->
            <div class="history-detail-footer">
                <button type="button" class="btn-outline-pill-full" @onclick="Close">
                    Tutup
                </button>
            </div>
        </div>
    </BodyContent>
</AppModal>

<!-- Stacked View-Only Room Details Modal (V46: Nested di atas Detail Riwayat) -->
<RoomDetailsModal @bind-Visible="_isRoomDetailOpen" 
                  Room="_roomForDetail" 
                  Mode="DetailRuanganMode.ViewOnly" 
                  ZIndex="100050" />

<style>
    .history-detail-modal {
        display: flex;
        flex-direction: column;
    }

    .history-detail-photo-wrap {
        width: 100%;
        height: 220px;
        position: relative;
        background: var(--color-neutral-100, #F5F5F7);
        border-top-left-radius: var(--radius-lg, 22px);
        border-top-right-radius: var(--radius-lg, 22px);
        overflow: hidden;
    }
    
    .history-detail-photo-wrap.clickable {
        cursor: pointer;
    }

    .history-detail-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .history-detail-photo-wrap.clickable:hover .history-detail-photo {
        transform: scale(1.03);
    }

    .history-photo-overlay {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 3;
    }

    .history-detail-photo-wrap.clickable:hover .history-photo-overlay {
        opacity: 1;
    }

    .history-overlay-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.95);
        color: #0F172A;
        font-size: 12.5px;
        font-weight: 700;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
        transform: translateY(4px);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .history-detail-photo-wrap.clickable:hover .history-overlay-badge {
        transform: translateY(0);
    }

    body.dark-mode .history-overlay-badge {
        background: rgba(30, 41, 59, 0.95);
        color: #F8FAFC;
    }

    .history-detail-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .history-detail-title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        flex-wrap: wrap;
    }

    .history-title-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .history-detail-room-name {
        margin: 0;
        font-size: var(--fs-h2, 22px);
        line-height: var(--lh-h2, 28px);
        font-weight: var(--fw-bold, 700);
        color: var(--color-navy, #0F172A);
    }
    body.dark-mode .history-detail-room-name { color: var(--color-white, #FFFFFF); }

    .history-status-pill {
        padding: 6px 14px;
        border-radius: var(--radius-full, 999px);
        font-size: var(--fs-xs, 12px);
        font-weight: var(--fw-semibold, 600);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }
    .badge-approved { background: rgba(52, 211, 153, 0.15); color: #059669; }
    .badge-pending { background: rgba(245, 158, 11, 0.15); color: #D97706; }
    .badge-rejected { background: rgba(239, 68, 68, 0.15); color: #DC2626; }
    .badge-completed { background: rgba(59, 130, 246, 0.15); color: #2563EB; }
    .badge-canceled { background: rgba(100, 116, 139, 0.15); color: #64748B; }

    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }

    .history-detail-location {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: var(--fs-sm, 13.5px);
        color: var(--color-neutral-600, #6E6E73);
        margin-top: 4px;
    }
    .history-detail-location svg { color: var(--color-neutral-400, #86868B); }

    /* 3 Rounded Info Boxes */
    .history-detail-info-rows {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 4px;
    }

    .info-rounded-box {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        background: #EFF6FF;
        border: 1px solid #DBEAFE;
        border-radius: var(--radius-md, 14px);
    }
    body.dark-mode .info-rounded-box {
        background: rgba(30, 58, 138, 0.25);
        border-color: rgba(59, 130, 246, 0.2);
    }

    .info-icon-circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--color-white, #FFFFFF);
        color: var(--color-neutral-600, #6E6E73);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    }
    body.dark-mode .info-icon-circle {
        background: rgba(255,255,255,0.1);
        color: #93C5FD;
    }

    .info-text-col {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .info-label-caps {
        font-size: var(--fs-xs, 11px);
        font-weight: var(--fw-semibold, 600);
        color: #3B82F6;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    body.dark-mode .info-label-caps { color: #93C5FD; }

    .info-val-bold {
        font-size: var(--fs-base, 14px);
        font-weight: var(--fw-bold, 700);
        color: var(--color-navy, #0F172A);
    }
    body.dark-mode .info-val-bold { color: var(--color-white, #FFFFFF); }

    .history-detail-purpose {
        background: var(--color-neutral-100, #F5F5F7);
        border-radius: var(--radius-sm, 8px);
        padding: 12px 16px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    body.dark-mode .history-detail-purpose { background: rgba(255,255,255,0.05); }
    .purpose-text {
        margin: 0;
        font-size: var(--fs-sm, 13.5px);
        color: var(--color-neutral-900, #1D1D1F);
        line-height: var(--lh-sm, 20px);
    }
    body.dark-mode .purpose-text { color: var(--color-white, #FFFFFF); }

    .history-detail-footer {
        padding: 16px 24px 24px 24px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .btn-outline-pill-full {
        width: 100%;
        height: 44px;
        border-radius: 999px;
        border: 1.5px solid #CBD5E1;
        background: transparent;
        color: #334155;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .btn-outline-pill-full:hover {
        background: #F1F5F9;
        border-color: #94A3B8;
        color: #0F172A;
    }
    body.dark-mode .btn-outline-pill-full {
        border-color: #334155;
        color: #CBD5E1;
    }
    body.dark-mode .btn-outline-pill-full:hover {
        background: #1E293B;
        color: #FFFFFF;
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public BookingItem? Booking { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _isRoomDetailOpen = false;
    private RoomItem? _roomForDetail;

    private void OpenRoomDetail()
    {
        if (Booking == null) return;
        var room = RoomDataProvider.GetRooms().FirstOrDefault(r => r.Name.Equals(Booking.RoomName, StringComparison.OrdinalIgnoreCase))
                   ?? RoomDataProvider.GetRooms().FirstOrDefault(r => r.Name.Contains(Booking.RoomName, StringComparison.OrdinalIgnoreCase) || Booking.RoomName.Contains(r.Name, StringComparison.OrdinalIgnoreCase))
                   ?? new RoomItem("r-history", Booking.RoomName, Booking.Capacity > 0 ? Booking.Capacity : 12, "Ruang pertemuan modern dengan konektivitas lengkap dan fasilitas pendukung prima.", "Tersedia", new List<string> { "AC", "WiFi Cepat", "Proyektor", "Smart TV" }, "4", Booking.PhotoUrl);

        _roomForDetail = room;
        _isRoomDetailOpen = true;
    }

    private string GetStatusLabel(string? status) => status?.ToLowerInvariant() switch
    {
        "approved" => "Disetujui",
        "pending" => "Menunggu Persetujuan",
        "rejected" => "Ditolak",
        "completed" => "Selesai",
        "canceled" => "Dibatalkan",
        _ => status ?? "Disetujui"
    };

    private string GetStatusBadgeClass(string? status) => status?.ToLowerInvariant() switch
    {
        "approved" => "badge-approved",
        "pending" => "badge-pending",
        "rejected" => "badge-rejected",
        "completed" => "badge-completed",
        "canceled" => "badge-canceled",
        _ => "badge-approved"
    };

    private async Task HandleVisibleChanged(bool val)
    {
        Visible = val;
        if (VisibleChanged.HasDelegate)
        {
            await VisibleChanged.InvokeAsync(val);
        }
    }

    private async Task Close()
    {
        await HandleVisibleChanged(false);
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
