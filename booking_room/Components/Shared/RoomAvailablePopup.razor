@using booking_room.Components.Models
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="modal-header-custom">
    <div class="modal-header-left">
        <div class="modal-header-icon icon-green">
            <svg width="20" height="20" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 18V16H2V0H12V1H16V16H18V18H14V3H12V18H0ZM4 2V16V2ZM8 10C8.28333 10 8.52083 9.90417 8.7125 9.7125C8.90417 9.52083 9 9.28333 9 9C9 8.71667 8.90417 8.47917 8.7125 8.2875C8.52083 8.09583 8.28333 8 8 8C7.71667 8 7.47917 8.09583 7.2875 8.2875C7.09583 8.47917 7 8.71667 7 9C7 9.28333 7.09583 9.52083 7.2875 9.7125C7.47917 9.90417 7.71667 10 8 10ZM4 16H10V2H4V16Z" fill="#059669"/>
            </svg>
        </div>
        <div class="modal-header-info">
            <h3>Ruangan Tersedia</h3>
            <p>Pilih ruangan untuk rapat Anda berikutnya.</p>
        </div>
    </div>
</div>

<div class="modal-body-custom">
    @if (_isLoading)
    {
        <div class="skeleton-grid" style="grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
            @for (int i = 0; i < 2; i++)
            {
                <div class="skeleton-card" style="padding: 0.75rem;">
                    <div class="skeleton-shimmer skeleton-image" style="height: 100px; margin-bottom: 8px;"></div>
                    <div class="skeleton-shimmer skeleton-title"></div>
                    <div class="skeleton-shimmer skeleton-text short"></div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Filter pills -->
        <div class="avail-filter-row">
            <button class="avail-filter-pill pill-navy @(selectedDate == "Hari Ini" ? "active" : "")" @onclick='() => selectedDate = "Hari Ini"'>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                Hari Ini
            </button>
            <button class="avail-filter-pill pill-amber @(capacityFilter == 0 ? "active" : "")" @onclick="ToggleCapacity">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="17" cy="11" r="3" stroke="currentColor" stroke-width="2"/><path d="M23 21v-1a3 3 0 0 0-3-3h-1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                @(capacityFilter == 0 ? "Semua Kapasitas" : $"Min {capacityFilter} tempat")
            </button>
        </div>

        <!-- Grid ruangan 2 kolom -->
        <div class="avail-room-grid">
            @foreach (var room in DisplayRooms)
            {
                <div class="avail-room-card" @onclick="() => BookRoom(room)">
                    <div class="avail-room-photo @(room.HasPhoto ? "" : "avail-room-placeholder")">
                        @if (room.HasPhoto)
                        {
                            <img src="@room.PhotoUrl" alt="@room.DisplayName" />
                        }
                        else
                        {
                            <svg width="32" height="32" viewBox="0 0 18 18" fill="none"><path d="M0 18V16H2V0H12V1H16V16H18V18H14V3H12V18H0ZM4 2V16V2ZM8 10C8.28 10 8.52 9.9 8.71 9.71C8.9 9.52 9 9.28 9 9C9 8.72 8.9 8.48 8.71 8.29C8.52 8.1 8.28 8 8 8C7.72 8 7.48 8.1 7.29 8.29C7.1 8.48 7 8.72 7 9C7 9.28 7.1 9.52 7.29 9.71C7.48 9.9 7.72 10 8 10ZM4 16H10V2H4V16Z" fill="#93c5fd"/></svg>
                        }
                        @if (room.IsPremium)
                        {
                            <span class="avail-badge-premium">★ Premium</span>
                        }
                    </div>
                    <div class="avail-room-info">
                        <div class="avail-room-name">@room.DisplayName</div>
                        <div class="avail-room-meta">@room.Seats Tempat · @room.Feature</div>
                        <span class="avail-status-badge @room.StatusClass">@room.StatusLabel</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal-footer-custom" style="justify-content: flex-end;">
    <button class="popup-footer-btn btn-close-gray" @onclick="Close">Tutup</button>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string selectedDate = "Hari Ini";
    private int capacityFilter = 0;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(250);
        _isLoading = false;
    }

    private record RoomCard(string DisplayName, int Seats, string Feature, bool IsAvailableNow, string AvailableAt, bool IsPremium, bool HasPhoto, string PhotoUrl, string StatusClass, string StatusLabel);

    private List<RoomCard> allCards = new()
    {
        new("Executive Suite A", 12, "Video", true, "", true, false, "", "status-available", "Tersedia Sekarang"),
        new("Huddle Ruangan 4", 4, "Display", false, "14:00", false, false, "", "status-pending", "Tersedia: 14:00"),
        new("Workshop Space B", 24, "24 Tempat", false, "15:30", false, false, "", "status-pending", "Tersedia: 15:30"),
    };

    private IEnumerable<RoomCard> DisplayRooms => capacityFilter == 0
        ? allCards
        : allCards.Where(r => r.Seats >= capacityFilter);

    private void ToggleCapacity()
    {
        capacityFilter = capacityFilter switch { 0 => 4, 4 => 12, 12 => 24, _ => 0 };
    }

    private async Task BookRoom(RoomCard room)
    {
        await OnClose.InvokeAsync();
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
