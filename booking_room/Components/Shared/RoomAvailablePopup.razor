@using booking_room.Components.Models

<div class="modal-header-custom">
    <div class="modal-header-left">
        <div class="modal-header-icon icon-green">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 2H9C7.9 2 7 2.9 7 4V7H5C3.9 7 3 7.9 3 9V20C3 21.1 3.9 22 5 22H15C16.1 22 17 21.1 17 20V17H19C20.1 17 21 16.1 21 15V4C21 2.9 20.1 2 19 2ZM15 20H5V9H15V20ZM19 15H17V9C17 7.9 16.1 7 15 7H9V4H19V15Z" fill="#059669"/>
                <circle cx="10" cy="14" r="1.5" fill="#059669"/>
            </svg>
        </div>
        <div class="modal-header-info">
            <h3>Ruangan Tersedia</h3>
            <p>@availableCount tersedia dari @totalCount total ruangan</p>
        </div>
    </div>
    <button class="modal-close-btn" @onclick="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>
</div>

<div class="modal-body-custom">
    <!-- Statistics -->
    <div class="popup-stats-row">
        <div class="popup-stat-card stat-green">
            <div class="popup-stat-value">@availableCount</div>
            <div class="popup-stat-label">Tersedia</div>
        </div>
        <div class="popup-stat-card stat-red">
            <div class="popup-stat-value">@occupiedCount</div>
            <div class="popup-stat-label">Digunakan</div>
        </div>
        <div class="popup-stat-card stat-gray">
            <div class="popup-stat-value">@maintenanceCount</div>
            <div class="popup-stat-label">Maintenance</div>
        </div>
    </div>

    <!-- Filter tabs -->
    <div class="popup-filter-tabs">
        <button class="popup-filter-tab @(activeFilter == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>Semua</button>
        <button class="popup-filter-tab @(activeFilter == "available" ? "active" : "")" @onclick='() => SetFilter("available")'>Tersedia</button>
        <button class="popup-filter-tab @(activeFilter == "occupied" ? "active" : "")" @onclick='() => SetFilter("occupied")'>Digunakan</button>
        <button class="popup-filter-tab @(activeFilter == "maintenance" ? "active" : "")" @onclick='() => SetFilter("maintenance")'>Maintenance</button>
    </div>

    <!-- Room list -->
    <div class="popup-scroll-area">
        <div class="popup-room-list">
            @foreach (var room in filteredRooms)
            {
                <div class="popup-room-item">
                    <div class="popup-room-status @room.StatusClass"></div>
                    <div class="popup-room-details">
                        <div class="popup-room-name">@room.RoomName</div>
                        <div class="popup-room-meta">@room.Floor • @room.Facilities</div>
                    </div>
                    <div class="popup-room-capacity">@room.Capacity orang</div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string activeFilter = "all";
    private List<RoomDetail> allRooms = DashboardData.AllRooms;

    private int availableCount => allRooms.Count(r => r.StatusClass == "available");
    private int occupiedCount => allRooms.Count(r => r.StatusClass == "occupied");
    private int maintenanceCount => allRooms.Count(r => r.StatusClass == "maintenance");
    private int totalCount => allRooms.Count;

    private IEnumerable<RoomDetail> filteredRooms => activeFilter switch
    {
        "available" => allRooms.Where(r => r.StatusClass == "available"),
        "occupied" => allRooms.Where(r => r.StatusClass == "occupied"),
        "maintenance" => allRooms.Where(r => r.StatusClass == "maintenance"),
        _ => allRooms
    };

    private void SetFilter(string filter)
    {
        activeFilter = filter;
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
