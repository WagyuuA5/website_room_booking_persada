@using booking_room.Components.Models
@using System.Globalization

<!-- Date Strip -->
<div class="cal-date-strip">
    <button class="cal-nav-btn" @onclick="PrevWeek">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    @foreach (var day in _visibleDates)
    {
        var isSelected = day.Date == _selectedDate.Date;
        var isToday = day.Date == DateTime.Today;
        <button class="cal-date-item @(isSelected ? "selected" : "") @(isToday ? "today" : "")"
                @onclick="() => SelectDate(day)">
            <span class="cal-day-label">@day.ToString("ddd", new CultureInfo("id-ID")).ToUpper()</span>
            <span class="cal-day-number">@day.Day</span>
        </button>
    }
    <button class="cal-nav-btn" @onclick="NextWeek">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
</div>

<div class="cal-month-label">
    @_selectedDate.ToString("MMMM yyyy", new CultureInfo("id-ID"))
</div>

<!-- Hourly Grid -->
<div class="cal-grid-wrapper">
    <div class="cal-grid">
        <!-- Header Row -->
        <div class="cal-grid-header">
            <div class="cal-grid-room-col">Ruangan</div>
            @for (int h = 7; h <= 18; h++)
            {
                <div class="cal-grid-hour-col">@($"{h:D2}:00")</div>
            }
        </div>

        <!-- Baris Ruangan -->
        @foreach (var room in Rooms)
        {
            var bookings = GetBookingsForRoom(room.Id);
            <div class="cal-grid-row">
                <div class="cal-grid-room-cell" @onclick="() => OnRoomClick.InvokeAsync(room)" style="cursor: pointer;">
                    <span class="cal-room-name">@room.Name</span>
                    <span class="cal-room-floor">@room.Floor · @room.Capacity orang</span>
                </div>
                <div class="cal-grid-time-area">
                    @for (int h = 7; h <= 18; h++)
                    {
                        <div class="cal-grid-hour-bg"></div>
                    }
                    @foreach (var booking in bookings)
                    {
                        var leftPercent = ((booking.StartHour - 7) / 12.0) * 100;
                        var widthPercent = ((booking.EndHour - booking.StartHour) / 12.0) * 100;
                        var blockClass = booking.Status switch
                        {
                            "booked" => "cal-booking-block booking-booked",
                            "mine" => "cal-booking-block booking-mine",
                            _ => "cal-booking-block booking-free"
                        };
                        <div class="@blockClass" style="left: @leftPercent.ToString("0.###", CultureInfo.InvariantCulture)%; width: @widthPercent.ToString("0.###", CultureInfo.InvariantCulture)%;">
                            <span class="cal-booking-label">@booking.Label</span>
                            <span class="cal-booking-time">@booking.TimeRange</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Legend -->
<div class="cal-legend">
    <div class="cal-legend-item"><span class="cal-legend-dot slot-free"></span> Tersedia</div>
    <div class="cal-legend-item"><span class="cal-legend-dot slot-booked"></span> Dipesan</div>
    <div class="cal-legend-item"><span class="cal-legend-dot slot-mine"></span> Milik Saya</div>
</div>

<style>
