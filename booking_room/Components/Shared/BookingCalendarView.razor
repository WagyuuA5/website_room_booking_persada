        display: flex;
        align-items: center;
        gap: 6px;
        justify-content: center;
        padding: 0 0 12px 0;
    }
    .cal-nav-btn {
        background: white;
        border: 1px solid #E2E8F0;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #64748B;
        transition: all 0.2s;
        flex-shrink: 0;
    }
    .cal-nav-btn:hover {
        background: #F1F5F9;
        color: #1E293B;
    }
    .cal-date-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 8px 14px;
        border-radius: 14px;
        border: 1px solid transparent;
        background: transparent;
        cursor: pointer;
        transition: all 0.2s;
        min-width: 52px;
    }
    .cal-date-item:hover {
        background: #F1F5F9;
    }
    .cal-date-item.selected {
        background: var(--persada-navy-900, #16305C);
        color: white;
        border-color: var(--persada-navy-900, #16305C);
    }
    .cal-date-item.selected .cal-day-label,
    .cal-date-item.selected .cal-day-number {
        color: white;
    }
    .cal-date-item.today:not(.selected) {
        border-color: var(--persada-yellow-500, #EAB63C);
    }
    .cal-day-label {
        font-size: 0.65rem;
        font-weight: 700;
        color: #94A3B8;
        letter-spacing: 0.05em;
    }
    .cal-day-number {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1E293B;
    }
    .cal-month-label {
        text-align: center;
        font-size: 0.85rem;
        font-weight: 600;
        color: #64748B;
        margin-bottom: 16px;
        text-transform: capitalize;
    }

    .cal-grid-wrapper {
        overflow-x: auto;
        border: 1px solid #E2E8F0;
        border-radius: 16px;
        background: white;
    }
    .cal-grid {
        min-width: 900px;
    }
    .cal-grid-header {
        display: grid;
        grid-template-columns: 200px repeat(12, 1fr);
        background: #F8FAFC;
        border-bottom: 1px solid #E2E8F0;
    }
    .cal-grid-room-col {
        padding: 12px 16px;
        font-size: 0.75rem;
        font-weight: 700;
        color: #94A3B8;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    .cal-grid-hour-col {
        padding: 12px 8px;
        text-align: center;
        font-size: 0.7rem;
        font-weight: 600;
        color: #94A3B8;
    }
    .cal-grid-row {
        display: grid;
        grid-template-columns: 200px repeat(12, 1fr);
        border-bottom: 1px solid #F1F5F9;
        transition: background 0.15s;
        min-height: 56px;
    }
    .cal-grid-row:last-child {
        border-bottom: none;
    }
    .cal-grid-row:hover {
        background: #FAFBFC;
    }
    .cal-grid-room-cell {
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        border-right: 1px solid #E2E8F0;
        justify-content: center;
    }
    .cal-room-name {
        font-size: 0.8rem;
        font-weight: 700;
        color: #1E293B;
    }
    .cal-room-floor {
        font-size: 0.7rem;
        color: #94A3B8;
    }
    .cal-grid-time-area {
        grid-column: 2 / span 12;
        position: relative;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
    }
    .cal-grid-hour-bg {
        border-right: 1px solid #F1F5F9;
        border-bottom: 1px solid #F1F5F9;
        min-height: 56px;
    }
    .cal-grid-time-area:hover .cal-grid-hour-bg {
        background: rgba(241, 245, 249, 0.3);
    }
    .cal-booking-block {
        position: absolute;
        top: 6px;
        bottom: 6px;
        border-radius: 8px;
        padding: 6px 10px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 2px;
        overflow: hidden;
        z-index: 2;
        transition: transform 0.15s, box-shadow 0.15s;
    }
    .cal-booking-block:hover {
