@code {
    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public RoomItem? Room { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private string _bookerName = "Anggoro Ravi";
    private string _division = "Teknologi Informasi";
    
    private DateTime _selectedDate = DateTime.Today;
    private DateTime _startTime = DateTime.Today.AddHours(9);
    private DateTime _endTime = DateTime.Today.AddHours(10);
    
    private bool _isRecurring = false;
    private string _recurPattern = "daily"; // daily, weekly, monthly
    private bool[] _selectedDays = new bool[7];
    private string[] DayInitials = { "S", "S", "R", "K", "J", "S", "M" };
    private int _recurEndCount = 4;
    private DateTime _recurEndDate = DateTime.Today.AddMonths(1);
    
    private List<string> _participants = new List<string> { "Budi Santoso", "Siti Rahayu" };
    private string _newParticipant = "";
    
    private bool _isExternalGuest = false;
    private string _externalEmail = "";
    
    private string _notes = "";

    private HashSet<int> _skippedDates = new HashSet<int>();

    protected override void OnInitialized()
    {
        // Default select current day for weekly
        int dayIndex = (int)_selectedDate.DayOfWeek - 1;
        if (dayIndex < 0) dayIndex = 6; // Sunday
        _selectedDays[dayIndex] = true;
    }

    private async Task HandleVisibleChanged(bool value)
    {
        Visible = value;
        await VisibleChanged.InvokeAsync(value);
    }

    private async Task Back()
    {
        await OnBack.InvokeAsync();
    }

    private async Task Confirm()
    {
        await OnConfirm.InvokeAsync();
    }

    private void SetPattern(string pattern)
    {
        _recurPattern = pattern;
    }

    private void ToggleDay(int index)
    {
        _selectedDays[index] = !_selectedDays[index];
    }

    private void SkipDate(int index)
    {
        _skippedDates.Add(index);
    }

    private void AddParticipant()
    {
        if (!string.IsNullOrWhiteSpace(_newParticipant) && !_participants.Contains(_newParticipant.Trim()))
        {
            _participants.Add(_newParticipant.Trim());
            _newParticipant = "";
        }
    }

    private void RemoveParticipant(string name)
    {
        _participants.Remove(name);
    }

    private List<DateTime> GenerateRecurringDates()
    {
        var dates = new List<DateTime>();
        var currentDate = _selectedDate;
        int count = 0;

        // Simple mock generator for preview purposes
        while (count < _recurEndCount && currentDate <= _recurEndDate && dates.Count < 30) // cap to 30 for safety
        {
            if (_recurPattern == "daily")
            {
                dates.Add(currentDate);
                currentDate = currentDate.AddDays(1);
                count++;
            }
            else if (_recurPattern == "weekly")
            {
                int dayIdx = (int)currentDate.DayOfWeek - 1;
                if (dayIdx < 0) dayIdx = 6;
                
                if (_selectedDays[dayIdx])
                {
                    dates.Add(currentDate);
                    count++;
                }
                currentDate = currentDate.AddDays(1);
            }
            else if (_recurPattern == "monthly")
            {
                dates.Add(currentDate);
                currentDate = currentDate.AddMonths(1);
                count++;
            }
        }

        return dates;
    }
}
