@using booking_room.Components.Models
@using booking_room.Services
@inject IToastService ToastService
@inject IModalService ModalService

<AppModal Visible="true" Size="md" ShowCloseButton="false" OnClose="HandleBack">
    <HeaderContent>
        <div class="cbm-header-content">
            <h2 class="modal-title">Konfirmasi Pemesanan</h2>
            <p class="modal-subtitle">Jadwalkan ruangan atau sumber daya baru</p>
        </div>
    </HeaderContent>

    <ChildContent>
        <div class="cbm-form">
            <div class="cbm-form-group">
                <label>Nama Pemesan</label>
                <input type="text" class="cbm-input" @bind="_requesterName" placeholder="Masukkan nama pemesan" />
            </div>

            <div class="cbm-form-group">
                <label>Divisi</label>
                <input type="text" class="cbm-input" @bind="_department" placeholder="Masukkan divisi Anda" />
            </div>

            <div class="cbm-form-row">
                <div class="cbm-form-group">
                    <label>Pilih Ruangan</label>
                    <div class="cbm-room-selector">
                        <span>@(Room?.Name ?? "Pilih Ruangan")</span>
                        <div class="rd-status-badge @(Room?.Status == "available" ? "rd-badge-available" : "rd-badge-booked")">
                            @(Room?.Status == "available" ? "TERSEDIA" : "SUDAH DIPESAN")
                        </div>
                    </div>
                </div>
                
                <div class="cbm-form-group">
                    <label>Kapasitas</label>
                    <div class="cbm-readonly-val">Kapasitas: @(Room?.Capacity ?? 0) Orang</div>
                </div>
            </div>

            <div class="cbm-form-row">
                <div class="cbm-form-group">
                    <label>Tanggal</label>
                    <input type="date" class="cbm-input" @bind="_bookingDate" />
                </div>
                <div class="cbm-form-group">
                    <label>Waktu</label>
                    <div class="cbm-time-row">
                        <input type="time" class="cbm-input" @bind="_startTime" />
                        <span>-</span>
                        <input type="time" class="cbm-input" @bind="_endTime" />
                    </div>
                </div>
            </div>

            <div class="cbm-form-group">
                <label>Undang Peserta</label>
                <input type="text" class="cbm-input" placeholder="Undang rekan kerja..." />
            </div>

            <div class="cbm-toggle-row">
                <div class="cbm-toggle-label">Undang tamu eksternal</div>
                <label class="cbm-switch">
                    <input type="checkbox" @bind="_inviteExternal" />
                    <span class="cbm-slider"></span>
                </label>
            </div>
            
            @if (_inviteExternal)
            {
                <div class="cbm-sub-panel">
                    <div class="cbm-form-group" style="margin:0;">
                        <input type="email" class="cbm-input" placeholder="Email Tamu (cth: tamu@perusahaan.com)" />
                    </div>
                </div>
            }

            <div class="cbm-toggle-row">
                <div class="cbm-toggle-label">Booking Berulang</div>
                <label class="cbm-switch">
                    <input type="checkbox" @bind="IsRecurring" />
                    <span class="cbm-slider"></span>
                </label>
            </div>

            @if (IsRecurring)
            {
                <div class="cbm-sub-panel recurring-panel">
                    <div class="cbm-form-row">
                        <div class="cbm-form-group">
                            <label>Ulangi setiap</label>
                            <select class="cbm-input" @bind="RecurringType">
                                <option value="">Pilih...</option>
                                <option value="Harian">Harian</option>
                                <option value="Mingguan">Mingguan</option>
                                <option value="Bulanan">Bulanan</option>
                            </select>
                        </div>
                        <div class="cbm-form-group">
                            <label>Berakhir pada</label>
                            <input type="date" class="cbm-input" @bind="RecurringEndDate" />
                        </div>
                    </div>
                    
                    @if (RecurringType == "Mingguan")
                    {
                        <div class="cbm-form-group" style="margin-top: 12px;">
                            <label>Pilih Hari</label>
                            <div class="cbm-days-row">
                                @foreach (var day in new[] { "Sen", "Sel", "Rab", "Kam", "Jum", "Sab", "Min" })
                                {
                                    <div class="cbm-day-pill @(SelectedDays.Contains(day) ? "active" : "")" 
                                         @onclick="() => ToggleDay(day)">
                                        @day
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="cbm-recurring-summary">
                        @GetRecurringSummary()
                    </div>
                    
                    @if (_showRecurringValidation)
                    {
                        <div class="cbm-validation-msg">Mohon lengkapi jenis pengulangan dan tanggal berakhir.</div>
                    }
                </div>
            }

            <div class="cbm-form-group" style="margin-top: 8px;">
                <label>Catatan / Permintaan Khusus</label>
                <textarea class="cbm-input" rows="2" placeholder="Kebutuhan peralatan, katering, dll."></textarea>
            </div>
        </div>
    </ChildContent>

    <FooterContent>
        <button class="btn-secondary-app" @onclick="HandleBack" disabled="@_isSubmitting">
            Batal
        </button>
        <button class="btn-primary-app" @onclick="HandleConfirm" disabled="@_isSubmitting">
            @if (_isSubmitting)
            {
                <svg class="spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="2" x2="12" y2="6"></line>
                    <line x1="12" y1="18" x2="12" y2="22"></line>
                    <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
                    <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
                    <line x1="2" y1="12" x2="6" y2="12"></line>
                    <line x1="18" y1="12" x2="22" y2="12"></line>
                    <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line>
                    <line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
                </svg>
                <span>Memproses...</span>
            }
            else
            {
                <span>Konfirmasi Pemesanan</span>
            }
        </button>
    </FooterContent>
</AppModal>

<style>
    .cbm-header-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .modal-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-card-dark, #0B1A3D);
        margin: 0;
    }
    .modal-subtitle {
        font-size: 0.875rem;
        color: var(--color-text-muted, #64748B);
        margin: 0;
    }
    
    .cbm-form {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .cbm-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .cbm-form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .cbm-form-group label {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--color-card-dark, #0B1A3D);
    }

    .cbm-input {
        padding: 10px 12px;
        border: 1px solid var(--divider-subtle, #E2E8F0);
        border-radius: 8px;
        font-size: 0.875rem;
        color: var(--color-card-dark, #0B1A3D);
        background: #FFFFFF;
        font-family: inherit;
    }
    
    .cbm-input:focus {
        outline: none;
        border-color: var(--color-brand-blue, #1F5D9A);
    }

    .cbm-room-selector {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 12px;
        background: #F8FAFC;
        border: 1px solid var(--divider-subtle, #E2E8F0);
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-card-dark, #0B1A3D);
    }

    .rd-status-badge {
        font-size: 0.625rem;
        padding: 4px 8px;
        border-radius: 999px;
        font-weight: 700;
    }
    .rd-badge-available {
        background: rgba(16, 185, 129, 0.1);
        color: #1AA262;
    }
    .rd-badge-booked {
        background: rgba(229, 72, 77, 0.1);
        color: #E5484D;
    }

    .cbm-readonly-val {
        padding: 10px 12px;
        background: #F8FAFC;
        border: 1px solid var(--divider-subtle, #E2E8F0);
        border-radius: 8px;
        font-size: 0.875rem;
        color: var(--color-text-muted, #64748B);
    }

    .cbm-time-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cbm-toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 8px;
    }

    .cbm-toggle-label {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-card-dark, #0B1A3D);
    }

    /* Switch toggle css */
    .cbm-switch {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
    }
    .cbm-switch input { 
        opacity: 0;
        width: 0;
        height: 0;
    }
    .cbm-slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: #CBD5E1;
        transition: .3s;
        border-radius: 24px;
    }
    .cbm-slider:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: .3s;
        border-radius: 50%;
    }
    input:checked + .cbm-slider {
        background-color: var(--color-brand-gold-500, #F5B301);
    }
    input:checked + .cbm-slider:before {
        transform: translateX(20px);
    }

    .cbm-sub-panel {
        background: #F8FAFC;
        border-radius: 8px;
        padding: 16px;
        margin-top: -4px;
        border: 1px solid #E2E8F0;
        animation: slideDown 0.3s ease;
    }

    @@keyframes slideDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .cbm-days-row {
        display: flex;
        gap: 6px;
    }
    
    .cbm-day-pill {
        flex: 1;
        text-align: center;
        padding: 6px 0;
        font-size: 0.75rem;
        font-weight: 600;
        background: #FFFFFF;
        border: 1px solid #CBD5E1;
        border-radius: 999px;
        cursor: pointer;
        color: var(--color-text-muted, #64748B);
        transition: all 0.2s ease;
    }
    
    .cbm-day-pill.active {
        background: var(--color-brand-blue, #1F5D9A);
        color: #FFFFFF;
        border-color: var(--color-brand-blue, #1F5D9A);
    }

    .cbm-recurring-summary {
        margin-top: 12px;
        font-size: 0.75rem;
        color: var(--color-text-muted, #64748B);
        font-style: italic;
    }

    .cbm-validation-msg {
        margin-top: 8px;
        font-size: 0.75rem;
        color: var(--color-danger, #EF4444);
        font-weight: 500;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 16px 24px;
        border-top: 1px solid var(--divider-subtle, rgba(15, 23, 42, 0.08));
        background: var(--surface-card, #FFFFFF);
    }

    .btn-cancel, .btn-confirm {
        padding: 10px 20px;
        border-radius: var(--radius-pill, 999px);
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
    }

    .btn-cancel {
        background: transparent;
        color: var(--color-text-muted, #64748B);
        border: 1px solid #CBD5E1;
    }

    .btn-cancel:hover:not(:disabled) {
        background: #F1F5F9;
        color: var(--color-card-dark, #0B1A3D);
    }

    .btn-confirm {
        background: var(--color-brand-gold-500, #FBBF24);
        color: var(--color-card-dark, #0B1A3D);
    }

    .btn-confirm:hover:not(:disabled) {
        background: var(--color-brand-gold-600, #F59E0B);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(245, 179, 1, 0.2);
    }

    .btn-cancel:disabled, .btn-confirm:disabled {
        opacity: 0.65;
        cursor: not-allowed;
    }

    .spinner {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        100% {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    [Parameter] public RoomItem? Room { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private bool _isSubmitting = false;
    private string _requesterName = "";
    private string _department = "";
    private DateTime _bookingDate = DateTime.Now;
    private TimeOnly _startTime = new TimeOnly(10, 0);
    private TimeOnly _endTime = new TimeOnly(11, 0);
    
    private bool _inviteExternal = false;

    // Recurring Booking Fields
    private bool _isRecurring = false;
    private bool IsRecurring
    {
        get => _isRecurring;
        set
        {
            _isRecurring = value;
            if (!value)
            {
                RecurringType = "";
                SelectedDays.Clear();
                RecurringEndDate = null;
                _showRecurringValidation = false;
            }
        }
    }

    private string _recurringType = "";
    private string RecurringType
    {
        get => _recurringType;
        set
        {
            _recurringType = value;
            _showRecurringValidation = false;
        }
    }

    private DateTime? _recurringEndDate;
    private DateTime? RecurringEndDate
    {
        get => _recurringEndDate;
        set
        {
            _recurringEndDate = value;
            _showRecurringValidation = false;
        }
    }

    private HashSet<string> SelectedDays = new HashSet<string>();
    private bool _showRecurringValidation = false;

    private void ToggleDay(string day)
    {
        if (SelectedDays.Contains(day))
        {
            SelectedDays.Remove(day);
        }
        else
        {
            SelectedDays.Add(day);
        }
    }

    private string GetRecurringSummary()
    {
        if (string.IsNullOrEmpty(RecurringType))
            return "Pilih jenis pengulangan.";
            
        string untilStr = RecurringEndDate.HasValue ? $"sampai dengan {RecurringEndDate.Value.ToString("dd MMM yyyy")}" : "tanpa batas waktu akhir";

        if (RecurringType == "Harian")
            return $"Akan berulang setiap hari, {untilStr}.";
            
        if (RecurringType == "Mingguan")
        {
            if (SelectedDays.Count == 0) return $"Akan berulang setiap minggu (pilih hari), {untilStr}.";
            var daysStr = string.Join(" & ", SelectedDays);
            return $"Akan berulang setiap {daysStr}, {untilStr}.";
        }
        
        if (RecurringType == "Bulanan")
            return $"Akan berulang setiap bulan pada tanggal yang sama, {untilStr}.";

        return "";
    }

    private async Task HandleBack()
    {
        if (!_isSubmitting)
        {
            await OnBack.InvokeAsync();
        }
    }

    private async Task HandleConfirm()
    {
        if (_isSubmitting) return;

        if (IsRecurring)
        {
            if (string.IsNullOrEmpty(RecurringType) || !RecurringEndDate.HasValue)
            {
                _showRecurringValidation = true;
                return;
            }
        }

        _isSubmitting = true;
        StateHasChanged();

        // Simulasi proses API
        await Task.Delay(1500);

        _isSubmitting = false;
        
        ToastService.Success("Pemesanan Berhasil", "Ruangan berhasil dipesan.");
        
        await OnConfirm.InvokeAsync();
    }
}


