@code {
    private CancellationTokenSource? _cts;
    private bool _disposed;
    [Parameter] public RoomItem? Room { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private RoomItem? SelectedRoom;
    private readonly List<RoomItem> _availableRoomOptions = new()
    {
        new("1", "Executive Boardroom A", 15, "Ruang rapat eksekutif premium.", "available", new() { "TV LED", "WiFi", "Proyektor" }, "Lantai 3"),
        new("2", "Training Room B", 30, "Ruang pelatihan interaktif.", "available", new() { "Audio", "Papan Tulis", "WiFi" }, "Lantai 2"),
        new("3", "Innovation Lab", 15, "Lab inovasi & prototyping.", "available", new() { "Smart Display", "3D Printer" }, "Lantai 3"),
        new("4", "Conference Hall", 50, "Aula konferensi kapasitas besar.", "available", new() { "Panggung", "Full AV", "WiFi" }, "Lantai 1"),
        new("5", "Huddle Space C", 6, "Ruang kolaborasi tim ringkas.", "booked", new() { "Monitor", "WiFi" }, "Lantai 1"),
        new("6", "Focus Room Alpha", 4, "Ruang fokus tenang 1-on-1.", "available", new() { "Papan Tulis", "WiFi" }, "Lantai 3")
    };

    private bool _isSubmitting = false;
    private string _requesterName = "Budi Santoso";
    private string _department = "IT / Engineering";
    private DateTime _bookingDate = DateTime.Now.AddDays(1);
    private TimeOnly _startTime = new TimeOnly(9, 0);
    private TimeOnly _endTime = new TimeOnly(11, 0);
    private string _notes = "";

    // CASE 3: Attendees & External Guests
    public record ColleagueItem(string Name, string AvatarBg, bool HasConflict);
    private List<ColleagueItem> _colleagues = new()
    {
        new ColleagueItem("Budi Santoso (Anda)", "#1F5D9A", false),
        new ColleagueItem("Siti Rahayu", "#10B981", false),
        new ColleagueItem("Ahmad Fauzi", "#F59E0B", true),
        new ColleagueItem("Dewi Lestari", "#8B5CF6", false),
        new ColleagueItem("Rian Hidayat", "#EC4899", false)
    };

    private readonly List<ColleagueItem> _suggestedColleagues = new()
    {
        new ColleagueItem("Maya Putri", "#06B6D4", false),
        new ColleagueItem("Hendra Wijaya", "#6366F1", true),
        new ColleagueItem("Agus Susanto", "#84CC16", false),
        new ColleagueItem("Fitri Handayani", "#F43F5E", false),
        new ColleagueItem("Dimas Pratama", "#D97706", false)
    };

    private string _newAttendeeInput = "";
    private bool _inviteExternal = false;
    private string _newExternalEmail = "";
    private List<string> _externalGuests = new();

    private int CurrentMaxCapacity => SelectedRoom?.Capacity ?? Room?.Capacity ?? 15;
    private int TotalAttendeesCount => _colleagues.Count + _externalGuests.Count;
    private double CapacityPercentage => Math.Min(100, Math.Round(((double)TotalAttendeesCount / Math.Max(1, CurrentMaxCapacity)) * 100));
    private bool IsOverCapacity => TotalAttendeesCount > CurrentMaxCapacity;

    // Recurring Booking Fields
    private bool _isRecurring = false;
    private bool IsRecurring
    {
        get => _isRecurring;
        set
        {
            _isRecurring = value;
            if (value)
            {
                if (string.IsNullOrEmpty(RecurringType)) RecurringType = "Mingguan";
                if (SelectedDays.Count == 0) SelectedDays.Add("S");
                UpdateSchedulePreview();
            }
        }
    }

    private string RecurringType = "Mingguan";
    private int _recurrenceCount = 4;
    private DateTime? RecurringEndDate;
    private HashSet<string> SelectedDays = new HashSet<string> { "S" };

    private record DayInfo(string Initial, string ShortName, string FullName);
    private readonly DayInfo[] _indonesianDays = new[]
    {
        new DayInfo("S", "Sen", "Senin"),
        new DayInfo("S", "Sel", "Selasa"),
        new DayInfo("R", "Rab", "Rabu"),
        new DayInfo("K", "Kam", "Kamis"),
        new DayInfo("J", "Jum", "Jumat"),
        new DayInfo("S", "Sab", "Sabtu"),
        new DayInfo("M", "Min", "Minggu")
    };

    private record SchedulePreviewItem(DateTime Date, string DateFormatted, bool IsConflict);
    private List<SchedulePreviewItem> _previewDates = new();

    protected override void OnInitialized()
    {
        SelectedRoom = Room;
        UpdateSchedulePreview();
    }

    private void SelectRoom(RoomItem r)
    {
        SelectedRoom = r;
        StateHasChanged();
    }

    private void AddAttendee()
    {
        if (string.IsNullOrWhiteSpace(_newAttendeeInput)) return;
        var name = _newAttendeeInput.Trim();
        if (!_colleagues.Any(c => c.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            var colors = new[] { "#3B82F6", "#10B981", "#8B5CF6", "#F59E0B", "#EC4899", "#06B6D4" };
            var color = colors[Math.Abs(name.GetHashCode()) % colors.Length];
            bool hasConflict = (_colleagues.Count % 3 == 0);
            _colleagues.Add(new ColleagueItem(name, color, hasConflict));
            _newAttendeeInput = "";
        }
    }

    private void AddQuickAttendee(ColleagueItem item)
    {
        if (!_colleagues.Any(c => c.Name == item.Name))
        {
            _colleagues.Add(item);
        }
    }

    private void HandleAttendeeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddAttendee();
        }
    }

    private void RemoveAttendee(ColleagueItem item)
    {
        if (_colleagues.Count > 1)
        {
            _colleagues.Remove(item);
        }
    }

    private void AddExternalGuest()
    {
        if (string.IsNullOrWhiteSpace(_newExternalEmail)) return;
        var email = _newExternalEmail.Trim();
        if (!_externalGuests.Contains(email))
        {
            _externalGuests.Add(email);
            _newExternalEmail = "";
        }
    }

    private void HandleExternalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddExternalGuest();
        }
    }

    private void RemoveExternalGuest(string email)
    {
        _externalGuests.Remove(email);
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private void SetRecurringType(string type)
    {
        RecurringType = type;
        UpdateSchedulePreview();
    }

    private void ToggleDay(string day)
    {
        if (SelectedDays.Contains(day))
        {
            if (SelectedDays.Count > 1) SelectedDays.Remove(day);
        }
        else
        {
            SelectedDays.Add(day);
        }
        UpdateSchedulePreview();
    }

    private void UpdateSchedulePreview()
    {
        _previewDates.Clear();
        var baseDate = _bookingDate;
        int count = Math.Max(1, Math.Min(_recurrenceCount, 12));

        for (int i = 0; i < count; i++)
        {
            DateTime nextDate;
            if (RecurringType == "Harian")
            {
                nextDate = baseDate.AddDays(i);
            }
            else if (RecurringType == "Mingguan")
            {
                nextDate = baseDate.AddDays(i * 7);
            }
            else // Bulanan
            {
                nextDate = baseDate.AddMonths(i);
            }

            bool isConflict = (i == 2 && count > 2);
            _previewDates.Add(new SchedulePreviewItem(
                nextDate,
                nextDate.ToString("dddd, dd MMM yyyy", new System.Globalization.CultureInfo("id-ID")),
                isConflict
            ));
        }
    }

    private void SkipDate(SchedulePreviewItem item)
    {
        _previewDates.Remove(item);
        ToastService.Info("Jadwal Dilewati", $"Tanggal {item.DateFormatted} dikeluarkan dari daftar pengulangan.");
    }

    private async Task HandleBack()
    {
        if (!_isSubmitting)
        {
            await OnBack.InvokeAsync();
        }
    }

    private async Task HandleConfirm()
    {
        if (_isSubmitting) return;

        if (string.IsNullOrWhiteSpace(_requesterName))
        {
            ToastService.Warning("Validasi Gagal", "Nama pemesan wajib diisi.");
            return;
        }

        if (_disposed) return;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        
        _isSubmitting = true;
        StateHasChanged();

        try 
        {
            await Task.Delay(1000, _cts.Token);
            if (_disposed) return;
            _isSubmitting = false;
            ToastService.Success("Pemesanan Berhasil", "Permintaan reservasi ruangan Anda berhasil diajukan.");
            await OnConfirm.InvokeAsync();
        }
        catch (TaskCanceledException) { }
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
