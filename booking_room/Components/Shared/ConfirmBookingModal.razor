@code {
    [Parameter] public bool Visible { get; set; } = false;
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public RoomItem? Room { get; set; }
    [Parameter] public List<RoomItem> AvailableRooms { get; set; } = new();
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    // Loading states
    private bool _isLoadingModal = false;
    private bool _isCalculatingSchedule = false;

    // Form states
    private string _bookerName = "Anggoro Ravi";
    private string _division = "Teknologi Informasi";

    // TODO: konfirmasi penamaan resmi ke HRD Persada
    private readonly string[] _divisionList = new[]
    {
        "Direksi & Sekretariat Perusahaan",
        "Keuangan & Administrasi",
        "Audit Internal",
        "Sumber Daya Manusia & Rekrutmen",
        "Operasional – Layanan Keamanan (Security)",
        "Operasional – Layanan Kebersihan (Cleaning Service)",
        "Operasional – Contact Center",
        "Operasional – Layanan Teknis & Maintenance",
        "Marketing & Pengembangan Bisnis (Commercial)",
        "Teknologi Informasi",
        "Legal & General Affairs (GA)",
        "Training & Konsultasi SDM"
    };
    
    private DateTime _selectedDate = DateTime.Today;
    private DateTime _startTime = DateTime.Today.AddHours(9);
    private DateTime _endTime = DateTime.Today.AddHours(10);
    
    private bool _isRecurring = false;
    private string _recurPattern = "daily"; // daily, weekly, monthly
    
    private bool[] _selectedDays = new bool[7] { false, true, false, true, false, false, false }; // Default Selasa & Kamis
    private string[] DayLetters = { "S", "S", "R", "K", "J", "S", "M" }; // Senin, Selasa, Rabu, Kamis, Jumat, Sabtu, Minggu
    private int _recurEndCount = 4;
    private DateTime _recurEndDate = DateTime.Today.AddMonths(1);
    
    private List<string> _participants = new() { "Alex Mercer", "Nadia Pradipta" };
    private string _newParticipant = "";
    private bool _isExternalGuest = false;
    private string _externalEmail = "";
    private string _notes = "";
    private HashSet<int> _skippedDates = new();
    private readonly System.Globalization.CultureInfo _idCulture = new System.Globalization.CultureInfo("id-ID");

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && !_isLoadingModal)
        {
            _isLoadingModal = true;
            await Task.Delay(400); // Smooth skeleton feel
            _isLoadingModal = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_isLoadingModal)
        {
            try
            {
                await JS.InvokeVoidAsync("initDragScroll", "roomSelectionCarousel");
            }
            catch { }
        }
    }

    private IEnumerable<RoomItem> GetDisplayRooms()
    {
        var sampleRooms = RoomDataProvider.GetRooms().ToList();

        if (Room != null)
        {
            var idx = sampleRooms.FindIndex(r => r.Id == Room.Id);
            if (idx > 0)
            {
                var current = sampleRooms[idx];
                sampleRooms.RemoveAt(idx);
                sampleRooms.Insert(0, current);
            }
            else if (idx < 0)
            {
                sampleRooms.Insert(0, Room);
            }
        }

        return sampleRooms;
    }

    private void SelectRoom(RoomItem room)
    {
        Room = room;
    }

    private async Task OnRecurringToggled()
    {
        if (_isRecurring)
        {
            await CalculateSchedule();
        }
    }

    private async Task ChangePattern(string pattern)
    {
        _recurPattern = pattern;
        await CalculateSchedule();
    }

    private async Task ToggleDay(int index)
    {
        _selectedDays[index] = !_selectedDays[index];
        await CalculateSchedule();
    }

    private async Task CalculateSchedule()
    {
        _isCalculatingSchedule = true;
        StateHasChanged();
        await Task.Delay(350); // Shimmer preview calculation
        _isCalculatingSchedule = false;
        StateHasChanged();
    }

    private List<DateTime> GenerateRecurringDates()
    {
        var dates = new List<DateTime>();
        var curr = _selectedDate;
        int count = Math.Clamp(_recurEndCount, 1, 20);

        for (int i = 0; i < count; i++)
        {
            if (_recurPattern == "daily")
                dates.Add(curr.AddDays(i));
            else if (_recurPattern == "weekly")
                dates.Add(curr.AddDays(i * 7));
            else if (_recurPattern == "monthly")
                dates.Add(curr.AddMonths(i));
        }

        return dates;
    }

    private void SkipDate(int index)
    {
        _skippedDates.Add(index);
    }

    private void HandleParticipantKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddParticipant();
        }
    }

    private void AddParticipant()
    {
        if (!string.IsNullOrWhiteSpace(_newParticipant))
        {
            _participants.Add(_newParticipant.Trim());
            _newParticipant = "";
        }
    }

    private void RemoveParticipant(string name)
    {
        _participants.Remove(name);
    }

    private async Task HandleVisibleChanged(bool val)
    {
        Visible = val;
        await VisibleChanged.InvokeAsync(val);
    }

    private async Task Back()
    {
        await HandleVisibleChanged(false);
        await OnBack.InvokeAsync();
    }

    private async Task Confirm()
    {
        await HandleVisibleChanged(false);
        string roomName = Room?.Name ?? "Ruangan";
        string dateStr = _selectedDate.ToString("dd MMMM yyyy", _idCulture);
        string timeStr = $"{_startTime:HH:mm} - {_endTime:HH:mm} WIB";
        ToastService.Success(
            "Pemesanan Berhasil",
            $"Ruangan {roomName} telah dipesan untuk {dateStr}, {timeStr}.",
            4500
        );
        await OnConfirm.InvokeAsync();
    }
}
