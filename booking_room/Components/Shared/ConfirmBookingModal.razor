@namespace booking_room.Components.Shared
@using booking_room.Components.Models

<AppModal Visible="@Visible" VisibleChanged="HandleVisibleChanged" Size="lg" Title="Konfirmasi Pemesanan" Subtitle="Jadwalkan ruangan atau sumber daya baru" ShowFooter="true">
    <IconContent>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
            <path d="M9 16l2 2 4-4"></path>
        </svg>
    </IconContent>
    <ChildContent>
        <div class="confirm-modal-body custom-scrollbar">
            
            <!-- SECTION 1: Data Pemesan -->
            <div class="form-section">
                <div class="grid-2-col">
                    <div class="form-group">
                        <label>NAMA PEMESAN</label>
                        <input type="text" class="form-input" @bind="_bookerName" />
                    </div>
                    <div class="form-group">
                        <label>DIVISI</label>
                        <select class="form-input" @bind="_division">
                            <option value="Teknologi Informasi">Teknologi Informasi</option>
                            <option value="Keuangan">Keuangan</option>
                            <option value="SDM">SDM</option>
                            <option value="Operasional">Operasional</option>
                            <option value="Marketing">Marketing</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: Pilih Ruangan (Carousel) -->
            <div class="form-section">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <label style="margin-bottom: 0;">RUANGAN TERPILIH</label>
                    <div class="carousel-nav">
                        <button class="nav-arrow" @onclick="ScrollLeft">
                            <img src="icons/icon_arrow_left.svg" width="16" height="16" alt="" />
                        </button>
                        <button class="nav-arrow" @onclick="ScrollRight">
                            <img src="icons/icon_arrow_right.svg" width="16" height="16" alt="" />
                        </button>
                    </div>
                </div>
                
                <div class="room-carousel" id="roomCarousel">
                    @if (AvailableRooms != null && AvailableRooms.Any())
                    {
                        foreach (var r in AvailableRooms)
                        {
                            bool isActive = Room != null && r.Id == Room.Id;
                            <div class="carousel-card @(isActive ? "active" : "")" @onclick="() => SelectRoom(r)">
                                <div class="carousel-img-wrap">
                                    <img src="@(string.IsNullOrEmpty(r.PhotoUrl) ? "/images/default-room.jpg" : r.PhotoUrl)" alt="@r.Name" />
                                    <div class="carousel-status">
                                        <StatusIsland Status="@ParseRoomStatus(r.Status)" EnableCountdown="false" Class="island-small" />
                                    </div>
                                </div>
                                <div class="carousel-info">
                                    <div class="c-title">@r.Name</div>
                                    <div class="c-desc">@r.Description</div>
                                    <div class="c-meta">Kapasitas @r.Capacity org &bull; Lantai @r.Floor</div>
                                    <div class="c-amenities">
                                        @foreach(var am in r.Amenities.Take(3))
                                        {
                                            var ai = RoomAmenity.Create(am);
                                            <img src="@ai.IconSvgPath" width="14" height="14" alt="" />
                                        }
                                        @if(r.Amenities.Count > 3) {
                                            <span class="c-am-more">+@(r.Amenities.Count - 3)</span>
                                        }
                                    </div>
                                    @if(isActive)
                                    {
                                        <button class="btn-ganti">GANTI RUANGAN</button>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else if (Room != null)
                    {
                        <div class="carousel-card active">
                            <div class="carousel-img-wrap">
                                <img src="@(string.IsNullOrEmpty(Room.PhotoUrl) ? "/images/default-room.jpg" : Room.PhotoUrl)" alt="@Room.Name" />
                                <div class="carousel-status">
                                    <StatusIsland Status="@ParseRoomStatus(Room.Status)" EnableCountdown="false" Class="island-small" />
                                </div>
                            </div>
                            <div class="carousel-info">
                                <div class="c-title">@Room.Name</div>
                                <div class="c-desc">@Room.Description</div>
                                <div class="c-meta">Kapasitas @Room.Capacity org &bull; Lantai @Room.Floor</div>
                                <button class="btn-ganti">GANTI RUANGAN</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- SECTION 3: Jadwal -->
            <div class="form-section">
                <div class="grid-2-col">
                    <div class="form-group">
                        <label>TANGGAL</label>
                        <input type="date" class="form-input" @bind="_selectedDate" />
                    </div>
                    <div class="form-group">
                        <label>WAKTU (MULAI - SELESAI)</label>
                        <div class="time-inputs">
                            <input type="time" class="form-input" @bind="_startTime" />
                            <span class="time-separator">-</span>
                            <input type="time" class="form-input" @bind="_endTime" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 4: Jadikan Berulang (Recurring Booking) -->
            <div class="form-section recurring-section">
                <div class="recurring-header">
                    <div class="recurring-title-wrap">
                        <img src="icons/Icon_book_1.svg" width="20" height="20" alt="" />
                        <span>Jadikan Berulang (Recurring Booking)</span>
                    </div>
                    <div class="toggle-switch">
                        <input type="checkbox" id="recurringToggle" @bind="_isRecurring" />
                        <label for="recurringToggle" class="toggle-label"></label>
                    </div>
                </div>
                
                <div class="recurring-panel @(_isRecurring ? "expanded" : "collapsed")">
                    <div class="recurring-panel-inner">
                        
                        <div class="form-group">
                            <label>POLA PERULANGAN</label>
                            <div class="segmented-control">
                                <button class="segment-btn @(_recurPattern == "daily" ? "active" : "")" @onclick="@(() => SetPattern("daily"))">Harian</button>
                                <button class="segment-btn @(_recurPattern == "weekly" ? "active" : "")" @onclick="@(() => SetPattern("weekly"))">Mingguan</button>
                                <button class="segment-btn @(_recurPattern == "monthly" ? "active" : "")" @onclick="@(() => SetPattern("monthly"))">Bulanan</button>
                            </div>
                        </div>

                        @if (_recurPattern == "weekly")
                        {
                            <div class="form-group">
                                <div class="day-selector">
                                    @for (int i = 0; i < 7; i++)
                                    {
                                        var idx = i;
                                        <button class="day-circle @(_selectedDays[idx] ? "selected" : "")" @onclick="@(() => ToggleDay(idx))">
                                            @DayInitials[idx]
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        <div class="grid-2-col">
                            <div class="form-group">
                                <label>BERAKHIR SETELAH</label>
                                <div class="input-with-suffix">
                                    <input type="number" class="form-input" min="1" max="30" @bind="_recurEndCount" />
                                    <span class="suffix">Kali</span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>ATAU TANGGAL</label>
                                <input type="date" class="form-input" @bind="_recurEndDate" />
                            </div>
                        </div>

                        <div class="preview-schedule">
                            <label>PREVIEW JADWAL</label>
                            <div class="schedule-list">
                                @{
                                    var dates = GenerateRecurringDates();
                                    for (int i = 0; i < dates.Count; i++)
                                    {
                                        var idx = i;
                                        var date = dates[idx];
                                        if (_skippedDates.Contains(idx))
                                            continue;

                                        bool isConflict = (idx == 1 || idx == 4); // mock data

                                        <div class="schedule-card @(isConflict ? "conflict" : "")">
                                            <div class="s-date">@date.ToString("dd MMM yyyy, dddd")</div>
                                            @if (isConflict)
                                            {
                                                <div class="s-conflict">
                                                    <div class="s-error-msg">
                                                        <img src="icons/icon_alert_danger.svg" width="14" height="14" alt="" />
                                                        <span>Ruangan tidak tersedia pada waktu ini</span>
                                                    </div>
                                                    <div class="s-actions">
                                                        <button class="btn-outline-sm" @onclick="@(() => SkipDate(idx))">Lewati</button>
                                                        <button class="btn-solid-sm">Ganti Ruangan</button>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="s-success">
                                                    <span class="badge-success">
                                                        <img src="icons/icon_check_circle.svg" width="12" height="12" alt="" />
                                                        TERSEDIA
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- SECTION 5: Undang Peserta -->
            <div class="form-section">
                <label>UNDANG PESERTA</label>
                <div class="modern-search-bar">
                    <img src="icons/icon_search.svg" width="18" height="18" class="search-icon" alt="" />
                    <input type="text" class="form-input search-input" placeholder="Cari nama kolega..." @bind="_newParticipant" />
                    <button class="btn-add-circle" @onclick="AddParticipant">
                        <img src="icons/icon_plus.svg" width="20" height="20" alt="" />
                    </button>
                </div>
                
                @{
                    int capacity = Room?.Capacity ?? 0;
                    int participantCount = _participants.Count + 1; // +1 for booker
                    double fillPercent = capacity > 0 ? ((double)participantCount / capacity) * 100 : 0;
                    bool overCapacity = participantCount > capacity;
                }
                
                <div class="capacity-indicator">
                    <div class="capacity-text">
                        <img src="icons/icon_group.svg" width="16" height="16" alt="" />
                        @participantCount dari @capacity Kapasitas Ruangan
                    </div>
                    <div class="progress-bar-bg">
                        <div class="progress-bar-fill modern-gradient @(overCapacity ? "danger" : "")" style="width: @(Math.Min(fillPercent, 100))%;"></div>
                    </div>
                </div>

                <div class="chip-list">
                    @foreach (var p in _participants)
                    {
                        <div class="pill-chip">
                            <div class="pill-avatar" style="background-color: @GetAvatarColor(p)">@p.Substring(0,1).ToUpper()</div>
                            <span class="pill-name">@p</span>
                            <button class="pill-remove" @onclick="@(() => RemoveParticipant(p))">
                                <img src="icons/icon_close.svg" width="14" height="14" alt="" />
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- SECTION 6: Undang Tamu Eksternal -->
            <div class="form-section">
                <div class="recurring-header" style="padding: 0; background: transparent; border: none; margin-bottom: 12px;">
                    <div class="recurring-title-wrap" style="color: var(--color-navy, #334155); font-weight: 500;">
                        <span>Undang Tamu Eksternal (Di luar Persada)</span>
                    </div>
                    <div class="toggle-switch">
                        <input type="checkbox" id="extGuest" @bind="_isExternalGuest" />
                        <label for="extGuest" class="toggle-label"></label>
                    </div>
                </div>
                @if (_isExternalGuest)
                {
                    <div class="form-group">
                        <input type="email" class="form-input" placeholder="Email tamu eksternal..." @bind="_externalEmail" />
                    </div>
                }
            </div>

            <!-- SECTION 7: Catatan -->
            <div class="form-section">
                <label>CATATAN / PERMINTAAN KHUSUS</label>
                <textarea class="form-input" rows="3" @bind="_notes"></textarea>
            </div>
            
        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn-cancel" @onclick="Back">Batal</button>
        <button class="btn-confirm" @onclick="Confirm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Konfirmasi Pemesanan
        </button>
    </FooterContent>
</AppModal>

<style>
    /* Variables */
    :root {
        --color-primary: #F59E0B;
        --color-primary-light: #FEF3C7;
        --color-primary-dark: #92400E;
        --color-navy: #0F172A;
        --color-neutral-100: #F1F5F9;
        --color-neutral-200: #E2E8F0;
        --color-neutral-300: #CBD5E1;
        --color-neutral-600: #475569;
        --color-neutral-800: #1E293B;
        --color-white: #FFFFFF;
        --color-danger-bg: #FEF2F2;
        --color-danger-text: #DC2626;
        --color-success-bg: #DCFCE7;
        --color-success-text: #166534;
        
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 24px;
        --radius-full: 999px;
    }

    body.dark-mode {
        --color-navy: #E2E8F0;
        --color-neutral-100: #1E293B;
        --color-neutral-200: #334155;
        --color-neutral-300: #475569;
        --color-neutral-600: #94A3B8;
        --color-neutral-800: #F1F5F9;
        --color-white: #0F172A;
        --color-danger-bg: #450A0A;
        --color-danger-text: #F87171;
        --color-success-bg: #052E16;
        --color-success-text: #4ADE80;
    }

    .confirm-modal-body {
        display: flex;
        flex-direction: column;
        gap: 24px;
        padding: 16px 0;
    }

    .form-section {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    label {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--color-neutral-600);
        margin-bottom: 4px;
    }

    .form-input {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid var(--color-neutral-300);
        border-radius: var(--radius-sm);
        background-color: var(--color-white);
        color: var(--color-neutral-800);
        font-family: inherit;
        font-size: 1rem;
        outline: none;
        transition: border-color 0.2s;
    }

    .form-input:focus {
        border-color: var(--color-primary);
    }

    .grid-2-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    @@media (max-width: 640px) {
        .grid-2-col {
            grid-template-columns: 1fr;
        }
    }

    /* Selected Room Card */
    .selected-room-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border: 3px solid var(--color-primary);
        border-radius: var(--radius-md);
        background-color: var(--color-white);
    }

    .room-card-content {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .room-thumbnail {
        width: 48px;
        height: 48px;
        border-radius: var(--radius-sm);
        overflow: hidden;
        background-color: var(--color-neutral-200);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .room-thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .room-thumbnail-placeholder {
        font-weight: 700;
        color: var(--color-neutral-600);
        font-size: 1.2rem;
    }

    .room-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .room-title {
        font-weight: 700;
        color: var(--color-neutral-800);
        font-size: 1.1rem;
    }

    .room-meta {
        font-size: 0.85rem;
        color: var(--color-neutral-600);
    }

    .room-status {
        margin-top: 2px;
    }

    .status-badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 2px 8px;
    .carousel-status {
        position: absolute;
        top: 8px; left: 8px;
    }
    
    .carousel-info {
        padding: 12px;
        position: relative;
    }
    .c-title { font-weight: 700; font-size: 0.95rem; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .c-desc { font-size: 0.75rem; color: #64748b; margin-bottom: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .c-meta { font-size: 0.7rem; color: #64748b; margin-bottom: 8px; }
    .c-amenities { display: flex; gap: 4px; align-items: center; color: #64748b; }
    .c-am-more { font-size: 0.7rem; font-weight: 600; background: #f1f5f9; padding: 2px 6px; border-radius: 4px; }
    
    .btn-ganti {
        position: absolute;
        top: 12px; right: 12px;
        background: #fffbeb;
        color: #b45309;
        border: none;
        padding: 4px 8px;
        font-size: 0.65rem;
        font-weight: 700;
        border-radius: 100px;
        cursor: pointer;
    }

    .time-inputs {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .time-separator {
        color: var(--color-text-muted, #64748b);
        font-weight: 600;
    }

    /* Recurring Section */
    .recurring-section {
        background-color: var(--color-surface, #f8fafc);
        border: 1px solid var(--color-border, #e2e8f0);
        border-radius: 16px;
        padding: 16px;
    }

    .recurring-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .recurring-title-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: var(--color-primary, #F59E0B);
    }
    .recurring-title-wrap img {
        background: #fffbeb;
        padding: 4px;
        border-radius: 8px;
    }

    .toggle-switch {
        position: relative;
        width: 44px;
        height: 24px;
    }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .toggle-label {
        position: absolute; cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: #cbd5e1;
        transition: .3s; border-radius: 34px;
    }
    .toggle-label:before {
        position: absolute; content: "";
        height: 18px; width: 18px; left: 3px; bottom: 3px;
        background-color: white; transition: .3s; border-radius: 50%;
    }
    input:checked + .toggle-label { background-color: var(--color-primary, #F59E0B); }
    input:checked + .toggle-label:before { transform: translateX(20px); }

    .recurring-panel {
        overflow: hidden;
        transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out, margin-top 0.3s ease-in-out;
    }
    .recurring-panel.collapsed {
        max-height: 0; opacity: 0; margin-top: 0;
    }
    .recurring-panel.expanded {
        max-height: 1500px;
        opacity: 1;
    }
    .recurring-panel-inner {
        padding-top: 20px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    /* Tabs */
    .tabs-group {
        display: flex;
        gap: 8px;
    }
    .tab-btn {
        padding: 8px 16px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--color-neutral-200);
        background-color: transparent;
        color: var(--color-neutral-600);
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .tab-btn.active {
        background-color: var(--color-primary-light);
        border: 1.5px solid var(--color-primary);
        color: var(--color-primary-dark);
        font-weight: 700;
    }

    /* Day Selector */
    .day-selector {
        display: flex;
        gap: 8px;
    }
    .day-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid var(--color-neutral-300);
        background: transparent;
        color: var(--color-neutral-600);
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }
    .day-circle.selected {
        background-color: var(--color-primary);
        border-color: var(--color-primary);
        color: white;
    }

    .input-with-suffix {
        display: flex;
        align-items: center;
        background-color: var(--color-white);
        border: 1px solid var(--color-neutral-300);
        border-radius: var(--radius-sm);
        overflow: hidden;
    }
    .input-with-suffix input {
        border: none;
        border-radius: 0;
    }
    .suffix {
        padding: 0 16px;
        color: var(--color-neutral-600);
        font-weight: 600;
        background-color: var(--color-neutral-100);
        border-left: 1px solid var(--color-neutral-300);
        height: 100%;
        display: flex;
        align-items: center;
    }

    /* Preview Schedule */
    .preview-schedule {
        margin-top: 8px;
    }
    .schedule-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 8px;
    }
    .schedule-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        background-color: var(--color-white);
        border: 1px solid var(--color-neutral-200);
        border-radius: var(--radius-sm);
    }
    .schedule-row.conflict {
        background-color: var(--color-danger-bg);
        border-color: rgba(220, 38, 38, 0.2);
    }
    .schedule-date {
        font-weight: 600;
        color: var(--color-neutral-800);
    }
    .schedule-conflict-info {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .conflict-text {
        color: var(--color-danger-text);
        font-size: 0.85rem;
        font-weight: 600;
    }
    .conflict-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .btn-text-sm {
        background: none;
        border: none;
        color: var(--color-neutral-600);
        font-weight: 600;
        cursor: pointer;
        font-size: 0.85rem;
        text-decoration: underline;
    }
    .btn-outline-pill {
        background: transparent;
        border: 1px solid var(--color-primary);
        color: var(--color-primary);
        padding: 4px 12px;
        border-radius: var(--radius-full);
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
    }
    .pill-green {
        background-color: var(--color-success-bg);
        color: var(--color-success-text);
        padding: 4px 12px;
        border-radius: var(--radius-full);
        font-weight: 700;
        font-size: 0.75rem;
    }

    /* Undang Peserta */
    .input-with-button {
        display: flex;
        gap: 8px;
    }
    .btn-add {
        background-color: var(--color-navy);
        color: white;
        border: none;
        padding: 0 16px;
        border-radius: var(--radius-sm);
        font-weight: 600;
        cursor: pointer;
    }

    .capacity-indicator {
        margin: 8px 0;
    }
    .capacity-text {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--color-neutral-600);
