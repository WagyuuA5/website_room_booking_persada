@using booking_room.Components.Models
@using System.Globalization
@inject booking_room.Services.LoadingStateService LoadingState
@inject NavigationManager Navigation

<style>
    .confirm-booking-wrapper {
        display: flex;
        flex-direction: column;
        max-width: 520px; 
        width: 100%;
        margin: 0 auto;
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        max-height: 88vh;
        box-shadow: 0 4px 24px rgba(16,48,92,0.08);
        font-family: 'Inter', sans-serif;
    }

    .modal-header-section {
        padding: 24px 24px 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        background: #fff;
        position: sticky;
        top: 0;
        z-index: 10;
        border-bottom: 1px solid #E5E7EB;
    }
    .modal-title {
        color: #16305C;
        font-weight: 700;
        font-size: 1.25rem;
        margin: 0 0 4px 0;
    }
    .modal-subtitle {
        color: #6B7280;
        font-size: 0.875rem;
        margin: 0;
    }

    .modal-body-section {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .grid-2-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-label {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 0.875rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }
    .input-icon {
        position: absolute;
        left: 12px;
        color: #9CA3AF;
        pointer-events: none;
        display: flex;
    }
    .form-input {
        width: 100%;
        padding: 10px 12px 10px 36px;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        font-size: 0.875rem;
        color: #111827;
        background: #fff;
        outline: none;
        transition: border-color 0.2s;
    }
    .form-input::placeholder {
        color: #9CA3AF;
    }
    .form-input:focus {
        border-color: #EAB63C;
        box-shadow: 0 0 0 2px rgba(234, 182, 60, 0.2);
    }
    .form-select {
        width: 100%;
        padding: 10px 32px 10px 36px;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        font-size: 0.875rem;
        color: #111827;
        background: #fff;
        outline: none;
        appearance: none;
    }
    .form-select:focus {
        border-color: #EAB63C;
        box-shadow: 0 0 0 2px rgba(234, 182, 60, 0.2);
    }
    .select-chevron {
        position: absolute;
        right: 12px;
        color: #9CA3AF;
        pointer-events: none;
        display: flex;
    }

    .time-inputs {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .time-inputs span {
        color: #6B7280;
        font-weight: 500;
    }

    /* Room Cards */
    .room-cards-scroll {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 12px;
    }
    
    .room-card {
        border: 1px solid #E5E7EB;
        border-radius: 14px;
        padding: 12px;
        cursor: pointer;
        position: relative;
        background: #fff;
        transition: all 0.2s;
        display: flex;
        flex-direction: column;
    }
    .room-card:hover:not(.disabled) {
        border-color: #EAB63C;
    }
    .room-card.selected {
        border: 2px solid #EAB63C;
        background: #FEF9F0;
    }
    .room-card.disabled {
        opacity: 0.5;
        cursor: not-allowed;
        background: #F9FAFB;
    }
    
    .room-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 0.6rem;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 4px;
    }
    .badge-available { background: #D1FAE5; color: #059669; }
    .badge-booked { background: #FEE2E2; color: #DC2626; }

    .room-icon-name {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 16px;
    }
    .room-icon {
        color: #4B5563;
    }
    .room-card.selected .room-icon {
        color: #EAB63C;
    }
    .room-name {
        font-weight: 600;
        font-size: 0.85rem;
        color: #111827;
        margin: 0;
        line-height: 1.2;
    }
    .room-cap {
        font-size: 0.75rem;
        color: #6B7280;
        margin-top: 4px;
    }
    .room-amenities {
        font-size: 0.7rem;
        color: #6B7280;
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 6px;
    }

    /* Capacity Indicator */
    .capacity-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .capacity-text {
        font-size: 0.75rem;
        color: #6B7280;
    }
    .capacity-bar-bg {
        width: 80px;
        height: 4px;
        background: #E5E7EB;
        border-radius: 999px;
        overflow: hidden;
    }
    .capacity-bar-fill {
        height: 100%;
        background: #EAB63C;
        border-radius: 999px;
        transition: width 0.3s ease;
    }

    /* Attendee Chips */
    .attendee-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
        align-items: center;
    }
    .attendee-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fff;
        border: 1px solid #E5E7EB;
        padding: 4px 8px 4px 4px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 500;
        color: #374151;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    .chip-avatar {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #DBEAFE;
        color: #1D4ED8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6rem;
        font-weight: 700;
    }
    .chip-remove {
        background: transparent;
        border: none;
        color: #9CA3AF;
        cursor: pointer;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .chip-remove:hover { color: #EF4444; }

    .conflict-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #FDF2F8;
        color: #DB2777;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    /* Toggle */
    .external-guest-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 36px;
        height: 20px;
    }
    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }
    .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: #E5E7EB;
        transition: .3s;
        border-radius: 20px;
    }
    .toggle-slider:before {
        position: absolute;
        content: "";
        height: 16px;
        width: 16px;
        left: 2px;
        bottom: 2px;
        background-color: white;
        transition: .3s;
        border-radius: 50%;
    }
    input:checked + .toggle-slider {
        background-color: #EAB63C;
    }
    input:checked + .toggle-slider:before {
        transform: translateX(16px);
    }

    textarea.form-input {
        resize: vertical;
        min-height: 80px;
        padding: 12px;
    }

    /* Footer */
    .modal-footer-section {
        padding: 16px 24px;
        background: #fff;
        border-top: 1px solid #E5E7EB;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        position: sticky;
        bottom: 0;
        z-index: 10;
    }
    .btn-pill {
        border-radius: 999px;
        padding: 8px 20px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }
    .btn-cancel {
        background: #fff;
        border: 1px solid #D1D5DB;
        color: #374151;
    }
    .btn-cancel:hover {
        background: #F9FAFB;
    }
    .btn-confirm {
        background: #EAB63C;
        border: 1px solid #EAB63C;
        color: #111827;
    }
    .btn-confirm:hover {
        background: #D9A02A;
    }

    .recurrence-pattern-btn {
        background: #fff;
        border: 1px solid #E5E7EB;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748B;
        cursor: pointer;
        transition: all 0.2s;
    }
    .recurrence-pattern-btn.active {
        background: #EAB63C;
        border-color: #EAB63C;
        color: #111827;
    }
    .recurrence-pattern-btn:hover:not(.active) {
        background: #F9FAFB;
    }

    .recurrence-preview {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 12px;
    }
    .recurrence-preview-title {
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748B;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .recurrence-preview-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .recurrence-preview-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        color: #374151;
    }
    .recurrence-preview-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #EAB63C;
        flex-shrink: 0;
    }
</style>

<div class="confirm-booking-wrapper">
    <div class="modal-header-section">
        <div>
            <h2 class="modal-title">Konfirmasi Booking</h2>
            <p class="modal-subtitle">Jadwalkan sumber daya atau ruangan baru</p>
        </div>
    </div>

    <div class="modal-body-section">
        <!-- Row 1: Nama Pemesan & Divisi -->
        <div class="grid-2-col">
            <div>
                <label class="form-label">Nama Pemesan (Nama Lengkap)</label>
                <div class="input-wrapper">
                    <span class="input-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </span>
                    <input type="text" class="form-input" placeholder="Masukkan nama lengkap" @bind="_requesterName" />
                </div>
            </div>
            <div>
                <label class="form-label">Divisi</label>
                <div class="input-wrapper">
                    <span class="input-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>
                    </span>
                    <select class="form-select" @bind="_division">
                        <option value="" disabled selected>Pilih divisi</option>
                        <option value="IT">IT</option>
                        <option value="HR">HR</option>
                        <option value="Finance">Finance</option>
                        <option value="Marketing">Marketing</option>
                    </select>
                    <span class="select-chevron">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                    </span>
                </div>
            </div>
        </div>

        <!-- Room Selection -->
        <div>
            <label class="form-label">Pilih Ruangan</label>
            <div class="room-cards-scroll">
                @foreach (var room in _suggestedRooms)
                {
                    var isSelected = room.Id == _selectedRoomId;
                    var isAvailable = room.Status == "available";
                    var cardClass = isSelected ? "room-card selected" : "room-card";
                    if (!isAvailable) cardClass += " disabled";

                    <div class="@cardClass" @onclick="() => SelectRoom(room)">
                        <span class="room-badge @(isAvailable ? "badge-available" : "badge-booked")">
                            @(isAvailable ? "TERSEDIA" : "DIPESAN")
                        </span>
                        
                        <div class="room-icon-name">
                            <span class="room-icon">
                                @if(room.Name.Contains("Boardroom", StringComparison.OrdinalIgnoreCase))
                                {
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>
                                }
                                else if(room.Name.Contains("Studio", StringComparison.OrdinalIgnoreCase))
                                {
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                                }
                                else
                                {
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 9v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9"/><path d="M9 22V12h6v10M2 10.6L12 2l10 8.6"/></svg>
                                }
                            </span>
                            <div>
                                <h3 class="room-name">@room.Name</h3>
                                <div class="room-cap">Kapasitas: @room.Capacity Orang</div>
                            </div>
                        </div>
                        <div class="room-amenities">
                            @string.Join(", ", room.Amenities.Take(3))
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Date & Time -->
        <div class="grid-2-col">
            <div>
                <label class="form-label">Tanggal</label>
                <div class="input-wrapper">
                    <span class="input-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
                    </span>
                    <input type="date" class="form-input" placeholder="dd/mm/yyyy" @bind="_bookingDate" />
                </div>
            </div>
            <div>
                <label class="form-label">Waktu (Mulai - Selesai)</label>
                <div class="time-inputs">
                    <div class="input-wrapper" style="flex: 1;">
                        <span class="input-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                        </span>
                        <input type="time" class="form-input" @bind="_startTime" />
                    </div>
                    <span>-</span>
                    <div class="input-wrapper" style="flex: 1;">
                        <span class="input-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                        </span>
                        <input type="time" class="form-input" @bind="_endTime" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Invite Attendees -->
        <div>
            <label class="form-label">
                Undang Peserta
                <div class="capacity-indicator">
                    <span class="capacity-text">@_attendees.Count dari @SelectedRoomCapacity Kapasitas Ruangan</span>
                    <div class="capacity-bar-bg">
                        <div class="capacity-bar-fill" style="width: @CapacityPercentage.ToString(CultureInfo.InvariantCulture)%;"></div>
                    </div>
                </div>
            </label>
            <div class="input-wrapper">
                <span class="input-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                <input type="text" class="form-input" placeholder="Undang kolega..." @bind="_attendeeSearch" @bind:event="oninput" @onkeyup="HandleAttendeeInput" />
            </div>
            
            <div class="attendee-chips">
                @foreach (var attendee in _attendees)
                {
                    <div class="attendee-chip">
                        <div class="chip-avatar">@attendee[0]</div>
                        @attendee
                        <button type="button" class="chip-remove" @onclick="() => RemoveAttendee(attendee)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6L18 18"/></svg>
                        </button>
                    </div>
                }
                
                @if (_hasConflict)
                {
                    <div class="conflict-badge">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        Potensi bentrok jadwal
                    </div>
                }
            </div>
        </div>

        <!-- Recurring Booking -->
        <div>
            <div class="external-guest-row">
                <label class="form-label" style="margin-bottom: 0;">Jadikan Berulang (Recurring Booking)</label>
                <label class="toggle-switch">
                    <input type="checkbox" @bind="_isRecurring" />
                    <span class="toggle-slider"></span>
                </label>
            </div>

            @if (_isRecurring)
            {
                <div style="margin-top: 12px; display: flex; flex-direction: column; gap: 12px;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="form-label">Pola Pengulangan</label>
                        <div style="display: flex; gap: 8px;">
                            @foreach (var pattern in _recurrencePatterns)
                            {
                                <button class="recurrence-pattern-btn @(_recurrencePattern == pattern ? "active" : "")" @onclick="() => _recurrencePattern = pattern">
                                    @pattern
                                </button>
                            }
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="form-label">Ulang Sampai</label>
                        <input type="date" class="form-input" @bind="_recurrenceEndDate" />
                    </div>

                    <div class="recurrence-preview">
                        <div class="recurrence-preview-title">Preview Jadwal Berulang</div>
                        <div class="recurrence-preview-list">
                            @foreach (var preview in _recurrencePreview)
                            {
                                <div class="recurrence-preview-item">
                                    <span class="recurrence-preview-dot"></span>
                                    <span>@preview</span>
                                </div>
                            }
                        </div>
                    </div>

                    @if (_hasRecurrenceConflict)
                    {
                        <div class="conflict-badge">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                            Terdeteksi bentrok jadwal pada tanggal berulang
                        </div>
                    }
                </div>
            }
        </div>

        <!-- External Guests -->
        <div>
            <div class="external-guest-row">
                <label class="form-label" style="margin-bottom: 0;">Undang tamu eksternal</label>
                <label class="toggle-switch">
                    <input type="checkbox" @bind="_allowExternalGuests" />
                    <span class="toggle-slider"></span>
                </label>
            </div>
            
            @if (_allowExternalGuests)
            {
                <div class="input-wrapper" style="margin-top: 12px;">
                    <span class="input-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    </span>
                    <input type="email" class="form-input" placeholder="Email Tamu (cth. tamu@perusahaan.com)" />
                </div>
            }
        </div>

        <!-- Notes -->
        <div>
            <label class="form-label">Catatan / Permintaan Khusus</label>
            <textarea class="form-input" placeholder="Kebutuhan peralatan, katering, dsb."></textarea>
        </div>
    </div>

    <div class="modal-footer-section" style="display: flex; gap: 16px; margin-top: 24px;">
        <button class="btn-modal-outline" @onclick="OnClose">Batal</button>
        <button class="btn-modal-primary" @onclick="SubmitBooking">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            Konfirmasi Booking
        </button>
    </div>
</div>

@code {
    [Parameter] public RoomItem? InitialRoom { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string _requesterName = "";
    private string _division = "";
    private string _selectedRoomId = "";
    private DateTime? _bookingDate = DateTime.Today;
    private TimeOnly? _startTime = new TimeOnly(10, 0);
    private TimeOnly? _endTime = new TimeOnly(11, 0);
    private string _attendeeSearch = "";
    private List<string> _attendees = new() { "Alex Mercer", "Nadia Pradipta" };
    private bool _hasConflict = true; 
    private bool _allowExternalGuests = true; 

    private bool _isRecurring = false;
    private string _recurrencePattern = "Mingguan";
    private readonly string[] _recurrencePatterns = { "Harian", "Mingguan", "Bulanan" };
    private DateTime? _recurrenceEndDate = DateTime.Today.AddDays(14);
    private bool _hasRecurrenceConflict = false;

    private List<RoomItem> _suggestedRooms = new();

    protected override void OnInitialized()
    {
        _suggestedRooms = new List<RoomItem>
        {
            new RoomItem("1", "Alpha Boardroom", 12, "", "available", new List<string>{"TV", "WiFi", "Proyektor"}, "1"),
            new RoomItem("2", "Beta Studio", 4, "", "available", new List<string>{"Kamera", "Mikrofon", "WiFi"}, "1"),
            new RoomItem("3", "Gamma Lounge", 8, "", "booked", new List<string>{"Sofa", "Kopi", "WiFi"}, "1")
        };

        if (InitialRoom != null)
        {
            _selectedRoomId = InitialRoom.Id;
        }
        else
        {
            _selectedRoomId = "1";
        }
    }

    private void SelectRoom(RoomItem room)
    {
        if (room.Status == "available")
        {
            _selectedRoomId = room.Id;
        }
    }

    private int SelectedRoomCapacity => _suggestedRooms.FirstOrDefault(r => r.Id == _selectedRoomId)?.Capacity ?? 10;
    
    private double CapacityPercentage => Math.Min(100.0, (_attendees.Count / (double)SelectedRoomCapacity) * 100);

    private void HandleAttendeeInput(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_attendeeSearch))
        {
            _attendees.Add(_attendeeSearch);
            _attendeeSearch = "";
        }
    }

    private void RemoveAttendee(string name)
    {
        _attendees.Remove(name);
        if (_attendees.Count < 2)
        {
            _hasConflict = false; 
        }
    }

    private List<string> _recurrencePreview
    {
        get
        {
            if (!_isRecurring || !_startTime.HasValue || !_endTime.HasValue)
                return new List<string>();

            var preview = new List<string>();
            var current = _bookingDate ?? DateTime.Today;
            var end = _recurrenceEndDate ?? DateTime.Today.AddDays(14);
            var step = _recurrencePattern switch
            {
                "Harian" => TimeSpan.FromDays(1),
                "Bulanan" => TimeSpan.FromDays(30),
                _ => TimeSpan.FromDays(7)
            };

            _hasRecurrenceConflict = false;
            var count = 0;
            while (current <= end && count < 5)
            {
                preview.Add($"{current:dd MMM yyyy} — {_startTime.Value:HH:mm} s/d {_endTime.Value:HH:mm}");
                current = current.Add(step);
                count++;
                if (count == 1) _hasRecurrenceConflict = _hasConflict;
            }
            return preview;
        }
    }

    private async Task SubmitBooking()
    {
        await OnClose.InvokeAsync();
        Navigation.NavigateTo("/status");
    }
}


