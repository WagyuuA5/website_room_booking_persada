@using booking_room.Components.Models
@inject booking_room.Services.IToastService ToastService

<div class="confirm-booking-modal modal-content">
    <div class="modal-header">
        <h2 class="modal-title">Konfirmasi Pemesanan Anda</h2>
    </div>

    <div class="modal-body">
        <h3 class="section-title">Ringkasan Pemesanan</h3>
        
        <div class="summary-card">
            <div class="summary-row">
                <div class="summary-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 9v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9"/><path d="M9 22V12h6v10M2 10.6L12 2l10 8.6"/></svg>
                </div>
                <div class="summary-info">
                    <span class="summary-label">Ruangan</span>
                    <span class="summary-value">@(Room?.Name ?? "Ruangan Tidak Diketahui")</span>
                </div>
            </div>
            
            <div class="summary-divider"></div>
            
            <div class="summary-row">
                <div class="summary-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <div class="summary-info">
                    <span class="summary-label">Tanggal</span>
                    <span class="summary-value">@DateTime.Today.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))</span>
                </div>
            </div>
            
            <div class="summary-divider"></div>
            
            <div class="summary-row">
                <div class="summary-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div class="summary-info">
                    <span class="summary-label">Waktu</span>
                    <span class="summary-value">@_startTime.ToString("HH:mm") - @_endTime.ToString("HH:mm")</span>
                </div>
            </div>
            
            <div class="summary-divider"></div>
            
            <div class="summary-row">
                <div class="summary-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </div>
                <div class="summary-info">
                    <span class="summary-label">Kapasitas</span>
                    <span class="summary-value">@(Room?.Capacity ?? 0) Kursi</span>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button class="btn-cancel" @onclick="HandleBack" disabled="@_isSubmitting">Kembali</button>
        <button class="btn-confirm" @onclick="HandleConfirm" disabled="@_isSubmitting">
            @if (_isSubmitting)
            {
                <svg class="spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line></svg>
                <span>Memproses...</span>
            }
            else
            {
                <span>Konfirmasi Pemesanan</span>
            }
        </button>
    </div>
</div>

<style>
    .confirm-booking-modal {
        background: var(--color-white, #FFFFFF);
        border-radius: var(--radius-card, 20px);
        width: 100%;
        max-width: 480px;
        box-shadow: var(--shadow-modal, 0 20px 60px rgba(0, 0, 0, 0.25));
        display: flex;
        flex-direction: column;
        font-family: 'Inter', sans-serif;
        overflow: hidden;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 24px 16px;
        border-bottom: 1px solid #E5E7EB;
    }

    .modal-title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-card-dark, #0B1A3D);
    }

    .app-modal-close {
        background: none;
        border: none;
        color: var(--color-text-muted, #64748B);
        cursor: pointer;
        padding: 4px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s;
    }

    .app-modal-close:hover:not(:disabled) {
        background-color: #F1F5F9;
        color: var(--color-danger, #EF4444);
    }

    .app-modal-close:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .modal-body {
        padding: 24px;
    }

    .section-title {
        margin: 0 0 16px 0;
        font-size: 1rem;
        font-weight: 600;
        color: var(--color-card-dark, #0B1A3D);
    }

    .summary-card {
        background: var(--surface-card, #FFFFFF);
        border: 1px solid var(--divider-subtle, rgba(15, 23, 42, 0.08));
        border-radius: 12px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .summary-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .summary-icon {
        color: var(--color-text-muted, #64748B);
        display: flex;
        align-items: center;
        justify-content: center;
        padding-top: 2px;
    }

    .summary-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .summary-label {
        font-size: 0.75rem;
        color: var(--color-text-muted, #64748B);
        font-weight: 500;
    }

    .summary-value {
        font-size: 0.9375rem;
        color: var(--color-card-dark, #0B1A3D);
        font-weight: 600;
    }

    .summary-divider {
        height: 1px;
        background-color: #E2E8F0;
        margin: 4px 0;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 16px 24px;
        border-top: 1px solid var(--divider-subtle, rgba(15, 23, 42, 0.08));
        background: var(--surface-card, #FFFFFF);
    }

    .btn-cancel, .btn-confirm {
        padding: 10px 20px;
        border-radius: var(--radius-pill, 999px);
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
    }

    .btn-cancel {
        background: transparent;
        color: var(--color-text-muted, #64748B);
        border: 1px solid #CBD5E1;
    }

    .btn-cancel:hover:not(:disabled) {
        background: #F1F5F9;
        color: var(--color-card-dark, #0B1A3D);
    }

    .btn-confirm {
        background: var(--color-accent-gold-1, #FBBF24);
        color: var(--color-card-dark, #0B1A3D);
    }

    .btn-confirm:hover:not(:disabled) {
        background: var(--color-accent-gold-2, #F59E0B);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.2);
    }

    .btn-cancel:disabled, .btn-confirm:disabled {
        opacity: 0.65;
        cursor: not-allowed;
    }

    .spinner {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        100% {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    [Parameter] public RoomItem? Room { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private bool _isSubmitting = false;
    private TimeOnly _startTime = new TimeOnly(10, 0);
    private TimeOnly _endTime = new TimeOnly(11, 0);

    private async Task HandleBack()
    {
        if (!_isSubmitting)
        {
            await OnBack.InvokeAsync();
        }
    }

    private async Task HandleConfirm()
    {
        if (_isSubmitting) return;

        _isSubmitting = true;
        StateHasChanged();

        // Simulasi proses API
        await Task.Delay(1500);

        _isSubmitting = false;
        
        ToastService.Success("Pemesanan Berhasil", "Ruangan berhasil dipesan.");
        
        await OnConfirm.InvokeAsync();
    }
}
