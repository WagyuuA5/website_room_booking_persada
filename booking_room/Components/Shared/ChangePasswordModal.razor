@namespace booking_room.Components.Shared
@inject booking_room.Services.IToastService ToastService

<AppModal Visible="@Visible" VisibleChanged="HandleVisibleChanged" Size="sm" ShowCloseButton="false"
          Title="Ubah Kata Sandi" Subtitle="Pastikan kata sandi Anda kuat dan belum pernah digunakan sebelumnya.">
    <BodyContent>
        <div class="change-password-form">
            <div class="form-group">
                <label>Kata Sandi Saat Ini <span class="text-danger">*</span></label>
                <input type="password" @bind="CurrentPassword" class="form-input" placeholder="Masukkan kata sandi lama" />
            </div>

            <div class="form-group">
                <label>Kata Sandi Baru <span class="text-danger">*</span></label>
                <input type="password" @bind="NewPassword" class="form-input" placeholder="Minimal 8 karakter" />
            </div>

            <div class="form-group">
                <label>Konfirmasi Kata Sandi Baru <span class="text-danger">*</span></label>
                <input type="password" @bind="ConfirmPassword" class="form-input" placeholder="Ulangi kata sandi baru" />
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="form-error-alert">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <span>@_errorMessage</span>
                </div>
            }
        </div>
    </BodyContent>

    <FooterContent>
        <div class="change-password-footer">
            <button type="button" class="btn-secondary" @onclick="Close">Batal</button>
            <button type="button" class="btn-primary" @onclick="Save">Simpan Perubahan</button>
        </div>
    </FooterContent>
</AppModal>

<style>
    .change-password-form {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .form-group label {
        font-size: var(--fs-xs, 12px);
        font-weight: var(--fw-semibold, 600);
        color: var(--color-neutral-600, #6E6E73);
    }
    .text-danger { color: var(--color-danger, #EF4444); }

    .form-input {
        width: 100%;
        height: 40px;
        padding: 0 12px;
        border: 1px solid var(--color-neutral-200, #E8E8ED);
        border-radius: var(--radius-sm, 8px);
        font-size: var(--fs-sm, 14px);
        background: var(--color-white, #FFFFFF);
        color: var(--color-navy, #0F172A);
        box-sizing: border-box;
        outline: none;
        transition: var(--motion-fast);
    }
    .form-input:focus {
        border-color: var(--color-primary, #F5A623);
    }
    body.dark-mode .form-input {
        background: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.1);
        color: var(--color-white, #FFFFFF);
    }

    .form-error-alert {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(239, 68, 68, 0.1);
        color: var(--color-danger, #EF4444);
        padding: 8px 12px;
        border-radius: var(--radius-sm, 8px);
        font-size: var(--fs-xs, 12px);
    }

    .change-password-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        width: 100%;
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string CurrentPassword { get; set; } = "";
    private string NewPassword { get; set; } = "";
    private string ConfirmPassword { get; set; } = "";
    private string _errorMessage = "";

    private async Task HandleVisibleChanged(bool val)
    {
        Visible = val;
        await VisibleChanged.InvokeAsync(val);
        if (!val && OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task Close()
    {
        _errorMessage = "";
        CurrentPassword = "";
        NewPassword = "";
        ConfirmPassword = "";
        await HandleVisibleChanged(false);
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(CurrentPassword))
        {
            _errorMessage = "Kata sandi saat ini wajib diisi.";
            return;
        }

        if (string.IsNullOrWhiteSpace(NewPassword) || NewPassword.Length < 6)
        {
            _errorMessage = "Kata sandi baru minimal 6 karakter.";
            return;
        }

        if (NewPassword != ConfirmPassword)
        {
            _errorMessage = "Konfirmasi kata sandi tidak cocok.";
            return;
        }

        _errorMessage = "";
        ToastService.Success("Kata Sandi Diperbarui", "Kata sandi Anda berhasil diubah.");
        await Close();
    }
}
