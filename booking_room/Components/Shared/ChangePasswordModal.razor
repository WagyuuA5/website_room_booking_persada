@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string CurrentPassword { get; set; } = "";
    private string NewPassword { get; set; } = "";
    private string ConfirmPassword { get; set; } = "";
    private bool _isToastVisible = false;

    private async Task Save()
    {
        _isToastVisible = true;
        StateHasChanged();

        await Task.Delay(1500);
        await OnClose.InvokeAsync();
    }
}

<div>
    @if (_isToastVisible)
    {
        <div class="save-toast">Perubahan berhasil disimpan</div>
    }
    <h3 class="modal-title">Ubah Kata Sandi</h3>
    <p class="modal-subtitle">Pastikan kata sandi Anda kuat dan belum pernah digunakan sebelumnya.</p>

    <div class="form-group">
        <label>Kata Sandi Saat Ini</label>
        <input type="password" @bind="CurrentPassword" class="form-control" />
    </div>

    <div class="form-group">
        <label>Kata Sandi Baru</label>
        <input type="password" @bind="NewPassword" class="form-control" />
    </div>

    <div class="form-group">
        <label>Konfirmasi Kata Sandi Baru</label>
        <input type="password" @bind="ConfirmPassword" class="form-control" />
    </div>

    <div class="modal-actions">
        <button class="btn btn-secondary" @onclick="OnClose">Batal</button>
        <button class="btn btn-primary" @onclick="Save">Simpan Perubahan</button>
    </div>
</div>

<style>
    .modal-title { font-size: 1.25rem; font-weight: 600; color: #16305C; margin-bottom: 0.5rem; }
    .modal-subtitle { font-size: 0.875rem; color: #6B7280; margin-bottom: 1.5rem; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; font-size: 0.875rem; font-weight: 500; color: #374151; margin-bottom: 0.25rem; }
    .form-control { width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.875rem; box-sizing: border-box; }
    .form-control:focus { outline: none; border-color: #16305C; box-shadow: 0 0 0 1px #16305C; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 2rem; }
    .btn { padding: 0.5rem 1rem; border-radius: 999px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: none; transition: background-color 0.2s; }
    .btn-secondary { background-color: #F3F4F6; color: #374151; }
    .btn-secondary:hover { background-color: #E5E7EB; }
    .btn-primary { background-color: #16305C; color: white; }
    .btn-primary:hover { background-color: #0F2346; }
    .btn-primary:focus-visible { outline: 2px solid #16305C; outline-offset: 2px; }

    .save-toast {
        position: fixed;
        bottom: 32px;
        left: 50%;
        transform: translateX(-50%);
        background-color: #10B981;
        color: #FFFFFF;
        padding: 12px 24px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 10px 25px rgba(16, 185, 129, 0.3);
        z-index: 1000;
        animation: toastFade 3s forwards;
    }

    @@keyframes toastFade {
        0% { opacity: 0; transform: translate(-50%, 20px); }
        10% { opacity: 1; transform: translate(-50%, 0); }
        90% { opacity: 1; transform: translate(-50%, 0); }
        100% { opacity: 0; transform: translate(-50%, -20px); }
    }
</style>