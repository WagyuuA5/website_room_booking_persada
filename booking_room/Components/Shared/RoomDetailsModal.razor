@using booking_room.Components.Models
@inject booking_room.Services.LoadingStateService LoadingState

<div class="room-details-v2">
    @if (_isLoading)
    {
        <div class="skeleton-shimmer" style="width: 100%; height: 100%; border-radius: 24px;"></div>
    }
    else if (Room != null)
    {
        <div class="rd-layout">
            <div class="rd-left">
                <div class="rd-badge @(Room.Status == "available" ? "rd-badge-available" : "rd-badge-booked")">
                    <span class="rd-dot @(Room.Status == "available" ? "rd-dot-available" : "rd-dot-booked")"></span>
                    @(Room.Status == "available" ? "Tersedia Sekarang" : "Dipesan")
                </div>
                
                <div class="rd-photo-wrapper">
                    <img src="@(string.IsNullOrEmpty(Room.PhotoUrl) ? "https://images.unsplash.com/photo-1556761175-5973dc0f32b7?auto=format&fit=crop&w=800&q=80" : Room.PhotoUrl)" alt="@Room.Name" class="rd-photo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                    <div class="rd-photo-placeholder" style="display:none; position:absolute; inset:0; align-items:center; justify-content:center; background:#f3f4f6;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    </div>
                </div>

                <div class="rd-floor-map-container">
                    <h4 class="rd-map-title">CARA MENUJU RUANGAN — @Room.Floor.ToUpper()</h4>
                    <svg class="rd-floor-map-svg" viewBox="0 0 400 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Lift / Lobby (Kiri) -->
                        <g transform="translate(10, 20)">
                            <rect x="0" y="0" width="60" height="60" rx="8" fill="#EFF6FF" stroke="#3B82F6" stroke-width="2" />
                            <text x="30" y="34" fill="#1D4ED8" font-size="12" font-weight="700" font-family="sans-serif" text-anchor="middle">LIFT</text>
                        </g>

                        <!-- Panah Penunjuk Arah (Tengah) -->
                        <path d="M 80 50 L 220 50" stroke="#94A3B8" stroke-width="2" stroke-dasharray="6 4" stroke-linecap="round" />
                        <polygon points="220,45 230,50 220,55" fill="#94A3B8" />

                        <!-- Ruangan Lain (Konteks) -->
                        <rect x="120" y="10" width="80" height="30" rx="4" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.5" />
                        <rect x="120" y="60" width="80" height="30" rx="4" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.5" />

                        <!-- Ruangan Target (Kanan, Highlighted) -->
                        <g transform="translate(250, 20)">
                            <rect x="0" y="0" width="120" height="60" rx="8" fill="#FEF3C7" stroke="#F59E0B" stroke-width="2.5" />
                            <text x="60" y="34" fill="#B45309" font-size="12" font-weight="700" font-family="sans-serif" text-anchor="middle">DI SINI</text>
                        </g>
                    </svg>
                </div>
            </div>

            <div class="rd-right">
                <div class="rd-content">
                    <h2 class="rd-title">@Room.Name</h2>
                    <div class="rd-location">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <span>@Room.Floor, Sayap Utara, Persada HQ</span>
                    </div>

                    <p class="rd-desc @(isDescriptionExpanded ? "rd-desc-expanded" : "")">
                        @Room.Description
                    </p>
                    <button class="rd-desc-toggle" @onclick="ToggleDescription">
                        @(isDescriptionExpanded ? "Sembunyikan detail" : "Lihat lebih detail")
                    </button>

                    <h3 class="rd-amenities-label">FASILITAS TERMASUK</h3>
                    
                    <div class="rd-amenities-grid">
                        <div class="rd-amenity">
                            <div class="rd-amenity-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12.55a11 11 0 0114.08 0"></path>
                                    <path d="M1.42 9a16 16 0 0121.16 0"></path>
                                    <path d="M8.53 16.11a6 6 0 016.95 0"></path>
                                    <circle cx="12" cy="20" r="1"></circle>
                                </svg>
                            </div>
                            <span>WiFi Berkecepatan Tinggi</span>
                        </div>
                        <div class="rd-amenity">
                            <div class="rd-amenity-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect>
                                    <polyline points="17 2 12 7 7 2"></polyline>
                                </svg>
                            </div>
                            <span>Layar 85 Inci</span>
                        </div>
                        <div class="rd-amenity">
                            <div class="rd-amenity-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="23 7 16 12 23 17 23 7"></polygon>
                                    <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                                </svg>
                            </div>
                            <span>Konferensi Video</span>
                        </div>
                        <div class="rd-amenity">
                            <div class="rd-amenity-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </div>
                            <span>Hingga @Room.Capacity Orang</span>
                        </div>
                    </div>
                </div>

                <div class="rd-footer" style="display: flex; gap: 16px; margin-top: 24px;">
                    <button class="btn-modal-outline" @onclick="OnClose">Batal</button>
                    <button class="btn-modal-primary" @onclick="HandleBookNow">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        Booking Sekarang
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .room-details-v2 {
        position: relative;
        width: 100%;
        max-width: 1000px;
        height: auto;
        min-height: 420px;
        max-height: 90vh;
        overflow: hidden;
        background: #FFFFFF;
        border-radius: 24px;
        box-shadow: 0 4px 24px rgba(16,48,92,0.08);
        font-family: 'Inter', 'Poppins', sans-serif;
    }

    .rd-layout {
        display: flex;
        width: 100%;
        height: 100%;
        border-radius: 24px;
        overflow: hidden;
    }

    .rd-left {
        width: 50%;
        position: relative;
        height: 100%;
        display: flex;
        flex-direction: column;
        border-right: 1px solid #E5E7EB;
        overflow-y: auto;
        background: #F8FAFC;
    }

    .rd-photo-wrapper {
        position: relative;
        width: 100%;
        height: 280px;
        flex-shrink: 0;
    }

    .rd-photo-placeholder {
        flex-direction: column;
        gap: 8px;
        color: #9ca3af;
        font-size: 12px;
        font-weight: 600;
    }

    .rd-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .rd-badge {
        position: absolute;
        top: 20px;
        left: 20px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        border-radius: 999px;
        color: #FFFFFF;
        font-size: 12px;
        font-weight: 500;
        z-index: 10;
    }

    .rd-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .rd-dot-available { background-color: #10B981; }
    .rd-dot-booked { background-color: #EF4444; }

    .rd-right {
        width: 50%;
        padding: 32px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: #FFFFFF;
        overflow-y: auto;
    }

    .rd-content {
        flex-grow: 1;
    }

    .rd-title {
        color: #16305C;
        font-size: 24px;
        font-weight: 700;
        margin: 0 0 8px 0;
        line-height: 1.2;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .rd-location {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #6B7280;
        font-size: 13px;
        margin-bottom: 16px;
    }

    .rd-desc {
        color: #6B7280;
        font-size: 14px;
        line-height: 1.5;
        margin: 0 0 24px 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    .rd-amenities-label {
        font-size: 11px;
        color: #9CA3AF;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0 0 12px 0;
        font-weight: 600;
    }

    .rd-amenities-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px 16px;
    }

    .rd-amenity {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-right: 8px;
    }

    .rd-amenity-icon {
        width: 36px;
        height: 36px;
        background: #F3F4F6;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .rd-amenity span {
        font-size: 13px;
        color: #4B5563;
        font-weight: 500;
        white-space: normal;
        word-wrap: break-word;
        overflow-wrap: break-word;
        line-height: 1.4;
    }

    .rd-footer {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 24px;
    }

    .rd-btn-book {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #EAB63C;
        color: #111827;
        font-weight: 600;
        font-size: 14px;
        border: none;
        padding: 12px 0;
        border-radius: 999px;
        cursor: pointer;
        transition: background 0.2s;
    }

    .rd-btn-book:hover {
        background: #DCA52B;
    }

    .rd-btn-cancel {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        color: #3B82F6;
        font-weight: 600;
        font-size: 14px;
        border: 1px solid #BFDBFE;
        padding: 12px 0;
        border-radius: 999px;
        cursor: pointer;
        transition: background 0.2s;
    }

    .rd-btn-cancel:hover {
        background: #EFF6FF;
    }

    .rd-desc-expanded {
        -webkit-line-clamp: unset;
        overflow: visible;
        display: block;
    }

    .rd-desc-toggle {
        background: none;
        border: none;
        color: #16305C;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        padding: 0;
        margin-bottom: 20px;
        font-family: 'Inter', 'Poppins', sans-serif;
    }

    .rd-floor-map-container {
        padding: 24px;
        background: #F8FAFC;
    }

    .rd-map-title {
        font-size: 11px;
        font-weight: 700;
        color: #64748B;
        margin: 0 0 16px 0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .rd-floor-map-svg {
        width: 100%;
        height: auto;
        display: block;
        background: white;
        border-radius: 12px;
        border: 1px solid #E2E8F0;
        padding: 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }

    @@media (max-width: 600px) {
        .rd-amenities-grid {
            grid-template-columns: 1fr;
        }
        .rd-floor-map-container {
            display: none; /* Hide on very small screens to not block image */
        }
    }
</style>

@code {
    [Parameter] public RoomItem? Room { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<RoomItem> OnBookNow { get; set; }

    private bool _isLoading = true;
    private bool isDescriptionExpanded = false;

    protected override async Task OnParametersSetAsync()
    {
        if (Room != null && _isLoading)
        {
            // Simulate fetch delay
            await Task.Delay(300);
            _isLoading = false;
        }
        else if (Room == null)
        {
            _isLoading = true; // reset loading if room becomes null so skeleton shows next time
        }
    }

    private async Task HandleBookNow()
    {
        if (Room != null)
        {
            await OnBookNow.InvokeAsync(Room);
        }
    }

    private void ToggleDescription()
    {
        isDescriptionExpanded = !isDescriptionExpanded;
    }
}
