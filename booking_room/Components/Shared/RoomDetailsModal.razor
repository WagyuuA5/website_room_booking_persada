@using booking_room.Components.Models
@inject booking_room.Services.LoadingStateService LoadingState

<div class="room-details-modal">
    @if (_isLoading)
    {
        <!-- Skeleton for Room Details -->
        <div class="room-details-layout">
            <div class="room-details-photo skeleton-shimmer" style="height: 100%; border-radius: 0;"></div>
            <div class="room-details-info">
                <div class="skeleton-shimmer skeleton-title" style="margin-bottom: 1rem; width: 60%;"></div>
                <div class="skeleton-shimmer skeleton-text" style="margin-bottom: 2rem; width: 40%;"></div>
                <div class="skeleton-shimmer skeleton-text" style="margin-bottom: 0.5rem;"></div>
                <div class="skeleton-shimmer skeleton-text" style="margin-bottom: 0.5rem;"></div>
                <div class="skeleton-shimmer skeleton-text" style="margin-bottom: 2rem; width: 80%;"></div>
                <div class="skeleton-shimmer skeleton-title" style="margin-bottom: 1rem; width: 50%;"></div>
                <div class="skeleton-grid" style="grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="skeleton-shimmer skeleton-text"></div>
                    <div class="skeleton-shimmer skeleton-text"></div>
                    <div class="skeleton-shimmer skeleton-text"></div>
                    <div class="skeleton-shimmer skeleton-text"></div>
                </div>
            </div>
        </div>
    }
    else if (Room != null)
    {
        <div class="room-details-layout content-fade-in">
            <!-- Kiri: Foto Ruangan -->
            <div class="room-details-photo-container">
                <button class="modal-close-btn photo-close-btn" @onclick="OnClose">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="photo-badge @(Room.Status == "available" ? "status-available" : "status-booked")">
                    <span class="status-dot @(Room.Status == "available" ? "available" : "booked")"></span>
                    @(Room.Status == "available" ? "Available Now" : "Booked")
                </div>
                <!-- Placeholder image for the room -->
                <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=800&q=80" alt="@Room.Name" class="room-details-img" />
            </div>

            <!-- Kanan: Informasi Detail -->
            <div class="room-details-content">
                <div class="room-details-body">
                    <h2 class="room-details-title">@Room.Name</h2>
                    <div class="room-details-location">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        @Room.Floor, Persada HQ
                    </div>
                    
                    <p class="room-details-desc">
                        @Room.Description
                        Peralatan presentasi lengkap dan pencahayaan alami yang sangat baik menjadikannya pilihan ideal untuk pertemuan penting dan sesi kolaborasi.
                    </p>

                    <h3 class="amenities-label">INCLUDED AMENITIES</h3>
                    <div class="amenities-grid">
                        <div class="amenity-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 12.55a11 11 0 0114.08 0M1.42 9a16 16 0 0121.16 0M8.53 16.11a6 6 0 016.95 0M12 20h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span>High-Speed Wi-Fi</span>
                        </div>
                        <div class="amenity-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2" y="7" width="20" height="15" rx="2" ry="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 2l-5 5-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span>TV Display</span>
                        </div>
                        <div class="amenity-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M23 7l-7 5 7 5V7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span>Video Conf</span>
                        </div>
                        <div class="amenity-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 7a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span>Kapasitas @Room.Capacity</span>
                        </div>
                    </div>
                </div>

                <div class="room-details-footer">
                    <button class="btn-cancel" @onclick="OnClose">Cancel</button>
                    <button class="btn-book-now" @onclick="HandleBookNow">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Book Now
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public RoomItem? Room { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<RoomItem> OnBookNow { get; set; }

    private bool _isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        if (Room != null && _isLoading)
        {
            // Simulate fetch delay to show skeleton
            await Task.Delay(300);
            _isLoading = false;
        }
    }

    private async Task HandleBookNow()
    {
        if (Room != null)
        {
            await OnBookNow.InvokeAsync(Room);
        }
    }
}
