@using booking_room.Components.Models
@inject booking_room.Services.LoadingStateService LoadingState

<div class="room-details-v2">
    @if (_isLoading)
    {
        <div class="skeleton-shimmer" style="width: 100%; height: 100%; border-radius: 24px;"></div>
    }
    else if (Room != null)
    {
        <div class="rd-header">
            <div class="rd-header-photo">
                <img src="@(string.IsNullOrEmpty(Room.PhotoUrl) ? "https://images.unsplash.com/photo-1556761175-5973dc0f32b7?auto=format&fit=crop&w=800&q=80" : Room.PhotoUrl)" alt="@Room.Name" class="rd-photo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                <div class="rd-photo-placeholder" style="display:none; position:absolute; inset:0; align-items:center; justify-content:center; background:#f3f4f6;">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                </div>
                <div class="rd-badge @(Room.Status == "available" ? "rd-badge-available" : "rd-badge-booked")">
                    <span class="rd-dot @(Room.Status == "available" ? "rd-dot-available" : "rd-dot-booked")"></span>
                    @(Room.Status == "available" ? "Tersedia Sekarang" : "Dipesan")
                </div>
            </div>
        </div>

        <div class="rd-body">
            <div class="rd-content">
                <h2 class="rd-title">@Room.Name</h2>
                <div class="rd-location">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>@Room.Floor, Sayap Utara, Persada HQ</span>
                </div>

                <div class="rd-section-divider"></div>

                <p class="rd-desc @(isDescriptionExpanded ? "rd-desc-expanded" : "")">
                    @Room.Description
                </p>
                <button class="rd-desc-toggle" @onclick="ToggleDescription">
                    @(isDescriptionExpanded ? "Sembunyikan detail" : "Lihat lebih detail")
                </button>

                <div class="rd-section-divider"></div>

                <h3 class="rd-amenities-label">FASILITAS TERMASUK</h3>
                
                <div class="rd-amenities-grid">
                    <div class="rd-amenity">
                        <div class="rd-amenity-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12.55a11 11 0 0114.08 0"></path>
                                <path d="M1.42 9a16 16 0 0121.16 0"></path>
                                <path d="M8.53 16.11a6 6 0 016.95 0"></path>
                                <circle cx="12" cy="20" r="1"></circle>
                            </svg>
                        </div>
                        <span>WiFi Berkecepatan Tinggi</span>
                    </div>
                    <div class="rd-amenity">
                        <div class="rd-amenity-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect>
                                <polyline points="17 2 12 7 7 2"></polyline>
                            </svg>
                        </div>
                        <span>Layar 85 Inci</span>
                    </div>
                    <div class="rd-amenity">
                        <div class="rd-amenity-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                            </svg>
                        </div>
                        <span>Konferensi Video</span>
                    </div>
                    <div class="rd-amenity">
                        <div class="rd-amenity-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <span>Hingga @Room.Capacity Orang</span>
                    </div>
                </div>

                <div class="rd-section-divider"></div>

                <h3 class="rd-amenities-label">CARA MENUJU RUANGAN</h3>
                <div class="rd-floor-map-container">
                    <svg class="rd-floor-map-svg" viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Latar Koridor -->
                        <path d="M 0 100 L 400 100" stroke="#CBD5E1" stroke-width="40" stroke-opacity="0.3" />
                        <path d="M 0 80 L 400 80 M 0 120 L 400 120" stroke="#94A3B8" stroke-width="1" stroke-dasharray="4 4" />
                        
                        <!-- Lift / Pintu Masuk (Kiri) -->
                        <g transform="translate(10, 55)">
                            <rect x="0" y="0" width="70" height="90" rx="8" fill="#EFF6FF" stroke="#3B82F6" stroke-width="2" />
                            <text x="35" y="28" fill="#1D4ED8" font-size="12" font-weight="700" font-family="sans-serif" text-anchor="middle">LIFT</text>
                            <svg x="22" y="38" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#1D4ED8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                <path d="M12 8v8" />
                                <path d="M8 12h8" />
                            </svg>
                            <text x="35" y="72" fill="#1D4ED8" font-size="10" font-weight="600" font-family="sans-serif" text-anchor="middle">Lantai 3</text>
                        </g>

                        <!-- Panah Rute -->
                        <path d="M 95 100 L 240 100" stroke="#3B82F6" stroke-width="3" stroke-dasharray="6 4" stroke-linecap="round" />
                        <polygon points="240,95 250,100 240,105" fill="#3B82F6" />

                        <!-- Ruangan Konteks -->
                        <rect x="105" y="15" width="90" height="60" rx="6" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.5" />
                        <text x="150" y="48" fill="#64748B" font-size="11" font-weight="600" font-family="sans-serif" text-anchor="middle">Konf. Room A</text>
                        
                        <rect x="105" y="125" width="90" height="60" rx="6" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.5" />
                        <text x="150" y="158" fill="#64748B" font-size="11" font-weight="600" font-family="sans-serif" text-anchor="middle">Lounge</text>

                        <!-- Ruangan Target (Kanan) -->
                        <g transform="translate(260, 10)">
                            <rect x="0" y="0" width="130" height="180" rx="10" fill="#FEF3C7" stroke="#F59E0B" stroke-width="3" />
                            <circle cx="65" cy="55" r="24" fill="#F59E0B" fill-opacity="0.2" />
                            <svg x="47" y="37" width="36" height="36" viewBox="0 0 24 24" fill="#F59E0B" stroke="#B45309" stroke-width="1.5">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3" fill="#FFF"></circle>
                            </svg>
                            <text x="65" y="105" fill="#B45309" font-size="15" font-weight="800" font-family="sans-serif" text-anchor="middle">DI SINI</text>
                            
                            <foreignObject x="12" y="120" width="106" height="50">
                                <div xmlns="http://www.w3.org/1999/xhtml" style="font-family: sans-serif; font-size: 11px; font-weight: 700; color: #92400E; text-align: center; line-height: 1.3; word-wrap: break-word;">
                                    @Room.Name
                                </div>
                            </foreignObject>
                        </g>
                    </svg>
                    <div class="rd-map-legend">
                        <div class="rd-map-legend-item">
                            <span class="rd-map-legend-color" style="background: #3B82F6;"></span>
                            <span>Lift</span>
                        </div>
                        <div class="rd-map-legend-item">
                            <span class="rd-map-legend-color" style="background: #F59E0B;"></span>
                            <span>Target</span>
                        </div>
                        <div class="rd-map-legend-item">
                            <span class="rd-map-legend-color" style="background: #E5E7EB; border: 1px solid #CBD5E1;"></span>
                            <span>Ruangan Lain</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="rd-footer">
            <button class="btn-modal-outline" @onclick="OnClose">Batal</button>
            <button class="btn-modal-primary" @onclick="HandleBookNow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                Pesan Sekarang
            </button>
        </div>
    }
</div>

<style>
    .room-details-v2 {
        position: relative;
        width: 100%;
        max-width: 1000px;
        max-height: 90vh;
        overflow: hidden;
        background: #FFFFFF;
        border-radius: 24px;
        box-shadow: 0 4px 24px rgba(16,48,92,0.08);
        font-family: 'Inter', 'Poppins', sans-serif;
        display: flex;
        flex-direction: column;
    }

    .rd-header {
        position: relative;
        width: 100%;
        height: 280px;
        flex-shrink: 0;
        overflow: hidden;
    }

    .rd-header-photo {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .rd-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .rd-badge {
        position: absolute;
        top: 20px;
        left: 20px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        border-radius: 999px;
        color: #FFFFFF;
        font-size: 12px;
        font-weight: 500;
        z-index: 10;
    }

    .rd-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .rd-dot-available { background-color: #10B981; }
    .rd-dot-booked { background-color: #EF4444; }

    .rd-body {
        flex: 1;
        overflow-y: auto;
        padding: 24px 32px;
    }

    .rd-content {
        max-width: 600px;
    }

    .rd-title {
        color: #16305C;
        font-size: 24px;
        font-weight: 700;
        margin: 0 0 8px 0;
        line-height: 1.2;
    }

    .rd-location {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #6B7280;
        font-size: 13px;
        margin-bottom: 16px;
    }

    .rd-section-divider {
        height: 1px;
        background: #E5E7EB;
        margin: 20px 0;
    }

    .rd-desc {
        color: #6B7280;
        font-size: 14px;
        line-height: 1.5;
        margin: 0;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    .rd-amenities-label {
        font-size: 11px;
        color: #9CA3AF;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0 0 12px 0;
        font-weight: 600;
    }

    .rd-amenities-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .rd-amenity {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px;
        background: #F8FAFC;
        border-radius: 10px;
        border: 1px solid #E5E7EB;
    }

    .rd-amenity-icon {
        width: 36px;
        height: 36px;
        background: #F3F4F6;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .rd-amenity span {
        font-size: 13px;
        color: #4B5563;
        font-weight: 500;
        white-space: normal;
        word-wrap: break-word;
        overflow-wrap: break-word;
        line-height: 1.4;
    }

    .rd-footer {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 32px 24px 32px;
        border-top: 1px solid #E5E7EB;
        background: #FFFFFF;
        flex-shrink: 0;
    }

    .rd-btn-book {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #EAB63C;
        color: #111827;
        font-weight: 600;
        font-size: 14px;
        border: none;
        padding: 12px 0;
        border-radius: 999px;
        cursor: pointer;
        transition: background 0.2s;
    }

    .rd-btn-book:hover {
        background: #DCA52B;
    }

    .rd-btn-cancel {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        color: #3B82F6;
        font-weight: 600;
        font-size: 14px;
        border: 1px solid #BFDBFE;
        padding: 12px 0;
        border-radius: 999px;
        cursor: pointer;
        transition: background 0.2s;
    }

    .rd-btn-cancel:hover {
        background: #EFF6FF;
    }

    .rd-desc-expanded {
        -webkit-line-clamp: unset;
        overflow: visible;
        display: block;
    }

    .rd-desc-toggle {
        background: none;
        border: none;
        color: #16305C;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        padding: 0;
        margin-bottom: 0;
        font-family: 'Inter', 'Poppins', sans-serif;
    }

    .rd-floor-map-container {
        padding: 16px;
        background: #F8FAFC;
        border-radius: 12px;
        border: 1px solid #E5E7EB;
    }

    .rd-map-title {
        font-size: 11px;
        font-weight: 700;
        color: #64748B;
        margin: 0 0 12px 0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .rd-floor-map-svg {
        width: 100%;
        height: auto;
        min-height: 160px;
        display: block;
        background: white;
        border-radius: 12px;
        border: 1px solid #E2E8F0;
        padding: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }

    .rd-map-legend {
        display: flex;
        gap: 16px;
        margin-top: 12px;
        justify-content: center;
    }

    .rd-map-legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        color: #64748b;
        font-weight: 600;
    }

    .rd-map-legend-color {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        flex-shrink: 0;
    }

    @@media (max-width: 600px) {
        .rd-amenities-grid {
            grid-template-columns: 1fr;
        }
        .rd-floor-map-container {
            display: none;
        }
        .rd-body {
            padding: 16px;
        }
        .rd-footer {
            padding: 12px 16px 20px 16px;
        }
    }

    @@media (min-width: 601px) and (max-width: 900px) {
        .room-details-v2 {
            max-width: 95vw;
        }
        .rd-header {
            height: 220px;
        }
    }
</style>

@code {
    [Parameter] public RoomItem? Room { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<RoomItem> OnBookNow { get; set; }

    private bool _isLoading = true;
    private bool isDescriptionExpanded = false;

    protected override async Task OnParametersSetAsync()
    {
        if (Room != null && _isLoading)
        {
            await Task.Delay(300);
            _isLoading = false;
        }
        else if (Room == null)
        {
            _isLoading = true;
        }
    }

    private async Task HandleBookNow()
    {
        if (Room != null)
        {
            await OnBookNow.InvokeAsync(Room);
        }
    }

    private void ToggleDescription()
    {
        isDescriptionExpanded = !isDescriptionExpanded;
    }
}