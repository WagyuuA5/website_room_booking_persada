@using booking_room.Components.Models
@inject booking_room.Services.LoadingStateService LoadingState

<div class="room-details-v2">
    @if (_isLoading)
    {
        <div class="skeleton-shimmer" style="width: 100%; height: 100%; border-radius: 24px;"></div>
    }
    else if (Room != null)
    {
        <div class="rd-layout">
            <div class="rd-left">
                <div class="rd-badge @(Room.Status == "available" ? "rd-badge-available" : "rd-badge-booked")">
                    <span class="rd-dot @(Room.Status == "available" ? "rd-dot-available" : "rd-dot-booked")"></span>
                    @(Room.Status == "available" ? "Tersedia" : "Dipesan")
                </div>
                
                <img src="https://images.unsplash.com/photo-1556761175-5973dc0f32b7?auto=format&fit=crop&w=800&q=80" alt="@Room.Name" class="rd-photo" />
            </div>

            <div class="rd-right">
                <div class="rd-content">
                    <h2 class="rd-title">@Room.Name</h2>
                    <div class="rd-location">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <span>Lantai @Room.Floor, Persada HQ</span>
                    </div>

                    <p class="rd-desc">
                        @Room.Description
                        Boardroom andalan kami dirancang untuk rapat eksekutif berisiko tinggi. Menampilkan konferensi video 4K, audio terintegrasi, dan tempat duduk ergonomis hingga 12 orang.
                    </p>

                    <h3 class="rd-amenities-label">FASILITAS TERMASUK</h3>
                    
                    <div class="rd-amenities-grid">
                        <div class="rd-amenity">
                            <div class="rd-amenity-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12.55a11 11 0 0114.08 0"></path>
                                    <path d="M1.42 9a16 16 0 0121.16 0"></path>
                                    <path d="M8.53 16.11a6 6 0 016.95 0"></path>
                                    <circle cx="12" cy="20" r="1"></circle>
                                </svg>
                            </div>
                            <span>Wi-Fi Berkecepatan Tinggi</span>
                        </div>
                        <div class="rd-amenity">
                            <div class="rd-amenity-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect>
                                    <polyline points="17 2 12 7 7 2"></polyline>
                                </svg>
                            </div>
                            <span>Layar 85"</span>
                        </div>
                        <div class="rd-amenity">
                            <div class="rd-amenity-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="23 7 16 12 23 17 23 7"></polygon>
                                    <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                                </svg>
                            </div>
                            <span>Konferensi Video</span>
                        </div>
                        <div class="rd-amenity">
                            <div class="rd-amenity-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </div>
                            <span>Hingga @Room.Capacity Pax</span>
                        </div>
                    </div>
                </div>

                <div class="rd-footer">
                    <button class="rd-btn-book" @onclick="HandleBookNow">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        Pesan Sekarang
                    </button>
                    <button class="rd-btn-cancel" @onclick="OnClose">Batal</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .room-details-v2 {
        position: relative;
        width: 100%;
        max-width: 750px;
        height: 420px;
        background: #FFFFFF;
        border-radius: 24px;
        box-shadow: 0 4px 24px rgba(16,48,92,0.08);
        font-family: 'Inter', 'Poppins', sans-serif;
    }

    .rd-layout {
        display: flex;
        width: 100%;
        height: 100%;
        border-radius: 24px;
        overflow: hidden;
    }

    .rd-left {
        width: 50%;
        position: relative;
        height: 100%;
    }

    .rd-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .rd-badge {
        position: absolute;
        top: 20px;
        left: 20px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        border-radius: 999px;
        color: #FFFFFF;
        font-size: 12px;
        font-weight: 500;
        z-index: 10;
    }

    .rd-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .rd-dot-available { background-color: #10B981; }
    .rd-dot-booked { background-color: #EF4444; }

    .rd-right {
        width: 50%;
        padding: 32px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: #FFFFFF;
    }

    .rd-content {
        flex-grow: 1;
    }

    .rd-title {
        color: #16305C;
        font-size: 24px;
        font-weight: 700;
        margin: 0 0 8px 0;
        line-height: 1.2;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .rd-location {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #6B7280;
        font-size: 13px;
        margin-bottom: 16px;
    }

    .rd-desc {
        color: #6B7280;
        font-size: 14px;
        line-height: 1.5;
        margin: 0 0 24px 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .rd-amenities-label {
        font-size: 11px;
        color: #9CA3AF;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0 0 12px 0;
        font-weight: 600;
    }

    .rd-amenities-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px 12px;
    }

    .rd-amenity {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .rd-amenity-icon {
        width: 36px;
        height: 36px;
        background: #F3F4F6;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .rd-amenity span {
        font-size: 13px;
        color: #4B5563;
        font-weight: 500;
        white-space: nowrap;
    }

    .rd-footer {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 24px;
    }

    .rd-btn-book {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #EAB63C;
        color: #111827;
        font-weight: 600;
        font-size: 14px;
        border: none;
        padding: 12px 0;
        border-radius: 999px;
        cursor: pointer;
        transition: background 0.2s;
    }

    .rd-btn-book:hover {
        background: #DCA52B;
    }

    .rd-btn-cancel {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        color: #3B82F6;
        font-weight: 600;
        font-size: 14px;
        border: 1px solid #BFDBFE;
        padding: 12px 0;
        border-radius: 999px;
        cursor: pointer;
        transition: background 0.2s;
    }

    .rd-btn-cancel:hover {
        background: #EFF6FF;
    }
</style>

@code {
    [Parameter] public RoomItem? Room { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<RoomItem> OnBookNow { get; set; }

    private bool _isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        if (Room != null && _isLoading)
        {
            // Simulate fetch delay
            await Task.Delay(300);
            _isLoading = false;
        }
    }

    private async Task HandleBookNow()
    {
        if (Room != null)
        {
            await OnBookNow.InvokeAsync(Room);
        }
    }
}
