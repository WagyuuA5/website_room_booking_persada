@using booking_room.Components.Models
@inject booking_room.Services.LoadingStateService LoadingState

<div class="room-details-v6">
    @if (_isLoading)
    {
        <div class="skeleton-shimmer" style="width: 100%; height: 100%; border-radius: var(--modal-radius-outer, 28px);"></div>
    }
    else if (Room != null)
    {
        <div class="rd-split-layout">
            <!-- Left: Photo -->
            <div class="rd-photo-column">
                <div class="rd-photo-wrap">
                    <img src="@(string.IsNullOrEmpty(Room.PhotoUrl) ? "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=800&q=80" : Room.PhotoUrl)" alt="@Room.Name" class="rd-photo-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                    <div class="rd-photo-placeholder" style="display:none; position:absolute; inset:0; align-items:center; justify-content:center; background:#f3f4f6;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    </div>
                    <div class="rd-photo-overlay">
                        <span class="rd-status-badge @(Room.Status == "available" ? "rd-badge-available" : "rd-badge-booked")">
                            <span class="rd-status-dot @(Room.Status == "available" ? "rd-dot-available" : "rd-dot-booked")"></span>
                            @(Room.Status == "available" ? "Tersedia Sekarang" : "Dipesan")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Right: Info -->
            <div class="rd-info-column">
                <div class="rd-info-content">
                    <h2 class="rd-room-name">@Room.Name</h2>
                    <div class="rd-location-row">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <span>@Room.Floor, Sayap Utara, Persada HQ</span>
                    </div>

                    <p class="rd-description">@Room.Description</p>

                    <div class="rd-amenities-section">
                        <h3 class="rd-section-label">FASILITAS TERMASUK</h3>
                        <div class="rd-amenities-grid">
                            <div class="rd-amenity-item">
                                <div class="rd-amenity-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M5 12.55a11 11 0 0114.08 0"></path>
                                        <path d="M1.42 9a16 16 0 0121.16 0"></path>
                                        <path d="M8.53 16.11a6 6 0 016.95 0"></path>
                                        <circle cx="12" cy="20" r="1"></circle>
                                    </svg>
                                </div>
                                <span>WiFi</span>
                            </div>
                            <div class="rd-amenity-item">
                                <div class="rd-amenity-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect>
                                        <polyline points="17 2 12 7 7 2"></polyline>
                                    </svg>
                                </div>
                                <span>Layar 85 Inci</span>
                            </div>
                            <div class="rd-amenity-item">
                                <div class="rd-amenity-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="23 7 16 12 23 17 23 7"></polygon>
                                        <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                                    </svg>
                                </div>
                                <span>Konferensi Video</span>
                            </div>
                            <div class="rd-amenity-item">
                                <div class="rd-amenity-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                </div>
                                <span>Hingga @Room.Capacity Orang</span>
                            </div>
                        </div>
                    </div>

                    <div class="rd-actions-row">
                        <button class="btn-book-now" @onclick="HandleBookNow">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            Pesan Sekarang
                        </button>
                        <button class="btn-cancel-outline" @onclick="OnClose">
                            Tutup
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .room-details-v6 {
        position: relative;
        width: 100%;
        max-width: 100%;
        min-height: 420px;
        max-height: 90vh;
        overflow: hidden;
        background: #FFFFFF;
        border-radius: var(--modal-radius-outer, 28px);
        box-shadow: var(--shadow-modal);
        font-family: 'Inter', 'Poppins', sans-serif;
        display: flex;
        flex-direction: column;
    }

    .rd-split-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 420px;
    }

    .rd-photo-column {
        position: relative;
        overflow: hidden;
        min-height: 300px;
    }

    .rd-photo-wrap {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 300px;
    }

    .rd-photo-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        inset: 0;
    }

    .rd-photo-overlay {
        position: absolute;
        top: 16px;
        left: 16px;
        z-index: 10;
    }

    .rd-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        backdrop-filter: blur(8px);
    }

    .rd-badge-available {
        background: rgba(16, 185, 129, 0.2);
        color: #1AA262;
        border: 1px solid rgba(26, 162, 98, 0.3);
    }

    .rd-badge-booked {
        background: rgba(229, 72, 77, 0.2);
        color: #E5484D;
        border: 1px solid rgba(229, 72, 77, 0.3);
    }

    .rd-status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .rd-dot-available { background-color: #1AA262; }
    .rd-dot-booked { background-color: #E5484D; }

    .rd-info-column {
        display: flex;
        flex-direction: column;
        padding: 24px;
        gap: 16px;
    }

    .rd-info-content {
        display: flex;
        flex-direction: column;
        gap: 16px;
        flex: 1;
    }

    .rd-room-name {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--color-brand-navy, #0F1F3D);
        margin: 0;
        line-height: 1.2;
        letter-spacing: -0.02em;
    }

    .rd-location-row {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--color-brand-text-muted, #6B7280);
        font-size: 0.875rem;
        font-weight: 500;
    }

    .rd-location-row svg {
        color: #9CA3AF;
    }

    .rd-description {
        color: var(--color-brand-text-muted, #6B7280);
        font-size: 0.875rem;
        line-height: 1.6;
        margin: 0;
    }

    .rd-amenities-section {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .rd-section-label {
        font-size: 0.6875rem;
        font-weight: 700;
        color: #9CA3AF;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin: 0;
    }

    .rd-amenities-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .rd-amenity-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        background: var(--surface-card, #FFFFFF);
        border-radius: 12px;
        border: 1px solid var(--color-brand-gray-border, #E5E7EB);
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--color-brand-navy, #0F1F3D);
    }

    .rd-amenity-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #F3F4F6;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #6B7280;
    }

    .rd-actions-row {
        display: flex;
        gap: 12px;
        margin-top: auto;
        padding-top: 8px;
    }

    .btn-book-now {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 999px;
        background: var(--color-brand-gold-500, #F5B301);
        color: var(--color-brand-navy-900, #0F1B3D);
        font-weight: 700;
        font-size: 0.9375rem;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-book-now:hover {
        background: var(--color-brand-gold-600, #E0A400);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(245, 179, 1, 0.3);
    }

    .btn-cancel-outline {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 999px;
        background: transparent;
        color: var(--color-brand-blue, #1F5D9A);
        font-weight: 700;
        font-size: 0.9375rem;
        border: 1.5px solid #BFDBFE;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-cancel-outline:hover {
        background: #EFF6FF;
    }

    @@media (max-width: 768px) {
        .rd-split-layout {
            grid-template-columns: 1fr;
        }
        .rd-photo-column {
            min-height: 200px;
        }
        .rd-photo-wrap {
            min-height: 200px;
        }
    }
</style>

@code {
    [Parameter] public RoomItem? Room { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<RoomItem> OnBookNow { get; set; }

    private bool _isLoading = true;

    protected override void OnParametersSet()
    {
        if (Room != null)
        {
            _isLoading = false;
        }
        else
        {
            _isLoading = true;
        }
    }

    private async Task HandleBookNow()
    {
        if (Room != null)
        {
            await OnBookNow.InvokeAsync(Room);
        }
    }
}
