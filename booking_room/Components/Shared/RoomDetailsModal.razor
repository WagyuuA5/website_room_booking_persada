@using booking_room.Components.Models
@using booking_room.Services
@inject LoadingStateService LoadingState

<AppModal Visible="@Visible" Size="lg" ShowHeader="false" ShowFooter="false" ShowCloseButton="true" OnClose="CloseModal">
    <BodyContent>
        <div class="rdm-container">
            <!-- Kolom Kiri CASE 1: Foto 16:7 + Peta Denah 120px min-height + padding 16px + gap 12px & 16px -->
            <div class="rdm-left-col">
                <div class="rdm-photo-box">
                    <img src="@(string.IsNullOrEmpty(Room?.PhotoUrl) ? "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=800&q=80" : Room.PhotoUrl)" 
                         alt="@Room?.Name" class="rdm-photo" />
                </div>

                <div class="rdm-map-box">
                    <div class="map-grid-header">
                        <span class="map-label">DENAH LOKASI RUANGAN</span>
                        <span class="map-badge">@(string.IsNullOrEmpty(Room?.Floor) ? "Lantai 3, Sayap Barat" : Room.Floor)</span>
                    </div>
                    <div class="map-grid-visual">
                        <div class="map-zone other">ZONA A</div>
                        <div class="map-zone active">@Room?.Name (LOKASI INI)</div>
                        <div class="map-zone other">ZONA B</div>
                        <div class="map-zone other">LOBBY / LIFT</div>
                    </div>
                </div>
            </div>

            <!-- Kolom Kanan: Detail Informasi, Fasilitas, & Aksi Pemesanan -->
            <div class="rdm-right-col">
                <div class="rdm-header-info">
                    <div class="rdm-title-row">
                        <h2 class="rdm-title">@Room?.Name</h2>
                        <span class="rdm-status-pill @(Room?.Status == "available" ? "available" : "booked")">
                            @(Room?.Status == "available" ? "Tersedia" : "Dipesan")
                        </span>
                    </div>
                    <p class="rdm-floor-text">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <span>Gedung Utama, @(string.IsNullOrEmpty(Room?.Floor) ? "Lantai 3" : Room.Floor)</span>
                    </p>
                </div>

                <div class="rdm-specs-row">
                    <div class="rdm-spec-card">
                        <span class="spec-label">KAPASITAS</span>
                        <span class="spec-value">@Room?.Capacity Orang</span>
                    </div>
                    <div class="rdm-spec-card">
                        <span class="spec-label">TIPE RUANGAN</span>
                        <span class="spec-value">Rapat & Konferensi</span>
                    </div>
                </div>

                <div class="rdm-desc-box">
                    <span class="section-micro-label">DESKRIPSI RUANGAN</span>
                    <p class="rdm-desc-text">
                        @(string.IsNullOrEmpty(Room?.Description) ? "Ruangan berstandar modern yang dilengkapi dengan fasilitas lengkap untuk mendukung presentasi, rapat harian, dan konferensi virtual." : Room.Description)
                    </p>
                </div>

                <div class="rdm-amenities-box">
                    <span class="section-micro-label">FASILITAS TERSEDIA</span>
                    <div class="amenities-chips-wrap">
                        @if (Room?.Amenities != null && Room.Amenities.Any())
                        {
                            @foreach (var amenity in Room.Amenities)
                            {
                                <div class="amenity-badge">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span>@amenity</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="amenity-badge"><span>WiFi Cepat</span></div>
                            <div class="amenity-badge"><span>TV LED 4K</span></div>
                            <div class="amenity-badge"><span>Papan Tulis</span></div>
                            <div class="amenity-badge"><span>Pendingin Ruangan (AC)</span></div>
                        }
                    </div>
                </div>

                <div class="rdm-action-footer">
                    <button type="button" class="btn-rdm-close" @onclick="CloseModal">Tutup</button>
                    @if (Room?.Status == "available")
                    {
                        <button type="button" class="btn-rdm-book" @onclick="HandleBook">Pesan Ruangan Ini</button>
                    }
                </div>
            </div>
        </div>
    </BodyContent>
</AppModal>

<style>
    .rdm-container {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 24px;
        align-items: start;
        height: auto;
    }

    /* CASE 1: Left column layout strictly sized */
    .rdm-left-col {
        display: flex;
        flex-direction: column;
        gap: 12px;
        height: auto;
    }

    .rdm-photo-box {
        width: 100%;
        aspect-ratio: 16 / 7;
        border-radius: 12px;
        overflow: hidden;
        background: #F1F5F9;
        box-shadow: 0 2px 8px rgba(15, 31, 61, 0.06);
    }
    .rdm-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .rdm-map-box {
        width: 100%;
        min-height: 120px;
        padding: 16px;
        box-sizing: border-box;
        border-radius: 12px;
        background: #F8FAFC;
        border: 1.5px solid #E2E8F0;
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 4px;
    }
    body.dark-mode .rdm-map-box {
        background: rgba(15, 23, 42, 0.5);
        border-color: rgba(255, 255, 255, 0.08);
    }

    .map-grid-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .map-label {
        font-size: 0.6875rem;
        font-weight: 700;
        color: #64748B;
        letter-spacing: 0.05em;
    }
    .map-badge {
        font-size: 0.6875rem;
        font-weight: 700;
        background: #EFF6FF;
        color: #1F5D9A;
        padding: 2px 8px;
        border-radius: 999px;
    }
    body.dark-mode .map-badge {
        background: rgba(31, 93, 154, 0.3);
        color: #93C5FD;
    }

    .map-grid-visual {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }
    .map-zone {
        padding: 10px 8px;
        border-radius: 8px;
        font-size: 0.6875rem;
        font-weight: 700;
        text-align: center;
    }
    .map-zone.other {
        background: #FFFFFF;
        border: 1px dashed #CBD5E1;
        color: #94A3B8;
    }
    body.dark-mode .map-zone.other {
        background: rgba(30, 41, 59, 0.4);
        border-color: rgba(255, 255, 255, 0.1);
    }
    .map-zone.active {
        background: #1F5D9A;
        color: #FFFFFF;
        box-shadow: 0 2px 6px rgba(31, 93, 154, 0.3);
    }

    /* Right column */
    .rdm-right-col {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .rdm-title-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }
    .rdm-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--persada-navy-900, #0F1F3D);
        margin: 0;
    }
    body.dark-mode .rdm-title { color: #F8FAFC; }

    .rdm-status-pill {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 999px;
    }
    .rdm-status-pill.available { background: #DCFCE7; color: #15803D; }
    .rdm-status-pill.booked { background: #FEF3C7; color: #D97706; }

    .rdm-floor-text {
        font-size: 0.8125rem;
        color: var(--persada-text-secondary, #6B7280);
        margin: 4px 0 0 0;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .rdm-specs-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }
    .rdm-spec-card {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 10px 12px;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    body.dark-mode .rdm-spec-card {
        background: rgba(15, 23, 42, 0.5);
        border-color: rgba(255, 255, 255, 0.08);
    }
    .spec-label {
        font-size: 0.625rem;
        font-weight: 700;
        color: #94A3B8;
        letter-spacing: 0.05em;
    }
    .spec-value {
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--persada-navy-900, #0F1F3D);
    }
    body.dark-mode .spec-value { color: #F8FAFC; }

    .section-micro-label {
        font-size: 0.6875rem;
        font-weight: 700;
        color: #94A3B8;
        letter-spacing: 0.05em;
        display: block;
        margin-bottom: 6px;
    }
    .rdm-desc-text {
        font-size: 0.8125rem;
        color: var(--persada-text-secondary, #4B5563);
        line-height: 1.5;
        margin: 0;
    }
    body.dark-mode .rdm-desc-text { color: #CBD5E1; }

    .amenities-chips-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }
    .amenity-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--persada-text-primary, #374151);
    }
    body.dark-mode .amenity-badge {
        background: rgba(30, 41, 59, 0.5);
        border-color: rgba(255, 255, 255, 0.08);
        color: #CBD5E1;
    }

    .rdm-action-footer {
        display: flex;
        gap: 10px;
        margin-top: 8px;
        padding-top: 14px;
        border-top: 1px solid var(--divider-subtle, #F1F5F9);
    }
    body.dark-mode .rdm-action-footer { border-color: rgba(255, 255, 255, 0.08); }

    .btn-rdm-close {
        flex: 1;
        height: 40px;
        border-radius: 999px;
        background: transparent;
        border: 1.5px solid #CBD5E1;
        font-size: 0.8125rem;
        font-weight: 700;
        color: #475569;
        cursor: pointer;
    }
    body.dark-mode .btn-rdm-close {
        border-color: rgba(255, 255, 255, 0.2);
        color: #CBD5E1;
    }
    .btn-rdm-book {
        flex: 1.5;
        height: 40px;
        border-radius: 999px;
        background: #1F5D9A;
        border: none;
        font-size: 0.8125rem;
        font-weight: 700;
        color: #FFFFFF;
        cursor: pointer;
        transition: background 0.15s ease;
    }
    .btn-rdm-book:hover { background: #164879; }

    @@media (max-width: 768px) {
        .rdm-container { grid-template-columns: 1fr; }
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public RoomItem? Room { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnBook { get; set; }

    private async Task CloseModal()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleBook()
    {
        if (OnBook.HasDelegate)
        {
            await OnBook.InvokeAsync();
        }
    }
}


