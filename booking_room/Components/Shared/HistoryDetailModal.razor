@using booking_room.Components.Models

<div class="history-detail-modal" @onclick:stopPropagation="true">
    @if (Booking != null)
    {
        <!-- Header Image Full Width -->
        <div class="detail-hero-image" style="background-image: url('@Booking.PhotoUrl'); background-color: #f3f4f6;">
        </div>

        <div class="detail-modal-body">
            <div class="detail-header-row">
                <div class="detail-title-col">
                    <h2 class="detail-room-title">@Booking.RoomName</h2>
                    <span class="detail-room-floor">@Booking.Floor</span>
                </div>
                <div class="detail-status-col">
                    <span class="detail-status-badge @GetStatusClass()">
                        @BookingDataStore.GetStatusLabel(Booking.Status)
                    </span>
                </div>
            </div>

            <!-- Info Cards Grid -->
            <div class="info-cards-container">
                <div class="info-card-blue">
                    <div class="info-icon-circle">
                        <!-- Calendar Icon -->
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="info-card-text">
                        <span class="info-label">TANGGAL</span>
                        <span class="info-value">@Booking.Date</span>
                    </div>
                </div>

                <div class="info-card-blue">
                    <div class="info-icon-circle">
                        <!-- Clock Icon -->
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="info-card-text">
                        <span class="info-label">WAKTU</span>
                        <span class="info-value">@Booking.TimeSlot</span>
                    </div>
                </div>

                <div class="info-card-blue">
                    <div class="info-icon-circle">
                        <!-- Users Icon -->
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="info-card-text">
                        <span class="info-label">PESERTA</span>
                        <span class="info-value">@Booking.Attendees Peserta</span>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

<style>
    .history-detail-modal {
        width: 100%;
        max-width: 440px;
        background: #FFFFFF;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(16,48,92,0.08);
        font-family: 'Inter', sans-serif;
    }
    .detail-hero-image {
        width: 100%;
        height: 180px;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        position: relative;
    }
    .modal-close-btn-round {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(4px);
        border: none;
        color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .modal-close-btn-round:hover {
        background-color: rgba(255, 255, 255, 0.4);
    }
    .detail-modal-body {
        padding: 24px;
    }
    .detail-header-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
        gap: 16px;
    }
    .detail-title-col {
        flex: 1;
    }
    .detail-room-title {
        color: #16305C;
        font-size: 24px;
        font-weight: 700;
        margin: 0 0 4px 0;
        line-height: 1.2;
    }
    .detail-room-floor {
        color: #6B7280;
        font-size: 14px;
        display: block;
    }
    .detail-status-col {
        flex-shrink: 0;
    }
    .detail-status-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
    }
    .detail-status-badge.badge-completed {
        background-color: #DBEAFE;
        color: #1E40AF;
    }
    .detail-status-badge.badge-rejected {
        background-color: #FEE2E2;
        color: #991B1B;
    }
    .detail-status-badge.badge-approved {
        background-color: #D1FAE5;
        color: #065F46;
    }
    .detail-status-badge.badge-pending {
        background-color: #FEF3C7;
        color: #92400E;
    }

    .info-cards-container {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .info-card-blue {
        background-color: #F0F4FF;
        border-radius: 12px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .info-icon-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #E2E8F0;
        color: #16305C;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .info-card-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .info-label {
        color: #6B7280;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .info-value {
        color: #16305C;
        font-size: 15px;
        font-weight: 700;
    }
</style>

@code {
    [Parameter] public BookingItem? Booking { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string GetStatusClass()
    {
        return BookingDataStore.GetStatusBadgeClass(Booking?.Status ?? "completed");
    }
}
