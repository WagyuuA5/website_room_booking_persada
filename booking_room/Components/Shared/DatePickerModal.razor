@namespace booking_room.Components.Shared
@using System.Globalization

<AppModal Visible="@Visible" VisibleChanged="HandleVisibleChanged" LayoutMode="list" Size="sm" ShowHeader="true" Title="Pilih Tanggal" Subtitle="Kapan rapat Anda berlangsung?" ShowCloseButton="false" OnClose="HandleCancel">
    <IconContent>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
    </IconContent>
    <BodyContent>
        <div class="date-picker-container">
            <h3 class="date-picker-title">Pilih Tanggal</h3>

            <div class="date-picker-header">
                <button type="button" class="nav-btn" @onclick="PrevMonth" aria-label="Bulan Sebelumnya">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                <div class="current-month">@_currentMonth.ToString("MMMM yyyy", _culture)</div>
                <button type="button" class="nav-btn" @onclick="NextMonth" aria-label="Bulan Berikutnya">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
            </div>

            <div class="calendar-grid">
                <div class="weekday">M</div>
                <div class="weekday">S</div>
                <div class="weekday">S</div>
                <div class="weekday">R</div>
                <div class="weekday">K</div>
                <div class="weekday">J</div>
                <div class="weekday">S</div>

                @foreach (var day in GetDaysInMonth())
                {
                    <button type="button" class="day-btn @(day.IsOtherMonth ? "other-month" : "") @(day.Date.Date == DateTime.Today ? "today" : "") @(day.Date.Date == _tempSelectedDate?.Date ? "selected" : "")" 
                            @onclick="() => SelectDate(day.Date)">
                        @day.Date.Day
                    </button>
                }
            </div>
        </div>
    </BodyContent>
    <FooterContent>
        <div class="date-picker-footer">
            <button type="button" class="btn-text-cancel" @onclick="HandleCancel">Batal</button>
            <button type="button" class="btn-picker-confirm" @onclick="ConfirmSelection">@ConfirmText</button>
        </div>
    </FooterContent>
</AppModal>

<style>
    .date-picker-container {
        padding: 8px 4px;
    }
    .date-picker-title {
        font-size: var(--fs-h3, 20px);
        line-height: var(--lh-h3, 26px);
        font-weight: var(--fw-bold, 700);
        color: var(--color-navy, #0F172A);
        margin: 0 0 16px 0;
    }
    body.dark-mode .date-picker-title { color: var(--color-white, #FFFFFF); }

    .date-picker-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }
    .current-month {
        font-weight: var(--fw-bold, 700);
        font-size: var(--fs-base, 16px);
        color: var(--color-navy, #0F172A);
        text-transform: capitalize;
    }
    body.dark-mode .current-month { color: var(--color-white, #FFFFFF); }

    .nav-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1px solid var(--color-neutral-200, #E8E8ED);
        background: transparent;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--color-neutral-600, #6E6E73);
        transition: var(--motion-fast);
    }
    .nav-btn:hover {
        background: var(--color-neutral-100, #F5F5F7);
        color: var(--color-navy, #0F172A);
    }
    body.dark-mode .nav-btn {
        border-color: rgba(255,255,255,0.1);
        color: var(--color-neutral-400, #86868B);
    }
    body.dark-mode .nav-btn:hover {
        background: rgba(255,255,255,0.1);
        color: var(--color-white, #FFFFFF);
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
        text-align: center;
    }
    .weekday {
        font-size: var(--fs-xs, 12px);
        font-weight: var(--fw-bold, 700);
        color: var(--color-neutral-400, #86868B);
        padding: 6px 0;
    }
    .day-btn {
        width: 36px;
        height: 36px;
        margin: 0 auto;
        border-radius: 50%;
        border: none;
        background: transparent;
        font-size: var(--fs-sm, 14px);
        font-weight: var(--fw-semibold, 600);
        color: var(--color-navy, #0F172A);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--motion-fast);
    }
    body.dark-mode .day-btn { color: var(--color-white, #FFFFFF); }

    .day-btn:hover:not(.selected) {
        background: var(--color-neutral-100, #F5F5F7);
    }
    body.dark-mode .day-btn:hover:not(.selected) {
        background: rgba(255,255,255,0.1);
    }

    .day-btn.other-month {
        color: var(--color-neutral-400, #86868B);
        opacity: 0.5;
    }
    .day-btn.today {
        border: 1px solid var(--color-primary, #F5A623);
    }
    .day-btn.selected {
        background: var(--color-navy, #0F172A) !important;
        color: var(--color-white, #FFFFFF) !important;
    }
    body.dark-mode .day-btn.selected {
        background: var(--color-primary, #F5A623) !important;
        color: var(--color-navy, #0F172A) !important;
    }

    .date-picker-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }
    .btn-text-cancel {
        background: transparent;
        border: none;
        color: var(--color-danger, #EF4444);
        font-size: var(--fs-sm, 14px);
        font-weight: var(--fw-semibold, 600);
        cursor: pointer;
        padding: 8px 12px;
    }
    .btn-text-cancel:hover {
        text-decoration: underline;
    }

    .btn-picker-confirm {
        background: var(--color-navy, #0F172A);
        color: var(--color-white, #FFFFFF);
        border: none;
        border-radius: var(--radius-full, 999px);
        padding: 8px 20px;
        font-size: var(--fs-sm, 14px);
        font-weight: var(--fw-semibold, 600);
        cursor: pointer;
        transition: var(--motion-fast);
    }
    .btn-picker-confirm:hover {
        opacity: 0.9;
    }
    body.dark-mode .btn-picker-confirm {
        background: var(--color-primary, #F5A623);
        color: var(--color-navy, #0F172A);
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public DateTime? SelectedDate { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback<DateTime?> OnDateSelected { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "Pilih Tanggal";

    private DateTime _currentMonth = DateTime.Today;
    private DateTime? _tempSelectedDate;
    private CultureInfo _culture = new CultureInfo("id-ID");

    protected override void OnInitialized()
    {
        _tempSelectedDate = SelectedDate ?? DateTime.Today;
        if (SelectedDate.HasValue)
        {
            _currentMonth = new DateTime(SelectedDate.Value.Year, SelectedDate.Value.Month, 1);
        }
        else
        {
            _currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        }
    }

    private async Task HandleVisibleChanged(bool val)
    {
        Visible = val;
        await VisibleChanged.InvokeAsync(val);
        if (!val)
        {
            await OnCancel.InvokeAsync();
        }
    }

    private async Task HandleCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnCancel.InvokeAsync();
    }

    private async Task ConfirmSelection()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnDateSelected.InvokeAsync(_tempSelectedDate);
    }

    private void PrevMonth()
    {
        _currentMonth = _currentMonth.AddMonths(-1);
    }

    private void NextMonth()
    {
        _currentMonth = _currentMonth.AddMonths(1);
    }

    private void SelectDate(DateTime date)
    {
        _tempSelectedDate = date;
    }

    private class CalendarDay
    {
        public DateTime Date { get; set; }
        public bool IsOtherMonth { get; set; }
    }

    private List<CalendarDay> GetDaysInMonth()
    {
        var days = new List<CalendarDay>();
        var firstDayOfMonth = new DateTime(_currentMonth.Year, _currentMonth.Month, 1);
        var daysInMonth = DateTime.DaysInMonth(_currentMonth.Year, _currentMonth.Month);
        
        int startDayOfWeek = (int)firstDayOfMonth.DayOfWeek;
        
        var prevMonth = firstDayOfMonth.AddMonths(-1);
        var daysInPrevMonth = DateTime.DaysInMonth(prevMonth.Year, prevMonth.Month);
        for (int i = startDayOfWeek - 1; i >= 0; i--)
        {
            days.Add(new CalendarDay 
            { 
                Date = new DateTime(prevMonth.Year, prevMonth.Month, daysInPrevMonth - i),
                IsOtherMonth = true 
            });
        }
        
        for (int i = 1; i <= daysInMonth; i++)
        {
            days.Add(new CalendarDay 
            { 
                Date = new DateTime(_currentMonth.Year, _currentMonth.Month, i),
                IsOtherMonth = false 
            });
        }
        
        int remainingCells = 42 - days.Count;
        if (remainingCells >= 7 && days.Count == 35) remainingCells = 0;
        if (remainingCells >= 7) remainingCells -= 7;

        var nextMonth = firstDayOfMonth.AddMonths(1);
        for (int i = 1; i <= remainingCells; i++)
        {
            days.Add(new CalendarDay 
            { 
                Date = new DateTime(nextMonth.Year, nextMonth.Month, i),
                IsOtherMonth = true 
            });
        }
        
        return days;
    }
}

