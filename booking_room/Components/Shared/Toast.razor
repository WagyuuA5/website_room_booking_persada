@namespace booking_room.Components.Shared
@using booking_room.Services
@inject IToastService ToastService
@implements IDisposable

@if (ToastService.ActiveToasts.Any())
{
    <div class="dynamic-island-toast-host">
        @foreach (var toast in ToastService.ActiveToasts)
        {
            <div class="island-toast-item" key="@toast.Id">
                <IslandCapsule State="compact"
                               AccentColor="@toast.AccentColor"
                               Title="@toast.Title"
                               Subtitle="@toast.Message"
                               CompactText="@toast.Title"
                               BadgeText="@toast.BadgeText"
                               ShowCloseButton="true"
                               OnClose="() => ToastService.Remove(toast.Id)">
                    <ChildContent>
                        @if (!string.IsNullOrEmpty(toast.Message))
                        {
                            <div style="font-size: 0.8125rem; color: #E5E7EB; margin-top: 4px;">@toast.Message</div>
                        }
                    </ChildContent>
                </IslandCapsule>
            </div>
        }
    </div>
}

<style>
    .dynamic-island-toast-host {
        position: fixed;
        top: 24px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        pointer-events: none;
    }

    .island-toast-item {
        pointer-events: auto;
        animation: toastDropIn 0.35s var(--island-spring, cubic-bezier(0.34, 1.56, 0.64, 1)) forwards;
    }

    @@keyframes toastDropIn {
        from {
            opacity: 0;
            transform: translateY(-24px) scale(0.9);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ToastService.OnChange -= StateHasChanged;
    }
}
