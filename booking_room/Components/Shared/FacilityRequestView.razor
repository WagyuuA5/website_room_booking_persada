@using booking_room.Components.Models
@inject NavigationManager Navigation

<style>
    .facility-request-view {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .facility-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .facility-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--persada-navy-900);
        margin: 0;
    }

    .facility-subtitle {
        font-size: 0.875rem;
        color: #6B7280;
        margin: 4px 0 0 0;
    }

    .btn-facility-new {
        background: var(--persada-yellow-500);
        color: var(--persada-navy-900);
        border: none;
        padding: 10px 20px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-facility-new:hover {
        background: var(--accent-amber-hover);
        transform: translateY(-1px);
    }

    .facility-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 16px;
    }

    .facility-card {
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: 16px;
        padding: 20px;
        box-shadow: var(--shadow-sm);
        transition: all 0.2s;
    }

    .facility-card:hover {
        box-shadow: var(--shadow-md);
        border-color: #CBD5E1;
    }

    .facility-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 12px;
    }

    .facility-card-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1E293B;
        margin: 0;
    }

    .facility-card-badge {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 999px;
        white-space: nowrap;
    }

    .badge-pending {
        background: #FEF3C7;
        color: #92400E;
    }

    .badge-approved {
        background: #D1FAE5;
        color: #065F46;
    }

    .badge-rejected {
        background: #FEE2E2;
        color: #991B1B;
    }

    .badge-progress {
        background: #DBEAFE;
        color: #1E40AF;
    }

    .facility-card-body {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .facility-card-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        color: #4B5563;
    }

    .facility-card-row svg {
        color: #9CA3AF;
        flex-shrink: 0;
    }

    .facility-card-footer {
        margin-top: 16px;
        padding-top: 12px;
        border-top: 1px solid #F3F4F6;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .facility-card-date {
        font-size: 0.75rem;
        color: #9CA3AF;
        font-weight: 500;
    }

    .facility-card-id {
        font-size: 0.7rem;
        color: #6B7280;
        font-weight: 600;
    }

    .facility-empty {
        text-align: center;
        padding: 60px 20px;
        background: #fff;
        border: 1px dashed #E5E7EB;
        border-radius: 16px;
    }

    .facility-empty svg {
        color: #CBD5E1;
        margin-bottom: 16px;
    }

    .facility-empty-title {
        font-size: 1rem;
        font-weight: 700;
        color: #64748B;
        margin: 0 0 8px 0;
    }

    .facility-empty-desc {
        font-size: 0.85rem;
        color: #94A3B8;
        margin: 0;
    }

    

    .form-group {
        margin-bottom: 16px;
    }

    .form-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
    }

    .form-input {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        font-size: 0.875rem;
        color: #111827;
        background: #fff;
        outline: none;
        transition: border-color 0.2s;
    }

    .form-input:focus {
        border-color: #EAB63C;
        box-shadow: 0 0 0 2px rgba(234, 182, 60, 0.2);
    }

    textarea.form-input {
        resize: vertical;
        min-height: 80px;
        padding: 12px;
    }

    .form-select {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        font-size: 0.875rem;
        color: #111827;
        background: #fff;
        outline: none;
        appearance: none;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 24px;
    }

    .btn-cancel {
        background: #fff;
        border: 1px solid #D1D5DB;
        color: #374151;
        padding: 10px 20px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.875rem;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-cancel:hover {
        background: #F9FAFB;
    }

    .btn-submit {
        background: #EAB63C;
        border: 1px solid #EAB63C;
        color: #111827;
        padding: 10px 20px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.875rem;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-submit:hover {
        background: #D9A02A;
    }
</style>

<div class="facility-request-view">
    <div class="facility-header">
        <div>
            <h2 class="facility-title">Permintaan Fasilitas</h2>
            <p class="facility-subtitle">Kelola permintaan fasilitas tambahan untuk ruangan Anda</p>
        </div>
        <button class="btn-facility-new" @onclick="OpenNewRequest">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Permintaan Baru
        </button>
    </div>

    <div class="facility-table-wrapper" style="margin-top: 24px;">
        <booking_room.Components.Shared.DataGrid TItem="FacilityRequest"
                                                 Data="_requests"
                                                 Columns="gridColumns"
                                                 IsLoading="false"
                                                 SearchPlaceholder="Cari permintaan fasilitas..."
                                                 FileNamePrefix="fasilitas" OnRowClick="ShowRequestDetail" />
    </div>

    @if (_showNewRequestModal)
    {
                <AppModal Visible="true" Size="md" ShowCloseButton="false" OnClose="CloseNewRequest">
            <BodyContent>
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <h3 class="modal-title">Permintaan Fasilitas Baru</h3>
                        <p class="modal-subtitle">Sampaikan kebutuhan fasilitas tambahan untuk admin</p>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Ruangan</label>
                        <select class="form-select" @bind="_newRoomName">
                            <option value="" disabled>Pilih ruangan</option>
                            <option value="Executive Boardroom A">Executive Boardroom A</option>
                            <option value="Training Ruangan B">Training Ruangan B</option>
                            <option value="Huddle Space C">Huddle Space C</option>
                            <option value="Studio Webinar">Studio Webinar</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Fasilitas yang Diminta</label>
                        <input type="text" class="form-input" placeholder="Contoh: Proyektor tambahan, Podium, Whiteboard" @bind="_newFacility" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Tanggal</label>
                        <input type="date" class="form-input" @bind="_newDate" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Catatan Tambahan</label>
                        <textarea class="form-input" placeholder="Jelaskan kebutuhan fasilitas secara detail..." @bind="_newNote"></textarea>
                    </div>
                </div>
            </BodyContent>
            <FooterContent>
                <div class="modal-actions" style="width: 100%; display: flex; gap: 12px; margin-top: 16px;">
                    <button class="btn btn-secondary" style="flex: 1;" @onclick="CloseNewRequest">Batal</button>
                    <button class="btn btn-primary" style="flex: 1;" @onclick="SubmitNewRequest">Kirim Permintaan</button>
                </div>
            </FooterContent>
        </AppModal>
    }
</div>


@if (_showRequestDetail && _selectedRequest != null)
{
    <AppModal Visible="true" Size="md" ShowCloseButton="false" OnClose="CloseRequestDetail">
        <BodyContent>
            <div style="display: flex; flex-direction: column; gap: 16px;">
                <div>
                    <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #0F1F3D;">Detail Permintaan</h3>
                    <p style="margin: 4px 0 0 0; color: #6B7280; font-size: 0.875rem;">ID: @_selectedRequest.RequestId</p>
                </div>
                
                <div style="display: grid; grid-template-columns: 1fr; gap: 12px; background: #F8FAFC; padding: 16px; border-radius: 12px; border: 1px solid #E2E8F0;">
                    <div>
                        <span style="display: block; font-size: 0.75rem; font-weight: 700; color: #9CA3AF; margin-bottom: 2px;">FASILITAS</span>
                        <span style="font-size: 0.875rem; font-weight: 700; color: #1F2937;">@_selectedRequest.Facility</span>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div>
                            <span style="display: block; font-size: 0.75rem; font-weight: 700; color: #9CA3AF; margin-bottom: 2px;">RUANGAN</span>
                            <span style="font-size: 0.875rem; font-weight: 600; color: #4B5563;">@_selectedRequest.RoomName</span>
                        </div>
                        <div>
                            <span style="display: block; font-size: 0.75rem; font-weight: 700; color: #9CA3AF; margin-bottom: 2px;">STATUS</span>
                            <span style="font-size: 0.875rem; font-weight: 700; color: #1F2937;">@_selectedRequest.Status</span>
                        </div>
                    </div>
                    <div>
                        <span style="display: block; font-size: 0.75rem; font-weight: 700; color: #9CA3AF; margin-bottom: 2px;">TANGGAL & WAKTU</span>
                        <span style="font-size: 0.875rem; font-weight: 600; color: #4B5563;">@_selectedRequest.Date • @_selectedRequest.TimeSlot</span>
                    </div>
                    <div>
                        <span style="display: block; font-size: 0.75rem; font-weight: 700; color: #9CA3AF; margin-bottom: 2px;">PEMOHON</span>
                        <span style="font-size: 0.875rem; font-weight: 600; color: #4B5563;">Anda (Budi Santoso) - Divisi IT</span>
                    </div>
                </div>
            </div>
        </BodyContent>
        <FooterContent>
            <button class="btn-secondary-app" style="width: 100%;" @onclick="CloseRequestDetail">Tutup</button>
        </FooterContent>
    </AppModal>
}

@code {
    private bool _showRequestDetail = false;
    private FacilityRequest? _selectedRequest;

    private void ShowRequestDetail(FacilityRequest request)
    {
        _selectedRequest = request;
        _showRequestDetail = true;
    }

    private void CloseRequestDetail()
    {
        _showRequestDetail = false;
        _selectedRequest = null;
    }
    private bool _showNewRequestModal = false;
    private string _newRoomName = "";
    private string _newFacility = "";
    private DateTime? _newDate = DateTime.Today;
    private string _newNote = "";

    private List<FacilityRequest> _requests = new()
    {
        new("FRQ-001", "Proyektor 4K Tambahan", "Executive Boardroom A", "Senin, 25 Ags 2026", "09:00 - 11:00", "Menunggu", "25 Ags 2026"),
        new("FRQ-002", "Podium & Mikrofon Wireless", "Training Ruangan B", "Selasa, 26 Ags 2026", "13:00 - 16:00", "Disetujui", "24 Ags 2026"),
        new("FRQ-003", "Whiteboard Glass", "Huddle Space C", "Rabu, 27 Ags 2026", "10:00 - 12:00", "Diproses", "23 Ags 2026")
    };
    
    private List<booking_room.Components.Shared.GridColumn<FacilityRequest>> gridColumns = new();

    protected override void OnInitialized()
    {
        gridColumns = new List<booking_room.Components.Shared.GridColumn<FacilityRequest>>
        {
            new booking_room.Components.Shared.GridColumn<FacilityRequest>
            {
                Title = "ID",
                PropertyName = "RequestId",
                ValueFunc = r => r.RequestId
            },
            new booking_room.Components.Shared.GridColumn<FacilityRequest>
            {
                Title = "FASILITAS",
                PropertyName = "Facility",
                ValueFunc = r => r.Facility
            },
            new booking_room.Components.Shared.GridColumn<FacilityRequest>
            {
                Title = "RUANGAN",
                PropertyName = "RoomName",
                ValueFunc = r => r.RoomName
            },
            new booking_room.Components.Shared.GridColumn<FacilityRequest>
            {
                Title = "TANGGAL",
                PropertyName = "Date",
                ValueFunc = r => r.Date
            },
            new booking_room.Components.Shared.GridColumn<FacilityRequest>
            {
                Title = "STATUS",
                PropertyName = "Status",
                ValueFunc = r => r.Status,
                CellTemplate = req => builder =>
                {
                    var badgeClass = req.Status switch
                    {
                        "Menunggu" => "badge-pending",
                        "Disetujui" => "badge-approved",
                        "Ditolak" => "badge-rejected",
                        "Diproses" => "badge-progress",
                        _ => "badge-pending"
                    };
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", $"facility-card-badge {badgeClass}");
                    builder.AddContent(2, req.Status);
                    builder.CloseElement();
                }
            }
        };
    }

    private void OpenNewRequest()
    {
        _showNewRequestModal = true;
        _newRoomName = "";
        _newFacility = "";
        _newDate = DateTime.Today;
        _newNote = "";
    }

    private void CloseNewRequest()
    {
        _showNewRequestModal = false;
    }

    private void SubmitNewRequest()
    {
        if (string.IsNullOrWhiteSpace(_newRoomName) || string.IsNullOrWhiteSpace(_newFacility))
            return;

        var id = $"FRQ-{_requests.Count + 1:D3}";
        var newReq = new FacilityRequest(
            id,
            _newFacility,
            _newRoomName,
            _newDate?.ToString("dddd, dd MMM yyyy") ?? "Tanpa tanggal",
            "Segera",
            "Menunggu",
            DateTime.Today.ToString("dd MMM yyyy")
        );

        _requests.Insert(0, newReq);
        CloseNewRequest();
    }

    public record FacilityRequest(string RequestId, string Facility, string RoomName, string Date, string TimeSlot, string Status, string CreatedAt);
}




