@namespace booking_room.Components.Shared
@using booking_room.Services
@inject IModalService ModalService

<AppModal Visible="true" Size="sm" ShowCloseButton="false" OnClose="HandleCancel">
    <HeaderContent>
        <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 40px; height: 40px; border-radius: 12px; background: rgba(245, 158, 11, 0.12); display: flex; align-items: center; justify-content: center; color: #B45309; flex-shrink: 0;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
            </div>
            <div>
                <h3 style="margin: 0; font-size: 1.15rem; font-weight: 800; color: var(--persada-navy-900, #0F1F3D);">Minta Tambahan Waktu</h3>
                <p style="margin: 2px 0 0 0; font-size: 0.85rem; color: #64748B;">@(string.IsNullOrWhiteSpace(RoomName) ? "Alpha Boardroom" : RoomName)</p>
            </div>
        </div>
    </HeaderContent>
    <ChildContent>
        <div style="display: flex; flex-direction: column; gap: 1.15rem;">
            <!-- Info Alert Box -->
            <div style="display: flex; align-items: flex-start; gap: 0.75rem; background-color: var(--surface-card, #FFFFFF); border: 1px solid rgba(245, 158, 11, 0.4); border-radius: 12px; padding: 0.875rem 1rem;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                <p style="font-size: 0.825rem; line-height: 1.45; color: #475569; margin: 0;">
                    Anda dapat memperpanjang jendela check-in tepat 10 menit. Tindakan ini hanya dapat dilakukan satu kali per pesanan.
                </p>
            </div>

            <!-- Form Field -->
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                <label style="font-size: 0.875rem; font-weight: 600; color: #334155; margin: 0;">
                    Alasan perpanjangan <span style="color: #EF4444; font-weight: 700;">*</span>
                </label>
                <textarea class="form-control"
                          rows="3"
                          placeholder="cth., Sedang di perjalanan, Rapat sebelumnya belum selesai"
                          style="width: 100%; border: 1px solid #CBD5E1; border-radius: 12px; padding: 0.75rem; font-size: 0.875rem; outline: none;"
                          @bind="_reason"
                          @bind:event="oninput"></textarea>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-secondary-app" @onclick="HandleCancel">
            Batal
        </button>
        <button type="button"
                class="btn-primary-app"
                disabled="@string.IsNullOrWhiteSpace(_reason)"
                @onclick="SubmitExtension">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
            </svg>
            Tambah 10 menit
        </button>
    </FooterContent>
</AppModal>

@code {
    [Parameter] public string RoomName { get; set; } = "Alpha Boardroom";
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnRequestExtension { get; set; }

    private string _reason = "";

    private async Task HandleCancel()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
        else if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
        await ModalService.CloseTopAsync(ModalResult.Cancel());
    }

    private async Task SubmitExtension()
    {
        if (!string.IsNullOrWhiteSpace(_reason))
        {
            if (OnRequestExtension.HasDelegate)
            {
                await OnRequestExtension.InvokeAsync(_reason.Trim());
            }
            await ModalService.CloseTopAsync(ModalResult.Ok(_reason.Trim()));
        }
    }
}


