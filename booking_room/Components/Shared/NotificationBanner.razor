<div class="notification-banner @(IsActionRequired ? "action-required" : "reminder")">
    <div class="banner-content">
        @if (IsActionRequired)
        {
            <div class="banner-icon-circle">
                <svg width="12" height="13" viewBox="0 0 12 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3.52571 1.42236V0.000157833H7.53679V1.42236H3.52571ZM4.82427 8.06984H6.23823V4.54511H4.82427V8.06984ZM5.53125 13.0085C4.76784 13.0085 4.05125 12.8631 3.38147 12.5723C2.71169 12.2815 2.12624 11.8869 1.62513 11.3885C1.12401 10.8901 0.728037 10.3061 0.437215 9.63629C0.146393 8.96651 0.000981882 8.24991 0.000981882 7.48651C0.000981882 6.7231 0.146393 6.0065 0.437215 5.33673C0.728037 4.66695 1.12401 4.0815 1.62513 3.58038C2.12624 3.07926 2.71169 2.68329 3.38147 2.39247C4.05125 2.10165 4.76784 1.95624 5.53125 1.95624C6.14502 1.95624 6.73998 2.05346 7.31613 2.2479C7.89227 2.44235 8.42615 2.72704 8.91776 3.10198L9.83334 2.1864L10.8396 3.19266L9.92402 4.10824C10.299 4.59985 10.5823 5.13235 10.774 5.70575C10.9657 6.27915 11.0615 6.87274 11.0615 7.48651C11.0615 8.24991 10.9161 8.96651 10.6253 9.63629C10.3345 10.3061 9.93849 10.8901 9.43737 11.3885C8.93626 11.8869 8.35081 12.2815 7.68103 12.5723C7.01125 12.8631 6.29466 13.0085 5.53125 13.0085ZM5.53125 11.4627C6.63705 11.4627 7.57756 11.0764 8.3528 10.3039C9.12805 9.53145 9.51567 8.5923 9.51567 7.48651C9.51567 6.38071 9.12805 5.44019 8.3528 4.66495C7.57756 3.88971 6.63705 3.50209 5.53125 3.50209C4.42545 3.50209 3.48494 3.88971 2.7097 4.66495C1.93446 5.44019 1.54683 6.38071 1.54683 7.48651C1.54683 8.5923 1.93446 9.53145 2.7097 10.3039C3.48494 11.0764 4.42545 11.4627 5.53125 11.4627Z" fill="#0f1f3d"/>
                </svg>
            </div>
            <div class="banner-text">
                <strong>Action Required</strong>
                <p>Check-in within @RemainingTimeFormatted or the slot will be released automatically.</p>
            </div>
            <button class="banner-btn-checkin" @onclick="CheckInNow">Check-in Now →</button>
        }
        else
        {
            <span class="banner-bullet">•</span>
            <span class="banner-text">@ReminderText</span>
            <button class="banner-link" @onclick="Dismiss">Later</button>
            <button class="banner-btn-checkin" @onclick="CheckInNow">Check-in Now</button>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsActionRequired { get; set; }
    [Parameter] public string ReminderText { get; set; } = string.Empty;
    [Parameter] public EventCallback OnDismiss { get; set; }
    [Parameter] public EventCallback OnCheckIn { get; set; }

    [Parameter] public DateTime? TargetTime { get; set; }

    private string RemainingTimeFormatted = "00:00";
    private Timer? _countdownTimer;

    protected override void OnInitialized()
    {
        if (IsActionRequired && TargetTime.HasValue)
        {
            UpdateRemainingTime();
            _countdownTimer = new Timer(_ =>
            {
                UpdateRemainingTime();
                InvokeAsync(StateHasChanged);
            }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
    }

    private void UpdateRemainingTime()
    {
        if (TargetTime.HasValue)
        {
            var remaining = TargetTime.Value - DateTime.Now;
            if (remaining <= TimeSpan.Zero)
            {
                RemainingTimeFormatted = "00:00";
            }
            else
            {
                RemainingTimeFormatted = remaining.ToString(@"mm\:ss");
            }
        }
    }

    private async Task Dismiss()
    {
        _countdownTimer?.Dispose();
        await OnDismiss.InvokeAsync();
    }

    private async Task CheckInNow()
    {
        _countdownTimer?.Dispose();
        await OnCheckIn.InvokeAsync();
    }

    public void Dispose()
    {
        _countdownTimer?.Dispose();
    }
}
