@implements IDisposable

<div class="notification-banner @(BannerType == booking_room.Services.NotificationState.BannerType.ActionRequired ? "action-required" : "reminder")">
    <div class="banner-content">
        @if (BannerType == booking_room.Services.NotificationState.BannerType.ActionRequired)
        {
            <div class="banner-icon-circle">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="13" r="9" stroke="#0f1f3d" stroke-width="2"/>
                    <path d="M12 8V13L15.5 15" stroke="#0f1f3d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M9 2H15" stroke="#0f1f3d" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </div>
            <div class="banner-text">
                <strong>Tindakan Diperlukan</strong>
                <p>Konfirmasi kehadiran dalam <strong>@RemainingTimeFormatted</strong> atau slot akan otomatis dilepas.</p>
            </div>
            <button class="banner-btn-checkin" @onclick="CheckInNow">Konfirmasi Kehadiran Sekarang →</button>
        }
        else
        {
            <div class="banner-icon-circle">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="9" stroke="#f59e0b" stroke-width="2"/>
                    <path d="M12 7v5l3 3" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <span class="banner-bullet">•</span>
            <span class="banner-text">Akan datang: Alpha Room pukul 09:00 (15 menit lagi)</span>
            <button class="banner-link" @onclick="Dismiss">Nanti</button>
            <button class="banner-btn-checkin" @onclick="CheckInNow">Konfirmasi Kehadiran Sekarang</button>
        }
    </div>
    @if (BannerType == booking_room.Services.NotificationState.BannerType.ActionRequired && countdownPercentage > 0)
    {
        <div class="banner-countdown-bar" style="width: @countdownPercentage.ToString("0.0")%;"></div>
    }
</div>

@code {
    [Parameter] public booking_room.Services.NotificationState.BannerType BannerType { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }
    [Parameter] public EventCallback OnCheckIn { get; set; }

    [Parameter] public DateTime? TargetTime { get; set; }

    private string RemainingTimeFormatted = "00:00";
    private double countdownPercentage = 100;
    private double totalSeconds = 0;
    private System.Threading.Timer? _countdownTimer;

    protected override void OnParametersSet()
    {
        if (BannerType == booking_room.Services.NotificationState.BannerType.ActionRequired && TargetTime.HasValue)
        {
            if (_countdownTimer == null)
            {
                totalSeconds = (TargetTime.Value - DateTime.Now).TotalSeconds;
                UpdateRemainingTime();
                _countdownTimer = new System.Threading.Timer(_ =>
                {
                    UpdateRemainingTime();
                    InvokeAsync(StateHasChanged);
                }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
            }
        }
        else
        {
            _countdownTimer?.Dispose();
            _countdownTimer = null;
        }
    }

    private void UpdateRemainingTime()
    {
        if (TargetTime.HasValue)
        {
            var remaining = TargetTime.Value - DateTime.Now;
            if (remaining <= TimeSpan.Zero)
            {
                RemainingTimeFormatted = "00:00";
                countdownPercentage = 0;
            }
            else
            {
                RemainingTimeFormatted = remaining.ToString(@"mm\:ss");
                countdownPercentage = totalSeconds > 0 ? (remaining.TotalSeconds / totalSeconds) * 100 : 0;
            }
        }
    }

    private async Task Dismiss()
    {
        _countdownTimer?.Dispose();
        await OnDismiss.InvokeAsync();
    }

    private async Task CheckInNow()
    {
        _countdownTimer?.Dispose();
        await OnCheckIn.InvokeAsync();
    }

    public void Dispose()
    {
        _countdownTimer?.Dispose();
    }
}
