@namespace booking_room.Components.Shared
@inject IJSRuntime JS

@if (Visible)
{
    <div class="modal-unified-backdrop @BackdropClass" @onclick="HandleBackdropClick">
        <div class="modal-unified-dialog @GetSizeClass() @DialogClass" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            @if (ShowHeader && (HeaderContent != null || !string.IsNullOrEmpty(Title) || ShowCloseButton))
            {
                <div class="modal-unified-header">
                    @if (HeaderContent != null)
                    {
                        @HeaderContent
                    }
                    else
                    {
                        <div class="modal-unified-header-text">
                            @if (!string.IsNullOrEmpty(Title))
                            {
                                <h3 class="modal-unified-title">@Title</h3>
                            }
                            @if (!string.IsNullOrEmpty(Subtitle))
                            {
                                <p class="modal-unified-subtitle">@Subtitle</p>
                            }
                        </div>
                    }

                    @if (ShowCloseButton)
                    {
                        <button class="modal-unified-close-btn" @onclick="CloseAsync" type="button" aria-label="Tutup modal">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    }
                </div>
            }

            <div class="modal-unified-body @BodyClass">
                @if (BodyContent != null)
                {
                    @BodyContent
                }
                else if (ChildContent != null)
                {
                    @ChildContent
                }
            </div>

            @if (ShowFooter && FooterContent != null)
            {
                <div class="modal-unified-footer">
                    @FooterContent
                </div>
            }
        </div>
    </div>
}

<style>
    .modal-unified-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 31, 61, 0.55);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 16px;
        overflow-y: auto;
        animation: modalFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .modal-unified-dialog {
        position: relative;
        background: var(--persada-white, #FFFFFF);
        border-radius: var(--radius-modal, 20px);
        box-shadow: var(--shadow-modal);
        width: 100%;
        max-height: calc(100vh - 32px);
        max-height: var(--modal-max-height, 90vh);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        margin: auto;
        animation: modalScaleUp 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Size variants */
    .modal-size-sm { max-width: var(--modal-max-width-sm, 440px); }
    .modal-size-md { max-width: var(--modal-max-width-md, 560px); }
    .modal-size-lg { max-width: var(--modal-max-width-lg, 720px); }
    .modal-size-xl { max-width: var(--modal-max-width-xl, 960px); }

    .modal-unified-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--persada-white, #FFFFFF);
        padding: 20px 24px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        border-bottom: 1px solid var(--color-brand-gray-border, #E5E7EB);
        flex-shrink: 0;
    }

    .modal-unified-header-text {
        flex: 1;
        min-width: 0;
    }

    .modal-unified-title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-brand-navy, #0F1F3D);
        line-height: 1.3;
    }

    .modal-unified-subtitle {
        margin: 4px 0 0 0;
        font-size: 0.875rem;
        color: var(--color-brand-text-muted, #6B7280);
        line-height: 1.4;
    }

    .modal-unified-close-btn {
        background: transparent;
        border: none;
        padding: 6px;
        color: #9CA3AF;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .modal-unified-close-btn:hover {
        background-color: #F3F4F6;
        color: var(--color-brand-navy, #0F1F3D);
    }

    .modal-unified-body {
        flex: 1 1 auto;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 24px;
        -webkit-overflow-scrolling: touch;
    }

    .modal-unified-footer {
        position: sticky;
        bottom: 0;
        z-index: 10;
        background: var(--persada-white, #FFFFFF);
        padding: 16px 24px;
        border-top: 1px solid var(--color-brand-gray-border, #E5E7EB);
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        flex-shrink: 0;
    }

    @@keyframes modalFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes modalScaleUp {
        from {
            opacity: 0;
            transform: scale(0.96) translateY(8px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @@media (max-width: 640px) {
        .modal-unified-backdrop {
            padding: 8px;
        }
        .modal-unified-dialog {
            max-height: 94vh;
            border-radius: 16px;
        }
        .modal-unified-header {
            padding: 16px 20px;
        }
        .modal-unified-body {
            padding: 20px;
        }
        .modal-unified-footer {
            padding: 14px 20px;
        }
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string Size { get; set; } = "md"; // sm, md, lg, xl
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowFooter { get; set; } = true;
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;
    [Parameter] public string BackdropClass { get; set; } = string.Empty;
    [Parameter] public string DialogClass { get; set; } = string.Empty;
    [Parameter] public string BodyClass { get; set; } = string.Empty;

    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? BodyContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string GetSizeClass() => Size switch
    {
        "sm" => "modal-size-sm",
        "lg" => "modal-size-lg",
        "xl" => "modal-size-xl",
        _ => "modal-size-md"
    };

    private async Task HandleBackdropClick()
    {
        if (CloseOnBackdropClick)
        {
            await CloseAsync();
        }
    }

    private async Task CloseAsync()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
