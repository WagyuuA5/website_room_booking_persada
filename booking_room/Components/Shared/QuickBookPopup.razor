@using booking_room.Components.Models
@inject NavigationManager Navigation

<div class="modal-header-custom">
    <div class="modal-header-left">
        <div class="modal-header-icon icon-navy">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M11 21H5C3.9 21 3 20.1 3 19V5C3 3.9 3.9 3 5 3H19C20.1 3 21 3.9 21 5V11.5" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M7 7H17M7 11H13M7 15H11" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                <circle cx="18" cy="18" r="4" fill="#f59e0b"/>
                <path d="M16.5 18L17.5 19L19.5 17" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <div class="modal-header-info">
            <h3>Pesan Ruangan — @RoomName</h3>
            <p>Tersedia dalam @AvailableInMinutes menit • Kapasitas @Capacity orang</p>
        </div>
    </div>
</div>

<div class="modal-body-custom">
    <p style="font-size: 0.85rem; color: #64748b; margin: 0 0 16px 0; font-weight: 500;">Pilih ruangan untuk booking instan:</p>
    <div style="display: flex; flex-direction: column; gap: 10px;">
        @foreach (var room in suggestedRooms)
        {
            <div class="quick-suggestion-card" @onclick="() => BookSuggestedRoom(room)">
                <div class="quick-suggestion-info">
                    <div class="quick-suggestion-name">@room.RoomName</div>
                    <div class="quick-suggestion-meta">Tersedia dalam @room.AvailableInMinutes menit · @room.Capacity orang</div>
                </div>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </div>
        }
    </div>
    <button class="btn btn-outline-primary" style="width: 100%; margin-top: 16px; border-radius: 999px; font-weight: 600; padding: 0.6rem; font-size: 0.85rem;" @onclick="SearchOtherRooms">
        Cari Ruangan Lain
    </button>
</div>

<div class="modal-footer-custom">
    <button class="popup-btn popup-btn-secondary" @onclick="Close">Batal</button>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string RoomName { get; set; } = "";
    [Parameter] public int AvailableInMinutes { get; set; }
    [Parameter] public int Capacity { get; set; }

    private record SuggestedRoom(string RoomName, int AvailableInMinutes, int Capacity);

    private List<SuggestedRoom> suggestedRooms = new()
    {
        new("Delta Boardroom", 45, 12),
        new("Boardroom A", 90, 20),
        new("Meeting Room 1", 120, 8),
    };

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task BookSuggestedRoom(SuggestedRoom room)
    {
        await OnClose.InvokeAsync();
        Navigation.NavigateTo("/bookings");
    }

    private void SearchOtherRooms()
    {
        Navigation.NavigateTo("/bookings");
    }
}

<style>
    .quick-suggestion-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        background: #F8FAFC;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .quick-suggestion-card:hover {
        border-color: #CBD5E1;
        background: #F1F5F9;
    }

    .quick-suggestion-name {
        font-weight: 700;
        font-size: 0.9rem;
        color: #1D1D1F;
        margin-bottom: 2px;
    }

    .quick-suggestion-meta {
        font-size: 0.8rem;
        color: #64748b;
    }
</style>
