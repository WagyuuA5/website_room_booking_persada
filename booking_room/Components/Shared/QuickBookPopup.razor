@using booking_room.Components.Models
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="quick-book-body">
    <div class="quick-book-section-desc">
        Pilih ruangan rekomendasi untuk pemesanan cepat instan:
    </div>

    <div class="quick-suggestion-list">
        @foreach (var room in suggestedRooms)
        {
            <div class="quick-suggestion-card" @onclick="() => BookSuggestedRoom(room)">
                <div class="quick-suggestion-icon-wrap">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
                <div class="quick-suggestion-info">
                    <div class="quick-suggestion-name">@room.RoomName</div>
                    <div class="quick-suggestion-meta">
                        <span>Tersedia dalam @room.AvailableInMinutes menit</span>
                        <span class="meta-dot">•</span>
                        <span>Kapasitas @room.Capacity orang</span>
                    </div>
                </div>
                <div class="quick-suggestion-chevron">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </div>
            </div>
        }
    </div>

</div>

<style>
    .quick-book-body {
        display: flex;
        flex-direction: column;
    }

    .quick-book-section-desc {
        font-size: 0.875rem;
        color: #64748B;
        margin: 0 0 16px 0;
        font-weight: 500;
    }

    .quick-suggestion-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .quick-suggestion-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        background: #FFFFFF;
        border: 1px solid var(--divider-subtle, rgba(15, 23, 42, 0.08));
        border-radius: 16px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .quick-suggestion-card:hover {
        border-color: var(--persada-yellow-500, #F59E0B);
        background: #FFFFFF;
        box-shadow: 0 4px 14px rgba(15, 31, 61, 0.08);
        transform: translateY(-1px);
    }

    .quick-suggestion-icon-wrap {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #DBEAFE;
        color: #1E40AF;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .quick-suggestion-info {
        flex: 1;
        min-width: 0;
    }

    .quick-suggestion-name {
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--persada-navy-900, #0F1F3D);
        margin-bottom: 3px;
    }

    .quick-suggestion-meta {
        font-size: 0.8125rem;
        color: #64748B;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .meta-dot {
        opacity: 0.6;
    }

    .quick-suggestion-chevron {
        color: #94A3B8;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease, color 0.2s ease;
    }

    .quick-suggestion-card:hover .quick-suggestion-chevron {
        color: var(--persada-navy-900, #0F1F3D);
        transform: translateX(2px);
    }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string RoomName { get; set; } = "";
    [Parameter] public int AvailableInMinutes { get; set; }
    [Parameter] public int Capacity { get; set; }

    private record SuggestedRoom(string RoomName, int AvailableInMinutes, int Capacity);

    private List<SuggestedRoom> suggestedRooms = new()
    {
        new("Delta Boardroom", 45, 12),
        new("Boardroom A", 90, 20),
        new("Meeting Room 1", 120, 8),
    };

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task BookSuggestedRoom(SuggestedRoom room)
    {
        await OnClose.InvokeAsync();
        Navigation.NavigateTo("/bookings");
    }

    private void SearchOtherRooms()
    {
        Navigation.NavigateTo("/bookings");
    }
}
