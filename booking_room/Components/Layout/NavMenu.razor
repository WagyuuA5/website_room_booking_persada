@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation

<div class="d-flex flex-column h-100">
    <div class="d-flex align-items-center justify-content-between p-4">
        <InlineSvg Src="/icons/logoo_psd-removebg-preview 2.svg" Class="navbar-brand-logo" />
        <button class="sidebar-close d-md-none" aria-label="Close sidebar">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <nav class="nav flex-column flex-grow-1 px-2">
        <NavLink class="nav-menu-item" href="/" Match="NavLinkMatch.All" ActiveClass="nav-active">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 6V0H18V6H10ZM0 10V0H8V10H0ZM10 18V8H18V18H10ZM0 18V12H8V18H0ZM2 8H6V2H2V8ZM12 16H16V10H12V16ZM12 4H16V2H12V4ZM2 16H6V14H2V16Z" fill="white" fill-opacity="0.7"/>
            </svg>
            Dashboard
        </NavLink>

        <NavLink class="nav-menu-item" href="/bookings" ActiveClass="nav-active">
            <InlineSvg Src="/icons/Icon_book_1.svg" Style="width:24px; height:24px; fill:currentColor;" />
            Pemesanan
        </NavLink>

        <NavLink class="nav-menu-item" href="/status" ActiveClass="nav-active">
            <InlineSvg Src="/icons/Icon_status_1.svg" Style="width:24px; height:24px; fill:currentColor;" />
            Status
        </NavLink>

        <NavLink class="nav-menu-item" href="/history" ActiveClass="nav-active">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Riwayat
        </NavLink>

        <NavLink class="nav-menu-item" href="/pengaturan" ActiveClass="nav-active">
            <InlineSvg Src="/icons/Icon_setting_1.svg" Style="width:24px; height:24px; fill:currentColor;" />
            Pengaturan
        </NavLink>
    </nav>

    <div class="p-3 mt-auto">
        <a href="logout" class="nav-menu-item text-danger">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
            </svg>
            Keluar
        </a>
    </div>
</div>
