@inherits LayoutComponentBase
@using booking_room.Services
@using booking_room.Components.Models
@inject NavigationManager Navigation
@inject INotificationService NotificationService
@inject booking_room.Services.LoadingStateService LoadingState
@inject IJSRuntime JS
@implements IDisposable

<div class="page d-flex">
    @if (_showSplitAnimation)
    {
        <div class="split-transition-overlay @(_splitOpening ? "opening" : "")">
            <div class="split-panel top"></div>
            <div class="split-panel bottom"></div>
        </div>
    }

    @if (_isNavigating)
    {
        <div class="top-progress-bar">
            <div class="top-progress-bar-inner"></div>
        </div>
    }

    <aside class="sidebar">
        <SidebarDragHandle />
        <NavMenu />
    </aside>

    <main class="main-content flex-grow-1">
        <header class="dashboard-header">
            <div class="d-flex align-items-center gap-2">
            </div>
            <div class="dashboard-header-right">
                <button class="dark-mode-toggle" @onclick="ToggleDarkMode" aria-label="Toggle Dark Mode" style="background: none; border: none; color: var(--persada-text-primary); cursor: pointer; padding: 4px; display: flex; align-items: center; justify-content: center; margin-right: 8px;">
                    @if (_isDarkMode)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    }
                </button>
                <div class="notification-bell-wrapper" style="position: relative;">
                    <div class="notification-bell" @onclick="ToggleNotificationPanel" style="cursor: pointer;">
                        <InlineSvg Src="/icons/icon_bell_notif.svg" />
                    </div>
                    <booking_room.Components.Shared.NotificationPanel Visible="@_showNotificationPanel" OnClose="CloseNotificationPanel" />
                </div>
                <div class="profile-avatar-wrapper" @onclick="ToggleProfilePanel" style="cursor: pointer; position: relative;">
                    @if (!string.IsNullOrEmpty(BookingDataStore.CurrentUser.PhotoUrl))
                    {
                        <img src="@BookingDataStore.CurrentUser.PhotoUrl" alt="Profil Pengguna" class="profile-avatar" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                        <img src="https://ui-avatars.com/api/?name=Admin+User&background=0f1f3d&color=fff" alt="Profil Pengguna" class="profile-avatar" style="display:none; position:absolute; inset:0;" />
                    }
                    else
                    {
                        <img src="https://ui-avatars.com/api/?name=Admin+User&background=0f1f3d&color=fff" alt="Profil Pengguna" class="profile-avatar" />
                    }
                    <booking_room.Components.Shared.ProfilePanel Visible="@_showProfilePanel" OnClose="CloseProfilePanel" />
                </div>
            </div>
        </header>

        <div class="dashboard-body">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="app-error-fallback" style="padding: 24px; text-align: center; border-radius: var(--card-radius); background: var(--card-bg); box-shadow: var(--shadow-sm); margin: 24px auto; max-width: 400px;">
                        <div style="color: var(--accent-red); margin-bottom: 16px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        </div>
                        <p style="color: var(--text-navy); font-weight: 500; margin-bottom: 16px;">Terjadi kesalahan saat memuat halaman ini.</p>
                        <button class="btn btn-primary" style="background: var(--accent-amber); border: none; padding: 10px 20px; border-radius: 999px; font-weight: 600; color: #fff;" @onclick="() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true)">
                            Muat Ulang Halaman
                        </button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Terjadi kesalahan yang tidak terduga.
    <a href="." class="reload">Muat Ulang</a>
    <span class="dismiss">🗙</span>
</div>

<booking_room.Components.Shared.ToastContainer />

@code {
    private bool _showNotificationPanel = false;
    private bool _showProfilePanel = false;
    private bool _isDarkMode = false;
    private bool _isNavigating = false;
    
    private bool _showSplitAnimation = false;
    private bool _splitOpening = false;
    private bool _isSidebarCollapsed = false;

    private void CloseSidebar() { }

    private void ToggleNotificationPanel()
    {
        _showNotificationPanel = !_showNotificationPanel;
        if (_showNotificationPanel) _showProfilePanel = false;
    }

    private void CloseNotificationPanel()
    {
        _showNotificationPanel = false;
    }

    private void ToggleProfilePanel()
    {
        _showProfilePanel = !_showProfilePanel;
        if (_showProfilePanel) _showNotificationPanel = false;
    }

    private void CloseProfilePanel()
    {
        _showProfilePanel = false;
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        NotificationService.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var isLoggedIn = await JS.InvokeAsync<string>("localStorage.getItem", "isLoggedIn");
                if (isLoggedIn != "true")
                {
                    Navigation.NavigateTo("/login", forceLoad: true);
                    return;
                }
            }
            catch { }

            try
            {
                var theme = await JS.InvokeAsync<string>("localStorage.getItem", "theme");
                if (theme == "dark")
                {
                    _isDarkMode = true;
                    await JS.InvokeVoidAsync("document.body.classList.add", "dark-mode");
                }
                
                var sidebarPref = await JS.InvokeAsync<string>("localStorage.getItem", "sidebarWidthState");
                _isSidebarCollapsed = sidebarPref == "collapsed";

                var playSplit = await JS.InvokeAsync<string>("localStorage.getItem", "playSplitAnimation");
                if (playSplit == "true")
                {
                    _showSplitAnimation = true;
                    await JS.InvokeVoidAsync("localStorage.removeItem", "playSplitAnimation");
                    StateHasChanged();
                    
                    await Task.Delay(50);
                    _splitOpening = true;
                    StateHasChanged();
                    
                    await Task.Delay(700);
                    _showSplitAnimation = false;
                    _splitOpening = false;
                    await InvokeAsync(StateHasChanged);
                }
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        if (_isDarkMode)
        {
            await JS.InvokeVoidAsync("document.body.classList.add", "dark-mode");
            await JS.InvokeVoidAsync("localStorage.setItem", "theme", "dark");
        }
        else
        {
            await JS.InvokeVoidAsync("document.body.classList.remove", "dark-mode");
            await JS.InvokeVoidAsync("localStorage.setItem", "theme", "light");
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        CloseSidebar();
        _isNavigating = true;
        LoadingState.SetLoading(true);
        await InvokeAsync(StateHasChanged);
        await Task.Delay(300);
        _isNavigating = false;
        LoadingState.SetLoading(false);
        await InvokeAsync(StateHasChanged);

        try
        {
            var isLoggedIn = await JS.InvokeAsync<string>("localStorage.getItem", "isLoggedIn");
            if (isLoggedIn != "true")
            {
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
        catch { }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        NotificationService.OnChange -= StateHasChanged;
    }
}
