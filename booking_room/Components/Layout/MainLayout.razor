@inherits LayoutComponentBase
@using booking_room.Services
@using booking_room.Components.Models
@inject NavigationManager Navigation
@inject INotificationService NotificationService
@inject booking_room.Services.LoadingStateService LoadingState
@implements IDisposable

<div class="page d-flex">
    <aside class="sidebar @(_sidebarOpen ? "show" : "")">
        <NavMenu />
    </aside>

    <main class="main-content flex-grow-1">
        <header class="dashboard-header">
            <div class="d-flex align-items-center gap-2">
                <button class="sidebar-toggle d-md-none" @onclick="ToggleSidebar" aria-label="Toggle sidebar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                </button>
            </div>
            <div class="dashboard-header-right">
                <div class="notification-bell" @onclick="ToggleNotificationPanel" style="cursor: pointer;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                    </svg>
                    @if (NotificationService.UnreadCount > 0)
                    {
                        <span class="notification-dot" style="display: flex; align-items: center; justify-content: center; font-size: 0.5rem; color: white;">@NotificationService.UnreadCount</span>
                    }
                </div>
                <div class="profile-avatar-wrapper" @onclick="ToggleProfilePanel" style="cursor: pointer; position: relative;">
                    @if (!string.IsNullOrEmpty(BookingDataStore.CurrentUser.PhotoUrl))
                    {
                        <img src="@BookingDataStore.CurrentUser.PhotoUrl" alt="Profil Pengguna" class="profile-avatar" />
                    }
                    else
                    {
                        <img src="https://ui-avatars.com/api/?name=Admin+User&background=0f1f3d&color=fff" alt="Profil Pengguna" class="profile-avatar" />
                    }
                </div>
            </div>
        </header>

        <div class="dashboard-body">
            @Body
        </div>
    </main>
</div>

<div class="sidebar-overlay @(_sidebarOpen ? "show" : "")" @onclick="CloseSidebar"></div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<booking_room.Components.Shared.NotificationPanel Visible="@_showNotificationPanel" OnClose="CloseNotificationPanel" OnInvitationClick="OpenInvitationModal" />

<booking_room.Components.Shared.UserProfilePanel Visible="@_showProfilePanel" OnClose="CloseProfilePanel" />

<booking_room.Components.Shared.ModalOverlayBlur Visible="@_isInvitationModalVisible" OnClose="CloseInvitationModal" Size="default">
    <booking_room.Components.Shared.InvitationModal OnClose="CloseInvitationModal" OnRsvp="HandleInvitationRsvp" />
</booking_room.Components.Shared.ModalOverlayBlur>

@code {
    private bool _sidebarOpen = false;
    private bool _showNotificationPanel = false;
    private bool _showProfilePanel = false;
    private bool _isInvitationModalVisible = false;

    private void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
    }

    private void CloseSidebar()
    {
        _sidebarOpen = false;
    }

    private void ToggleNotificationPanel()
    {
        _showNotificationPanel = !_showNotificationPanel;
        if (_showNotificationPanel) _showProfilePanel = false;
    }

    private void CloseNotificationPanel()
    {
        _showNotificationPanel = false;
    }

    private void ToggleProfilePanel()
    {
        _showProfilePanel = !_showProfilePanel;
        if (_showProfilePanel) _showNotificationPanel = false;
    }

    private void CloseProfilePanel()
    {
        _showProfilePanel = false;
    }

    private void OpenInvitationModal(booking_room.Services.NotificationItem item)
    {
        _showNotificationPanel = false;
        _isInvitationModalVisible = true;
    }

    private void CloseInvitationModal()
    {
        _isInvitationModalVisible = false;
    }

    private void HandleInvitationRsvp(string rsvp)
    {
        // Handle RSVP logic here (simulate)
        Console.WriteLine($"RSVP received: {rsvp}");
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        NotificationService.OnChange += StateHasChanged;
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        CloseSidebar();
        LoadingState.SetLoading(true);
        await InvokeAsync(StateHasChanged);
        await Task.Delay(250);
        LoadingState.SetLoading(false);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        NotificationService.OnChange -= StateHasChanged;
    }
}
