@page "/settings"
@inherits LayoutComponentBase
@implements IDisposable

<PageTitle>Pengaturan — Persada Room</PageTitle>

@if (_isLoading)
{
    <div class="hero-card" style="display: flex; flex-direction: column; gap: 16px; padding: 2rem;">
        <div class="skeleton-shimmer" style="height: 32px; width: 200px;"></div>
        <div class="skeleton-shimmer" style="height: 16px; width: 300px;"></div>
    </div>
}
else
{
    <div class="hero-card">
        <h1 class="hero-title">Pengaturan</h1>
        <p class="hero-subtitle">Fitur pengaturan akan segera tersedia.</p>
    </div>
}

@code {
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(300);
        _isLoading = false;
    }

    public void Dispose()
    {
    }
}
