    private void OpenRescheduleModal(UserMeeting meeting)
    {
        _isMeetingDetailOpen = false;
        _rescheduleMeeting = meeting;
        _rescheduleDate = meeting.Date;
        _rescheduleStartTime = meeting.StartTime.ToString("HH:mm");
        _rescheduleEndTime = meeting.EndTime.ToString("HH:mm");
        CheckSlotAvailability();
        _isRescheduleModalOpen = true;
    }

    private void OnRescheduleTimeOrDateChanged()
    {
        CheckSlotAvailability();
    }

    private void CheckSlotAvailability()
    {
        if (TimeSpan.TryParse(_rescheduleStartTime, out var start) && TimeSpan.TryParse(_rescheduleEndTime, out var end))
        {
            if (end <= start)
            {
                _isSlotAvailable = false;
                _slotStatusMessage = "Waktu selesai harus lebih besar dari waktu mulai";
            }
            else if (start.Hours == 13) // simulasi slot penuh pada pukul 13:00
            {
                _isSlotAvailable = false;
                _slotStatusMessage = "Slot Penuh pada jam ini (bentrok dengan reservasi lain)";
            }
            else
            {
                _isSlotAvailable = true;
                _slotStatusMessage = "Slot Tersedia untuk Ruangan Ini";
            }
        }
        else
        {
            _isSlotAvailable = false;
            _slotStatusMessage = "Format waktu tidak valid";
        }
    }

    private void SaveReschedule()
    {
        if (!_isSlotAvailable || _rescheduleMeeting == null) return;

        if (TimeSpan.TryParse(_rescheduleStartTime, out var start) && TimeSpan.TryParse(_rescheduleEndTime, out var end))
        {
            var newStart = _rescheduleDate.Date.Add(start);
            var newEnd = _rescheduleDate.Date.Add(end);

            var index = UpcomingMeetings.FindIndex(m => m.Id == _rescheduleMeeting.Id);
            if (index >= 0)
            {
                var updated = _rescheduleMeeting with
                {
                    Date = _rescheduleDate.Date,
                    StartTime = newStart,
                    EndTime = newEnd
                };
                UpcomingMeetings[index] = updated;

                var uIndex = UserMeetings.FindIndex(m => m.Id == _rescheduleMeeting.Id);
                if (uIndex >= 0) UserMeetings[uIndex] = updated;

                if (NextMeeting.Id == updated.Id)
                {
                    NextMeeting = updated;
                }

                ToastService.Success("Jadwal Berhasil Diperbarui", $"Pertemuan '{updated.Title}' berhasil dijadwalkan ulang ke {updated.Date:dd MMM yyyy}, {updated.StartTime:HH:mm} - {updated.EndTime:HH:mm} WIB.");
                _isRescheduleModalOpen = false;
                SafeStateHasChanged();
            }
        }
    }

