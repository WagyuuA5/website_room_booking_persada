@page "/beranda"
@page "/user/beranda"
@rendermode InteractiveServer
@using booking_room.Components.Models
@using booking_room.Components.Shared
@using booking_room.Services
@inject NavigationManager Navigation
@inject NotificationState NotificationState
@inject IToastService ToastService
@inject IModalService ModalService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Beranda — Persada Booking Ruangan</PageTitle>

<div class="beranda-container">
    @if (NotificationState.CurrentBannerType != NotificationState.BannerType.None)
    {
        <div style="margin-bottom: 24px;">
            <NotificationBanner BannerType="@NotificationState.CurrentBannerType"
                                TargetTime="@NotificationState.NextBookingTime"
                                OnDismiss="() => NotificationState.DismissBanner()"
                                OnCheckIn="HandleCheckInClick" />
        </div>
    }

    <!-- CASE 1 & CASE 2: Ringkasan Statistik adalah section paling atas (Hero Banner dihapus total) -->
    @if (isLoadingSummary)
    {
        <div class="skeleton" style="height: 120px; margin-top: 24px; margin-bottom: 32px;"></div>
    }
    else
    {
        <section class="summary-cards-grid content-fade-in" style="margin-top: 24px;">
            <!-- Card 1: Ruangan Tersedia Sekarang -->
            <div class="stat-card stat-card--success" @onclick="GoToPemesananTersedia" role="button" tabindex="0">
                <div class="stat-card-icon-wrap stat-card-icon-wrap--success">
                    <img src="/icon/icon_dshboard.svg" class="icon-md" alt="" />
                </div>
                <div class="stat-card-body">
                    <span class="stat-card-label">RUANGAN TERSEDIA SEKARANG</span>
                    <span class="stat-card-value">@AvailableRoomsCount <span class="stat-card-value-sub">/ @TotalRoomsCount</span></span>
                </div>
            </div>

            <!-- Card 2: Menunggu Persetujuan Admin (Case 2) -->
            <div class="stat-card stat-card--warning" @onclick="GoToStatusPending" role="button" tabindex="0">
                <div class="stat-card-icon-wrap stat-card-icon-wrap--warning">
                    <img src="/icon/icon_alert_warning.svg" class="icon-md" alt="" />
                </div>
                <div class="stat-card-body">
                    <span class="stat-card-label">MENUNGGU PERSETUJUAN ADMIN</span>
                    <span class="stat-card-value">@PendingActionCount</span>
                    <span class="stat-card-desc">Permintaan pemesanan Anda sedang menunggu persetujuan admin</span>
                </div>
            </div>

            <!-- Card 3: Rapat Berikutnya (Case 3A) -->
            <div class="stat-card stat-card--dark" @onclick="LihatDetailRapatBerikutnya" role="button" tabindex="0">
                <div class="stat-card-dark-header">
                    <img src="/icon/timer_dshbrd.svg" class="icon-sm icon-white" alt="" />
                    <span class="stat-card-dark-badge">TERSEDIA DALAM @NextMeetingCountdown</span>
                </div>
                <span class="stat-card-dark-label">Rapat Berikutnya</span>
                <span class="stat-card-dark-title">@NextMeeting.RoomName</span>
                <button class="btn-stat-dark" @onclick:stopPropagation="true" @onclick="LihatDetailRapatBerikutnya">
                    Lihat Detail
                </button>
            </div>
        </section>
    }

    <!-- CASE 4 & CASE 5: Grid dua kolom: Jadwal Mendatang (kiri) + Rekomendasi Ruangan (kanan) -->
    @if (isLoadingGrid)
    {
        <div class="skeleton" style="height: 290px; margin-bottom: 32px;"></div>
    }
    else
    {
        <section class="content-grid-two-col content-fade-in">
            <!-- Kolom Kiri: Jadwal Pertemuan Mendatang (Case 4) -->
            <div class="panel jadwal-mendatang-panel">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">Jadwal Pertemuan Mendatang</h2>
                        <p class="panel-subtitle">Daftar agenda rapat dan reservasi terdekat Anda</p>
                    </div>
                    <div class="jadwal-filter-tabs">
                        <button type="button" class="jadwal-filter-tab @(_jadwalFilter == "semua" ? "active" : "")" @onclick='() => SetJadwalFilter("semua")'>Semua</button>
                        <button type="button" class="jadwal-filter-tab @(_jadwalFilter == "minggu" ? "active" : "")" @onclick='() => SetJadwalFilter("minggu")'>Minggu Ini</button>
                        <button type="button" class="jadwal-filter-tab @(_jadwalFilter == "bulan" ? "active" : "")" @onclick='() => SetJadwalFilter("bulan")'>Bulan Ini</button>
                    </div>
                </div>

                <div class="jadwal-list">
                    @foreach (var meeting in FilteredUpcomingMeetings)
                    {
                        <!-- Klik seluruh baris membuka popup Detail Pertemuan (Case 4) -->
                        <div class="jadwal-item clickable-row" @onclick="() => OpenMeetingDetailFromRow(meeting)" role="button" tabindex="0">
                            <div class="jadwal-item-date">
                                <span class="jadwal-item-date-day">@meeting.Date.ToString("dd")</span>
                                <span class="jadwal-item-date-month">@meeting.Date.ToString("MMM")</span>
                            </div>
                            <div class="jadwal-item-info">
                                <span class="jadwal-item-title">@meeting.Title</span>
                                <span class="jadwal-item-meta">@meeting.RoomName (Lantai @meeting.Floor) • @meeting.StartTime.ToString("HH:mm")-@meeting.EndTime.ToString("HH:mm")</span>
                                <div class="jadwal-item-tags">
                                    <span class="tag-badge tag-badge--@meeting.CategorySlug">@meeting.CategoryLabel</span>
                                    <span class="tag-badge tag-badge--success">Terkonfirmasi</span>
                                </div>
                            </div>
                            <div class="jadwal-item-actions">
                                <button class="btn-icon-round" @onclick:stopPropagation="true" @onclick="() => ToggleQuickMenu(meeting.Id)" aria-label="Opsi">
                                    <img src="/icon/Icon_setting_1.svg" class="icon-sm" alt="Opsi" />
                                </button>
                                @if (ActiveQuickMenuId == meeting.Id)
                                {
                                    <div class="quick-menu-dropdown" @onclick:stopPropagation="true">
                                        <button @onclick="() => LihatDetail(meeting.Id)">Lihat Detail</button>
                                        <button @onclick="() => JadwalkanUlang(meeting.Id)">Jadwalkan Ulang</button>
                                        <button class="quick-menu-danger" @onclick="() => BatalkanRapat(meeting.Id)">Batalkan</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Kolom Kanan: Rekomendasi Untuk Anda (Case 5) -->
            <div class="panel rekomendasi-ruangan-panel">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">Rekomendasi Untuk Anda</h2>
                        <p class="panel-subtitle">Berdasarkan riwayat pemesanan Anda</p>
                    </div>
                </div>
                <div class="rekomendasi-list">
                    @foreach (var room in RecommendedRooms.Take(3))
                    {
                        <div class="rekomendasi-item">
                            <img src="@room.PhotoUrl" class="rekomendasi-item-photo" alt="@room.Name" />
                            <div class="rekomendasi-item-info">
                                <span class="rekomendasi-item-name">@room.Name</span>
                                <span class="rekomendasi-item-meta">
                                    <img src="/icon/icon_group.svg" class="icon-xs" alt="" /> @room.Capacity Orang
                                </span>
                                <!-- Badge Alasan Rekomendasi Eksplisit (Case 5) -->
                                <span class="rekomendasi-reason-badge rekomendasi-reason-badge--@room.ReasonType">
                                    @room.ReasonLabel
                                </span>
                            </div>
                            <button class="btn-pesan-small" @onclick="() => PesanCepat(room.Id)">Pesan</button>
                        </div>
                    }
                </div>
                <a class="panel-link-text" @onclick="GoToPemesanan">Lihat semua ruangan →</a>
            </div>
        </section>
    }

    <!-- CASE 6: Aktivitas Terkini & Identitas Orang -->
    @if (isLoadingActivities)
    {
        <div class="skeleton" style="height: 200px; margin-bottom: 32px;"></div>
    }
    else
    {
        <section class="panel aktivitas-terkini-panel content-fade-in">
            <h2 class="panel-title">Aktivitas Terkini</h2>
            <div class="aktivitas-timeline">
                @foreach (var activity in RecentActivities.Take(5))
                {
                    @if (!string.IsNullOrEmpty(activity.PersonName))
                    {
                        <!-- Item yang melibatkan orang spesifik (Clickable & Avatar Khusus) -->
                        <div class="aktivitas-item clickable-activity-row" @onclick="() => OpenContactModal(activity)" role="button" tabindex="0">
                            <div class="aktivitas-item-avatar-initial" style="background-color: @activity.AvatarBg;">
                                @GetInitials(activity.PersonName)
                            </div>
                            <div class="aktivitas-item-body">
                                <span class="aktivitas-item-text">
                                    <strong>@activity.PersonName</strong> @activity.Description
                                </span>
                                <span class="aktivitas-item-time">@activity.TimeAgo</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Item non-individu (System status icon) -->
                        <div class="aktivitas-item">
                            <div class="aktivitas-item-icon aktivitas-item-icon--@activity.TypeSlug">
                                <img src="@GetActivityIcon(activity.Type)" class="icon-sm" alt="" />
                            </div>
                            <div class="aktivitas-item-body">
                                <span class="aktivitas-item-text">@activity.Description</span>
                                <span class="aktivitas-item-time">@activity.TimeAgo</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>
    }

    <!-- CASE 8: Tren Pemesanan (grafik) -->
    @if (isLoadingChart)
    {
        <div class="skeleton" style="height: 260px; margin-bottom: 32px;"></div>
    }
    else
    {
        <section class="tren-pemesanan-panel content-fade-in" style="padding: 0; background: transparent; box-shadow: none;">
            <UserTrendChart />
        </section>
    }

    <!-- CASE 1: Floating Action Button (FAB) Pesan Ruangan (Tombol Pesan Instan dihapus) -->
    <button class="fab-pesan-ruangan" @onclick="GoToPemesanan" title="Pesan Ruangan" aria-label="Pesan Ruangan">
        <img src="/icon/Icon_book_1.svg" class="icon-white" style="width: 24px; height: 24px;" alt="Pesan Ruangan" />
    </button>
</div>

<!-- CASE 3B: Reusable Detail Modal using AppModal (dengan info peserta, agenda, fasilitas, dan bagikan) -->
<AppModal Visible="@_isMeetingDetailOpen"
          VisibleChanged="@(v => _isMeetingDetailOpen = v)"
          Title="Detail Pertemuan"
          Subtitle="Informasi jadwal rapat dan reservasi ruangan"
          Size="md"
          ShowHeader="true"
          ShowFooter="true">
    <IconContent>
        <img src="/icon/timer_dshbrd.svg" class="icon-sm" style="filter: invert(36%) sepia(85%) saturate(1450%) hue-rotate(203deg);" alt="" />
    </IconContent>
    <BodyContent>
        @if (_selectedMeeting != null)
        {
            <div style="display: flex; flex-direction: column; gap: 16px; padding: 4px 0;">
                <div style="background: var(--color-bg-page); border: 1px solid var(--color-border); border-radius: 12px; padding: 16px; display: flex; flex-direction: column; gap: 6px;">
                    <div style="font-size: 1.15rem; font-weight: 700; color: var(--color-text-primary);">@_selectedMeeting.Title</div>
                    <div style="font-size: 0.875rem; color: var(--color-text-secondary); display: flex; align-items: center; gap: 6px;">
                        <img src="/icon/icon_room.svg" class="icon-xs" alt="" />
                        <span>@_selectedMeeting.RoomName (Lantai @_selectedMeeting.Floor)</span>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div style="background: var(--color-bg-page); border: 1px solid var(--color-border); border-radius: 12px; padding: 12px;">
                        <span style="font-size: 11px; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase;">Tanggal</span>
                        <div style="font-size: 14px; font-weight: 600; color: var(--color-text-primary); margin-top: 2px;">@_selectedMeeting.Date.ToString("dd MMMM yyyy")</div>
                    </div>
                    <div style="background: var(--color-bg-page); border: 1px solid var(--color-border); border-radius: 12px; padding: 12px;">
                        <span style="font-size: 11px; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase;">Waktu</span>
                        <div style="font-size: 14px; font-weight: 600; color: var(--color-text-primary); margin-top: 2px;">@_selectedMeeting.StartTime.ToString("HH:mm") - @_selectedMeeting.EndTime.ToString("HH:mm") WIB</div>
                    </div>
                </div>

                <div style="display: flex; gap: 8px; align-items: center;">
                    <span class="tag-badge tag-badge--@_selectedMeeting.CategorySlug">@_selectedMeeting.CategoryLabel</span>
                    <span class="tag-badge tag-badge--success">Terkonfirmasi</span>
                </div>

                <!-- 1. Daftar Peserta (Case 3B.1) -->
                <div class="meeting-popup-section">
                    <span class="meeting-popup-label">Daftar Peserta (6 Orang)</span>
                    <div class="attendees-overlap-wrap">
                        <div class="attendees-avatars-row">
                            <div class="attendee-avatar-circle" style="background: #3B82F6;" title="Wahyu Ravi (Host)">WR</div>
                            <div class="attendee-avatar-circle" style="background: #10B981;" title="Ahmad Fauzi">AF</div>
                            <div class="attendee-avatar-circle" style="background: #8B5CF6;" title="Sarah Jenkins">SJ</div>
                            <div class="attendee-avatar-circle" style="background: #F59E0B;" title="Budi Santoso">BS</div>
                            <div class="attendee-avatar-circle attendee-avatar-more" title="2 peserta lainnya">+2</div>
                        </div>
                        <span class="attendees-text-summary">Wahyu Ravi (Host), Ahmad Fauzi, Sarah Jenkins, dan 3 lainnya</span>
                    </div>
                </div>

                <!-- 2. Agenda / Catatan Rapat (Case 3B.2) -->
                <div class="meeting-popup-section">
                    <span class="meeting-popup-label">Agenda / Catatan Rapat</span>
                    <div class="meeting-notes-box">
                        Sinkronisasi pencapaian target sprint mingguan, review alokasi utilisasi ruangan, dan penyesuaian dependensi implementasi tim teknis.
                    </div>
                </div>

                <!-- 3. Fasilitas Ruangan (Case 3B.3) -->
                <div class="meeting-popup-section">
                    <span class="meeting-popup-label">Fasilitas Ruangan Tersedia</span>
                    <div class="meeting-facilities-list">
                        <span class="facility-pill"><img src="/icon/icon_projector.svg" class="icon-xs" alt="" /> Proyektor 4K</span>
                        <span class="facility-pill"><img src="/icon/icon_wifi.svg" class="icon-xs" alt="" /> High-Speed WiFi</span>
                        <span class="facility-pill"><img src="/icon/icon_ac.svg" class="icon-xs" alt="" /> AC Sentral</span>
                    </div>
                </div>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
            <!-- Tombol Tersier Bagikan Undangan (Case 3B.4) -->
            <button type="button" class="btn btn-secondary" style="border-radius: 999px; padding: 8px 16px; font-weight: 600; font-size: 13px; display: inline-flex; align-items: center; gap: 6px;" @onclick="ShareInvitation">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="18" cy="5" r="3"></circle>
                    <circle cx="6" cy="12" r="3"></circle>
                    <circle cx="18" cy="19" r="3"></circle>
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                </svg>
                <span>Bagikan Undangan</span>
            </button>
            <div style="display: flex; gap: 10px;">
                <button type="button" class="btn btn-secondary" style="border-radius: 999px; padding: 8px 18px; font-weight: 600; font-size: 13px;" @onclick="() => _isMeetingDetailOpen = false">Tutup</button>
                <button type="button" class="btn btn-primary" style="background: #F5A623; border: none; border-radius: 999px; padding: 8px 18px; font-weight: 700; font-size: 13px; color: #1A1A1A;" @onclick="NavigateToStatusFromModal">Lihat di Status</button>
            </div>
        </div>
    </FooterContent>
</AppModal>

<!-- CASE 6B: Modal Detail Kontak / Pengundang (AppModal) -->
<AppModal Visible="@_isContactModalOpen"
          VisibleChanged="@(v => _isContactModalOpen = v)"
          Title="Detail Pengundang"
          Subtitle="Informasi kontak dan konteks aktivitas"
          Size="sm"
          ShowHeader="true"
          ShowFooter="true">
    <IconContent>
        <img src="/icon/icon_group.svg" class="icon-sm" alt="" />
    </IconContent>
    <BodyContent>
        @if (_selectedContact != null)
        {
            <div class="contact-modal-body">
                <div class="contact-header-wrap">
                    <div class="contact-avatar-large" style="background-color: @(_selectedContact.AvatarBg ?? "#3B82F6");">
                        @GetInitials(_selectedContact.PersonName ?? "")
                    </div>
                    <div class="contact-name">@_selectedContact.PersonName</div>
                    <div class="contact-title">@_selectedContact.PersonTitle</div>
                </div>

                <div class="contact-info-card">
                    <div class="contact-info-row">
                        <span class="contact-info-label">Email Kantor:</span>
                        <span class="contact-info-val">@_selectedContact.PersonEmail</span>
                    </div>
                    <div class="contact-info-row">
                        <span class="contact-info-label">Konteks:</span>
                        <span class="contact-info-val">@_selectedContact.Description</span>
                    </div>
                    <div class="contact-info-row">
                        <span class="contact-info-label">Waktu:</span>
                        <span class="contact-info-val">@_selectedContact.TimeAgo</span>
                    </div>
                </div>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <div style="display: flex; justify-content: flex-end; gap: 10px; width: 100%;">
            <button type="button" class="btn btn-secondary" style="border-radius: 999px; padding: 8px 18px; font-weight: 600; font-size: 13px;" @onclick="() => _isContactModalOpen = false">Tutup</button>
            <button type="button" class="btn btn-primary" style="background: #F5A623; border: none; border-radius: 999px; padding: 8px 18px; font-weight: 700; font-size: 13px; color: #1A1A1A;" @onclick="CopyContactEmail">Salin Email</button>
        </div>
    </FooterContent>
</AppModal>

<!-- Reusable Cancel Confirmation Modal using AppModal -->
<AppModal Visible="@_isCancelModalOpen"
          VisibleChanged="@(v => _isCancelModalOpen = v)"
          Title="Batalkan Rapat"
          Subtitle="Konfirmasi pembatalan reservasi ruangan"
          Size="sm"
          ShowHeader="true"
          ShowFooter="true">
    <IconContent>
        <img src="/icon/icon_alert_danger.svg" class="icon-sm" alt="" />
    </IconContent>
    <BodyContent>
        <p style="font-size: 14px; color: var(--color-text-secondary); margin: 0; line-height: 1.5;">
            Apakah Anda yakin ingin membatalkan jadwal rapat <strong>@_selectedMeeting?.Title</strong> di <strong>@_selectedMeeting?.RoomName</strong>?
        </p>
    </BodyContent>
    <FooterContent>
        <div style="display: flex; justify-content: flex-end; gap: 10px; width: 100%;">
            <button type="button" class="btn btn-secondary" style="border-radius: 999px; padding: 8px 18px; font-weight: 600; font-size: 13px;" @onclick="() => _isCancelModalOpen = false">Kembali</button>
            <button type="button" class="btn btn-danger" style="background: #DC2626; border: none; border-radius: 999px; padding: 8px 18px; font-weight: 700; font-size: 13px; color: #FFFFFF;" @onclick="ConfirmCancelMeeting">Ya, Batalkan</button>
        </div>
    </FooterContent>
</AppModal>

<style>
    .beranda-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 24px 32px;
        display: flex;
        flex-direction: column;
    }
    @@media (max-width: 768px) {
        .beranda-container {
            padding: 16px;
        }
    }

    .beranda-container > section {
        margin-bottom: 32px;
    }

    /* 2. RINGKASAN STATISTIK */
    .summary-cards-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }
    @@media (max-width: 900px) {
        .summary-cards-grid { grid-template-columns: 1fr; }
    }
    .stat-card {
        background: var(--color-bg-card);
        border-radius: var(--radius-lg);
        padding: 20px 22px;
        box-shadow: var(--shadow-card);
        cursor: pointer;
        transition: transform var(--transition-fast), box-shadow var(--transition-fast);
        display: flex;
        align-items: center;
        gap: 16px;
        border-left: 4px solid transparent;
        border-top: 1px solid var(--color-border);
        border-right: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
    }
    .stat-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-card-hover); }
    .stat-card--success { border-left-color: var(--color-success); }
    .stat-card--warning { border-left-color: var(--color-primary); }
    .stat-card-icon-wrap {
        width: 44px; height: 44px;
        border-radius: var(--radius-md);
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .stat-card-icon-wrap--success { background: var(--color-success-light); }
    .stat-card-icon-wrap--warning { background: var(--color-primary-light); }
    .stat-card-icon-wrap--success img { filter: none; }
    .stat-card-body { display: flex; flex-direction: column; gap: 2px; }
    .stat-card-label {
        font-size: 11px; font-weight: 600; letter-spacing: 0.5px;
        color: var(--color-text-muted); text-transform: uppercase;
    }
    .stat-card-value { font-size: 28px; font-weight: 700; color: var(--color-text-primary); }
    .stat-card-value-sub { font-size: 16px; font-weight: 500; color: var(--color-text-muted); }
    .stat-card-desc { font-size: 12px; color: var(--color-text-secondary); }

    /* CASE 3A: Stat Card Dark & Glass Button */
    .stat-card--dark {
        background: linear-gradient(160deg, #0F172A 0%, #1E3A5F 60%, #1E293B 100%);
        border: 1px solid rgba(59, 130, 246, 0.15);
        position: relative;
        overflow: hidden;
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
        color: white;
    }
    .stat-card--dark::after {
        content: '';
        position: absolute;
        top: -40%; right: -20%;
        width: 200px; height: 200px;
        background: radial-gradient(circle, rgba(74, 222, 128, 0.12) 0%, transparent 70%);
        pointer-events: none;
    }
    .stat-card-dark-header { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; position: relative; z-index: 1; }
    .stat-card-dark-badge {
        background: rgba(22, 163, 74, 0.2);
        color: #4ADE80;
        font-size: 11px; font-weight: 600;
        padding: 3px 10px;
        border-radius: 999px;
    }
    .stat-card-dark-label { font-size: 12px; color: rgba(255,255,255,0.6); position: relative; z-index: 1; }
    .stat-card-dark-title { font-size: 20px; font-weight: 700; margin-bottom: 10px; color: #FFFFFF; position: relative; z-index: 1; }
    .btn-stat-dark {
        background: rgba(255, 255, 255, 0.1);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        border-radius: 999px;
        padding: 10px 18px; font-size: 13px; font-weight: 600;
