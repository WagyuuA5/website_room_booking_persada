@page "/beranda"
@using booking_room.Components.Models
@inject NavigationManager Navigation

<PageTitle>Beranda — Persada</PageTitle>

<div class="user-dashboard">
    <header class="page-header">
        <h1>Beranda</h1>
        <p>Ringkasan aktivitas pemesanan ruangan Anda.</p>
        <button class="btn-primary" @onclick="GoToBooking">+ Pesan Ruangan</button>
    </header>

    <div class="stats-grid">
        <div class="stat-card">
            <h3>Pemesanan Aktif</h3>
            <div class="stat-value">2</div>
        </div>
        <div class="stat-card">
            <h3>Menunggu Persetujuan</h3>
            <div class="stat-value">1</div>
        </div>
        <div class="stat-card">
            <h3>Total Pemesanan Bulan Ini</h3>
            <div class="stat-value">5</div>
        </div>
    </div>
</div>

@code {
    private void GoToBooking()
    {
        Navigation.NavigateTo("/pemesanan");
    }
}

<style>
    .user-dashboard {
        padding: 24px;
    }
    .page-header {
        display: flex;
        flex-direction: column;
        margin-bottom: 24px;
    }
    .page-header h1 {
        font-size: 1.5rem;
        color: var(--text-navy);
        margin: 0 0 8px 0;
    }
    .page-header p {
        color: var(--persada-text-secondary);
        margin: 0 0 16px 0;
    }
    .btn-primary {
        background-color: var(--accent-amber);
        color: var(--text-navy);
        border: none;
        padding: 10px 20px;
        border-radius: 999px;
        font-weight: 600;
        cursor: pointer;
        align-self: flex-start;
    }
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 16px;
    }
    .stat-card {
        background: var(--card-bg);
        border-radius: var(--card-radius);
        padding: 20px;
        box-shadow: var(--shadow-sm);
    }
    .stat-card h3 {
        font-size: 0.9rem;
        color: var(--persada-text-secondary);
        margin: 0 0 12px 0;
    }
    .stat-card .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-navy);
    }
</style>
