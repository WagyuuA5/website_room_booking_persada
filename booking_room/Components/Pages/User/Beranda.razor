@page "/beranda"
@page "/dashboard"
@using booking_room.Components.Models
@using booking_room.Components.Shared
@inject NavigationManager Navigation
@inject booking_room.Services.NotificationState NotificationState
@inject booking_room.Services.LoadingStateService LoadingState
@inject booking_room.Services.IModalService ModalService
@inject IJSRuntime JS
@implements IDisposable
<PageTitle>Beranda — Persada Ruangan</PageTitle>

@if (NotificationState.CurrentBannerType != booking_room.Services.NotificationState.BannerType.None)
{
    <NotificationBanner TargetTime="@NotificationState.NextBookingTime" 
                        BannerType="@NotificationState.CurrentBannerType"
                        OnCheckIn="HandleCheckInClick" 
                        OnDismiss="DismissReminder" />
}

@if (LoadingState.IsLoading)
{
    <div class="content-fade-in">
        <div class="skeleton-shimmer" style="height: 100px; border-radius: 1rem; margin-bottom: 1.5rem;"></div>
        <div class="skeleton-stat-grid">
            <div class="skeleton-stat-card"><div class="skeleton-shimmer skeleton-title"></div><div class="skeleton-shimmer skeleton-text"></div></div>
            <div class="skeleton-stat-card"><div class="skeleton-shimmer skeleton-title"></div><div class="skeleton-shimmer skeleton-text"></div></div>
            <div class="skeleton-stat-card"><div class="skeleton-shimmer skeleton-title"></div><div class="skeleton-shimmer skeleton-text"></div></div>
        </div>
        <div class="skeleton-grid">
            <div class="skeleton-card" style="grid-column: span 2;"><div class="skeleton-shimmer" style="height: 250px;"></div></div>
            <div class="skeleton-card"><div class="skeleton-shimmer" style="height: 250px;"></div></div>
        </div>
    </div>
}
else
{
<div class="content-fade-in">
<div class="hero-card">
    <h1 class="hero-title">Selamat Datang, @(BookingDataStore.CurrentUser?.Name ?? "Pengguna")</h1>
    <p class="hero-subtitle">Kelola pemesanan ruangan perusahaan Anda dengan efisien. Pantau penggunaan ruangan, reservasi mendatang, dan analitik sistem dalam satu tempat.</p>
</div>

<div class="summary-cards">
    <!-- Card Segera Tersedia -->
    @if (nextRoom is not null)
    {
        <StatHighlightCard Title="Ruangan Segera Tersedia"
                           Value="@nextRoom.RoomName"
                           Subtitle="@($"Kapasitas: {nextRoom.Capacity} Orang")"
                           BadgeText="@($"Tersedia Dalam {nextRoom.AvailableInMinutes} Menit")"
                           ButtonText="Pemesanan Instan"
                           Variant="success"
                           OnClick='() => ShowPopup("QuickBook")'>
            <Icon>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
                </svg>
            </Icon>
        </StatHighlightCard>
    }
    else
    {
        <StatHighlightCard Title="Status Ruangan"
                           Value="Semua Tersedia"
                           Subtitle="Tidak ada ruangan yang sedang terpakai saat ini"
                           ButtonText="Lihat Semua Ruangan"
                           Variant="info"
                           OnClick="ViewAllRooms" />
    }

    <!-- Card Persetujuan Tertunda -->
    <StatHighlightCard Title="Persetujuan Tertunda"
                       Value="@DashboardData.PendingApprovals.ToString()"
                       Subtitle="Permintaan pemesanan menunggu tindakan"
                       Variant="warning"
                       ShowArrow="true"
                       OnClick='() => ShowPopup("PendingApprovals")'>
        <Icon>
            <InlineSvg Src="/icons/Icon_clndr.svg" Class="icon-main" />
        </Icon>
    </StatHighlightCard>
</div>

</div>

<div class="dashboard-lower-layout">
    <!-- Jadwal Saya Hari Ini -->
    @if (IsWidgetVisible("TodaySchedule"))
    {
        <div class="dashboard-widget upcoming-bookings-panel">
            <div class="upcoming-header">
                <h2 class="upcoming-title">Jadwal Saya Hari Ini</h2>
                <span class="upcoming-badge">@DashboardData.TodaySchedule.Count Agenda</span>
            </div>
            <div class="upcoming-list">
                @foreach (var item in DashboardData.TodaySchedule)
                {
                    <div class="upcoming-card" style="cursor: pointer;" @onclick="() => NavigateToBookingDetail(item)">
                        <div class="upcoming-accent" style="background-color: @item.AccentColor;"></div>
                        <div class="upcoming-content">
                            <div class="upcoming-top">
                                <div>
                                    <h3 class="upcoming-room-name">@item.RoomName</h3>
                                    <p class="upcoming-location">@item.Title</p>
                                </div>
                                <StatusBadge Status="@item.Status" CustomLabel="@item.StatusLabel" />
                            </div>
                            <div class="upcoming-bottom">
                                <div class="upcoming-schedule">
                                    <span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="currentColor"/></svg>
                                        @item.TimeSlot
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (!DashboardData.TodaySchedule.Any())
            {
                <div style="text-align: center; padding: 2rem; color: #94a3b8;">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" style="margin-bottom: 1rem; opacity: 0.5;"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    <p style="font-weight: 600; margin-bottom: 0.5rem;">Tidak ada jadwal hari ini</p>
                    <p style="font-size: 0.85rem; margin-bottom: 1rem;">Ayo pesan ruangan!</p>
                    <button class="btn btn-primary" style="border-radius: 999px; padding: 0.5rem 1.25rem; font-size: 0.85rem;" @onclick="ViewAllRooms">Cari Ruangan</button>
                </div>
            }
        </div>
    }
</div>

<div class="analytics-inline-panel" style="margin-top: 24px;">
    <div class="analytics-inline-header">
        <div>
            <h2 class="analytics-inline-title">Analitik Utilisasi Ruangan</h2>
            <p class="analytics-inline-subtitle">Tingkat penggunaan ruangan berdasarkan jam reservasi</p>
        </div>
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
            <div class="analytics-toggle">
                @foreach (var period in periods)
                {
                    <button class="@(selectedPeriod == period ? "active" : "")" @onclick="() => SelectPeriod(period)">@period</button>
                }
            </div>
            <div class="analytics-export-btns">
                <button class="btn-export" @onclick="ExportCSV" title="Unduh CSV">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    CSV
                </button>
                <button class="btn-export" @onclick="ExportJSON" title="Unduh JSON">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    JSON
                </button>
            </div>
        </div>
    </div>

    <!-- Chart Tren Penggunaan sesuai Gambar Referensi -->
    <UtilizationChart SelectedPeriod="@selectedPeriod" />

    <div class="analytics-inline-footer" style="margin-top: 16px;">
        <button class="btn btn-outline-primary" style="border-radius: 999px; font-weight: 600; padding: 0.5rem 1.25rem;" @onclick='() => OpenChartDetailModal()'>
            Lihat Detail
        </button>
    </div>
</div>

}

<!-- Pop-ups are now handled by ModalService via ModalHost -->

@code {
    private NextAvailableRoom? nextRoom;
    private AnalyticsData analyticsData = DashboardData.WeeklyData;
    private string selectedPeriod = "Minggu";
    private readonly string[] periods = { "Minggu", "Bulan", "Tahun" };
    private DateTime checkInTimestamp;
    
    private bool showAllUpcoming = false;

    private List<RoomItem> _allRooms = new()
    {
        new("1", "Executive Boardroom A", 12, "Ruang rapat unggulan.", "available", new() { "AC" }, "Lantai 3", ""),
        new("2", "Training Ruangan B", 30, "Ruang pelatihan kapasitas besar.", "booked", new() { "AC" }, "Lantai 2", ""),
        new("3", "Huddle Space C", 6, "Ruang kolaborasi kecil.", "available", new() { "AC" }, "Lantai 1", ""),
        new("4", "Studio Webinar", 15, "Ruang siaran.", "unavailable", new() { "AC" }, "Lantai 4", ""),
        new("5", "Focus Ruangan Alpha", 4, "Ruang sunyi.", "available", new() { "AC" }, "Lantai 1", ""),
        new("6", "Meeting Ruangan Prime", 8, "Ruang rapat standar.", "booked", new() { "AC" }, "Lantai 2", ""),
    };


    protected override void OnInitialized()
    {
        DashboardData.CurrentUserRole = "User";
        nextRoom = DashboardData.NextAvailableRooms.FirstOrDefault();
        NotificationState.OnChange += StateHasChanged;
        LoadingState.OnChange += StateHasChanged;
    }
    
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        NotificationState.OnChange -= StateHasChanged;
        LoadingState.OnChange -= StateHasChanged;
    }

    private void ToggleShowAllUpcoming()
    {
        showAllUpcoming = !showAllUpcoming;
    }

    private RenderFragment GetActivityIcon(string iconType) => iconType switch
    {
        "approval" => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>,
        "cancel" => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>,
        "alert" => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>,
        "booking" => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>,
        "checkin" => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"></path><circle cx="12" cy="12" r="10"></circle></svg>,
        _ => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle></svg>,
    };

    private bool IsWidgetVisible(string widgetName)
    {
        var role = DashboardData.CurrentUserRole;
        if (DashboardData.RoleWidgetPriority.TryGetValue(role, out var widgets))
        {
            return widgets.Contains(widgetName);
        }
        return true;
    }

    private void OpenModifyModal(UpcomingBookingItem booking)
    {
        Navigation.NavigateTo("/bookings");
    }

    private void OpenCancelModal(UpcomingBookingItem booking)
    {
        Navigation.NavigateTo("/status");
    }

    private void SelectPeriod(string period)
    {
        selectedPeriod = period;
        analyticsData = DashboardData.GetAnalytics(period);
        StateHasChanged();
    }

    private void ViewAllRooms()
    {
        Navigation.NavigateTo("/bookings");
    }

    private void DismissReminder()
    {
        NotificationState.DismissBanner();
    }

    private async Task HandleCheckInClick()
    {
        await ModalService.ShowAsync<CheckInCountdownCard>(new Dictionary<string, object>
        {
            { "RoomName", "Alpha Boardroom" },
            { "TimeSlot", "09:00 - 11:00" },
            { "Location", "Lantai 2, Sayap A" },
            { "Capacity", "12" },
            { "TargetTime", NotificationState.NextBookingTime ?? DateTime.Now },
            { "OnConfirm", EventCallback.Factory.Create(this, HandleConfirmCheckIn) },
            { "OnAutoReleased", EventCallback.Factory.Create(this, HandleBookingAutoReleased) }
        });
    }

    private async Task HandleConfirmCheckIn()
    {
        checkInTimestamp = DateTime.Now;
        await ModalService.ReplaceTopAsync(typeof(CheckInSuccessModal), new Dictionary<string, object>
        {
            { "Timestamp", checkInTimestamp },
            { "OnClose", EventCallback.Factory.Create(this, HandleSuccessClose) }
        });
    }

    private async Task HandleBookingAutoReleased()
    {
        await ModalService.ReplaceTopAsync(typeof(BookingAutoReleasedModal), new Dictionary<string, object>
        {
            { "RoomName", "Alpha Boardroom" },
            { "OnBookAnother", EventCallback.Factory.Create(this, HandleBookAnother) }
        });
    }

    private void HandleBookAnother()
    {
        Navigation.NavigateTo("/bookings");
    }

    private void HandleSuccessClose()
    {
        NotificationState.DismissBanner();
        ModalService.CloseAllAsync();
    }

    private async Task OpenChartDetailModal(string? roomName = null)
    {
        var parameters = new Dictionary<string, object>
        {
            { "SelectedPeriod", selectedPeriod }
        };
        if (!string.IsNullOrEmpty(roomName))
        {
            parameters["HighlightRoom"] = roomName;
        }
        await ModalService.ShowAsync<ChartDetailModal>(parameters);
    }

    private async Task ShowPopup(string popupName)
    {
        if (popupName == "RoomAvailable" || popupName == "QuickBook")
        {
            await ModalService.ShowAsync<AvailableRoomsModal>();
        }
        else if (popupName == "AnalyticsDetail")
        {
            await OpenChartDetailModal();
        }
        else if (popupName == "PendingApprovals" || popupName == "PendingApproval")
        {
            await ModalService.ShowAsync<PendingApprovalsModal>();
        }
    }

    private void ClosePopup()
    {
        ModalService.Close();
    }

    private Task VisibleChanged(bool visible)
    {
        return Task.CompletedTask;
    }

    private void GoToStatusPage()
    {
        ClosePopup();
        Navigation.NavigateTo("/status");
    }

    private void GoToBookingsPage()
    {
        ClosePopup();
        Navigation.NavigateTo("/bookings");
    }

    private async Task NavigateToBookingDetail(TodayScheduleItem item)
    {
        await ModalService.ShowAsync<ScheduleDetailModal>(new Dictionary<string, object>
        {
            { "Item", item },
            { "OnCheckIn", EventCallback.Factory.Create(this, HandleCheckInClick) }
        });
    }

    private void OpenMap()
    {
        Navigation.NavigateTo("/bookings?tab=Peta");
    }

    // Data model for ApexCharts
    public class RoomUsagePoint
    {
        public string Label { get; set; } = "";
        public decimal Value { get; set; }
    }

    private void ExportCSV()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Ruangan,Jam Penggunaan");
        foreach (var room in analyticsData.Rooms)
        {
            csv.AppendLine($"{room.RoomName},{room.HoursUsed}");
        }
        DownloadFile(csv.ToString(), $"analytics-{selectedPeriod}.csv", "text/csv");
    }

    private void ExportJSON()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(new { Period = selectedPeriod, Rooms = analyticsData.Rooms });
        DownloadFile(json, $"analytics-{selectedPeriod}.json", "application/json");
    }

    private void DownloadFile(string content, string fileName, string contentType)
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes(content);
        var base64 = Convert.ToBase64String(bytes);
        var dataUrl = $"data:{contentType};base64,{base64}";
        var js = $"var a=document.createElement('a');a.href='{dataUrl}';a.download='{fileName}';document.body.appendChild(a);a.click();document.body.removeChild(a);";
        JS.InvokeVoidAsync("eval", js);
    }
}

<style>
    .analytics-horizontal-bars {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 12px 0 16px;
    }

    .hbar-item {
        cursor: pointer;
        padding: 12px 16px;
        border-radius: 14px;
        transition: all 0.2s ease;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
    }

    .hbar-item:hover {
        background: #F1F5F9;
        border-color: #CBD5E1;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(15, 31, 61, 0.06);
    }

    .hbar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .hbar-room-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .hbar-rank {
        width: 24px;
        height: 24px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .hbar-name {
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--persada-navy-900, #0F1F3D);
    }

    .hbar-value-wrap {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
    }

    .hbar-hours {
        font-weight: 700;
        color: var(--persada-navy-900, #0F1F3D);
    }

    .hbar-percent {
        color: #64748B;
        font-size: 0.8rem;
    }

    .hbar-track {
        width: 100%;
        height: 8px;
        background: #E2E8F0;
        border-radius: 999px;
        overflow: hidden;
    }

    .hbar-fill {
