    {
        Navigation.NavigateTo("/pemesanan?tab=ruangan");
    }

    private void LihatDetailRapatBerikutnya()
    {
        _selectedMeeting = NextMeeting;
        _isMeetingDetailOpen = true;
    }

    private void OpenMeetingDetailFromRow(UserMeeting meeting)
    {
        _selectedMeeting = meeting;
        _isMeetingDetailOpen = true;
    }

    private void OpenContactModal(ActivityItem activity)
    {
        _selectedContact = activity;
        _isContactModalOpen = true;
    }

