    private void CloseCancelModal()
    {
        _isCancelModalOpen = false;
        cancellationReason = "";
        showValidationError = false;
    }

    private void ConfirmCancellation()
    {
        if (string.IsNullOrWhiteSpace(cancellationReason))
        {
            showValidationError = true;
            return;
        }

        if (_selectedMeeting != null)
        {
            UpcomingMeetings.RemoveAll(m => m.Id == _selectedMeeting.Id);
            UserMeetings.RemoveAll(m => m.Id == _selectedMeeting.Id);
            ToastService.Success("Jadwal Dibatalkan", $"Reservasi rapat di {_selectedMeeting.RoomName} telah dibatalkan.");
        }
        _isCancelModalOpen = false;
        cancellationReason = "";
        showValidationError = false;
    }

