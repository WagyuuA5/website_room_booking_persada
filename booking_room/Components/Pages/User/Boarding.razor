@page "/boarding"
@layout booking_room.Components.Layout.AuthLayout
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Pengenalan — Persada Ruangan</PageTitle>

<div class="boarding-viewport" 
     @onpointerdown="HandlePointerDown"
     @onpointerup="HandlePointerUp"
     @ontouchstart="HandleTouchStart"
     @ontouchend="HandleTouchEnd">
     
    <!-- Background Slides Full-Bleed (Layar 1: Gedung Sunset/Eksterior, Layar 2: Gedung Sudut/Interior) -->
    <div class="boarding-bg-layer">
        <div class="boarding-bg-slide @(currentSlide == 0 ? "active" : "")">
            <img src="/images/FOTO_GEDUNG_PERSADA.png" alt="Gedung Persada Eksterior" class="boarding-bg-img ken-burns" />
        </div>
        <div class="boarding-bg-slide @(currentSlide == 1 ? "active" : "")">
            <img src="/images/FOTO_GEDUNG_PERSADA (2).png" alt="Gedung Persada Sudut" class="boarding-bg-img ken-burns" />
        </div>
        <!-- Gradient Overlay Langsung ke Foto Latar (Bukan Kotak Teks) -->
        <div class="boarding-overlay"></div>
    </div>

    <!-- Top Bar: Logo PERSADA di Kiri & Tombol Lewati di Kanan (Tanpa Tombol Open) -->
    <header class="boarding-topbar">
        <div class="boarding-logo-wrap">
            <img src="/icons/logoo_psd-removebg-preview.svg" alt="Persada Logo" class="boarding-brand-logo" />
        </div>
        <button type="button" class="btn-boarding-skip" @onclick="SkipBoarding">
            Lewati
        </button>
    </header>

    <!-- Main Content: Teks Hero Langsung di Atas Foto (Tanpa Glass Box/Frame Melayang) -->
    <main class="boarding-hero-wrapper">
        <div class="boarding-hero-text @(isTransitioning ? "fade-out" : "fade-in")">
            
            <!-- Badge Pill Solid (Tanpa Blur) -->
            <div class="boarding-badge-solid">
                @slides[currentSlide].Badge
            </div>

            <!-- Judul Besar Bold dengan Text Shadow Halus -->
            <h1 class="boarding-title-hero">
                @slides[currentSlide].Title
            </h1>

            <!-- Deskripsi Teks Bersih Langsung di Atas Foto -->
            <p class="boarding-desc-hero">
                @slides[currentSlide].Description
            </p>

            <!-- Indikator Titik Pagination (Tanpa Kotak Pembungkus, Murni Indikator Halaman) -->
            <div class="boarding-pagination" aria-label="Indikator halaman">
                <span class="boarding-dot @(currentSlide == 0 ? "active" : "")"></span>
                <span class="boarding-dot @(currentSlide == 1 ? "active" : "")"></span>
            </div>
        </div>
    </main>

    <!-- Footer Copyright -->
    <footer class="boarding-footer">
        &copy; 2026 PT Personel Alih Daya Tbk. Sistem Manajemen Pemesanan Ruangan.
    </footer>
</div>

<style>
    /* Viewport Utama Full Bleed */
    .boarding-viewport {
        position: relative;
        width: 100vw;
        min-height: 100vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        user-select: none;
        touch-action: pan-y;
        background-color: #0A0F1D;
        font-family: inherit;
    }

    /* Background Full Bleed Layers */
    .boarding-bg-layer {
        position: absolute;
        inset: 0;
        z-index: 1;
        overflow: hidden;
    }

    .boarding-bg-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 0.8s ease-in-out;
    }

    .boarding-bg-slide.active {
        opacity: 1;
    }

    .boarding-bg-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transform: scale(1);
    }

    /* Efek Ken Burns / Zoom Lambat Dinamis */
    .ken-burns {
        animation: kenBurnsZoom 22s infinite alternate ease-in-out;
    }

    @@keyframes kenBurnsZoom {
        0% { transform: scale(1); }
        100% { transform: scale(1.08); }
    }

    /* Gradient Overlay Langsung pada Foto: Dari transparan di atas ke gelap di bawah untuk kontras teks */
    .boarding-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            rgba(10, 15, 29, 0.25) 0%,
            rgba(10, 15, 29, 0.35) 35%,
            rgba(10, 15, 29, 0.72) 70%,
            rgba(10, 15, 29, 0.92) 100%
        );
        pointer-events: none;
    }

    /* Top Bar */
    .boarding-topbar {
        position: relative;
        z-index: 10;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 32px 56px;
    }

    .boarding-logo-wrap {
        display: flex;
        align-items: center;
    }

    .boarding-brand-logo {
        height: 52px;
        width: auto;
        filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.45));
    }

    /* Tombol Lewati di Pojok Kanan Atas (Tanpa Tombol Open Apapun) */
    .btn-boarding-skip {
        background: rgba(255, 255, 255, 0.16);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: #FFFFFF;
        font-size: 0.9rem;
        font-weight: 600;
        padding: 8px 22px;
        border-radius: 999px;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    }

    .btn-boarding-skip:hover {
        background: rgba(255, 255, 255, 0.26);
        border-color: rgba(255, 255, 255, 0.5);
        transform: translateY(-1px);
    }

    /* Kontainer Hero: Teks Langsung di Atas Foto Tanpa Box/Kotak Kaca Melayang */
    .boarding-hero-wrapper {
        position: relative;
        z-index: 10;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 0 56px 40px;
        width: 100%;
        max-width: 900px;
    }

    .boarding-hero-text {
        display: flex;
        flex-direction: column;
        gap: 16px;
        text-align: left;
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .boarding-hero-text.fade-in {
        opacity: 1;
        transform: translateY(0);
    }

    .boarding-hero-text.fade-out {
        opacity: 0.2;
        transform: translateY(6px);
    }

    /* Badge Solid Berdiri Sendiri Langsung di Atas Foto (Tanpa Blur) */
    .boarding-badge-solid {
        display: inline-block;
        align-self: flex-start;
        background: #F5A623;
        color: #0F172A;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1.2px;
        padding: 6px 14px;
        border-radius: 999px;
        text-transform: uppercase;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }

    /* Judul Besar Hero dengan Text Shadow Halus */
    .boarding-title-hero {
        font-size: 3rem;
        font-weight: 800;
        color: #FFFFFF;
        line-height: 1.15;
        margin: 0;
        letter-spacing: -0.025em;
        text-shadow: 0 2px 14px rgba(0, 0, 0, 0.65);
        max-width: 720px;
    }

    /* Deskripsi Teks Hero dengan Text Shadow Halus */
    .boarding-desc-hero {
        font-size: 1.15rem;
        color: rgba(255, 255, 255, 0.9);
        line-height: 1.65;
        margin: 0;
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
        max-width: 620px;
    }

    /* Indikator Titik Pagination (2 Titik Langsung di Bawah Teks) */
    .boarding-pagination {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
    }

    .boarding-dot {
        height: 8px;
        width: 8px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.4);
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
        transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .boarding-dot.active {
        width: 32px;
        background: #F5A623;
        box-shadow: 0 0 12px rgba(245, 166, 35, 0.7);
    }

    /* Footer Copyright Bawah */
    .boarding-footer {
        position: relative;
        z-index: 10;
        text-align: left;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.55);
        padding: 16px 56px 28px;
    }

    /* Responsif */
    @@media (max-width: 768px) {
        .boarding-topbar {
            padding: 20px 24px;
        }
        .boarding-brand-logo {
            height: 42px;
        }
        .boarding-hero-wrapper {
            padding: 0 24px 28px;
        }
        .boarding-title-hero {
            font-size: 2rem;
        }
        .boarding-desc-hero {
            font-size: 1rem;
        }
        .boarding-footer {
            padding: 12px 24px 20px;
        }
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public int? Slide { get; set; }

    private int currentSlide = 0;
    private bool isTransitioning = false;
    private double _pointerStartX = 0;
    private double _pointerStartY = 0;

    private record SlideData(string Badge, string Title, string Description);

    // Slide 1: Interior signage ("Satu Sistem, Semua Kebutuhan Ruangan")
    // Slide 2: Foto gedung ("Kelola Ruang Rapat Perusahaan Anda")
    private readonly SlideData[] slides = new[]
    {
        new SlideData(
            "KOLABORASI MODERN",
            "Satu Sistem, Semua Kebutuhan Ruangan",
            "Kemudahan reservasi cepat, persetujuan admin real-time, dan pemantauan ketersediaan fasilitas dalam satu platform terpadu."
        ),
        new SlideData(
            "SISTEM MANAJEMEN RUANGAN",
            "Kelola Ruang Rapat Perusahaan Anda",
            "Solusi cerdas manajemen ruang rapat yang terstruktur, efisien, dan siap mendukung produktivitas kolaborasi bisnis Anda."
        )
    };

    protected override void OnParametersSet()
    {
        if (Slide.HasValue && Slide.Value >= 0 && Slide.Value <= 1)
        {
            currentSlide = Slide.Value;
        }
    }

    private void HandlePointerDown(PointerEventArgs e)
    {
        _pointerStartX = e.ClientX;
        _pointerStartY = e.ClientY;
    }

    private async Task HandlePointerUp(PointerEventArgs e)
    {
        var deltaX = e.ClientX - _pointerStartX;
        var deltaY = e.ClientY - _pointerStartY;

        await ProcessSwipeGesture(deltaX, deltaY);
    }

    private void HandleTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            _pointerStartX = e.Touches[0].ClientX;
            _pointerStartY = e.Touches[0].ClientY;
        }
    }

    private async Task HandleTouchEnd(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length > 0)
        {
            var deltaX = e.ChangedTouches[0].ClientX - _pointerStartX;
            var deltaY = e.ChangedTouches[0].ClientY - _pointerStartY;

            await ProcessSwipeGesture(deltaX, deltaY);
        }
    }

    private async Task ProcessSwipeGesture(double deltaX, double deltaY)
    {
        // Hanya deteksi gesture jika pergeseran horizontal lebih dominan daripada vertikal (> 40px)
        if (Math.Abs(deltaX) > Math.Abs(deltaY) && Math.Abs(deltaX) > 40)
        {
            if (deltaX < 0) // Geser ke kiri (maju)
            {
                if (currentSlide == 0)
                {
                    GoToSlide(1);
                }
                else if (currentSlide == 1)
                {
                    // Swipe melewati slide terakhir -> otomatis arahkan ke halaman Login
                    await CompleteBoarding();
                }
            }
            else if (deltaX > 0) // Geser ke kanan (mundur)
            {
                if (currentSlide == 1)
                {
                    GoToSlide(0);
                }
            }
        }
    }

    private void GoToSlide(int slideIndex)
    {
        if (slideIndex == currentSlide) return;
        isTransitioning = true;
        currentSlide = slideIndex;
        _ = Task.Run(async () =>
        {
            await Task.Delay(250);
            isTransitioning = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task SkipBoarding()
    {
        await CompleteBoarding();
    }

    private async Task CompleteBoarding()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "persada-onboarding-seen", "true");
            await JS.InvokeVoidAsync("localStorage.setItem", "hasSeenBoarding", "true");
        }
        catch { }
        Navigation.NavigateTo("/login");
    }
}
