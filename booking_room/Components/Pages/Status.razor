@page "/status"
@page "/bookings/status"
@using booking_room.Components.Models
@using booking_room.Components.Shared

<PageTitle>Booking Status - PADA Management</PageTitle>

<div class="page-container bg-slate-50">
    <div class="page-header">
        <h1 class="page-title">Status Pemesanan</h1>
        <p class="page-subtitle">Tinjau status saat ini dari permintaan pemesanan Anda.</p>
    </div>

    <div class="status-layout">
        <!-- Kolom Kiri: List Booking -->
        <div class="status-list-col">
            <div class="status-toolbar">
                <div class="search-bar">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="search-icon"><path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.134 17 3 13.866 3 10C3 6.134 6.134 3 10 3C13.866 3 17 6.134 17 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <input type="text" placeholder="Cari pemesanan..." @bind="searchQuery" @bind:event="oninput" />
                </div>
                <button class="btn-filter" @onclick="ToggleFilterPopup">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Filter
                </button>
                
                @if (isFilterOpen)
                {
                    <div class="filter-popup-anchor">
                        <FilterByStatusPopup CurrentStatus="@activeFilter" OnApply="ApplyFilter" OnClose="CloseFilterPopup" />
                    </div>
                }
            </div>

            <div class="booking-cards-list">
                @if (!FilteredBookings.Any())
                {
                    <div class="empty-state">
                        <p>Tidak ditemukan pemesanan yang sesuai dengan kriteria Anda.</p>
                    </div>
                }
                else
                {
                    @foreach (var booking in FilteredBookings)
                    {
                        var isSelected = booking.Id == selectedBooking?.Id;
                        <div class="booking-list-card @(isSelected ? "selected" : "")" @onclick="() => SelectBooking(booking)">
                            <div class="card-thumbnail">
                                <img src="@booking.PhotoUrl" alt="@booking.RoomName" />
                            </div>
                            <div class="card-content">
                                <div class="card-header-row">
                                    <div class="card-title-group">
                                        <h3 class="card-room-name">@booking.RoomName</h3>
                                        <span class="card-req-id">@booking.RequestId</span>
                                    </div>
                                    <span class="status-badge @BookingDataStore.GetStatusBadgeClass(booking.Status)">
                                        <span class="status-dot"></span>
                                        @BookingDataStore.GetStatusLabel(booking.Status)
                                    </span>
                                </div>
                                <div class="card-meta-row">
                                    <span class="meta-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2"/></svg> @booking.Date</span>
                                    <span class="meta-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2"/></svg> @booking.TimeSlot</span>
                                    <span class="meta-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 7a4 4 0 100-8 4 4 0 000 8z" stroke="currentColor" stroke-width="2"/></svg> @booking.Attendees Peserta</span>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Kolom Kanan: Detail Sticky -->
        <div class="status-detail-col">
            @if (selectedBooking != null)
            {
                <div class="detail-panel-sticky">
                    <div class="detail-photo-wrapper">
                        <span class="detail-status-overlay">
                            <span class="status-dot"></span>
                            @BookingDataStore.GetStatusLabel(selectedBooking.Status).ToUpper()
                        </span>
                        <img src="@selectedBooking.PhotoUrl" alt="@selectedBooking.RoomName" class="detail-photo" />
                    </div>
                    
                    <div class="detail-panel-body">
                        <div class="detail-header-block">
                            <h2 class="detail-room-name">@selectedBooking.RoomName</h2>
                            <span class="detail-req-id">Request ID: @selectedBooking.RequestId</span>
                        </div>

                        <div class="detail-requester">
                            <span class="label-small">DIPESAN OLEH</span>
                            <div class="requester-profile">
                                <div class="avatar-circle">
                                    @GetInitials(selectedBooking.RequestedBy)
                                </div>
                                <div class="requester-info">
                                    <span class="requester-name">@selectedBooking.RequestedBy</span>
                                    <span class="requester-title">@selectedBooking.RequestedByTitle</span>
                                </div>
                            </div>
                        </div>

                        <hr class="detail-divider" />

                        <div class="detail-grid">
                            <div class="grid-item">
                                <span class="grid-label">TANGGAL</span>
                                <span class="grid-value">@selectedBooking.Date</span>
                            </div>
                            <div class="grid-item">
                                <span class="grid-label">WAKTU</span>
                                <span class="grid-value">@selectedBooking.TimeSlot</span>
                            </div>
                            <div class="grid-item">
                                <span class="grid-label">DURASI</span>
                                <span class="grid-value">@selectedBooking.Duration</span>
                            </div>
                            <div class="grid-item">
                                <span class="grid-label">KAPASITAS</span>
                                <span class="grid-value">@selectedBooking.Attendees/@selectedBooking.Capacity Peserta</span>
                            </div>
                        </div>

                        <div class="purpose-box">
                            <div class="purpose-header">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                <span class="purpose-label">Tujuan</span>
                            </div>
                            <p class="purpose-text">@selectedBooking.Purpose</p>
                        </div>

                        <div class="detail-actions">
                            <button class="btn-modify" @onclick="OpenModifyModal">Ubah</button>
                            <button class="btn-cancel-req" @onclick="OpenCancelModal">Batalkan Permintaan</button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-detail-state">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="#CBD5E1" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke="#CBD5E1" stroke-width="2"/></svg>
                    <p>Pilih pemesanan untuk melihat detail</p>
                </div>
            }
        </div>
    </div>
</div>

<ModalOverlayBlur Visible="isModifyModalOpen" OnClose="CloseModifyModal" Size="default">
    <ModifyBookingModal Booking="selectedBooking" OnClose="CloseModifyModal" OnUpdate="HandleModifyUpdate" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="isCancelModalOpen" OnClose="CloseCancelModal" Size="default">
    <CancelRequestModal Booking="selectedBooking" OnClose="CloseCancelModal" OnConfirm="HandleCancelConfirm" />
</ModalOverlayBlur>

<style>
    .page-container { padding: 32px; font-family: 'Inter', sans-serif; }
    .bg-slate-50 { background-color: #F8FAFC; min-height: 100vh; }
    .page-header { margin-bottom: 32px; }
    .page-title { color: #16305C; font-size: 28px; font-weight: 700; margin: 0 0 8px 0; }
    .page-subtitle { color: #6B7280; font-size: 15px; margin: 0; }

    .status-layout { display: grid; grid-template-columns: 1fr 400px; gap: 24px; }
    .status-list-col { min-width: 0; }
    .status-detail-col { position: relative; }

    .status-toolbar { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; position: relative; }
    .search-bar { position: relative; flex-grow: 1; display: flex; align-items: center; }
    .search-bar .search-icon { position: absolute; left: 14px; color: #9CA3AF; }
    .search-bar input { width: 100%; padding: 10px 16px 10px 42px; border: 1px solid #E5E7EB; border-radius: 12px; font-size: 14px; background: #FFFFFF; }
    .search-bar input:focus { outline: none; border-color: #16305C; }
    .btn-filter { display: inline-flex; align-items: center; gap: 6px; padding: 10px 16px; border: 1px solid #E5E7EB; border-radius: 999px; background: #FFFFFF; color: #374151; font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .btn-filter:hover { background-color: #F9FAFB; }
    .filter-popup-anchor { position: absolute; top: 50px; right: 0; z-index: 100; }

    .booking-cards-list { display: flex; flex-direction: column; gap: 12px; }
    .booking-list-card { display: flex; gap: 16px; background: #FFFFFF; border: 1px solid #F1F5F9; border-radius: 16px; padding: 16px; cursor: pointer; transition: all 0.2s; }
    .booking-list-card:hover { border-color: #CBD5E1; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
    .booking-list-card.selected { border-color: #EAB63C; box-shadow: 0 0 0 2px rgba(234,182,60,0.2); }
    .card-thumbnail { width: 72px; height: 72px; flex-shrink: 0; border-radius: 12px; overflow: hidden; }
    .card-thumbnail img { width: 100%; height: 100%; object-fit: cover; }
    .card-content { flex-grow: 1; min-width: 0; }
    .card-header-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }
    .card-room-name { color: #16305C; font-size: 15px; font-weight: 600; margin: 0; }
    .card-req-id { color: #9CA3AF; font-size: 12px; }
    .card-meta-row { display: flex; gap: 16px; flex-wrap: wrap; }
    .meta-item { display: inline-flex; align-items: center; gap: 4px; color: #6B7280; font-size: 12px; }
    .meta-item svg { color: #9CA3AF; }

    .status-badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; white-space: nowrap; }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .badge-pending { background-color: #FEF3C7; color: #92400E; }
    .badge-approved { background-color: #D1FAE5; color: #065F46; }
    .badge-rejected { background-color: #FEE2E2; color: #991B1B; }
    .badge-completed { background-color: #DBEAFE; color: #1E40AF; }

    .detail-panel-sticky { position: sticky; top: 32px; background: #FFFFFF; border-radius: 20px; overflow: hidden; border: 1px solid #F1F5F9; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
    .detail-photo-wrapper { position: relative; height: 180px; }
    .detail-photo { width: 100%; height: 100%; object-fit: cover; }
    .detail-status-overlay { position: absolute; top: 12px; left: 12px; background: rgba(0,0,0,0.6); color: white; padding: 4px 12px; border-radius: 999px; font-size: 11px; font-weight: 600; display: flex; align-items: center; gap: 6px; text-transform: uppercase; letter-spacing: 0.05em; }
    .detail-panel-body { padding: 24px; }
    .detail-header-block { margin-bottom: 20px; }
    .detail-room-name { color: #16305C; font-size: 20px; font-weight: 700; margin: 0 0 4px 0; }
    .detail-req-id { color: #9CA3AF; font-size: 12px; }
    .label-small { display: block; color: #9CA3AF; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
    .requester-profile { display: flex; align-items: center; gap: 12px; }
    .avatar-circle { width: 40px; height: 40px; background-color: #16305C; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; }
    .requester-name { display: block; color: #16305C; font-size: 14px; font-weight: 600; }
    .requester-title { display: block; color: #9CA3AF; font-size: 12px; }
    .detail-divider { border: none; border-top: 1px solid #F1F5F9; margin: 20px 0; }
    .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
    .grid-item { display: flex; flex-direction: column; gap: 4px; }
    .grid-label { color: #9CA3AF; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
    .grid-value { color: #16305C; font-size: 14px; font-weight: 600; }
    .purpose-box { background-color: #F8FAFC; border-radius: 12px; padding: 16px; margin-bottom: 24px; }
    .purpose-header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; color: #6B7280; }
    .purpose-label { font-size: 13px; font-weight: 600; }
    .purpose-text { color: #4B5563; font-size: 13px; line-height: 1.5; margin: 0; }
    .detail-actions { display: flex; gap: 12px; }
    .btn-modify { flex: 1; background-color: #EAB63C; color: #16305C; border: none; border-radius: 999px; padding: 12px; font-weight: 700; font-size: 14px; cursor: pointer; transition: opacity 0.2s; }
    .btn-modify:hover { opacity: 0.9; }
    .btn-cancel-req { flex: 1; background: #FFFFFF; color: #EF4444; border: 1px solid #FEE2E2; border-radius: 999px; padding: 12px; font-weight: 600; font-size: 14px; cursor: pointer; transition: background-color 0.2s; }
    .btn-cancel-req:hover { background-color: #FEF2F2; }

    .empty-state { text-align: center; padding: 60px 20px; color: #9CA3AF; }
    .empty-detail-state { display: flex; flex-direction: column; align-items: center; justify-content: center; background: #FFFFFF; border-radius: 20px; border: 1px solid #F1F5F9; padding: 60px 20px; color: #94A3B8; }
    .empty-detail-state p { margin: 12px 0 0 0; font-size: 14px; }

    .detail-requester { margin-bottom: 20px; }

    @@media (max-width: 1024px) {
        .status-layout { grid-template-columns: 1fr; }
        .detail-panel-sticky { position: static; }
    }
</style>

@code {
    private List<BookingItem> allBookings = new();
    private BookingItem? selectedBooking;
    private string searchQuery = "";
    private string activeFilter = "All Status";
    private bool isFilterOpen = false;
    
    private bool isModifyModalOpen = false;
    private bool isCancelModalOpen = false;

    protected override void OnInitialized()
    {
        allBookings = BookingDataStore.AllBookings;
        selectedBooking = allBookings.FirstOrDefault();
    }

    private IEnumerable<BookingItem> FilteredBookings
    {
        get
        {
            var query = allBookings.AsEnumerable();
            
            if (activeFilter != "All Status")
            {
                query = query.Where(b => b.Status.Equals(activeFilter, StringComparison.OrdinalIgnoreCase));
            }
            
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.ToLower();
                query = query.Where(b => b.RoomName.ToLower().Contains(q) || b.RequestId.ToLower().Contains(q));
            }
            
            return query;
        }
    }

    private void SelectBooking(BookingItem booking)
    {
        selectedBooking = booking;
    }

    private void ToggleFilterPopup()
    {
        isFilterOpen = !isFilterOpen;
    }

    private void CloseFilterPopup()
    {
        isFilterOpen = false;
    }

    private void ApplyFilter(string status)
    {
        activeFilter = status;
        isFilterOpen = false;
    }

    private void OpenModifyModal()
    {
        isModifyModalOpen = true;
    }

    private void CloseModifyModal()
    {
        isModifyModalOpen = false;
    }

    private void HandleModifyUpdate(BookingItem updatedBooking)
    {
        // Update in list
        var index = allBookings.FindIndex(b => b.Id == updatedBooking.Id);
        if (index != -1)
        {
            allBookings[index] = updatedBooking;
            selectedBooking = updatedBooking;
        }
        isModifyModalOpen = false;
        // In real app, show toast notification here
    }

    private void OpenCancelModal()
    {
        isCancelModalOpen = true;
    }

    private void CloseCancelModal()
    {
        isCancelModalOpen = false;
    }

    private void HandleCancelConfirm(BookingItem booking)
    {
        // Update status to rejected/cancelled
        var index = allBookings.FindIndex(b => b.Id == booking.Id);
        if (index != -1)
        {
            var updated = booking with { Status = "rejected" };
            allBookings[index] = updated;
            selectedBooking = updated;
        }
        isCancelModalOpen = false;
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return $"{parts[0].Substring(0, 1)}{parts[1].Substring(0, 1)}".ToUpper();
    }
}
