@page "/status"
@page "/bookings/status"
@using booking_room.Components.Models
@using booking_room.Components.Shared
@using booking_room.Services
@inject IToastService ToastService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Status Pemesanan — Persada Ruangan</PageTitle>

<div class="content-fade-in status-page-wrapper">
    <!-- Header Halaman CASE 4: Padding-top 24px, Title-to-Subtitle 4px, Subtitle-to-Filters 20px -->
    <div class="status-page-header">
        <div>
            <h1 class="status-hero-title">Status Pemesanan</h1>
            <p class="status-hero-subtitle">Pantau dan kelola seluruh status permintaan reservasi ruangan Anda.</p>
        </div>
        <div class="status-header-actions">
            <button type="button" class="status-btn-icon-refresh" @onclick="RefreshData" title="Perbarui Data" aria-label="Perbarui Data">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Search & Filter (CASE 13: Funnel icon and right chevron on Semua Status) -->
    <div class="status-filters">
        <div class="search-bar-wrapper">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" class="search-bar-input" placeholder="Cari pemesanan..." @bind="_searchQuery" @bind:event="oninput" />
        </div>
        <div class="filter-dropdown-wrapper">
            <svg class="filter-dropdown-funnel" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            <select class="filter-select" @bind="activeFilter" @bind:after="OnFilterChanged">
                @foreach (var opt in _statusFilterOptions)
                {
                    <option value="@opt">@opt</option>
                }
            </select>
            <svg class="filter-dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>
    </div>

    <!-- Layout Utama 2-Kolom -->
    <div class="status-main-layout">
        <!-- List di Kiri: Seragam min-height 110px per card, tanpa floating divs -->
        <div class="status-list-container">
            @if (!FilteredBookings.Any())
            {
                <div class="status-empty-state">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.5">
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <p class="empty-title">Tidak ada pemesanan ditemukan</p>
                    <p class="empty-desc">Coba sesuaikan kata kunci pencarian atau filter status.</p>
                </div>
            }
            else
            {
                @foreach (var booking in FilteredBookings)
                {
                    <div class="booking-list-card @(selectedBooking?.Id == booking.Id ? "active" : "")" @onclick="() => SelectBooking(booking)">
                        <!-- CASE 12: Robust <img> thumb with fallback for all statuses including Ditolak -->
                        <div class="booking-card-thumb">
                            <img src="@GetSafePhoto(booking)" alt="@booking.RoomName" class="booking-thumb-img" onerror="this.src='https://images.unsplash.com/photo-1497366216548-37526070297c?w=600&auto=format&fit=crop&q=80'" />
                        </div>
                        <div class="booking-card-content">
                            <div class="booking-card-header">
                                <h3 class="booking-card-title">@booking.RoomName</h3>
                                <span class="booking-card-id">#@booking.RequestId</span>
                            </div>
                            <div class="booking-card-time">@booking.Date • @booking.TimeSlot</div>
                            <div class="booking-card-footer-row">
                                <div class="booking-card-attendees">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                    <span>@booking.Attendees Peserta</span>
                                </div>
                                <div class="booking-card-status">
                                    <StatusBadge Status="@booking.Status" />
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Detail Panel Kanan -->
        <div class="status-detail-panel @(selectedBooking != null ? "visible" : "")">
            @if (selectedBooking != null)
            {
                <div class="detail-panel-hero clickable" @onclick="OpenRoomMasterDetail" role="button" tabindex="0" title="Klik foto untuk melihat Detail Ruangan">
                    <img src="@GetSafePhoto(selectedBooking)" class="detail-hero-img" alt="@selectedBooking.RoomName" onerror="this.src='https://images.unsplash.com/photo-1497366216548-37526070297c?w=600&auto=format&fit=crop&q=80'" />
                    <div class="detail-hero-overlay">
                        <div class="hero-overlay-badge lihat-detail-ruangan-btn">
                            <span>Lihat Detail Ruangan</span>
                        </div>
                    </div>
                    <div class="detail-hero-status-badge">
                        <StatusBadge Status="@selectedBooking.Status" />
                    </div>
                </div>
                <div class="detail-panel-content">
                    <!-- Room title row without old Detail Ruangan button -->
                    <div class="detail-panel-title-row">
                        <div>
                            <h2 class="detail-panel-title" @onclick="OpenRoomMasterDetail" style="cursor: pointer;" title="Klik untuk melihat detail ruangan lengkap">@selectedBooking.RoomName</h2>
                            <p class="detail-panel-id">ID Permintaan: #@selectedBooking.RequestId</p>
                        </div>
                    </div>
                    
                    <div class="detail-panel-grid">
                        <div class="detail-info-block">
                            <label>PEMOHON</label>
                            <div class="info-val-strong">@(string.IsNullOrEmpty(selectedBooking.RequestedBy) ? "Budi Santoso" : selectedBooking.RequestedBy)</div>
                            <div class="info-val-sub">@(string.IsNullOrEmpty(selectedBooking.RequestedByTitle) ? "VP of Engineering" : selectedBooking.RequestedByTitle)</div>
                        </div>
                        <div class="detail-info-block">
                            <label>WAKTU & TANGGAL</label>
                            <div class="info-val-strong">@selectedBooking.Date</div>
                            <div class="info-val-sub">@selectedBooking.TimeSlot (@selectedBooking.Duration)</div>
                        </div>
                        <div class="detail-info-block">
                            <label>KAPASITAS</label>
                            <div class="info-val-strong">@selectedBooking.Attendees / @selectedBooking.Capacity</div>
                            <div class="info-val-sub">Peserta Hadir</div>
                        </div>
                        <div class="detail-info-block">
                            <label>LOKASI RUANGAN</label>
                            <div class="info-val-strong">Gedung Utama</div>
                            <div class="info-val-sub">@(string.IsNullOrEmpty(selectedBooking.Floor) ? "Lantai 3, Sayap Barat" : selectedBooking.Floor)</div>
                        </div>
                    </div>

                    <div class="detail-info-block" style="margin-top: 14px;">
                        <label>TUJUAN RAPAT</label>
                        <div class="info-val-purpose">
                            @(string.IsNullOrEmpty(selectedBooking.Purpose) ? "Pembaruan proyek dan evaluasi kuartal berjalan bersama tim manajemen dan pemangku kepentingan." : selectedBooking.Purpose)
                        </div>
                    </div>

                    @if (selectedBooking.Status.Equals("rejected", StringComparison.OrdinalIgnoreCase) || selectedBooking.Status.Equals("ditolak", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="detail-rejection-box">
                            <div class="rejection-title">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                                <span>Alasan Penolakan</span>
                            </div>
                            <p class="rejection-text">Ruangan dialihkan oleh General Affairs untuk agenda rapat direksi mendadak. Silakan pilih ruangan alternatif.</p>
                        </div>
                    }

                    <div class="detail-panel-actions">
                        @if (BookingPolicy.CanModifyBooking(selectedBooking.Status) || BookingPolicy.CanCancelBooking(selectedBooking.Status))
                        {
                            <div class="detail-action-subrow">
                                @if (BookingPolicy.CanModifyBooking(selectedBooking.Status))
                                {
                                    <button type="button" class="btn-action-modify" @onclick="OpenModifyModal">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                        <span>Ubah Jadwal</span>
                                    </button>
                                }
                                @if (BookingPolicy.CanCancelBooking(selectedBooking.Status))
                                {
                                    <button type="button" class="btn-action-cancel-outline" @onclick="OpenCancelModal">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                        <span>Batalkan Permintaan</span>
                                    </button>
                                }
                            </div>
                        }

                        <div class="detail-action-subrow">
                            <!-- Tombol "Lihat Jadwal Ruangan" SELALU tampil, apapun status -->
                            <button type="button" class="btn-action-view" @onclick='() => Navigation.NavigateTo($"/pemesanan?tab=kalender")'>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                                <span>Lihat Jadwal Ruangan</span>
                            </button>
                            <button type="button" class="btn-action-close" @onclick="() => selectedBooking = null" title="Tutup detail panel">
                                <span>Tutup</span>
                            </button>
                        </div>

                        @if (selectedBooking.Status.Equals("rejected", StringComparison.OrdinalIgnoreCase) || selectedBooking.Status.Equals("ditolak", StringComparison.OrdinalIgnoreCase))
                        {
                            <button type="button" class="btn-action-rebook" @onclick='() => Navigation.NavigateTo("/pemesanan?tab=ruangan")'>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>Pesan Ruangan Lagi</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Reusable Modern Cancel Modal (CASE 1 & CASE 4) -->
<CancelBookingModal @bind-Visible="isCancelModalOpen" 
                    RoomName="@selectedBooking?.RoomName" 
                    RequestId="@selectedBooking?.RequestId" 
                    OnConfirmCancel="ConfirmCancelWithReason" />

<!-- Reusable Modern Modify Modal (CASE 4) -->
<ModifyBookingModal @bind-Visible="isModifyModalOpen" 
                    Booking="selectedBooking" 
                    OnUpdate="ConfirmModifyWithBooking" />

<!-- Master Room Details Popup (CASE 2a) -->
<RoomDetailsModal @bind-Visible="_isRoomModalOpen" 
                  Room="_selectedRoomForModal" 
                  Mode="DetailRuanganMode.ViewOnly" />

<style>
    /* CASE 4: Padding 24px 24px 28px strictly from navbar bottom */
    .status-page-wrapper {
        padding: 24px 24px 28px;
        max-width: 1400px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 0;
    }
    
    .status-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 0;
        margin-bottom: 20px;
    }
    
    .status-hero-title {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--persada-navy-900, #0F1F3D);
        margin: 0 0 4px 0;
        letter-spacing: -0.02em;
    }
    body.dark-mode .status-hero-title { color: #F8FAFC; }
    
    .status-hero-subtitle {
        font-size: 0.875rem;
        color: var(--persada-text-secondary, #6B7280);
        margin: 0;
    }
    
    .status-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .status-btn-new-booking {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 0 18px;
        height: 42px;
        background: #F59E0B;
        color: #0F172A;
        border: none;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(245, 158, 11, 0.25);
    }
    .status-btn-new-booking:hover {
        background: #D97706;
        color: #FFFFFF;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(217, 119, 6, 0.35);
    }
    body.dark-mode .status-btn-new-booking {
        background: #F59E0B;
        color: #0F172A;
    }

    .status-btn-icon-refresh {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        padding: 0;
        background: var(--surface-card, #FFFFFF);
        border: 1.5px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 12px;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }
    body.dark-mode .status-btn-icon-refresh {
        background: #1C1C1E;
        border-color: rgba(255, 255, 255, 0.12);
        color: #F8FAFC;
    }
    .status-btn-icon-refresh:hover {
        background: #F8FAFC;
        border-color: #CBD5E1;
        color: var(--persada-navy-900, #0F1F3D);
        transform: translateY(-1px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.07);
    }
    
    /* CASE 5: Filters perfectly aligned flex with align-items: center */
    .status-filters {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 20px;
    }
    
    .search-bar-wrapper {
        position: relative;
        flex: 1;
        max-width: 380px;
        height: 44px;
        display: flex;
        align-items: center;
        margin: 0;
        padding: 0;
    }
    
    .search-bar-wrapper svg {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #9CA3AF;
        pointer-events: none;
        width: 18px;
        height: 18px;
    }
    
    .search-bar-input {
        width: 100%;
        height: 44px;
        padding: 0 14px 0 42px;
        border: 1.5px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 12px;
        font-size: 0.875rem;
        outline: none;
        box-sizing: border-box;
        background: var(--surface-card, #FFFFFF);
        color: var(--persada-text-primary, #111827);
        transition: border-color 0.2s, box-shadow 0.2s;
        margin: 0;
        line-height: normal;
    }
    body.dark-mode .search-bar-input {
        background: #1C1C1E;
        border-color: rgba(255, 255, 255, 0.1);
        color: #F8FAFC;
    }
    .search-bar-input:focus {
        border-color: #1F5D9A;
        box-shadow: 0 0 0 3px rgba(31, 93, 154, 0.12);
    }
    
    .filter-dropdown-wrapper {
        position: relative;
        height: 44px;
        display: flex;
        align-items: center;
        margin: 0;
        padding: 0;
    }

    .filter-dropdown-funnel {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        color: #64748B;
        width: 16px;
        height: 16px;
        z-index: 1;
    }
    
    .filter-select {
        height: 44px;
        padding: 0 38px 0 40px;
        border: 1.5px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 12px;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--persada-text-primary, #111827);
        background-color: var(--surface-card, #FFFFFF);
        outline: none;
        cursor: pointer;
        box-sizing: border-box;
        transition: border-color 0.2s;
        margin: 0;
        line-height: normal;
        display: block;
        appearance: none;
        -webkit-appearance: none;
    }
    body.dark-mode .filter-select {
        background-color: #1C1C1E;
        border-color: rgba(255, 255, 255, 0.1);
        color: #F8FAFC;
    }
    .filter-select:focus {
        border-color: #1F5D9A;
    }

    .filter-dropdown-chevron {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        color: #64748B;
        width: 14px;
        height: 14px;
        z-index: 1;
    }
    
    .status-main-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 420px;
        gap: 24px;
        align-items: start;
    }
    
    .status-list-container {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-height: calc(100vh - 200px);
        overflow-y: auto;
        padding-right: 6px;
    }
    
    .status-list-container::-webkit-scrollbar { width: 6px; }
    .status-list-container::-webkit-scrollbar-thumb {
        background: #CBD5E1;
        border-radius: 4px;
    }
    
    /* CASE 5: Uniform min-height: 110px across all list cards */
    .booking-list-card {
        display: flex;
        gap: 16px;
        padding: 16px;
        min-height: 110px;
        box-sizing: border-box;
        background: var(--surface-card, #FFFFFF);
        border: 1.5px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 16px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    body.dark-mode .booking-list-card {
        background: #1C1C1E;
        border-color: rgba(255, 255, 255, 0.1);
    }
    .booking-list-card:hover {
        border-color: #CBD5E1;
        box-shadow: 0 4px 14px rgba(15, 31, 61, 0.06);
        transform: translateY(-1px);
    }
    .booking-list-card.active {
        border-color: #1F5D9A;
        box-shadow: 0 4px 16px rgba(31, 93, 154, 0.12);
        background: #F8FAFC;
    }
    body.dark-mode .booking-list-card.active {
        background: rgba(31, 93, 154, 0.15);
        border-color: #3B82F6;
    }
    
    .booking-card-thumb {
        width: 84px;
        height: 84px;
        border-radius: 12px;
        overflow: hidden;
        background-color: #F1F5F9;
        flex-shrink: 0;
    }
    .booking-thumb-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    
    .booking-card-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    
    .booking-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 2px;
    }
    
    .booking-card-title {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--persada-text-primary, #0F1F3D);
    }
    body.dark-mode .booking-card-title { color: #F8FAFC; }
    
    .booking-card-id {
        font-size: 0.75rem;
        color: var(--persada-text-secondary, #9CA3AF);
        font-weight: 600;
    }
    
    .booking-card-time {
        font-size: 0.8125rem;
        color: var(--persada-text-secondary, #4B5563);
        margin-bottom: 4px;
    }
    
    .booking-card-footer-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 6px;
    }

    .booking-card-attendees {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.75rem;
        color: var(--persada-text-secondary, #6B7280);
    }
    
    .booking-card-status {
        display: flex;
        align-items: center;
    }
    
    .status-detail-panel {
        background: var(--surface-card, #FFFFFF);
        border: 1px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 20px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 20px rgba(15, 31, 61, 0.06);
        position: sticky;
        top: 14px;
        max-height: calc(100vh - 120px);
    }
    body.dark-mode .status-detail-panel {
        background: #1C1C1E;
        border-color: rgba(255, 255, 255, 0.1);
    }
    
    .detail-panel-hero.clickable {
        position: relative;
        width: 100%;
        height: 190px;
        min-height: 180px;
        flex-shrink: 0;
        overflow: hidden;
        background: #F1F5F9;
        cursor: pointer;
    }
    
    .detail-panel-hero.clickable .detail-hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .detail-panel-hero.clickable:hover .detail-hero-img {
        transform: scale(1.03);
    }

    .detail-hero-overlay {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, 0.35);
        display: flex;
