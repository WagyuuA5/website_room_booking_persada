@code {
    [SupplyParameterFromQuery(Name = "filter")]
    public string? StatusFilterQuery { get; set; }

    [SupplyParameterFromQuery(Name = "bookingId")]
    public string? BookingIdQuery { get; set; }

    private bool _disposed;
    private System.Threading.CancellationTokenSource? _cts;
    
    private string _searchQuery = "";
    private string activeFilter = "Semua Status";
    private readonly string[] _statusFilterOptions = new[] { "Semua Status", "Menunggu Persetujuan", "Disetujui", "Ditolak", "Dibatalkan", "Selesai" };

    private bool isCancelModalOpen = false;
    private bool isModifyModalOpen = false;

    private bool _isRoomModalOpen = false;
    private RoomItem? _selectedRoomForModal;

    private List<BookingItem> _allBookings = new();
    private BookingItem? selectedBooking;

    protected override async Task OnInitializedAsync()
    {
        _cts = new System.Threading.CancellationTokenSource();
        try {
            await LoadDataAsync(_cts.Token);
        } catch (TaskCanceledException) {}
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(StatusFilterQuery) && _statusFilterOptions.Contains(StatusFilterQuery))
        {
            activeFilter = StatusFilterQuery;
        }

        if (!string.IsNullOrEmpty(BookingIdQuery) && _allBookings.Any())
        {
            var match = _allBookings.FirstOrDefault(b => b.Id == BookingIdQuery || b.RequestId.Contains(BookingIdQuery, StringComparison.OrdinalIgnoreCase));
            if (match != null)
            {
                selectedBooking = match;
            }
        }
    }

    private async Task LoadDataAsync(System.Threading.CancellationToken token)
    {
        // Add fake delay to simulate async api
        await Task.Delay(200, token);
        _allBookings = BookingDataStore.AllBookings.ToList();

        if (selectedBooking == null && _allBookings.Count > 0)
        {
            if (!string.IsNullOrEmpty(BookingIdQuery))
            {
                var match = _allBookings.FirstOrDefault(b => b.Id == BookingIdQuery || b.RequestId.Contains(BookingIdQuery, StringComparison.OrdinalIgnoreCase));
                selectedBooking = match ?? _allBookings[0];
            }
            else
            {
                selectedBooking = _allBookings[0];
            }
        }
        
        if (!_disposed) {
            try { await InvokeAsync(StateHasChanged); } catch {}
        }
    }
    
    private void LoadData() { }

    private string GetSafePhoto(BookingItem item)
    {
        return RoomDataProvider.GetRoomPhoto(item.PhotoUrl, item.RoomName);
    }

    private void OpenRoomMasterDetail()
    {
        if (selectedBooking == null) return;
        var room = RoomDataProvider.GetRooms().FirstOrDefault(r => r.Name.Equals(selectedBooking.RoomName, StringComparison.OrdinalIgnoreCase))
                   ?? RoomDataProvider.GetRooms().FirstOrDefault(r => r.Name.Contains(selectedBooking.RoomName, StringComparison.OrdinalIgnoreCase) || selectedBooking.RoomName.Contains(r.Name, StringComparison.OrdinalIgnoreCase))
                   ?? new RoomItem(
                       selectedBooking.Id,
                       selectedBooking.RoomName,
                       selectedBooking.Capacity > 0 ? selectedBooking.Capacity : 12,
                       "Ruang pertemuan modern dengan fasilitas lengkap dan konektivitas prima untuk menunjang produktivitas rapat.",
                       "available",
                       new List<string> { "AC", "WiFi Cepat", "Smart TV", "Proyektor" },
                       string.IsNullOrEmpty(selectedBooking.Floor) ? "3" : selectedBooking.Floor.Replace("Lantai", "").Trim(),
                       selectedBooking.PhotoUrl
                   );

        _selectedRoomForModal = room;
        _isRoomModalOpen = true;
    }

    private IEnumerable<BookingItem> FilteredBookings
    {
        get
        {
            var query = _allBookings.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(b => b.RoomName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
                                      || b.RequestId.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrEmpty(activeFilter) && activeFilter != "Semua Status")
            {
                query = activeFilter switch
                {
                    "Menunggu Persetujuan" => query.Where(b => b.Status.Equals("pending", StringComparison.OrdinalIgnoreCase)),
                    "Disetujui" => query.Where(b => b.Status.Equals("approved", StringComparison.OrdinalIgnoreCase)),
                    "Ditolak" => query.Where(b => b.Status.Equals("rejected", StringComparison.OrdinalIgnoreCase)),
                    "Dibatalkan" => query.Where(b => b.Status.Equals("canceled", StringComparison.OrdinalIgnoreCase)),
                    "Selesai" => query.Where(b => b.Status.Equals("completed", StringComparison.OrdinalIgnoreCase)),
                    _ => query
                };
            }

            return query;
        }
    }

    private void SelectBooking(BookingItem item)
    {
        selectedBooking = item;
    }

    private void OnFilterChanged()
    {
        var first = FilteredBookings.FirstOrDefault();
        if (first != null) selectedBooking = first;
    }

    private async Task RefreshData()
    {
        if (_cts != null) {
            _cts.Cancel();
            _cts.Dispose();
        }
        _cts = new System.Threading.CancellationTokenSource();
        try {
            await LoadDataAsync(_cts.Token);
            ToastService.Success("Data Diperbarui", "Status pemesanan berhasil disinkronkan.");
        } catch (TaskCanceledException) {}
    }

    private void OpenCancelModal()
    {
        isCancelModalOpen = true;
    }

    private void ConfirmCancelWithReason(string reason)
    {
        if (selectedBooking != null)
        {
            var updated = selectedBooking with { 
                Status = "canceled",
                RejectionReason = $"Dibatalkan oleh pemesan: {reason}"
            };
            var idx = _allBookings.FindIndex(b => b.Id == selectedBooking.Id);
            if (idx >= 0)
            {
                _allBookings[idx] = updated;
                selectedBooking = updated;
            }
            ToastService.Success("Pemesanan Dibatalkan", $"Permintaan pemesanan ruangan {updated.RoomName} telah dibatalkan.");
        }
    }

    private void OpenModifyModal()
    {
        isModifyModalOpen = true;
    }

    private void ConfirmModifyWithBooking(BookingItem updated)
    {
        var idx = _allBookings.FindIndex(b => b.Id == updated.Id);
        if (idx >= 0)
        {
            _allBookings[idx] = updated;
            selectedBooking = updated;
        }
        ToastService.Success("Pemesanan Diperbarui", $"Modifikasi pemesanan {updated.RoomName} berhasil disimpan.");
    }

    public void Dispose()
    {
        _disposed = true;
        if (_cts != null)
        {
            _cts.Cancel();
            _cts.Dispose();
            _cts = null;
        }
    }
}
