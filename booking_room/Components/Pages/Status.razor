@page "/status"
@page "/bookings/status"
@using booking_room.Components.Models
@using booking_room.Components.Shared
@using booking_room.Services
@inject IToastService ToastService
@implements IDisposable

<PageTitle>Status Pemesanan — Persada Ruangan</PageTitle>

<div class="status-page-wrapper">
    <!-- Header Halaman -->
    <div class="status-page-header">
        <div>
            <h1 class="status-hero-title">Status Pemesanan</h1>
            <p class="status-hero-subtitle">Tinjau status permintaan reservasi Anda saat ini.</p>
        </div>
        <div class="status-header-actions">
            <button class="status-btn-icon-refresh" @onclick="RefreshData" title="Muat Ulang Data">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
                </svg>
                <span>Perbarui Data</span>
            </button>
        </div>
    </div>

    <!-- Search & Filter -->
    <div class="status-filters">
        <div class="search-bar-wrapper">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" class="search-bar-input" placeholder="Cari pemesanan..." @bind="_searchQuery" @bind:event="oninput" />
        </div>
        <div class="filter-dropdown">
            <select class="filter-select" @bind="activeFilter" @bind:after="OnFilterChanged">
                @foreach (var opt in _statusFilterOptions)
                {
                    <option value="@opt">@opt</option>
                }
            </select>
        </div>
    </div>

    <div class="status-main-layout">
        <!-- List di Kiri -->
        <div class="status-list-container">
            @foreach (var booking in FilteredBookings)
            {
                <div class="booking-list-card @(selectedBooking?.Id == booking.Id ? "active" : "")" @onclick="() => SelectBooking(booking)">
                    <div class="booking-card-thumb" style="background-image: url('@booking.PhotoUrl');">
                    </div>
                    <div class="booking-card-content">
                        <div class="booking-card-header">
                            <h3 class="booking-card-title">@booking.RoomName</h3>
                            <span class="booking-card-id">#@booking.RequestId</span>
                        </div>
                        <div class="booking-card-time">@booking.Date • @booking.TimeSlot</div>
                        <div class="booking-card-attendees">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            @booking.Attendees Peserta
                        </div>
                        <div class="booking-card-status">
                            <StatusBadge Status="@booking.Status" />
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Detail Panel Kanan -->
        <div class="status-detail-panel @(selectedBooking != null ? "visible" : "")">
            @if (selectedBooking != null)
            {
                <div class="detail-panel-hero">
                    <img src="@selectedBooking.PhotoUrl" class="detail-hero-img" alt="Room" onerror="this.style.display='none'" />
                    <div class="detail-hero-status-badge">
                        <StatusBadge Status="@selectedBooking.Status" />
                    </div>
                </div>
                <div class="detail-panel-content">
                    <h2 class="detail-panel-title">@selectedBooking.RoomName</h2>
                    <p class="detail-panel-id">ID Permintaan: @selectedBooking.RequestId</p>
                    
                    <div class="detail-panel-grid">
                        <div class="detail-info-block">
                            <label>PEMOHON</label>
                            <div class="info-val-strong">Budi Santoso</div>
                            <div class="info-val-sub">VP of Engineering</div>
                        </div>
                        <div class="detail-info-block">
                            <label>WAKTU</label>
                            <div class="info-val-strong">@selectedBooking.Date</div>
                            <div class="info-val-sub">@selectedBooking.TimeSlot (@selectedBooking.Duration)</div>
                        </div>
                        <div class="detail-info-block">
                            <label>KAPASITAS</label>
                            <div class="info-val-strong">@selectedBooking.Attendees / @selectedBooking.Capacity</div>
                            <div class="info-val-sub">Peserta Hadir</div>
                        </div>
                    </div>

                    <div class="detail-info-block" style="margin-top: 16px;">
                        <label>TUJUAN RAPAT</label>
                        <div class="info-val-purpose">
                            @(string.IsNullOrEmpty(selectedBooking.Purpose) ? "Pembaruan proyek dan evaluasi kuartal berjalan bersama tim manajemen." : selectedBooking.Purpose)
                        </div>
                    </div>

                    <div class="detail-panel-actions">
                        @if (selectedBooking.Status != "completed" && selectedBooking.Status != "rejected")
                        {
                            <button class="btn btn-primary btn-full" @onclick="OpenModifyModal">Modifikasi</button>
                            <button class="btn btn-danger-outline btn-full" @onclick="OpenCancelModal">Batalkan Permintaan</button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<AppModal Visible="@isCancelModalOpen" ShowCloseButton="false" OnClose="CloseCancelModal" Size="sm">
    <BodyContent>
        <div style="text-align: center;">
            <div style="width: 48px; height: 48px; border-radius: 50%; background: #FEE2E2; color: #DC2626; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </div>
            <h3 style="margin: 0 0 8px 0; font-size: 1.125rem; color: #111827;">Batalkan Permintaan?</h3>
            <p style="margin: 0 0 16px 0; font-size: 0.875rem; color: #6B7280;">Tindakan ini tidak dapat dibatalkan. Berikan alasan pembatalan di bawah ini.</p>
            <textarea style="width: 100%; box-sizing: border-box; padding: 12px; border: 1px solid #D1D5DB; border-radius: 8px; font-family: inherit; font-size: 0.875rem; min-height: 80px;" placeholder="Tulis alasan pembatalan (wajib)..."></textarea>
        </div>
    </BodyContent>
    <FooterContent>
        <div style="display: flex; gap: 12px; width: 100%;">
            <button class="btn btn-secondary" style="flex: 1;" @onclick="CloseCancelModal">Batal</button>
            <button class="btn" style="flex: 1; background: #DC2626; color: white;" @onclick="ConfirmCancel">Konfirmasi Pembatalan</button>
        </div>
    </FooterContent>
</AppModal>

<AppModal Visible="@isModifyModalOpen" ShowCloseButton="false" OnClose="CloseModifyModal" Size="md" Title="Modifikasi Booking">
    <BodyContent>
        <div style="display: flex; flex-direction: column; gap: 20px;">
            <div>
                <h4 style="margin: 0 0 12px 0; font-size: 0.875rem; color: #111827;">Detail Personil</h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div>
                        <label style="display: block; font-size: 0.75rem; color: #6B7280; margin-bottom: 4px;">Nama Peminjam</label>
                        <input type="text" style="width: 100%; box-sizing: border-box; padding: 8px 12px; border: 1px solid #D1D5DB; border-radius: 6px; font-family: inherit; font-size: 0.875rem;" value="Budi Santoso" disabled />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.75rem; color: #6B7280; margin-bottom: 4px;">Divisi / Departemen</label>
                        <input type="text" style="width: 100%; box-sizing: border-box; padding: 8px 12px; border: 1px solid #D1D5DB; border-radius: 6px; font-family: inherit; font-size: 0.875rem;" value="IT / Engineering" disabled />
                    </div>
                </div>
            </div>
            <div>
                <h4 style="margin: 0 0 12px 0; font-size: 0.875rem; color: #111827;">Logistik</h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div>
                        <label style="display: block; font-size: 0.75rem; color: #6B7280; margin-bottom: 4px;">Rentang Tanggal</label>
                        <input type="date" style="width: 100%; box-sizing: border-box; padding: 8px 12px; border: 1px solid #D1D5DB; border-radius: 6px; font-family: inherit; font-size: 0.875rem;" value="2024-11-20" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.75rem; color: #6B7280; margin-bottom: 4px;">Durasi</label>
                        <select style="width: 100%; box-sizing: border-box; padding: 8px 12px; border: 1px solid #D1D5DB; border-radius: 6px; font-family: inherit; font-size: 0.875rem;">
                            <option>1 Jam</option>
                            <option selected>2 Jam</option>
                            <option>3 Jam</option>
                        </select>
                    </div>
                </div>
            </div>
            <div>
                <h4 style="margin: 0 0 12px 0; font-size: 0.875rem; color: #111827;">Informasi Tambahan</h4>
                <label style="display: block; font-size: 0.75rem; color: #6B7280; margin-bottom: 4px;">Catatan Admin</label>
                <textarea style="width: 100%; box-sizing: border-box; padding: 8px 12px; border: 1px solid #D1D5DB; border-radius: 6px; font-family: inherit; font-size: 0.875rem; min-height: 80px;" placeholder="Tulis catatan jika ada perubahan fasilitas..."></textarea>
            </div>
        </div>
    </BodyContent>
    <FooterContent>
        <div style="display: flex; gap: 12px; width: 100%; justify-content: flex-end;">
            <button class="btn btn-secondary" @onclick="CloseModifyModal">Batal</button>
            <button class="btn" style="background: #F5B301; color: #0F1F3D; font-weight: 700;" @onclick="ConfirmModify">Perbarui Pemesanan</button>
        </div>
    </FooterContent>
</AppModal>

<style>
