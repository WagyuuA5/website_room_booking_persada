@page "/status"
@page "/bookings/status"
@using booking_room.Components.Models
@using booking_room.Components.Shared
@using booking_room.Services
@inject IToastService ToastService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Status Pemesanan — Persada Ruangan</PageTitle>

<div class="content-fade-in status-page-wrapper">
    <!-- Header Halaman CASE 5: Ruang atas proporsional & rapi -->
    <div class="status-page-header">
        <div>
            <h1 class="status-hero-title">Status Pemesanan</h1>
            <p class="status-hero-subtitle">Pantau dan kelola seluruh status permintaan reservasi ruangan Anda.</p>
        </div>
        <div class="status-header-actions">
            <button class="status-btn-icon-refresh" @onclick="RefreshData" title="Muat Ulang Data">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
                </svg>
                <span>Perbarui Data</span>
            </button>
        </div>
    </div>

    <!-- Search & Filter CASE 5: Sejajar sempurna secara horizontal dengan tinggi sama persis -->
    <div class="status-filters">
        <div class="search-bar-wrapper">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" class="search-bar-input" placeholder="Cari pemesanan..." @bind="_searchQuery" @bind:event="oninput" />
        </div>
        <div class="filter-dropdown-wrapper">
            <select class="filter-select" @bind="activeFilter" @bind:after="OnFilterChanged">
                @foreach (var opt in _statusFilterOptions)
                {
                    <option value="@opt">@opt</option>
                }
            </select>
        </div>
    </div>

    <!-- Layout Utama CASE 1: Grid 2-kolom dengan scroll independen & top alignment sejajar -->
    <div class="status-main-layout">
        <!-- List di Kiri (Scroll internal terkontrol) -->
        <div class="status-list-container">
            @if (!FilteredBookings.Any())
            {
                <div class="status-empty-state">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.5">
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <p class="empty-title">Tidak ada pemesanan ditemukan</p>
                    <p class="empty-desc">Coba sesuaikan kata kunci pencarian atau filter status.</p>
                </div>
            }
            else
            {
                @foreach (var booking in FilteredBookings)
                {
                    <div class="booking-list-card @(selectedBooking?.Id == booking.Id ? "active" : "")" @onclick="() => SelectBooking(booking)">
                        <div class="booking-card-thumb" style="background-image: url('@booking.PhotoUrl');">
                        </div>
                        <div class="booking-card-content">
                            <div class="booking-card-header">
                                <h3 class="booking-card-title">@booking.RoomName</h3>
                                <span class="booking-card-id">#@booking.RequestId</span>
                            </div>
                            <div class="booking-card-time">@booking.Date • @booking.TimeSlot</div>
                            <div class="booking-card-attendees">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                                <span>@booking.Attendees Peserta</span>
                            </div>
                            <div class="booking-card-status">
                                <StatusBadge Status="@booking.Status" />
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Detail Panel Kanan CASE 1 & CASE 4: Sticky, utuh, informatif untuk setiap kartu -->
        <div class="status-detail-panel @(selectedBooking != null ? "visible" : "")">
            @if (selectedBooking != null)
            {
                <div class="detail-panel-hero">
                    <img src="@selectedBooking.PhotoUrl" class="detail-hero-img" alt="@selectedBooking.RoomName" onerror="this.src='https://images.unsplash.com/photo-1497366216548-37526070297c?w=600&auto=format&fit=crop&q=80'" />
                    <div class="detail-hero-status-badge">
                        <StatusBadge Status="@selectedBooking.Status" />
                    </div>
                </div>
                <div class="detail-panel-content">
                    <h2 class="detail-panel-title">@selectedBooking.RoomName</h2>
                    <p class="detail-panel-id">ID Permintaan: #@selectedBooking.RequestId</p>
                    
                    <div class="detail-panel-grid">
                        <div class="detail-info-block">
                            <label>PEMOHON</label>
                            <div class="info-val-strong">Budi Santoso</div>
                            <div class="info-val-sub">VP of Engineering</div>
                        </div>
                        <div class="detail-info-block">
                            <label>WAKTU & TANGGAL</label>
                            <div class="info-val-strong">@selectedBooking.Date</div>
                            <div class="info-val-sub">@selectedBooking.TimeSlot (@selectedBooking.Duration)</div>
                        </div>
                        <div class="detail-info-block">
                            <label>KAPASITAS</label>
                            <div class="info-val-strong">@selectedBooking.Attendees / @selectedBooking.Capacity</div>
                            <div class="info-val-sub">Peserta Hadir</div>
                        </div>
                        <div class="detail-info-block">
                            <label>LOKASI RUANGAN</label>
                            <div class="info-val-strong">Gedung Utama</div>
                            <div class="info-val-sub">Lantai 3, Sayap Barat</div>
                        </div>
                    </div>

                    <div class="detail-info-block" style="margin-top: 14px;">
                        <label>TUJUAN RAPAT</label>
                        <div class="info-val-purpose">
                            @(string.IsNullOrEmpty(selectedBooking.Purpose) ? "Pembaruan proyek dan evaluasi kuartal berjalan bersama tim manajemen dan pemangku kepentingan." : selectedBooking.Purpose)
                        </div>
                    </div>

                    @if (selectedBooking.Status.Equals("rejected", StringComparison.OrdinalIgnoreCase) || selectedBooking.Status.Equals("ditolak", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="detail-rejection-box">
                            <div class="rejection-title">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                                <span>Alasan Penolakan</span>
                            </div>
                            <p class="rejection-text">Ruangan dialihkan oleh General Affairs untuk agenda rapat direksi mendadak. Silakan pilih ruangan alternatif.</p>
                        </div>
                    }

                    <!-- CASE 6: Redesign Tombol Modifikasi & Batalkan Permintaan -->
                    <div class="detail-panel-actions">
                        @if (selectedBooking.Status.Equals("pending", StringComparison.OrdinalIgnoreCase) || selectedBooking.Status.Equals("menunggu persetujuan", StringComparison.OrdinalIgnoreCase))
                        {
                            <button class="btn-action-modify" @onclick="OpenModifyModal">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 20h9"></path>
                                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                </svg>
                                <span>Modifikasi</span>
                            </button>
                            <button class="btn-action-cancel" @onclick="OpenCancelModal">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="15" y1="9" x2="9" y2="15"></line>
                                    <line x1="9" y1="9" x2="15" y2="15"></line>
                                </svg>
                                <span>Batalkan Permintaan</span>
                            </button>
                        }
                        else if (selectedBooking.Status.Equals("approved", StringComparison.OrdinalIgnoreCase) || selectedBooking.Status.Equals("disetujui", StringComparison.OrdinalIgnoreCase))
                        {
                            <button class="btn-action-modify" @onclick="OpenModifyModal">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 20h9"></path>
                                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                </svg>
                                <span>Modifikasi Jadwal</span>
                            </button>
                            <button class="btn-action-cancel" @onclick="OpenCancelModal">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="15" y1="9" x2="9" y2="15"></line>
                                    <line x1="9" y1="9" x2="15" y2="15"></line>
                                </svg>
                                <span>Batalkan Reservasi</span>
                            </button>
                        }
                        else
                        {
                            <button class="btn-action-rebook" @onclick='() => Navigation.NavigateTo("/bookings")'>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>Pesan Ruangan Lagi</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Batal Pemesanan -->
<AppModal Visible="@isCancelModalOpen" ShowCloseButton="false" OnClose="CloseCancelModal" Size="sm" Title="Konfirmasi Pembatalan">
    <BodyContent>
        <div style="text-align: center; padding: 12px 0;">
            <div style="width: 52px; height: 52px; border-radius: 50%; background: #FEE2E2; color: #EF4444; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
            <h3 style="font-size: 1.1rem; font-weight: 700; color: #111827; margin: 0 0 6px 0;">Batalkan Pemesanan Ini?</h3>
            <p style="font-size: 0.875rem; color: #6B7280; margin: 0;">Apakah Anda yakin ingin membatalkan permintaan pemesanan <strong>@(selectedBooking?.RoomName)</strong>? Tindakan ini tidak dapat dibatalkan.</p>
        </div>
    </BodyContent>
    <FooterContent>
        <div style="display: flex; gap: 12px; width: 100%;">
            <button class="btn-secondary-app" style="flex: 1;" @onclick="CloseCancelModal">Kembali</button>
            <button class="btn-danger-app" style="flex: 1;" @onclick="ConfirmCancel">Konfirmasi Batal</button>
        </div>
    </FooterContent>
</AppModal>

<!-- Modal Modifikasi Pemesanan -->
<AppModal Visible="@isModifyModalOpen" ShowCloseButton="false" OnClose="CloseModifyModal" Size="md" Title="Modifikasi Pemesanan">
    <BodyContent>
        <div style="display: flex; flex-direction: column; gap: 18px;">
            <div>
                <h4 style="margin: 0 0 10px 0; font-size: 0.8125rem; font-weight: 700; color: #6B7280; text-transform: uppercase; letter-spacing: 0.05em;">Detail Pemohon</h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div>
                        <label class="form-label-mini">Nama Pemohon</label>
                        <input type="text" class="form-control-modal" value="Budi Santoso" disabled />
                    </div>
                    <div>
                        <label class="form-label-mini">Divisi / Departemen</label>
                        <input type="text" class="form-control-modal" value="IT / Engineering" disabled />
                    </div>
                </div>
            </div>
            <div>
                <h4 style="margin: 0 0 10px 0; font-size: 0.8125rem; font-weight: 700; color: #6B7280; text-transform: uppercase; letter-spacing: 0.05em;">Jadwal Reservasi</h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div>
                        <label class="form-label-mini">Tanggal</label>
                        <input type="date" class="form-control-modal" value="2026-10-25" />
                    </div>
                    <div>
                        <label class="form-label-mini">Durasi</label>
                        <select class="form-control-modal">
                            <option>1 Jam</option>
                            <option selected>2 Jam</option>
                            <option>3 Jam</option>
                        </select>
                    </div>
                </div>
            </div>
            <div>
                <label class="form-label-mini">Catatan Tambahan</label>
                <textarea class="form-control-modal" style="min-height: 70px; resize: vertical;" placeholder="Tulis catatan jika ada perubahan fasilitas atau peserta..."></textarea>
            </div>
        </div>
    </BodyContent>
    <FooterContent>
        <div style="display: flex; gap: 12px; width: 100%; justify-content: flex-end;">
            <button class="btn-secondary-app" @onclick="CloseModifyModal">Batal</button>
            <button class="btn-primary-app" @onclick="ConfirmModify">Simpan Pembaruan</button>
        </div>
    </FooterContent>
</AppModal>

<style>
    .status-page-wrapper {
        padding: 16px 24px 32px;
        max-width: 1400px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }
    
    .status-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 4px;
    }
    
    .status-hero-title {
        font-size: var(--fs-h1, 30px);
        font-weight: var(--fw-h1, 700);
        color: var(--persada-navy-900, #0F1F3D);
        margin: 0 0 4px 0;
    }
    
    .status-hero-subtitle {
        font-size: 0.9375rem;
        color: var(--persada-text-secondary, #6B7280);
        margin: 0;
    }
    
    .status-btn-icon-refresh {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 16px;
        height: 42px;
        background: var(--persada-white, #FFFFFF);
        border: 1.5px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 999px;
        color: var(--persada-text-primary, #374151);
        font-weight: 600;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .status-btn-icon-refresh:hover {
        background: #F8FAFC;
        border-color: #CBD5E1;
        color: var(--persada-navy-900, #0F1F3D);
        transform: translateY(-1px);
    }
    
    /* CASE 5: Filters perfectly aligned */
    .status-filters {
        display: flex;
        gap: 12px;
        align-items: center;
    }
    
    .search-bar-wrapper {
        position: relative;
        flex: 1;
        max-width: 380px;
        height: 42px;
        display: flex;
        align-items: center;
    }
    
    .search-bar-wrapper svg {
        position: absolute;
        left: 14px;
        color: #9CA3AF;
        pointer-events: none;
    }
    
    .search-bar-input {
        width: 100%;
        height: 42px;
        padding: 0 14px 0 40px;
        border: 1.5px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 12px;
        font-size: 0.875rem;
        outline: none;
        box-sizing: border-box;
        background: var(--persada-white, #FFFFFF);
        color: var(--persada-text-primary, #111827);
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .search-bar-input:focus {
        border-color: #1F5D9A;
        box-shadow: 0 0 0 3px rgba(31, 93, 154, 0.12);
    }
    
    .filter-dropdown-wrapper {
        height: 42px;
        display: flex;
        align-items: center;
    }
    
    .filter-select {
        height: 42px;
        padding: 0 32px 0 14px;
        border: 1.5px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 12px;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--persada-text-primary, #111827);
        background-color: var(--persada-white, #FFFFFF);
        outline: none;
        cursor: pointer;
        box-sizing: border-box;
        transition: border-color 0.2s;
    }
    .filter-select:focus {
        border-color: #1F5D9A;
    }
    
    /* CASE 1: Grid layout with sticky right panel & top aligned */
    .status-main-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 420px;
        gap: 24px;
        align-items: start;
        margin-top: 4px;
    }
    
    .status-list-container {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-height: calc(100vh - 200px);
        overflow-y: auto;
        padding-right: 6px;
    }
    
    .status-list-container::-webkit-scrollbar {
        width: 6px;
    }
    .status-list-container::-webkit-scrollbar-thumb {
        background: #CBD5E1;
        border-radius: 4px;
    }
    
    .booking-list-card {
        display: flex;
        gap: 16px;
        padding: 16px;
        background: var(--persada-white, #FFFFFF);
        border: 1.5px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 16px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .booking-list-card:hover {
        border-color: #CBD5E1;
        box-shadow: 0 4px 14px rgba(15, 31, 61, 0.06);
        transform: translateY(-1px);
    }
    .booking-list-card.active {
        border-color: #1F5D9A;
        box-shadow: 0 4px 16px rgba(31, 93, 154, 0.12);
        background: #F8FAFC;
    }
    body.dark-mode .booking-list-card.active {
        background: rgba(31, 93, 154, 0.15);
        border-color: #3B82F6;
    }
    
    .booking-card-thumb {
        width: 84px;
        height: 84px;
        border-radius: 12px;
        background-size: cover;
        background-position: center;
        background-color: #F1F5F9;
        flex-shrink: 0;
    }
    
    .booking-card-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    
    .booking-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 3px;
    }
    
    .booking-card-title {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--persada-text-primary, #0F1F3D);
    }
    
    .booking-card-id {
        font-size: 0.75rem;
        color: var(--persada-text-secondary, #9CA3AF);
        font-weight: 600;
    }
    
    .booking-card-time {
        font-size: 0.8125rem;
        color: var(--persada-text-secondary, #4B5563);
        margin-bottom: 4px;
    }
    
    .booking-card-attendees {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.75rem;
        color: var(--persada-text-secondary, #6B7280);
    }
    
    .booking-card-status {
        margin-top: 8px;
    }
    
    /* CASE 1: Sticky detail panel */
    .status-detail-panel {
        background: var(--persada-white, #FFFFFF);
        border: 1px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 20px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 20px rgba(15, 31, 61, 0.06);
        position: sticky;
        top: 20px;
        max-height: calc(100vh - 200px);
        overflow-y: auto;
    }
    
    .detail-panel-hero {
        position: relative;
        height: 180px;
        background: #F1F5F9;
        flex-shrink: 0;
    }
    
    .detail-hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .detail-hero-status-badge {
        position: absolute;
        top: 14px;
        left: 14px;
    }
    
    .detail-panel-content {
        padding: 20px 22px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }
    
    .detail-panel-title {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--persada-text-primary, #0F1F3D);
    }
    
    .detail-panel-id {
        margin: -8px 0 2px 0;
        font-size: 0.8125rem;
        color: var(--persada-text-secondary, #6B7280);
    }
    
    .detail-panel-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }
    
    .detail-info-block label {
        display: block;
        font-size: 0.6875rem;
        font-weight: 700;
        color: var(--persada-text-secondary, #9CA3AF);
        letter-spacing: 0.05em;
        margin-bottom: 3px;
    }
    
    .info-val-strong {
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--persada-text-primary, #111827);
    }
    
    .info-val-sub {
        font-size: 0.75rem;
        color: var(--persada-text-secondary, #6B7280);
    }
    
    .info-val-purpose {
        font-size: 0.8125rem;
        color: var(--persada-text-primary, #374151);
        line-height: 1.5;
        background: #F8FAFC;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid #E2E8F0;
    }
    body.dark-mode .info-val-purpose {
        background: rgba(15, 23, 42, 0.4);
        border-color: rgba(255, 255, 255, 0.08);
    }
    
    .detail-rejection-box {
        background: #FEF2F2;
        border: 1px solid #FECACA;
        border-radius: 10px;
        padding: 10px 12px;
    }
    body.dark-mode .detail-rejection-box {
        background: rgba(127, 29, 29, 0.25);
        border-color: rgba(239, 68, 68, 0.3);
    }
    .rejection-title {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        color: #DC2626;
