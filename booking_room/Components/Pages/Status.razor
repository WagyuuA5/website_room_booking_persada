@page "/status"
@page "/bookings/status"
@using booking_room.Components.Models
@using booking_room.Components.Shared
@using booking_room.Services
@inject IToastService ToastService
@implements IDisposable

<PageTitle>Status Pemesanan — Persada Ruangan</PageTitle>

<div class="status-page-wrapper">
    <!-- Header Halaman -->
    <div class="status-page-header">
        <div>
            <h1 class="status-hero-title">Status Pemesanan</h1>
            <p class="status-hero-subtitle">Pantau status reservasi ruangan Anda secara langsung, kelola jadwal, dan lihat riwayat lengkap.</p>
        </div>
        <div class="status-header-actions">
            <button class="status-btn-icon-refresh" @onclick="RefreshData" title="Muat Ulang Data">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
                </svg>
                <span>Perbarui Data</span>
            </button>
        </div>
    </div>

    <!-- 4.1 Hero Kapsul Status Aktif (Dynamic Island Live Activity) -->
    <div class="status-island-hero-section">
        @if (_activeUpcomingBooking != null)
        {
            <div class="island-hero-card">
                <IslandCapsule State="@(_isHeroExpanded ? "expanded" : "compact")"
                               IsExpanded="@_isHeroExpanded"
                               IsExpandedChanged="OnHeroExpandChanged"
                               AccentColor="@GetStatusAccentColor(_activeUpcomingBooking.Status)"
                               Title="@_activeUpcomingBooking.RoomName"
                               Subtitle="@($"{_activeUpcomingBooking.Date} • {_activeUpcomingBooking.TimeSlot}")"
                               BadgeText="@GetCountdownText()"
                               ShowCloseButton="false">
                    <CompactContent>
                        <div class="island-hero-compact-content">
                            <div class="island-indicator-dot pulse" style="background-color: @GetStatusAccentColor(_activeUpcomingBooking.Status); color: @GetStatusAccentColor(_activeUpcomingBooking.Status);"></div>
                            <span class="island-compact-room">@_activeUpcomingBooking.RoomName</span>
                            <span class="island-compact-separator">•</span>
                            <span class="island-compact-time">@_activeUpcomingBooking.TimeSlot</span>
                            <span class="island-compact-countdown">@GetCountdownText()</span>
                            <span class="island-compact-chevron">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6 9l6 6 6-6"/>
                                </svg>
                            </span>
                        </div>
                    </CompactContent>
                    <ExpandedContent>
                        <div class="island-hero-expanded-content">
                            <div class="island-hero-expanded-header">
                                <div class="island-hero-room-badge-group">
                                    <div class="island-indicator-dot pulse" style="background-color: @GetStatusAccentColor(_activeUpcomingBooking.Status); color: @GetStatusAccentColor(_activeUpcomingBooking.Status);"></div>
                                    <div>
                                        <h2 class="island-hero-title-text">@_activeUpcomingBooking.RoomName</h2>
                                        <div class="island-hero-location-text">@_activeUpcomingBooking.Floor, Persada HQ</div>
                                    </div>
                                </div>
                                <StatusBadge Status="@_activeUpcomingBooking.Status" />
                            </div>

                            <div class="island-hero-meta-grid">
                                <div class="island-meta-item">
                                    <span class="island-meta-label">JADWAL</span>
                                    <span class="island-meta-value">@_activeUpcomingBooking.Date, @_activeUpcomingBooking.TimeSlot</span>
                                </div>
                                <div class="island-meta-item">
                                    <span class="island-meta-label">DURASI</span>
                                    <span class="island-meta-value">@_activeUpcomingBooking.Duration</span>
                                </div>
                                <div class="island-meta-item">
                                    <span class="island-meta-label">KAPASITAS</span>
                                    <span class="island-meta-value">@_activeUpcomingBooking.Attendees/@_activeUpcomingBooking.Capacity Orang</span>
                                </div>
                                <div class="island-meta-item">
                                    <span class="island-meta-label">COUNTDOWN REALTIME</span>
                                    <span class="island-meta-value text-accent-green">@GetCountdownText()</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(_activeUpcomingBooking.Purpose))
                            {
                                <div class="island-hero-purpose">
                                    <span class="island-meta-label">TUJUAN PERTEMUAN</span>
                                    <p>@_activeUpcomingBooking.Purpose</p>
                                </div>
                            }

                            <div class="island-hero-actions">
                                <button class="btn-island-secondary" @onclick="() => SelectBookingAndOpenSlide(_activeUpcomingBooking)" @onclick:stopPropagation="true">
                                    Lihat Detail Lengkap
                                </button>
                                @if (_activeUpcomingBooking.Status.Equals("pending", StringComparison.OrdinalIgnoreCase) || _activeUpcomingBooking.Status.Equals("approved", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="btn-island-danger" @onclick="() => OpenCancelModalFor(_activeUpcomingBooking)" @onclick:stopPropagation="true">
                                        Batalkan Pesanan
                                    </button>
                                }
                            </div>
                        </div>
                    </ExpandedContent>
                </IslandCapsule>
            </div>
        }
        else
        {
            <div class="island-hero-card">
                <IslandCapsule State="compact"
                               AccentColor="#6B7280"
                               Title="Tidak ada agenda aktif saat ini"
                               CompactText="Tidak ada agenda aktif saat ini"
                               BadgeText="STANDBY"
                               Clickable="false" />
            </div>
        }
    </div>

    <!-- Layout Utama: List Pemesanan & Detail Slide-In Panel -->
    <div class="status-main-layout @(_isSlidePanelOpen ? "slide-panel-open" : "")">
        <!-- Kolom Tabel -->
        <div class="status-table-container">
            <div class="status-table-toolbar">
                <div class="status-search-box">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" placeholder="Cari berdasarkan nama ruangan atau ID permintaan..." value="@_searchQuery" @oninput="OnSearchChanged" />
                </div>

                <div class="status-filter-group" style="position: relative;">
                    <button class="status-filter-btn" @onclick="ToggleFilterPopup">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        <span>Status: @activeFilter</span>
                    </button>

                    @if (isFilterOpen)
                    {
                        <div class="status-filter-dropdown-menu">
                            @foreach (var filter in _statusFilterOptions)
                            {
                                <button class="status-dropdown-item @(activeFilter == filter ? "active" : "")" @onclick="() => ApplyFilter(filter)">
                                    @filter
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="status-datagrid-card">
                <DataGrid TItem="BookingItem"
                          Data="FilteredBookingsForGrid"
                          Columns="gridColumns"
                          IsLoading="_isLoading"
                          SearchPlaceholder="Cari pemesanan..."
                          FileNamePrefix="status-pemesanan"
                          OnRowClick="SelectBookingAndOpenSlide">
                </DataGrid>
            </div>
        </div>

        <!-- 4.2 Panel Detail Slide-in dari Kanan -->
        <div class="status-slide-panel @(_isSlidePanelOpen ? "show" : "")">
            @if (selectedBooking != null)
            {
                <div class="slide-panel-inner">
                    <div class="slide-panel-header">
                        <div class="slide-panel-header-left">
                            <IslandCapsule State="compact"
                                           AccentColor="@GetStatusAccentColor(selectedBooking.Status)"
                                           Title="@selectedBooking.RoomName"
                                           CompactText="@GetStatusLabel(selectedBooking.Status)"
                                           Clickable="false" />
                            <span class="slide-panel-reqid">@selectedBooking.RequestId</span>
                        </div>
                        <button class="slide-panel-close-btn" @onclick="CloseSlidePanel" aria-label="Tutup Panel">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>

                    <div class="slide-panel-body">
                        <div class="slide-photo-wrap">
                            <img src="@(string.IsNullOrEmpty(selectedBooking.PhotoUrl) ? "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=800&q=80" : selectedBooking.PhotoUrl)" 
                                 alt="@selectedBooking.RoomName" 
                                 class="slide-photo-img" />
                            <div class="slide-photo-gradient"></div>
                            <div class="slide-photo-title-wrap">
                                <h3 class="slide-photo-title">@selectedBooking.RoomName</h3>
                                <p class="slide-photo-location">@selectedBooking.Floor, Persada HQ</p>
                            </div>
                        </div>

                        <div class="slide-content-card">
                            <div class="slide-requester-row">
                                <div class="slide-requester-avatar">@GetInitials(selectedBooking.RequestedBy)</div>
                                <div class="slide-requester-info">
                                    <span class="slide-req-label">DIAJUKAN OLEH</span>
                                    <span class="slide-req-name">@selectedBooking.RequestedBy</span>
                                    <span class="slide-req-title">@selectedBooking.RequestedByTitle</span>
                                </div>
                            </div>

                            <hr class="slide-divider" />

                            <div class="slide-meta-grid">
                                <div class="slide-meta-box">
                                    <span class="slide-meta-label">TANGGAL</span>
                                    <span class="slide-meta-value">@selectedBooking.Date</span>
                                </div>
                                <div class="slide-meta-box">
                                    <span class="slide-meta-label">WAKTU</span>
                                    <span class="slide-meta-value">@selectedBooking.TimeSlot</span>
                                </div>
                                <div class="slide-meta-box">
                                    <span class="slide-meta-label">DURASI</span>
                                    <span class="slide-meta-value">@selectedBooking.Duration</span>
                                </div>
                                <div class="slide-meta-box">
                                    <span class="slide-meta-label">PESERTA</span>
                                    <span class="slide-meta-value">@selectedBooking.Attendees / @selectedBooking.Capacity Org</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(selectedBooking.Purpose))
                            {
                                <div class="slide-purpose-box">
                                    <span class="slide-meta-label">TUJUAN PERTEMUAN</span>
                                    <p>@selectedBooking.Purpose</p>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="slide-panel-footer">
                        <button class="btn-slide-modify" @onclick="OpenModifyModal">Ubah Reservasi</button>
                        @if (selectedBooking.Status.Equals("pending", StringComparison.OrdinalIgnoreCase) || selectedBooking.Status.Equals("approved", StringComparison.OrdinalIgnoreCase))
                        {
                            <button class="btn-slide-cancel" @onclick="OpenCancelModal">Batalkan Permintaan</button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- 4.3 Modal Konfirmasi Pembatalan Terpusat -->
<AppModal Visible="@isCancelModalOpen" 
       VisibleChanged="@(v => isCancelModalOpen = v)"
       Title="Batalkan Pemesanan?"
       Subtitle="Tindakan ini akan membatalkan pemesanan dan membebaskan jadwal ruangan."
       Size="sm"
       OnClose="CloseCancelModal">
    <BodyContent>
        <CancelRequestModal Booking="@selectedBooking" OnClose="CloseCancelModal" OnConfirm="HandleCancelConfirm" />
    </BodyContent>
</AppModal>

<!-- Modal Modifikasi Reservasi -->
<AppModal Visible="@isModifyModalOpen"
       VisibleChanged="@(v => isModifyModalOpen = v)"
       Title="Ubah Jadwal Pemesanan"
       Subtitle="Sesuaikan tanggal, waktu, atau catatan pemesanan ruangan Anda."
       Size="md"
       OnClose="CloseModifyModal">
    <BodyContent>
        <ModifyBookingModal Booking="@selectedBooking" OnClose="CloseModifyModal" OnUpdate="HandleModifyUpdate" />
    </BodyContent>
</AppModal>

<style>
    .status-page-wrapper {
        padding: 32px;
        max-width: 1440px;
        margin: 0 auto;
        font-family: var(--font-family-primary, 'Inter', sans-serif);
    }

    .status-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 24px;
        gap: 16px;
        flex-wrap: wrap;
    }

    .status-hero-title {
        font-size: 2.25rem;
        font-weight: 800;
        color: var(--color-brand-navy, #0F1F3D);
        margin: 0 0 6px 0;
        letter-spacing: -0.02em;
        line-height: 1.2;
    }

    .status-hero-subtitle {
        font-size: 0.9375rem;
        color: var(--color-brand-text-muted, #6B7280);
        margin: 0;
        line-height: 1.5;
        max-width: 680px;
    }

    .status-btn-icon-refresh {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: var(--radius-pill, 999px);
        background: #FFFFFF;
        border: 1px solid var(--color-brand-gray-border, #E5E7EB);
        color: var(--color-brand-navy, #0F1F3D);
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: var(--shadow-card);
    }

    .status-btn-icon-refresh:hover {
        background: #F8FAFC;
        border-color: #CBD5E1;
        transform: translateY(-1px);
    }

    /* --- Dynamic Island Hero Section --- */
    .status-island-hero-section {
        margin-bottom: 28px;
        display: flex;
        justify-content: center;
    }

    .island-hero-card {
        width: 100%;
        max-width: 840px;
        display: flex;
        justify-content: center;
    }

    .island-hero-compact-content {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .island-compact-room {
        color: #FFFFFF;
        font-weight: 700;
    }

    .island-compact-separator {
        color: rgba(255, 255, 255, 0.3);
    }

    .island-compact-time {
        color: #D1D5DB;
    }

    .island-compact-countdown {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 999px;
        background: rgba(16, 185, 129, 0.18);
        color: #34D399;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .island-compact-chevron {
        color: #9CA3AF;
        display: flex;
        align-items: center;
    }

    .island-hero-expanded-content {
        display: flex;
        flex-direction: column;
        gap: 16px;
        width: 100%;
    }

    .island-hero-expanded-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
    }

    .island-hero-room-badge-group {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .island-hero-title-text {
        font-size: 1.25rem;
        font-weight: 800;
        color: #FFFFFF;
        margin: 0;
        line-height: 1.2;
    }

    .island-hero-location-text {
        font-size: 0.8125rem;
        color: #9CA3AF;
        margin-top: 2px;
    }

    .island-hero-meta-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
        background: rgba(255, 255, 255, 0.04);
        padding: 14px 18px;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .island-meta-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .island-meta-label {
        font-size: 0.6875rem;
        font-weight: 700;
        color: #9CA3AF;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .island-meta-value {
        font-size: 0.875rem;
        font-weight: 600;
        color: #F3F4F6;
    }

    .text-accent-green {
        color: #34D399;
    }

    .island-hero-purpose {
        background: rgba(255, 255, 255, 0.03);
        padding: 12px 16px;
        border-radius: 12px;
        border-left: 3px solid #F59E0B;
    }

    .island-hero-purpose p {
        margin: 4px 0 0 0;
        font-size: 0.8125rem;
        color: #D1D5DB;
        line-height: 1.4;
    }

    .island-hero-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
    }

    .btn-island-secondary {
        background: rgba(255, 255, 255, 0.12);
        color: #FFFFFF;
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 8px 18px;
        border-radius: 999px;
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-island-secondary:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    .btn-island-danger {
        background: rgba(239, 68, 68, 0.15);
        color: #FCA5A5;
        border: 1px solid rgba(239, 68, 68, 0.3);
        padding: 8px 18px;
        border-radius: 999px;
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-island-danger:hover {
        background: rgba(239, 68, 68, 0.25);
        color: #FFFFFF;
    }

    /* --- Status Main Layout --- */
    .status-main-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 24px;
        transition: grid-template-columns 0.35s var(--island-spring, cubic-bezier(0.34, 1.56, 0.64, 1));
        position: relative;
    }

    .status-main-layout.slide-panel-open {
        grid-template-columns: 1fr 420px;
    }

    .status-table-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-width: 0;
    }

    .status-table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .status-search-box {
        position: relative;
        flex: 1;
        min-width: 240px;
        display: flex;
        align-items: center;
    }

    .status-search-box svg {
        position: absolute;
        left: 16px;
        color: #9CA3AF;
        pointer-events: none;
    }

    .status-search-box input {
        width: 100%;
        padding: 10px 16px 10px 44px;
        border: 1px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: var(--radius-pill, 999px);
        font-size: 0.875rem;
        background: #FFFFFF;
        color: var(--color-brand-navy, #0F1F3D);
        outline: none;
        transition: all 0.2s;
    }

    .status-search-box input:focus {
        border-color: var(--color-brand-blue, #1F5D9A);
        box-shadow: 0 0 0 3px rgba(31, 93, 154, 0.12);
    }

    .status-filter-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: var(--radius-pill, 999px);
        background: #FFFFFF;
        border: 1px solid var(--color-brand-gray-border, #E5E7EB);
        color: var(--color-brand-navy, #0F1F3D);
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .status-filter-btn:hover {
        background: #F8FAFC;
        border-color: #CBD5E1;
    }

    .status-filter-dropdown-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        z-index: 50;
        background: #FFFFFF;
        border: 1px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: var(--radius-md, 12px);
        box-shadow: var(--shadow-popover);
        padding: 6px;
        min-width: 180px;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .status-dropdown-item {
        background: none;
        border: none;
        padding: 8px 12px;
        text-align: left;
        font-size: 0.8125rem;
        font-weight: 600;
        color: #4B5563;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.15s;
    }

    .status-dropdown-item:hover {
        background: #F1F5F9;
        color: var(--color-brand-navy, #0F1F3D);
    }

    .status-dropdown-item.active {
        background: #EFF6FF;
        color: var(--color-brand-blue, #1F5D9A);
    }

    .status-datagrid-card {
        background: #FFFFFF;
        border-radius: var(--radius-card, 16px);
        border: 1px solid var(--color-brand-gray-border, #E5E7EB);
        overflow: hidden;
        box-shadow: var(--shadow-card);
    }

    /* --- 4.2 Slide-in Panel Styles --- */
    .status-slide-panel {
        display: none;
        background: #FFFFFF;
        border: 1px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: var(--radius-card, 16px);
        box-shadow: var(--shadow-modal);
        overflow: hidden;
        flex-direction: column;
        animation: slideInRight 0.3s var(--island-spring, cubic-bezier(0.34, 1.56, 0.64, 1)) forwards;
    }

    .status-slide-panel.show {
        display: flex;
    }

    .slide-panel-inner {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .slide-panel-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--color-brand-gray-border, #E5E7EB);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #FFFFFF;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .slide-panel-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .slide-panel-reqid {
        font-size: 0.75rem;
        color: #9CA3AF;
        font-weight: 600;
    }

    .slide-panel-close-btn {
        background: none;
        border: none;
        padding: 6px;
        border-radius: 50%;
        color: #9CA3AF;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .slide-panel-close-btn:hover {
        background: #F3F4F6;
        color: #111827;
    }

    .slide-panel-body {
        padding: 20px;
        overflow-y: auto;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .slide-photo-wrap {
        position: relative;
        height: 160px;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow-card);
    }

    .slide-photo-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

