@code {
    private List<BookingItem> allBookings = new();
    private BookingItem? selectedBooking;
    private string activeFilter = "Semua Status";
    [SupplyParameterFromQuery(Name = "filter")] public string? QueryFilter { get; set; }
    private string _searchQuery = "";
    
    private readonly object _disposeLock = new();
    private bool _disposed = false;
    private System.Timers.Timer? _countdownTimer;
    private CancellationTokenSource _cts = new();

    private bool isModifyModalOpen = false;
    private bool isCancelModalOpen = false;

    private readonly string[] _statusFilterOptions = { "Semua Status", "Menunggu Persetujuan", "Disetujui", "Ditolak", "Selesai" };

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(QueryFilter) && _statusFilterOptions.Contains(QueryFilter))
        {
            activeFilter = QueryFilter;
        }
        try 
        {
            await Task.Delay(100, _cts.Token);
            allBookings = BookingDataStore.AllBookings.ToList();
            selectedBooking = FilteredBookings.FirstOrDefault();

            _countdownTimer = new System.Timers.Timer(1000);
            _countdownTimer.Elapsed += OnTimerElapsed;
            _countdownTimer.Start();
        }
        catch (Exception ex) when (ex is ObjectDisposedException || ex is TaskCanceledException || ex is OperationCanceledException)
        {
            // Ignore
        }
    }

    private IEnumerable<BookingItem> FilteredBookings
    {
        get
        {
            var result = allBookings.AsEnumerable();
            if (activeFilter != "Semua Status")
            {
                var filterKey = activeFilter switch
                {
                    "Menunggu Persetujuan" => "pending",
                    "Disetujui" => "approved",
                    "Ditolak" => "rejected",
                    "Selesai" => "completed",
                    _ => ""
                };
                if (!string.IsNullOrEmpty(filterKey))
                    result = result.Where(b => b.Status.Equals(filterKey, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.ToLower();
                result = result.Where(b => b.RoomName.ToLower().Contains(q) || b.RequestId.ToLower().Contains(q));
            }
            return result;
        }
    }

    private void OnFilterChanged()
    {
        selectedBooking = FilteredBookings.FirstOrDefault();
    }

    private void SelectBooking(BookingItem booking)
    {
        selectedBooking = booking;
    }

    private void OpenCancelModal() => isCancelModalOpen = true;
    private void CloseCancelModal() => isCancelModalOpen = false;
    private void ConfirmCancel()
    {
        if (selectedBooking != null)
        {
            var index = allBookings.FindIndex(b => b.Id == selectedBooking.Id);
            if (index >= 0)
            {
                var updated = selectedBooking with { Status = "rejected" };
                allBookings[index] = updated;
                selectedBooking = updated;
            }
        }
        isCancelModalOpen = false;
        ToastService.Success("Berhasil Dibatalkan", "Permintaan pemesanan ruangan berhasil dibatalkan.");
    }

    private void OpenModifyModal() => isModifyModalOpen = true;
    private void CloseModifyModal() => isModifyModalOpen = false;
    private void ConfirmModify()
    {
        isModifyModalOpen = false;
        ToastService.Success("Pemesanan Diperbarui", "Jadwal dan catatan pemesanan berhasil disimpan.");
    }

    private void RefreshData()
    {
        allBookings = BookingDataStore.AllBookings.ToList();
        selectedBooking = FilteredBookings.FirstOrDefault();
        ToastService.Info("Data Diperbarui", "Daftar status pemesanan berhasil dimuat ulang.");
    }

    private void OnTimerElapsed(object? sender, System.Timers.ElapsedEventArgs e)
    {
        lock (_disposeLock)
        {
            if (_disposed) return;
        }
        try 
        {
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is ObjectDisposedException || ex is TaskCanceledException || ex is OperationCanceledException)
        {
            // Ignore if already disposed
        }
    }

    public void Dispose()
    {
        lock (_disposeLock)
        {
            _disposed = true;
        }
        if (_countdownTimer != null)
        {
            _countdownTimer.Elapsed -= OnTimerElapsed;
            _countdownTimer.Stop();
            _countdownTimer.Dispose();
        }
        _cts.Cancel();
        _cts.Dispose();
    }
}
