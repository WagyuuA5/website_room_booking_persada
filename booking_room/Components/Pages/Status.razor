@page "/status"
@page "/bookings/status"
@using booking_room.Components.Models
@using booking_room.Components.Shared

<PageTitle>Status Pemesanan — Persada Ruangan</PageTitle>

<div class="s-page-header">
    <h1 class="s-page-title">Status Pemesanan</h1>
</div>

<div class="s-page-container">
    <!-- Topbar Halaman -->
    <div class="s-topbar">
        <div class="s-topbar-right">
            <button class="s-btn-icon-refresh" @onclick="RefreshData" title="Muat Ulang">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
        </div>
    </div>

    <div class="s-status-layout">
        <!-- Kolom Kiri: List Pemesanan -->
        <div class="s-list-col">
            <div class="s-toolbar">
                <button class="s-btn-filter" @onclick="ToggleFilterPopup">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Saring: @activeFilter
                </button>
                
                @if (isFilterOpen)
                {
                    <div class="s-filter-anchor">
                        <FilterByStatusPopup CurrentStatus="@activeFilter" OnApply="ApplyFilter" OnClose="CloseFilterPopup" />
                    </div>
                }
            </div>

            <div class="s-cards-list-wrapper" style="background: white; border-radius: 12px; border: 1px solid #E5E7EB;">
                <DataGrid TItem="BookingItem" 
                          Data="FilteredBookingsForGrid" 
                          Columns="gridColumns" 
                          IsLoading="_isLoading"
                          SearchPlaceholder="Cari pemesanan..."
                          FileNamePrefix="status-booking"
                          OnRowClick="SelectBooking">
                </DataGrid>
            </div>
        </div>

        <!-- Kolom Kanan: Detail Sticky -->
        <div class="s-detail-col">
            @if (selectedBooking != null)
            {
                <div class="s-detail-sticky">
                    <div class="s-detail-photo-wrap" @onclick="() => OpenDetailsModal(selectedBooking)" style="cursor: pointer;">
                        <span class="s-detail-badge @GetStatusBadgeClass(selectedBooking.Status)">
                            <span class="s-pill-dot"></span>
                            @GetStatusLabel(selectedBooking.Status).ToUpper()
                        </span>
                         <img src="@selectedBooking.PhotoUrl" alt="@selectedBooking.RoomName" class="s-detail-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                         <div class="s-detail-img-placeholder" style="display:none; position:absolute; inset:0; align-items:center; justify-content:center; background:#f3f4f6;">
                             <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                         </div>
                        <div class="s-detail-photo-overlay">
                            <span>Klik untuk detail</span>
                        </div>
                    </div>
                    
                    <div class="s-detail-body">
                        <div class="s-detail-header">
                            <h2>@selectedBooking.RoomName</h2>
                            <span class="s-detail-reqid">ID Permintaan: @selectedBooking.RequestId</span>
                        </div>

                        <div class="s-detail-requester">
                            <span class="s-label-small">DIAJUKAN OLEH</span>
                            <div class="s-requester-profile">
                                <div class="s-requester-avatar">@GetInitials(selectedBooking.RequestedBy)</div>
                                <div class="s-requester-info">
                                    <span class="s-req-name">@selectedBooking.RequestedBy</span>
                                    <span class="s-req-title">@selectedBooking.RequestedByTitle</span>
                                </div>
                            </div>
                        </div>

                        <hr class="s-divider" />

                        <div class="s-detail-grid">
                            <div class="s-grid-item">
                                <span class="s-grid-label">TANGGAL</span>
                                <span class="s-grid-val">@selectedBooking.Date</span>
                            </div>
                            <div class="s-grid-item">
                                <span class="s-grid-label">WAKTU</span>
                                <span class="s-grid-val">@selectedBooking.TimeSlot</span>
                            </div>
                            <div class="s-grid-item">
                                <span class="s-grid-label">DURASI</span>
                                <span class="s-grid-val">@selectedBooking.Duration</span>
                            </div>
                            <div class="s-grid-item">
                                <span class="s-grid-label">KAPASITAS</span>
                                <span class="s-grid-val">@selectedBooking.Attendees/@selectedBooking.Capacity Peserta</span>
                            </div>
                        </div>

                        <div class="s-purpose-box">
                            <div class="s-purpose-head">Tujuan Rapat</div>
                            <p>@selectedBooking.Purpose</p>
                        </div>

                        <div class="s-detail-actions">
                            <button class="s-btn-modify" @onclick="OpenModifyModal">Ubah</button>
                            <button class="s-btn-cancel-req" @onclick="OpenCancelModal">Batalkan Permintaan</button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="s-empty-detail">
                    <p>Pilih pemesanan untuk melihat detail</p>
                </div>
            }
        </div>
    </div>
</div>

<StatusRoomDetailsModal 
    Visible="isDetailsModalOpen" 
    Booking="modalBooking" 
    OnClose="CloseDetailsModal"
    OnModify="HandleDetailsModify" />

<!-- Existing modifikasi & cancel modals -->
<ModalOverlayBlur Visible="isModifyModalOpen" OnClose="CloseModifyModal" Size="default" ShowCloseButton="false">
    <ModifyBookingModal Booking="selectedBooking" OnClose="CloseModifyModal" OnUpdate="HandleModifyUpdate" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="isCancelModalOpen" OnClose="CloseCancelModal" Size="default" ShowCloseButton="false">
    <CancelRequestModal Booking="selectedBooking" OnClose="CloseCancelModal" OnConfirm="HandleCancelConfirm" />
</ModalOverlayBlur>

<style>
    .s-page-container { padding: 32px; font-family: 'Inter', sans-serif; background-color: #F3F4F6; min-height: 100vh; }
    .s-page-header { padding: 0 8px; margin-bottom: 24px; }
    .s-page-title { color: #16305C; font-size: 32px; font-weight: 700; margin: 0 0 8px 0; }
    
    .s-topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding: 0 8px; }
    .s-topbar-right { display: flex; align-items: center; gap: 16px; }
    .s-btn-icon-refresh { background: none; border: none; color: #6B7280; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: color 0.2s; padding: 4px; }
    .s-btn-icon-refresh:hover { color: #16305C; }
    .s-avatar-circle { width: 36px; height: 36px; border-radius: 50%; background-color: #16305C; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; }

    .s-status-layout { display: grid; grid-template-columns: 1fr 440px; gap: 24px; }
    .s-list-col { min-width: 0; }
    
    .s-toolbar { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; position: relative; }
    .s-search-bar { position: relative; flex-grow: 1; display: flex; align-items: center; }
    .s-search-icon { position: absolute; left: 16px; color: #6B7280; }
    .s-search-bar input { width: 100%; padding: 12px 16px 12px 44px; border: 1px solid #E5E7EB; border-radius: 999px; font-size: 14px; background: #FFFFFF; }
    .s-search-bar input:focus { outline: none; border-color: #16305C; box-shadow: 0 0 0 2px rgba(22,48,92,0.1); }
    .s-btn-filter { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; border: 1px solid #E5E7EB; border-radius: 999px; background: #FFFFFF; color: #16305C; font-size: 14px; font-weight: 600; cursor: pointer; }
    .s-btn-filter:hover { background-color: #F9FAFB; }
    .s-filter-anchor { position: absolute; top: 56px; right: 0; z-index: 100; }

    .s-cards-list { display: flex; flex-direction: column; gap: 16px; }
    .s-card { display: flex; gap: 16px; background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 20px; padding: 16px; cursor: pointer; transition: all 0.2s; position: relative; overflow: hidden; }
    .s-card:hover { border-color: #CBD5E1; box-shadow: 0 4px 12px rgba(16,48,92,0.04); }
    .s-card.selected { background-color: #F0F4FF; border-color: #E5E7EB; }
    .s-card.selected::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background-color: #EAB63C; }
    
    .s-card-thumbnail { width: 64px; height: 64px; flex-shrink: 0; border-radius: 12px; overflow: hidden; position: relative; }
    .s-card-thumbnail img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.2s; }
    .s-card-thumbnail:hover img { transform: scale(1.05); }
    .s-card-thumbnail-placeholder { position: absolute; inset: 0; }
    
    .s-card-content { flex-grow: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
    .s-card-header-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }
    .s-card-title-group { display: flex; flex-direction: column; gap: 2px; }
    .s-card-room { color: #16305C; font-size: 16px; font-weight: 700; margin: 0; }
    .s-card-reqid { color: #6B7280; font-size: 12px; }
    
    .s-card-meta { display: flex; gap: 16px; flex-wrap: wrap; }
    .s-card-meta span { display: inline-flex; align-items: center; gap: 6px; color: #6B7280; font-size: 13px; }

    .s-pill-status { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; white-space: nowrap; }
    .s-pill-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .bg-pending { background-color: #FEF3C7; color: #B45309; }
    .bg-approved { background-color: #D1FAE5; color: #10B981; }
    .bg-rejected { background-color: #FEE2E2; color: #EF4444; }
    .bg-completed { background-color: #DBEAFE; color: #1E40AF; }

    /* Sticky Detail */
    .s-detail-sticky { position: sticky; top: 32px; background: #FFFFFF; border-radius: 24px; overflow: hidden; border: 1px solid #E5E7EB; box-shadow: 0 4px 24px rgba(16,48,92,0.08); }
    .s-detail-photo-wrap { position: relative; height: 220px; overflow: hidden; background-color: #f3f4f6; }
    .s-detail-img { width: 100%; height: 100%; object-fit: cover; }
    .s-detail-img-placeholder { position: absolute; inset: 0; }
    .s-detail-badge { position: absolute; top: 16px; left: 16px; background: rgba(0,0,0,0.6); color: white; padding: 6px 14px; border-radius: 999px; font-size: 11px; font-weight: 700; display: flex; align-items: center; gap: 6px; z-index: 2; }
    .s-detail-photo-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(22,48,92,0.4); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.2s; color: white; font-weight: 600; font-size: 14px; }
    .s-detail-photo-wrap:hover .s-detail-photo-overlay { opacity: 1; }

    .s-detail-body { padding: 24px; }
    .s-detail-header { margin-bottom: 24px; }
    .s-detail-header h2 { color: #16305C; font-size: 24px; font-weight: 700; margin: 0 0 4px 0; }
    .s-detail-reqid { color: #6B7280; font-size: 13px; }
    
    .s-label-small { display: block; color: #9CA3AF; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
    .s-requester-profile { display: flex; align-items: center; gap: 12px; }
    .s-requester-avatar { width: 44px; height: 44px; background-color: #16305C; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; }
    .s-req-name { display: block; color: #16305C; font-size: 15px; font-weight: 600; }
    .s-req-title { display: block; color: #6B7280; font-size: 13px; }
    
    .s-divider { border: none; border-top: 1px solid #E5E7EB; margin: 24px 0; }
    
    .s-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; }
    .s-grid-item { display: flex; flex-direction: column; gap: 4px; }
    .s-grid-label { color: #9CA3AF; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
    .s-grid-val { color: #16305C; font-size: 15px; font-weight: 600; }
    
    .s-purpose-box { background-color: #F3F4F6; border-radius: 16px; padding: 16px; margin-bottom: 24px; }
    .s-purpose-head { font-size: 13px; font-weight: 600; color: #16305C; margin-bottom: 6px; }
    .s-purpose-box p { color: #6B7280; font-size: 14px; line-height: 1.5; margin: 0; }
    
    .s-detail-actions { display: flex; gap: 12px; }
    .s-btn-modify { flex: 1; background-color: #FFFFFF; color: #16305C; border: 1px solid #CBD5E1; border-radius: 999px; padding: 12px; font-weight: 600; font-size: 14px; cursor: pointer; transition: all 0.2s; }
    .s-btn-modify:hover { border-color: #16305C; background: #F8FAFC; }
    .s-btn-cancel-req { flex: 1; background: #FFFFFF; color: #EF4444; border: 1px solid #FEE2E2; border-radius: 999px; padding: 12px; font-weight: 600; font-size: 14px; cursor: pointer; transition: all 0.2s; }
    .s-btn-cancel-req:hover { background-color: #FEF2F2; }

    .s-empty-state { text-align: center; padding: 60px 20px; color: #9CA3AF; }
    .s-empty-detail { display: flex; align-items: center; justify-content: center; background: #FFFFFF; border-radius: 24px; border: 1px solid #E5E7EB; padding: 60px 20px; color: #9CA3AF; min-height: 400px; }
</style>

@code {
    private List<BookingItem> allBookings = new();
    private BookingItem? selectedBooking;
    private string searchQuery = "";
    private string activeFilter = "Semua Status";
    private bool isFilterOpen = false;
    
    private bool isModifyModalOpen = false;
    private bool isCancelModalOpen = false;

    // Details modal
    private bool isDetailsModalOpen = false;
    private BookingItem? modalBooking;

    private bool _isLoading = true;
    private List<GridColumn<BookingItem>> gridColumns = new();

    protected override async Task OnInitializedAsync()
    {
        gridColumns = new List<GridColumn<BookingItem>>
        {
            new GridColumn<BookingItem>
            {
                Title = "RUANGAN",
                PropertyName = "RoomName",
                ValueFunc = b => b.RoomName,
                CellTemplate = b => builder =>
                {
                    builder.OpenElement(0, "div");
                    builder.AddAttribute(1, "style", "display: flex; flex-direction: column;");
                    builder.OpenElement(2, "span");
                    builder.AddAttribute(3, "style", "font-weight: 600; color: #16305C;");
                    builder.AddContent(4, b.RoomName);
                    builder.CloseElement();
                    builder.OpenElement(5, "span");
                    builder.AddAttribute(6, "style", "font-size: 12px; color: #6B7280;");
                    builder.AddContent(7, b.RequestId);
                    builder.CloseElement();
                    builder.CloseElement();
                }
            },
            new GridColumn<BookingItem>
            {
                Title = "TANGGAL",
                PropertyName = "Date",
                ValueFunc = b => b.Date
            },
            new GridColumn<BookingItem>
            {
                Title = "WAKTU",
                PropertyName = "TimeSlot",
                ValueFunc = b => b.TimeSlot
            },
            new GridColumn<BookingItem>
            {
                Title = "STATUS",
                PropertyName = "Status",
                ValueFunc = b => GetStatusLabel(b.Status),
                CellTemplate = b => builder =>
                {
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", $"s-pill-status {GetStatusBadgeClass(b.Status)}");
                    builder.OpenElement(2, "span");
                    builder.AddAttribute(3, "class", "s-pill-dot");
                    builder.CloseElement();
                    builder.AddContent(4, " " + GetStatusLabel(b.Status));
                    builder.CloseElement();
                }
            }
        };
        await Task.Delay(400);
        allBookings = BookingDataStore.AllBookings;
        selectedBooking = allBookings.FirstOrDefault();
        _isLoading = false;
    }

    private IEnumerable<BookingItem> FilteredBookingsForGrid
    {
        get
        {
            var query = allBookings.AsEnumerable();
            
            if (activeFilter != "Semua Status")
            {
                query = query.Where(b => b.Status.Equals(activeFilter, StringComparison.OrdinalIgnoreCase));
            }
            
            return query;
        }
    }

    private void SelectBooking(BookingItem booking)
    {
        selectedBooking = booking;
    }

    private void RefreshData()
    {
        // Simulate data refresh
        allBookings = BookingDataStore.AllBookings.ToList();
    }

    private void ToggleFilterPopup()
    {
        isFilterOpen = !isFilterOpen;
    }

    private void CloseFilterPopup()
    {
        isFilterOpen = false;
    }

    private void ApplyFilter(string status)
    {
        activeFilter = status;
        isFilterOpen = false;
    }

    private void OpenDetailsModal(BookingItem booking)
    {
        modalBooking = booking;
        isDetailsModalOpen = true;
    }

    private void CloseDetailsModal()
    {
        isDetailsModalOpen = false;
    }

    private void HandleDetailsModify(BookingItem booking)
    {
        selectedBooking = booking;
        OpenModifyModal();
    }

    private void OpenModifyModal()
    {
        isModifyModalOpen = true;
    }

    private void CloseModifyModal()
    {
        isModifyModalOpen = false;
    }

    private void HandleModifyUpdate(BookingItem updatedBooking)
    {
        var index = allBookings.FindIndex(b => b.Id == updatedBooking.Id);
        if (index != -1)
        {
            allBookings[index] = updatedBooking;
            if (selectedBooking?.Id == updatedBooking.Id)
            {
                selectedBooking = updatedBooking;
            }
        }
        isModifyModalOpen = false;
    }

    private void OpenCancelModal()
    {
        isCancelModalOpen = true;
    }

    private void CloseCancelModal()
    {
        isCancelModalOpen = false;
    }

    private void HandleCancelConfirm(BookingItem booking)
    {
        var index = allBookings.FindIndex(b => b.Id == booking.Id);
        if (index != -1)
        {
            var updated = booking with { Status = "rejected" };
            allBookings[index] = updated;
            if (selectedBooking?.Id == booking.Id)
            {
                selectedBooking = updated;
            }
        }
        isCancelModalOpen = false;
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return $"{parts[0].Substring(0, 1)}{parts[1].Substring(0, 1)}".ToUpper();
    }

    private string GetStatusLabel(string status)
    {
        if (status.Equals("pending", StringComparison.OrdinalIgnoreCase)) return "Menunggu Persetujuan";
        if (status.Equals("approved", StringComparison.OrdinalIgnoreCase)) return "Disetujui";
        if (status.Equals("rejected", StringComparison.OrdinalIgnoreCase)) return "Ditolak";
        if (status.Equals("completed", StringComparison.OrdinalIgnoreCase)) return "Selesai";
        return status;
    }

    private string GetStatusBadgeClass(string status)
    {
        if (status.Equals("pending", StringComparison.OrdinalIgnoreCase)) return "bg-pending";
        if (status.Equals("approved", StringComparison.OrdinalIgnoreCase)) return "bg-approved";
        if (status.Equals("rejected", StringComparison.OrdinalIgnoreCase)) return "bg-rejected";
        if (status.Equals("completed", StringComparison.OrdinalIgnoreCase)) return "bg-completed";
        return "";
    }
}

