@code {
    private List<BookingItem> allBookings = new();
    private BookingItem? selectedBooking;
    private BookingItem? _activeUpcomingBooking;
    private string activeFilter = "Semua Status";
    private bool isFilterOpen = false;
    private bool _isSlidePanelOpen = false;
    private bool _isHeroExpanded = false;
    private string _searchQuery = "";
    private System.Timers.Timer? _countdownTimer;

    private bool isModifyModalOpen = false;
    private bool isCancelModalOpen = false;
    private bool _isLoading = true;
    private List<GridColumn<BookingItem>> gridColumns = new();

    private readonly string[] _statusFilterOptions = { "Semua Status", "Menunggu Persetujuan", "Disetujui", "Ditolak", "Selesai" };

    protected override async Task OnInitializedAsync()
    {
        gridColumns = new List<GridColumn<BookingItem>>
        {
            new GridColumn<BookingItem>
            {
                Title = "RUANGAN",
                PropertyName = "RoomName",
                ValueFunc = b => b.RoomName,
                CellTemplate = b => builder =>
                {
                    builder.OpenElement(0, "div");
                    builder.AddAttribute(1, "style", "display: flex; flex-direction: column;");
                    builder.OpenElement(2, "span");
                    builder.AddAttribute(3, "style", "font-weight: 700; color: #0F1F3D;");
                    builder.AddContent(4, b.RoomName);
                    builder.CloseElement();
                    builder.OpenElement(5, "span");
                    builder.AddAttribute(6, "style", "font-size: 12px; color: #6B7280; margin-top: 2px;");
                    builder.AddContent(7, $"{b.Floor} • {b.RequestId}");
                    builder.CloseElement();
                    builder.CloseElement();
                }
            },
            new GridColumn<BookingItem>
            {
                Title = "TANGGAL",
                PropertyName = "Date",
                ValueFunc = b => b.Date
            },
            new GridColumn<BookingItem>
            {
                Title = "WAKTU",
                PropertyName = "TimeSlot",
                ValueFunc = b => b.TimeSlot
            },
            new GridColumn<BookingItem>
            {
                Title = "DURASI",
                PropertyName = "Duration",
                ValueFunc = b => b.Duration
            },
            new GridColumn<BookingItem>
            {
                Title = "STATUS",
                PropertyName = "Status",
                ValueFunc = b => GetStatusLabel(b.Status),
                CellTemplate = b => builder =>
                {
                    builder.OpenComponent<StatusBadge>(0);
                    builder.AddAttribute(1, "Status", b.Status);
                    builder.CloseComponent();
                }
            }
        };

        allBookings = BookingDataStore.AllBookings.ToList();
        selectedBooking = allBookings.FirstOrDefault();
        _activeUpcomingBooking = allBookings.FirstOrDefault(b => b.Status.Equals("approved", StringComparison.OrdinalIgnoreCase) || b.Status.Equals("pending", StringComparison.OrdinalIgnoreCase));
        _isLoading = false;

        // Inisialisasi countdown timer untuk Dynamic Island Hero
        _countdownTimer = new System.Timers.Timer(1000);
        _countdownTimer.Elapsed += (s, e) => InvokeAsync(StateHasChanged);
        _countdownTimer.Start();
    }

    private IEnumerable<BookingItem> FilteredBookingsForGrid
    {
        get
        {
            var query = allBookings.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLowerInvariant();
                query = query.Where(b => b.RoomName.ToLowerInvariant().Contains(q) || b.RequestId.ToLowerInvariant().Contains(q));
            }

            if (activeFilter != "Semua Status")
            {
                var targetStatus = activeFilter switch
                {
                    "Menunggu Persetujuan" => "pending",
                    "Disetujui" => "approved",
                    "Ditolak" => "rejected",
                    "Selesai" => "completed",
                    _ => activeFilter
                };
                query = query.Where(b => b.Status.Equals(targetStatus, StringComparison.OrdinalIgnoreCase) || b.Status.Equals(activeFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
    }

    private void SelectBookingAndOpenSlide(BookingItem booking)
    {
        selectedBooking = booking;
        _isSlidePanelOpen = true;
    }

    private void CloseSlidePanel()
    {
        _isSlidePanelOpen = false;
    }

    private void RefreshData()
    {
        allBookings = BookingDataStore.AllBookings.ToList();
        _activeUpcomingBooking = allBookings.FirstOrDefault(b => b.Status.Equals("approved", StringComparison.OrdinalIgnoreCase) || b.Status.Equals("pending", StringComparison.OrdinalIgnoreCase));
        ToastService.Success("Data Diperbarui", "Daftar status pemesanan berhasil disinkronkan.");
    }

    private void ToggleFilterPopup()
    {
        isFilterOpen = !isFilterOpen;
    }

    private void ApplyFilter(string filter)
    {
        activeFilter = filter;
        isFilterOpen = false;
    }

    private void OnHeroExpandChanged(bool expanded)
    {
        _isHeroExpanded = expanded;
    }

    private void OpenCancelModalFor(BookingItem booking)
    {
        selectedBooking = booking;
        OpenCancelModal();
    }

    private void OpenModifyModal()
    {
        isModifyModalOpen = true;
    }

    private void CloseModifyModal()
    {
        isModifyModalOpen = false;
    }

    private void HandleModifyUpdate(BookingItem updatedBooking)
    {
        var index = allBookings.FindIndex(b => b.Id == updatedBooking.Id);
        if (index != -1)
        {
            allBookings[index] = updatedBooking;
            if (selectedBooking?.Id == updatedBooking.Id)
            {
                selectedBooking = updatedBooking;
            }
            if (_activeUpcomingBooking?.Id == updatedBooking.Id)
            {
                _activeUpcomingBooking = updatedBooking;
            }
        }
        isModifyModalOpen = false;
        ToastService.Success("Reservasi Diperbarui", $"Jadwal untuk {updatedBooking.RoomName} berhasil disesuaikan.");
    }

    private void OpenCancelModal()
    {
        isCancelModalOpen = true;
    }

    private void CloseCancelModal()
    {
        isCancelModalOpen = false;
    }

    private void HandleCancelConfirm(BookingItem booking)
    {
        var index = allBookings.FindIndex(b => b.Id == booking.Id);
        if (index != -1)
        {
            var updated = booking with { Status = "rejected" };
            allBookings[index] = updated;
            if (selectedBooking?.Id == booking.Id)
            {
                selectedBooking = updated;
            }
            if (_activeUpcomingBooking?.Id == booking.Id)
            {
                _activeUpcomingBooking = allBookings.FirstOrDefault(b => b.Status.Equals("approved", StringComparison.OrdinalIgnoreCase) || b.Status.Equals("pending", StringComparison.OrdinalIgnoreCase));
            }
        }
        isCancelModalOpen = false;
        ToastService.Warning("Pemesanan Dibatalkan", $"Pemesanan {booking.RoomName} telah dibatalkan.");
    }

    private string GetCountdownText()
    {
        return "18 Menit Menuju Check-in";
    }

    private string GetStatusAccentColor(string status) => (status ?? "").ToLowerInvariant() switch
    {
        "approved" or "disetujui" => "#10B981",
        "pending" or "menunggu" => "#F59E0B",
        "rejected" or "ditolak" => "#EF4444",
        "completed" or "selesai" => "#3B82F6",
        _ => "#10B981"
    };

    private string GetStatusLabel(string status)
    {
        if (status.Equals("pending", StringComparison.OrdinalIgnoreCase)) return "Menunggu Persetujuan";
        if (status.Equals("approved", StringComparison.OrdinalIgnoreCase)) return "Disetujui";
        if (status.Equals("rejected", StringComparison.OrdinalIgnoreCase)) return "Ditolak";
        if (status.Equals("completed", StringComparison.OrdinalIgnoreCase)) return "Selesai";
        return status;
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return $"{parts[0].Substring(0, 1)}{parts[1].Substring(0, 1)}".ToUpper();
    }

    public void Dispose()
    {
        _countdownTimer?.Dispose();
    }
}

