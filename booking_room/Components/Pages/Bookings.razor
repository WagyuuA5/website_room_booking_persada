@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabParam { get; set; }

    private string _activeTab = "ruangan";
    private bool _isTabSwitching = false;

    private string _searchQuery = "";
    private int? _filterCapacity = null;
    private DateTime? _selectedBookingDate = DateTime.Today;
    private string _selectedBookingTime = "09:00";
    private string _selectedDuration = "1";

    protected override void OnParametersSet()
    {
        var targetTab = string.IsNullOrWhiteSpace(TabParam) ? "ruangan" : TabParam.ToLowerInvariant();
        if (targetTab != "ruangan" && targetTab != "kalender" && targetTab != "fasilitas")
        {
            targetTab = "ruangan";
        }

        if (targetTab != _activeTab)
        {
            _activeTab = targetTab;
        }
    }

    private async Task SwitchTab(string tab)
    {
        if (_activeTab == tab) return;
        _isTabSwitching = true;
        _activeTab = tab;
        Navigation.NavigateTo($"/pemesanan?tab={tab}", replace: false);
        await Task.Delay(200);
        _isTabSwitching = false;
    }

    private bool _isBookingDatePickerOpen = false;
    private bool _isBookingTimePickerOpen = false;

    private bool _isLoading = true;
    private List<RoomItem> _allRooms = new();
    private IEnumerable<RoomItem> _filteredRooms = Array.Empty<RoomItem>();

    private bool _isRoomDetailVisible = false;
    private RoomItem? _selectedRoomForDetail;

    private bool _isConfirmBookingVisible = false;
    private RoomItem? _selectedRoomForBooking;
    
    private bool _disposed;
    private System.Threading.CancellationTokenSource? _cts;

    private readonly CultureInfo _idCulture = new CultureInfo("id-ID");

    protected override async Task OnInitializedAsync()
    {
        _cts = new System.Threading.CancellationTokenSource();
        LoadingState.OnChange += SafeStateHasChanged;
        
        try {
            await LoadDataAsync(_cts.Token);
        } catch (TaskCanceledException) {}
    }
    
    private async Task LoadDataAsync(System.Threading.CancellationToken token)
    {
        _isLoading = true;
        LoadingState.SetLoading(true);
        await Task.Delay(400, token);
        
        _allRooms = RoomDataProvider.GetRooms().ToList();
        
        ApplyFilter();
        _isLoading = false;
        LoadingState.SetLoading(false);
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    private void OpenDatePicker()
    {
        _isBookingDatePickerOpen = true;
        _isBookingTimePickerOpen = false;
    }

    private void OpenTimePicker()
    {
        _isBookingTimePickerOpen = true;
        _isBookingDatePickerOpen = false;
    }

    private void HandleBookingDateSelected(DateTime? date)
    {
        _selectedBookingDate = date;
        _isBookingDatePickerOpen = false;
        ApplyFilter();
    }

    private void HandleBookingTimeSelected(string timeStr)
    {
        _selectedBookingTime = timeStr;
        _isBookingTimePickerOpen = false;
    }

    private string GetFormattedDateString()
    {
        if (_selectedBookingDate.HasValue)
        {
            return _selectedBookingDate.Value.ToString("dd MMMM yyyy", _idCulture);
        }
        return DateTime.Today.ToString("dd MMMM yyyy", _idCulture);
    }

    private void ApplyFilter()
    {
        var q = _allRooms.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            q = q.Where(r => r.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                             r.Floor.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                             r.Description.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
        }

        if (_filterCapacity.HasValue && _filterCapacity > 0)
        {
            q = q.Where(r => r.Capacity >= _filterCapacity.Value);
        }

        _filteredRooms = q.ToList();
        StateHasChanged();
    }

    private void ViewDetail(RoomItem room)
    {
        _selectedRoomForDetail = room;
        _isRoomDetailVisible = true;
    }

    private void CloseDetail()
    {
        _isRoomDetailVisible = false;
        _selectedRoomForDetail = null;
    }

    private void ProceedToBook(RoomItem? room)
    {
        if (room == null) return;
        CloseDetail();
        _selectedRoomForBooking = room;
        _isConfirmBookingVisible = true;
    }

    private RoomStatus ParseRoomStatus(string status) => status?.ToLowerInvariant() switch
    {
        "available" => RoomStatus.Tersedia,
        "booked" => RoomStatus.Dipesan,
        "unavailable" => RoomStatus.TidakTersedia,
        "maintenance" or "pemeliharaan" => RoomStatus.Pemeliharaan,
        _ => RoomStatus.Tersedia
    };

    private int GetRoomRemainingMinutes(string id) => id switch
    {
        "2" => 120, // 2 jam
        "7" => 45,  // 45 menit
        _ => 90
    };

    private string LocalizeAmenity(string amenity) => amenity?.Trim().ToLowerInvariant() switch
    {
        "projector" or "proyektor" => "Proyektor",
        "video conf" or "video conference" or "konferensi video" => "Konferensi Video",
        "whiteboard" or "papan tulis" => "Papan Tulis",
        "audio system" or "sistem audio" => "Sistem Audio",
        _ => amenity ?? ""
    };

    private void SafeStateHasChanged()
    {
        if (_disposed) return;
        try {
            InvokeAsync(StateHasChanged);
        } catch {}
    }

    public void Dispose()
    {
        _disposed = true;
        LoadingState.OnChange -= SafeStateHasChanged;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
