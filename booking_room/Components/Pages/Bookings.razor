@page "/bookings"
@page "/pemesanan"
@using booking_room.Components.Models
@using booking_room.Components.Shared
@inject booking_room.Services.LoadingStateService LoadingState
@implements IDisposable

<PageTitle>Pemesanan Ruangan — Persada</PageTitle>

<div class="content-fade-in bookings-page-wrapper">
    <!-- Header -->
    <div class="bookings-header-row">
        <div>
            <h1 class="bookings-title">Katalog & Reservasi Ruangan</h1>
            <p class="bookings-sub">Pilih ruangan yang sesuai dengan kebutuhan rapat, workshop, atau kolaborasi tim Anda.</p>
        </div>
    </div>

    <!-- Search and Capacity Filters -->
    <div class="bookings-filter-bar">
        <div class="search-input-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" class="bookings-search-input" placeholder="Cari ruangan berdasarkan nama, lantai, atau fasilitas..."
                   value="@_searchQuery" @oninput="OnSearchInput" />
        </div>
        <div class="capacity-filter-wrap">
            <select class="capacity-select" @bind="_filterCapacity" @bind:after="ApplyFilter">
                <option value="0">Semua Kapasitas</option>
                <option value="4">Min. 4 Orang</option>
                <option value="8">Min. 8 Orang</option>
                <option value="15">Min. 15 Orang</option>
                <option value="30">Min. 30 Orang</option>
            </select>
        </div>
    </div>

    <!-- CASE 2: Rooms Horizontal Carousel Grid with Scroll-Snap & Fade Edge -->
    <div class="rooms-carousel-section">
        <div class="rooms-carousel-header">
            <h3 class="section-heading">Ruangan Unggulan</h3>
            <span class="carousel-hint">Geser horizontal untuk melihat ruangan lain &rarr;</span>
        </div>

        <div class="rooms-carousel-wrapper">
            <div class="rooms-horizontal-track">
                @foreach (var room in _filteredRooms)
                {
                    <div class="room-catalog-card @(room.Status == "available" ? "card-available" : "card-disabled")" 
                         @onclick="() => ViewDetail(room)">
                        <div class="room-card-photo-box">
                            <img src="@room.PhotoUrl" alt="@room.Name" class="room-card-photo" loading="lazy" />
                            <div class="room-status-badge @(room.Status == "available" ? "badge-available" : "badge-booked")">
                                @(room.Status == "available" ? "Tersedia" : "Dipesan")
                            </div>
                        </div>
                        <div class="room-card-body">
                            <h4 class="room-card-title">@room.Name</h4>
                            <div class="room-card-meta">
                                <span>👥 Kapasitas @room.Capacity Orang</span>
                                <span>•</span>
                                <span>📍 @room.Floor</span>
                            </div>
                            <p class="room-card-desc">@room.Description</p>
                            <div class="room-card-amenities">
                                @foreach (var am in room.Amenities.Take(3))
                                {
                                    <span class="amenity-chip">@am</span>
                                }
                            </div>
                        </div>
                        <div class="room-card-footer">
                            <button class="btn-card-detail" @onclick="() => ViewDetail(room)" @onclick:stopPropagation="true">
                                Detail & Denah
                            </button>
                            @if (room.Status == "available")
                            {
                                <button class="btn-card-book" @onclick="() => ProceedToBook(room)" @onclick:stopPropagation="true">
                                    Pesan
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="carousel-fade-edge"></div>
        </div>
    </div>
</div>

<!-- Modals -->
@if (_isRoomDetailVisible && _selectedRoomForDetail != null)
{
    <RoomDetailsModal Visible="_isRoomDetailVisible" 
                      Room="_selectedRoomForDetail" 
                      OnClose="CloseDetail" 
                      OnBook="() => ProceedToBook(_selectedRoomForDetail)" />
}

@if (_isConfirmBookingVisible && _selectedRoomForBooking != null)
{
    <ConfirmBookingModal Room="_selectedRoomForBooking" 
                         OnBack="CloseConfirm" 
                         OnConfirm="CloseConfirm" />
}

<style>
    .bookings-page-wrapper {
        max-width: 1400px;
        margin: 0 auto;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .bookings-title {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--persada-navy-900, #0F1F3D);
        margin: 0 0 4px 0;
        letter-spacing: -0.02em;
    }
    body.dark-mode .bookings-title { color: #F8FAFC; }
    .bookings-sub {
        font-size: 0.875rem;
        color: var(--persada-text-secondary, #6B7280);
        margin: 0;
    }

    .bookings-filter-bar {
        display: flex;
        gap: 12px;
        align-items: center;
    }
    .search-input-wrap {
        position: relative;
        flex: 1;
        max-width: 420px;
        height: 42px;
        display: flex;
        align-items: center;
    }
    .search-input-wrap svg {
        position: absolute;
        left: 14px;
        color: #9CA3AF;
        pointer-events: none;
    }
    .bookings-search-input {
        width: 100%;
        height: 42px;
        padding: 0 14px 0 40px;
        border: 1.5px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 12px;
        font-size: 0.875rem;
        background: var(--surface-card, #FFFFFF);
        color: var(--persada-text-primary, #111827);
        outline: none;
    }
    body.dark-mode .bookings-search-input {
        background: #1C1C1E;
        border-color: rgba(255, 255, 255, 0.1);
        color: #F8FAFC;
    }
    .capacity-select {
        height: 42px;
        padding: 0 32px 0 14px;
        border: 1.5px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 12px;
        font-size: 0.875rem;
        font-weight: 600;
        background: var(--surface-card, #FFFFFF);
        color: var(--persada-text-primary, #111827);
        outline: none;
    }
    body.dark-mode .capacity-select {
        background: #1C1C1E;
        border-color: rgba(255, 255, 255, 0.1);
        color: #F8FAFC;
    }

    /* CASE 2: Horizontal Carousel Track */
    .rooms-carousel-section {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 8px;
    }
    .rooms-carousel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .section-heading {
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--persada-navy-900, #0F1F3D);
        margin: 0;
    }
    body.dark-mode .section-heading { color: #F8FAFC; }
    .carousel-hint {
        font-size: 0.75rem;
        font-weight: 600;
        color: #1F5D9A;
    }
    body.dark-mode .carousel-hint { color: #60A5FA; }

    .rooms-carousel-wrapper {
        position: relative;
        width: 100%;
    }
    .rooms-horizontal-track {
        display: flex;
        gap: 16px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding-bottom: 8px;
        scrollbar-width: none;
    }
    .rooms-horizontal-track::-webkit-scrollbar {
        display: none;
    }

    .room-catalog-card {
        flex: 0 0 auto;
        width: 260px;
        min-height: 380px;
        scroll-snap-align: start;
        background: var(--surface-card, #FFFFFF);
        border: 1.5px solid var(--color-brand-gray-border, #E5E7EB);
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    body.dark-mode .room-catalog-card {
        background: #1C1C1E;
        border-color: rgba(255, 255, 255, 0.1);
    }
    .room-catalog-card:hover {
        border-color: #CBD5E1;
        box-shadow: 0 8px 24px rgba(15, 31, 61, 0.08);
        transform: translateY(-2px);
    }

    .room-card-photo-box {
        position: relative;
        width: 100%;
        height: 140px;
        overflow: hidden;
    }
    .room-card-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .room-status-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 0.6875rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 999px;
    }
    .badge-available { background: #DCFCE7; color: #15803D; }
    .badge-booked { background: #FEF3C7; color: #D97706; }

    .room-card-body {
        padding: 14px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .room-card-title {
        font-size: 0.9375rem;
        font-weight: 700;
        color: var(--persada-navy-900, #0F1F3D);
        margin: 0;
    }
    body.dark-mode .room-card-title { color: #F8FAFC; }
    .room-card-meta {
        font-size: 0.72rem;
        color: var(--persada-text-secondary, #6B7280);
        display: flex;
        gap: 6px;
    }
    .room-card-desc {
        font-size: 0.75rem;
        color: var(--persada-text-secondary, #64748B);
        margin: 0;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .room-card-amenities {
        display: flex;
        gap: 4px;
        flex-wrap: wrap;
        margin-top: auto;
    }
    .amenity-chip {
        font-size: 0.625rem;
        background: #F1F5F9;
        color: #475569;
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: 600;
    }
    body.dark-mode .amenity-chip {
        background: rgba(255, 255, 255, 0.08);
        color: #CBD5E1;
    }

    .room-card-footer {
        padding: 10px 14px 14px;
        display: flex;
        gap: 8px;
        border-top: 1px solid var(--divider-subtle, #F1F5F9);
    }
    body.dark-mode .room-card-footer { border-color: rgba(255, 255, 255, 0.08); }
    .btn-card-detail {
        flex: 1;
        height: 34px;
        border-radius: 999px;
        background: transparent;
        border: 1px solid #E2E8F0;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--persada-navy-900, #0F1F3D);
        cursor: pointer;
    }
    body.dark-mode .btn-card-detail {
        border-color: rgba(255, 255, 255, 0.15);
        color: #F8FAFC;
    }
    .btn-card-book {
        flex: 1;
        height: 34px;
        border-radius: 999px;
        background: #1F5D9A;
        border: none;
        font-size: 0.75rem;
        font-weight: 700;
        color: #FFFFFF;
        cursor: pointer;
    }
    .btn-card-book:hover { background: #164879; }

    .carousel-fade-edge {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 8px;
        width: 32px;
        background: linear-gradient(to right, transparent, var(--surface-card, #FFFFFF));
        pointer-events: none;
        border-radius: 0 16px 16px 0;
    }
    body.dark-mode .carousel-fade-edge {
        background: linear-gradient(to right, transparent, #0F172A);
    }
</style>

@code {
    private string _searchQuery = string.Empty;
    private int? _filterCapacity = 0;
    private bool _isRoomDetailVisible = false;
    private bool _isConfirmBookingVisible = false;
    private RoomItem? _selectedRoomForDetail;
    private RoomItem? _selectedRoomForBooking;
    private bool _disposed;

    private readonly List<RoomItem> _allRooms = new()
    {
        new("1", "Executive Boardroom A", 12, "Ruang rapat unggulan yang dirancang untuk pertemuan eksekutif tingkat tinggi. Dilengkapi konferensi video 4K dan audio terintegrasi.", "available", new() { "AC", "Proyektor", "Konferensi Video", "Papan Tulis" }, "Lantai 3", "https://images.unsplash.com/photo-1517502884422-41eaead166d4?w=400&q=80"),
        new("2", "Training Room B", 30, "Ruang pelatihan kapasitas besar dengan konfigurasi fleksibel dan layar ganda.", "available", new() { "AC", "Proyektor", "Papan Tulis", "Sistem Audio" }, "Lantai 2", "https://images.unsplash.com/photo-1572025442646-866d16c84a54?w=400&q=80"),
        new("3", "Huddle Space C", 6, "Ruang kolaborasi kecil yang nyaman untuk diskusi tim cepat.", "available", new() { "AC", "Papan Tulis" }, "Lantai 1", "https://images.unsplash.com/photo-1556761175-5973dc0f32b7?w=400&q=80"),
        new("4", "Studio Webinar", 15, "Ruang siaran langsung dan rekaman dengan pencahayaan profesional.", "booked", new() { "AC", "Konferensi Video", "Proyektor" }, "Lantai 4", "https://images.unsplash.com/photo-1600508774634-4e11d34730e2?w=400&q=80"),
        new("5", "Focus Room Alpha", 4, "Ruang sunyi untuk kerja konsentrasi tinggi atau sesi 1-on-1.", "available", new() { "AC" }, "Lantai 1", "https://images.unsplash.com/photo-1497366216548-37526070297c?w=400&q=80"),
        new("6", "Meeting Room Prime", 8, "Ruang rapat standar dengan peralatan presentasi lengkap.", "available", new() { "AC", "Proyektor", "Aksesibilitas" }, "Lantai 2", "https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=400&q=80")
    };

    private List<RoomItem> _filteredRooms = new();
    private System.Timers.Timer? _debounceTimer;

    protected override void OnInitialized()
    {
        _filteredRooms = _allRooms.ToList();
        LoadingState.OnChange += SafeStateHasChanged;
        
        _debounceTimer = new System.Timers.Timer(350);
        _debounceTimer.AutoReset = false;
        _debounceTimer.Elapsed += (sender, args) =>
        {
            if (_disposed) return;
            try
            {
                InvokeAsync(() =>
                {
                    if (!_disposed)
                    {
                        ApplyFilter();
                        StateHasChanged();
                    }
                });
            }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        };
    }

    private void SafeStateHasChanged()
    {
        if (_disposed) return;
        try
        {
            InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        _debounceTimer?.Stop();
        _debounceTimer?.Start();
    }

    private void ApplyFilter()
    {
        _filteredRooms = _allRooms.Where(room =>
        {
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.ToLower();
                if (!room.Name.ToLower().Contains(q) && !room.Floor.ToLower().Contains(q))
                    return false;
            }

            if (_filterCapacity.HasValue && _filterCapacity > 0 && room.Capacity < _filterCapacity.Value)
                return false;

            return true;
        }).ToList();
    }

    private void ViewDetail(RoomItem room)
    {
        _selectedRoomForDetail = room;
        _isRoomDetailVisible = true;
    }

    private void CloseDetail()
    {
        _isRoomDetailVisible = false;
        _selectedRoomForDetail = null;
    }

    private void ProceedToBook(RoomItem room)
    {
        CloseDetail();
        _selectedRoomForBooking = room;
        _isConfirmBookingVisible = true;
    }

    private void CloseConfirm()
    {
        _isConfirmBookingVisible = false;
        _selectedRoomForBooking = null;
    }

    public void Dispose()
    {
        _disposed = true;
        LoadingState.OnChange -= SafeStateHasChanged;
        _debounceTimer?.Dispose();
    }
}
