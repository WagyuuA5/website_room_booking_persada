@page "/bookings"
@using booking_room.Components.Models
@inject NavigationManager Navigation
@inject booking_room.Services.LoadingStateService LoadingState
@implements IDisposable

<PageTitle>Pemesanan Ruangan — Persada Room</PageTitle>

<div class="bookings-page-header">
    <h1>Cari Ruangan</h1>
    <p>Pilih ketersediaan, kapasitas, dan fasilitas untuk menemukan ruangan yang tepat sesuai kebutuhan Anda.</p>
</div>

<!-- Panel Pencarian -->
<div class="search-panel">
    <p class="search-panel-label">CARI RUANGAN</p>
    <div class="search-bar-wrapper">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.134 17 3 13.866 3 10C3 6.134 6.134 3 10 3C13.866 3 17 6.134 17 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <input type="text" class="search-bar-input" placeholder="Cari berdasarkan nama ruangan, gedung, atau lantai..."
               value="@_searchQuery" @oninput="OnSearchInput" />
    </div>
    <div class="filter-row">
        <div class="filter-group">
            <label>Tanggal</label>
            <input type="date" class="filter-input" @bind="_filterDate" />
        </div>
        <div class="filter-group">
            <label>Waktu Mulai</label>
            <input type="time" class="filter-input" @bind="_filterTime" />
        </div>
        <div class="filter-group">
            <label>Durasi</label>
            <select class="filter-select" @bind="_filterDuration">
                <option value="">Semua Durasi</option>
                <option value="0.5">30 Menit</option>
                <option value="1">1 Jam</option>
                <option value="2">2 Jam</option>
                <option value="3">3 Jam</option>
                <option value="4">4 Jam</option>
                <option value="5">5 Jam</option>
                <option value="6">6 Jam</option>
                <option value="7">7 Jam</option>
                <option value="8">8 Jam</option>
                <option value="9">9 Jam</option>
                <option value="10">10 Jam</option>
                <option value="11">11 Jam</option>
                <option value="12">12 Jam</option>
                <option value="13">13 Jam</option>
                <option value="14">14 Jam</option>
                <option value="15">15 Jam</option>
                <option value="sehari">Seharian</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Jumlah Peserta</label>
            <input type="number" class="filter-input" placeholder="Min. peserta" min="1" @bind="_filterCapacity" />
        </div>
    </div>
    <div class="amenities-row">
        @foreach (var amenity in _allAmenities)
        {
            <label class="amenity-checkbox">
                <input type="checkbox" checked="@_selectedAmenities.Contains(amenity)"
                       @onchange="e => ToggleAmenity(amenity, (bool)(e.Value ?? false))" />
                @amenity
            </label>
        }
    </div>
</div>

<!-- Grid Hasil -->
@if (LoadingState.IsLoading)
{
    <div class="skeleton-grid">
        @for (int i = 0; i < 3; i++)
        {
            <div class="skeleton-card">
                <div class="skeleton-shimmer skeleton-image"></div>
                <div class="skeleton-shimmer skeleton-title"></div>
                <div class="skeleton-shimmer skeleton-text"></div>
                <div class="skeleton-shimmer skeleton-text short"></div>
            </div>
        }
    </div>
}
else
{
    <div class="room-results-grid">
        @if (!_filteredRooms.Any())
        {
            <div class="no-results">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none"><path d="M10 10L14 14M14 10L10 14M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.134 17 3 13.866 3 10C3 6.134 6.134 3 10 3C13.866 3 17 6.134 17 10Z" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <p style="font-weight: 700; color: #64748b; margin-bottom: 0.25rem;">Ruangan Tidak Ditemukan</p>
                <p style="font-size: 0.8rem; color: #94a3b8;">Coba ubah filter atau kata kunci pencarian Anda.</p>
            </div>
        }
        else
        {
            @foreach (var room in _filteredRooms)
            {
                var cardClass = room.Status switch
                {
                    "available" => "status-available",
                    "booked" => "status-booked",
                    _ => "status-unavailable"
                };
                var badgeClass = room.Status switch
                {
                    "available" => "status-available",
                    "booked" => "status-booked",
                    _ => "status-unavailable"
                };
                var dotClass = room.Status switch
                {
                    "available" => "available",
                    "booked" => "booked",
                    _ => "unavailable"
                };
                var statusLabel = room.Status switch
                {
                    "available" => "Tersedia",
                    "booked" => "Dipesan (2 Jam Ke Depan)",
                    _ => "Tidak Tersedia"
                };

                <div class="room-result-card @cardClass">
                    <div class="room-card-photo" @onclick="() => ViewDetail(room)" style="cursor:pointer;">
                        <svg width="40" height="40" viewBox="0 0 18 18" fill="none"><path d="M0 18V16H2V0H12V1H16V16H18V18H14V3H12V18H0ZM4 2V16V2ZM8 10C8.28 10 8.52 9.9 8.71 9.71C8.9 9.52 9 9.28 9 9C9 8.72 8.9 8.48 8.71 8.29C8.52 8.1 8.28 8 8 8C7.72 8 7.48 8.1 7.29 8.29C7.1 8.48 7 8.72 7 9C7 9.28 7.1 9.52 7.29 9.71C7.48 9.9 7.72 10 8 10ZM4 16H10V2H4V16Z" fill="#93c5fd"/></svg>
                        <div class="room-card-status-badge @badgeClass">
                            <span class="status-dot @dotClass"></span>
                            @statusLabel
                        </div>
                    </div>
                    <div class="room-card-body">
                        <div class="room-card-name-row">
                            <div class="room-card-name">@room.Name</div>
                            <div class="room-card-capacity">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M16 11C17.66 11 18.99 9.66 18.99 8C18.99 6.34 17.66 5 16 5C14.34 5 13 6.34 13 8C13 9.66 14.34 11 16 11ZM8 11C9.66 11 10.99 9.66 10.99 8C10.99 6.34 9.66 5 8 5C6.34 5 5 6.34 5 8C5 9.66 6.34 11 8 11ZM8 13C5.67 13 1 14.17 1 16.5V19H15V16.5C15 14.17 10.33 13 8 13ZM16 13C15.71 13 15.38 13.02 15.03 13.05C16.19 13.89 17 15.02 17 16.5V19H23V16.5C23 14.17 18.33 13 16 13Z" fill="currentColor"/></svg>
                                @room.Capacity
                            </div>
                        </div>
                        <p class="room-card-desc">@room.Description</p>
                        <div class="room-card-amenities">
                            @foreach (var tag in room.Amenities.Take(4))
                            {
                                <span class="amenity-tag">@tag</span>
                            }
                        </div>
                    </div>
                    <div class="room-card-footer">
                        <button class="room-detail-btn" @onclick="() => ViewDetail(room)">Lihat Detail Ruangan</button>
                    </div>
                </div>
            }
        }
    </div>
}

<booking_room.Components.Shared.ModalOverlayBlur Visible="@_isRoomDetailVisible" OnClose="CloseDetail" Size="lg">
    <booking_room.Components.Shared.RoomDetailsModal 
        Room="@_selectedRoomForDetail" 
        OnClose="CloseDetail" 
        OnBookNow="ProceedToBook" />
</booking_room.Components.Shared.ModalOverlayBlur>

<booking_room.Components.Shared.ModalOverlayBlur Visible="@_isConfirmBookingVisible" OnClose="CloseConfirm" Size="lg" ShowCloseButton="false">
    <booking_room.Components.Shared.ConfirmBookingModal 
        InitialRoom="@_selectedRoomForBooking" 
        OnClose="CloseConfirm" />
</booking_room.Components.Shared.ModalOverlayBlur>

@code {
    private string _searchQuery = string.Empty;
    private DateTime? _filterDate;
    private TimeOnly? _filterTime;
    private string _filterDuration = "";
    private int? _filterCapacity;
    private HashSet<string> _selectedAmenities = new();
    
    private bool _isRoomDetailVisible = false;
    private RoomItem? _selectedRoomForDetail;

    private bool _isConfirmBookingVisible = false;
    private RoomItem? _selectedRoomForBooking;

    private readonly string[] _allAmenities = { "Pendingin Ruangan", "Proyektor", "Papan Tulis", "Konferensi Video", "Aksesibilitas" };

    private List<RoomItem> _allRooms = new()
    {
        new("1", "Executive Boardroom A", 12, "Ruang rapat eksekutif premium dengan panorama kota dan sistem konferensi video terintegrasi.", "available", new() { "Pendingin Ruangan", "Proyektor", "Konferensi Video", "Papan Tulis" }, "Lantai 3"),
        new("2", "Training Room B", 30, "Ruang pelatihan kapasitas besar dengan konfigurasi fleksibel dan layar ganda.", "booked", new() { "Pendingin Ruangan", "Proyektor", "Papan Tulis" }, "Lantai 2"),
        new("3", "Huddle Space C", 6, "Ruang kolaborasi kecil yang nyaman untuk diskusi tim cepat.", "available", new() { "Pendingin Ruangan", "Papan Tulis" }, "Lantai 1"),
        new("4", "Studio Webinar", 15, "Ruang siaran langsung dan rekaman dengan pencahayaan profesional.", "unavailable", new() { "Pendingin Ruangan", "Konferensi Video", "Proyektor" }, "Lantai 4"),
        new("5", "Focus Room Alpha", 4, "Ruang sunyi untuk kerja konsentrasi tinggi atau sesi 1-on-1.", "available", new() { "Pendingin Ruangan" }, "Lantai 1"),
        new("6", "Meeting Room Prime", 8, "Ruang rapat standar dengan peralatan presentasi lengkap.", "booked", new() { "Pendingin Ruangan", "Proyektor", "Aksesibilitas" }, "Lantai 2"),
    };

    private List<RoomItem> _filteredRooms = new();

    protected override void OnInitialized()
    {
        _filteredRooms = _allRooms.ToList();
        LoadingState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        LoadingState.OnChange -= StateHasChanged;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        _filteredRooms = _allRooms.Where(room =>
        {
            // Filter teks (nama, floor)
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.ToLower();
                if (!room.Name.ToLower().Contains(q) && !room.Floor.ToLower().Contains(q))
                    return false;
            }

            // Filter kapasitas
            if (_filterCapacity.HasValue && _filterCapacity > 0 && room.Capacity < _filterCapacity.Value)
                return false;

            // Filter fasilitas (semua fasilitas yang dipilih harus ada)
            if (_selectedAmenities.Any())
            {
                if (!_selectedAmenities.All(a => room.Amenities.Contains(a)))
                    return false;
            }

            return true;
        }).ToList();
    }

    private void ToggleAmenity(string amenity, bool isChecked)
    {
        if (isChecked) _selectedAmenities.Add(amenity);
        else _selectedAmenities.Remove(amenity);
        ApplyFilter();
    }

    private void ViewDetail(RoomItem room)
    {
        _selectedRoomForDetail = room;
        _isRoomDetailVisible = true;
    }

    private void CloseDetail()
    {
        _isRoomDetailVisible = false;
        _selectedRoomForDetail = null;
    }

    private void ProceedToBook(RoomItem room)
    {
        CloseDetail();
        _selectedRoomForBooking = room;
        _isConfirmBookingVisible = true;
    }

    private void CloseConfirm()
    {
        _isConfirmBookingVisible = false;
        _selectedRoomForBooking = null;
    }

    private void BookRoom(RoomItem room)
    {
        if (room.Status == "available")
        {
            _selectedRoomForBooking = room;
            _isConfirmBookingVisible = true;
        }
    }
}

