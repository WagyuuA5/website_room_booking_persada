@code {
    private string _activeTab = "password";
    private bool _disposed = false;
    private CancellationTokenSource? _cts;

    // Form inputs
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _isSaving = false;

    // Preferences
    private bool _is2FaEnabled = false;
    private bool _notifEmailBooking = true;
    private bool _notifEmailReminder = true;
    private bool _notifAppFacility = true;
    private bool _notifAppUrgent = true;
    private string _currentTheme = "light";
    private string _selectedLanguage = "id";
    private string _selectedTimezone = "WIB";
    private bool _googleCalendarSync = true;
    private bool _outlookCalendarSync = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("localStorage.getItem", "theme");
                if (!string.IsNullOrEmpty(theme))
                {
                    _currentTheme = theme;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
    }

    private async Task Toggle2FA(ChangeEventArgs e)
    {
        _is2FaEnabled = (bool)(e.Value ?? false);
        if (_is2FaEnabled)
        {
            ToastService.Success("2FA Diaktifkan", "Autentikasi dua langkah kini aktif pada akun Anda.");
        }
        else
        {
            ToastService.Warning("2FA Dinonaktifkan", "Perlindungan dua langkah telah dimatikan.");
        }
    }

    private async Task ChangeTheme(string theme)
    {
        _currentTheme = theme;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "theme", theme);
            if (theme == "dark")
            {
                await JS.InvokeVoidAsync("document.body.classList.add", "dark-mode");
                await JS.InvokeVoidAsync("document.documentElement.setAttribute", "data-theme", "dark");
            }
            else if (theme == "light")
            {
                await JS.InvokeVoidAsync("document.body.classList.remove", "dark-mode");
                await JS.InvokeVoidAsync("document.documentElement.setAttribute", "data-theme", "light");
            }
            else // system
            {
                await JS.InvokeVoidAsync("document.body.classList.remove", "dark-mode");
                await JS.InvokeVoidAsync("document.documentElement.removeAttribute", "data-theme");
            }
            ToastService.Info("Tema Diperbarui", $"Mode tampilan berhasil diubah ke {theme}.");
        }
        catch { }
    }

    private async Task SavePassword()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            ToastService.Warning("Validasi Gagal", "Kata sandi saat ini wajib diisi.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 6)
        {
            ToastService.Warning("Validasi Gagal", "Kata sandi baru minimal 6 karakter.");
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            ToastService.Error("Validasi Gagal", "Konfirmasi kata sandi tidak cocok.");
            return;
        }

        _isSaving = true;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();

        try
        {
            await Task.Delay(800, _cts.Token);
            if (_disposed) return;
            _currentPassword = "";
            _newPassword = "";
            _confirmPassword = "";
            _isSaving = false;
            ToastService.Success("Berhasil", "Kata sandi akun Anda telah berhasil diperbarui.");
        }
        catch (TaskCanceledException) { }
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}

