@page "/settings"
@page "/pengaturan"
@using booking_room.Components.Shared
@using booking_room.Services
@inject IJSRuntime JS
@inject IToastService ToastService
@implements IDisposable

<PageTitle>Pengaturan — Persada Room Booking</PageTitle>

<div class="content-fade-in settings-container">
    <!-- Page Header -->
    <div class="settings-page-header">
        <div class="settings-title-group">
            <h1 class="settings-main-title">Pengaturan</h1>
            <p class="settings-main-subtitle">Kelola preferensi akun, keamanan personal, dan integrasi jadwal Anda.</p>
        </div>
    </div>

    <!-- Main Two-Column Layout -->
    <div class="settings-grid-layout">
        <!-- Kolom Kiri: Sidebar Kategori Pengaturan -->
        <aside class="settings-nav-card">
            <!-- Kategori 1: KEAMANAN -->
            <div class="nav-category-group">
                <div class="nav-category-label">KEAMANAN</div>
                <div class="nav-category-list">
                    <button type="button" class="settings-nav-btn @(activeTab == "ubah-password" ? "active" : "")" @onclick='() => SelectTab("ubah-password")'>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <span>Ubah Kata Sandi</span>
                    </button>

                    <button type="button" class="settings-nav-btn @(activeTab == "verifikasi-2fa" ? "active" : "")" @onclick='() => SelectTab("verifikasi-2fa")'>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            <polyline points="9 12 11 14 15 10"></polyline>
                        </svg>
                        <span>PIN / Verifikasi 2 Langkah</span>
                    </button>

                    <button type="button" class="settings-nav-btn @(activeTab == "sesi-perangkat" ? "active" : "")" @onclick='() => SelectTab("sesi-perangkat")'>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                        <span>Sesi & Perangkat Aktif</span>
                    </button>
                </div>
            </div>

            <div class="nav-category-divider"></div>

            <!-- Kategori 2: PREFERENSI -->
            <div class="nav-category-group">
                <div class="nav-category-label">PREFERENSI</div>
                <div class="nav-category-list">
                    <button type="button" class="settings-nav-btn @(activeTab == "notifikasi" ? "active" : "")" @onclick='() => SelectTab("notifikasi")'>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <span>Notifikasi</span>
                    </button>

                    <button type="button" class="settings-nav-btn @(activeTab == "bahasa-zonawaktu" ? "active" : "")" @onclick='() => SelectTab("bahasa-zonawaktu")'>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                        <span>Bahasa & Zona Waktu</span>
                    </button>

                    <button type="button" class="settings-nav-btn @(activeTab == "integrasi" ? "active" : "")" @onclick='() => SelectTab("integrasi")'>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>Integrasi Kalender & Email</span>
                    </button>
                </div>
            </div>
        </aside>

        <!-- Kolom Kanan: Panel Konten Pengaturan -->
        <main class="settings-content-card">
            @if (_isLoadingTab)
            {
                <!-- Skeleton Transition (V46 standard) -->
                <div class="settings-skeleton-box">
                    <div class="skeleton-line skeleton-title"></div>
                    <div class="skeleton-line skeleton-sub"></div>
                    <div class="skeleton-card-block"></div>
                    <div class="skeleton-card-block"></div>
                    <div class="skeleton-card-block"></div>
                </div>
            }
            else
            {
                @switch (activeTab)
                {
                    case "notifikasi":
                        <!-- 1. NOTIFIKASI (Default) -->
                        <div class="content-panel-fade">
                            <div class="panel-header-row">
                                <div>
                                    <h2 class="panel-title">Pengaturan Notifikasi</h2>
                                    <p class="panel-subtitle">Tentukan peristiwa penting apa saja yang ingin Anda terima pemberitahuannya.</p>
                                </div>
                                <span class="badge-accent-user">Preferensi Personal</span>
                            </div>

                            <div class="settings-items-list">
                                <!-- 1. Konfirmasi Pemesanan -->
                                <div class="toggle-card">
                                    <div class="toggle-info">
                                        <div class="toggle-name">Konfirmasi Pemesanan</div>
                                        <div class="toggle-desc">Kirim pemberitahuan instan saat pengajuan reservasi ruangan Anda telah disetujui atau dikonfirmasi.</div>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="_notifBookingConfirmation" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <!-- 2. Pengingat Jadwal H-1 -->
                                <div class="toggle-card">
                                    <div class="toggle-info">
                                        <div class="toggle-name">Pengingat Jadwal H-1</div>
                                        <div class="toggle-desc">Peringatan otomatis 24 jam sebelum waktu penggunaan ruangan agar agenda rapat Anda tetap terorganisir.</div>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="_notifReminderH1" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <!-- 3. Pembatalan & Penolakan -->
                                <div class="toggle-card">
                                    <div class="toggle-info">
                                        <div class="toggle-name">Pembatalan & Penolakan</div>
                                        <div class="toggle-desc">Pemberitahuan cepat jika jadwal dibatalkan atau pengajuan pemesanan ditolak oleh pengelola gedung.</div>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="_notifCancellation" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <!-- 4. Pembatalan Terlambat / Tidak Hadir -->
                                <div class="toggle-card">
                                    <div class="toggle-info">
                                        <div class="toggle-name">Pembatalan Terlambat / Tidak Hadir</div>
                                        <div class="toggle-desc">Peringatan sistem jika Anda belum melakukan konfirmasi kehadiran setelah 15 menit waktu rapat berjalan (Auto-release SOP).</div>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="_notifNoShowLate" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <!-- 5. Notifikasi Dalam Aplikasi -->
                                <div class="toggle-card">
                                    <div class="toggle-info">
                                        <div class="toggle-name">Notifikasi Dalam Aplikasi</div>
                                        <div class="toggle-desc">Tampilkan tanda lonceng notifikasi dan popup peringatan langsung di dalam antarmuka sistem web.</div>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="_notifInApp" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                            </div>

                            <div class="panel-action-footer">
                                <button type="button" class="btn-save-user" @onclick="SaveNotificationSettings">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span>Simpan Pengaturan Notifikasi</span>
                                </button>
                            </div>
                        </div>
                        break;

                    case "ubah-password":
                        <!-- 2. UBAH KATA SANDI -->
                        <div class="content-panel-fade">
                            <div class="panel-header-row">
                                <div>
                                    <h2 class="panel-title">Ubah Kata Sandi</h2>
                                    <p class="panel-subtitle">Perbarui kata sandi Anda secara teratur untuk menjaga keamanan akun dan reservasi.</p>
                                </div>
                            </div>

                            <div class="form-container-card">
                                <div class="form-group-field">
                                    <label>Kata Sandi Saat Ini <span class="text-danger">*</span></label>
                                    <input type="password" @bind="_oldPassword" class="user-input-control" placeholder="Masukkan kata sandi lama Anda" />
                                </div>

                                <div class="form-group-field">
                                    <label>Kata Sandi Baru <span class="text-danger">*</span></label>
                                    <input type="password" @bind="_newPassword" class="user-input-control" placeholder="Minimal 8 karakter kombinasi huruf dan angka" />
                                </div>

                                <div class="form-group-field">
                                    <label>Konfirmasi Kata Sandi Baru <span class="text-danger">*</span></label>
                                    <input type="password" @bind="_confirmPassword" class="user-input-control" placeholder="Ketik ulang kata sandi baru" />
                                </div>

                                <div class="password-guideline-box">
                                    <div class="guideline-header">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <line x1="12" y1="16" x2="12" y2="12"></line>
                                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                        </svg>
                                        <span>Ketentuan Keamanan Sandi:</span>
                                    </div>
                                    <ul class="guideline-list">
                                        <li>Minimal 8 karakter.</li>
                                        <li>Gunakan campuran huruf kapital, huruf kecil, dan angka.</li>
                                        <li>Hindari menggunakan tanggal lahir atau nama yang mudah ditebak.</li>
                                    </ul>
                                </div>
                            </div>

                            <div class="panel-action-footer">
                                <button type="button" class="btn-save-user" @onclick="SavePasswordSettings">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span>Simpan Kata Sandi Baru</span>
                                </button>
                            </div>
                        </div>
                        break;

                    case "verifikasi-2fa":
                        <!-- 3. PIN / VERIFIKASI 2 LANGKAH -->
                        <div class="content-panel-fade">
                            <div class="panel-header-row">
                                <div>
                                    <h2 class="panel-title">PIN / Verifikasi 2 Langkah</h2>
                                    <p class="panel-subtitle">Tambahkan perlindungan ekstra saat melakukan pemesanan ruangan penting.</p>
                                </div>
                            </div>

                            <div class="settings-items-list">
                                <div class="toggle-card">
                                    <div class="toggle-info">
                                        <div class="toggle-name">Autentikasi Dua Faktor (2FA)</div>
                                        <div class="toggle-desc">Wajibkan kode verifikasi setiap kali masuk dari perangkat atau peramban yang belum dikenali.</div>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="_is2faActive" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <div class="toggle-card">
                                    <div class="toggle-info">
                                        <div class="toggle-name">PIN Reservasi Cepat</div>
                                        <div class="toggle-desc">Konfirmasi reservasi ruangan eksekutif menggunakan 6-digit PIN keamanan pribadi tanpa login berulang.</div>
                                    </div>
                                    <button type="button" class="btn-outline-pill-sm" @onclick='() => ToastService.Info("Konfigurasi PIN", "Form konfigurasi PIN 6-digit siap digunakan.")'>
                                        Atur PIN
                                    </button>
                                </div>

                                <div class="toggle-card">
                                    <div class="toggle-info">
                                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 2px;">
                                            <span class="toggle-name" style="margin: 0;">Kode Verifikasi via Email</span>
                                            <span class="badge-email-verified">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                Terverifikasi
                                            </span>
                                        </div>
                                        <div class="toggle-desc">whyuravi.2008@gmail.com • Menerima kode verifikasi login darurat saat autentikasi utama tidak tersedia.</div>
                                    </div>
                                    <span class="badge-status-pill-active">Aktif</span>
                                </div>
                            </div>

                            <div class="panel-action-footer">
                                <button type="button" class="btn-save-user" @onclick='() => ToastService.Success("Keamanan Diperbarui", "Pengaturan autentikasi 2 langkah berhasil disimpan.")'>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span>Simpan Pengaturan Keamanan</span>
                                </button>
                            </div>
                        </div>
                        break;

                    case "sesi-perangkat":
                        <!-- 4. SESI & PERANGKAT AKTIF -->
                        <div class="content-panel-fade">
                            <div class="panel-header-row">
                                <div>
                                    <h2 class="panel-title">Sesi & Perangkat Aktif</h2>
                                    <p class="panel-subtitle">Daftar perangkat yang saat ini memiliki akses aktif ke akun pemesanan ruangan Anda.</p>
                                </div>
                            </div>

                            <div class="devices-list">
                                @foreach (var dev in _devices)
                                {
                                    <div class="device-item @(dev.IsCurrent ? "current" : "") @(dev.IsRemoving ? "removing" : "")">
                                        <div class="device-icon-box">
                                            @if (dev.IconType == "mobile")
                                            {
                                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                                                    <line x1="12" y1="18" x2="12.01" y2="18"></line>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                                                    <line x1="8" y1="21" x2="16" y2="21"></line>
                                                    <line x1="12" y1="17" x2="12" y2="21"></line>
                                                </svg>
                                            }
                                        </div>
                                        <div class="device-details">
                                            <div class="device-name-row">
                                                <span class="device-name">@dev.Name</span>
                                                @if (dev.IsCurrent)
                                                {
                                                    <span class="badge-this-device">Perangkat Ini</span>
                                                }
                                            </div>
                                            <div class="device-meta">@dev.Meta</div>
                                        </div>
                                        @if (!dev.IsCurrent)
                                        {
                                            <button type="button" class="btn-logout-device" @onclick="() => LogoutDevice(dev)" disabled="@dev.IsRemoving">
                                                Logout
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="panel-action-footer">
                                <button type="button" class="btn-danger-outline" @onclick="LogoutAllOtherDevices">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                        <polyline points="16 17 21 12 16 7"></polyline>
                                        <line x1="21" y1="12" x2="9" y2="12"></line>
                                    </svg>
                                    <span>Keluar Dari Semua Sesi Lain</span>
                                </button>
                            </div>
                        </div>
                        break;

                    case "bahasa-zonawaktu":
                        <!-- 5. BAHASA & ZONA WAKTU -->
                        <div class="content-panel-fade">
                            <div class="panel-header-row">
                                <div>
                                    <h2 class="panel-title">Bahasa & Zona Waktu</h2>
                                    <p class="panel-subtitle">Sesuaikan bahasa sistem dan pengaturan zona waktu untuk agenda reservasi ruangan Anda.</p>
                                </div>
                            </div>

                            <div class="form-container-card">
                                <div class="form-group-field">
                                    <label>Bahasa Tampilan</label>
                                    <select class="user-input-control" @bind="_selectedLanguage">
                                        <option value="id">Bahasa Indonesia (ID)</option>
                                        <option value="en">English (US)</option>
                                    </select>
                                </div>

                                <div class="form-group-field">
                                    <label>Zona Waktu Kerja</label>
                                    <select class="user-input-control" @bind="_selectedTimezone">
                                        <option value="WIB">Waktu Indonesia Barat (WIB) — UTC+07:00 (Jakarta, Medan, Surabaya)</option>
                                        <option value="WITA">Waktu Indonesia Tengah (WITA) — UTC+08:00 (Denpasar, Makassar)</option>
                                        <option value="WIT">Waktu Indonesia Timur (WIT) — UTC+09:00 (Jayapura, Ambon)</option>
                                    </select>
                                </div>

                                <div class="form-group-field">
                                    <label>Format Waktu Tampilan</label>
                                    <div class="radio-pill-group">
                                        <label class="radio-pill-label @(_timeFormat == "24" ? "selected" : "")">
                                            <input type="radio" name="timeformat" value="24" checked="@(_timeFormat == "24")" @onchange='() => _timeFormat = "24"' />
                                            <span>24 Jam (mis. 14:00 WIB)</span>
                                        </label>
                                        <label class="radio-pill-label @(_timeFormat == "12" ? "selected" : "")">
                                            <input type="radio" name="timeformat" value="12" checked="@(_timeFormat == "12")" @onchange='() => _timeFormat = "12"' />
                                            <span>12 Jam (mis. 02:00 PM)</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="panel-action-footer">
                                <button type="button" class="btn-save-user" @onclick='() => ToastService.Success("Pengaturan Disimpan", "Preferensi bahasa dan zona waktu berhasil diperbarui.")'>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span>Simpan Pengaturan Regional</span>
                                </button>
                            </div>
                        </div>
                        break;

                    case "integrasi":
                        <!-- 6. INTEGRASI KALENDER & EMAIL (Moved from Admin to User Preference) -->
                        <div class="content-panel-fade">
                            <div class="panel-header-row">
                                <div>
                                    <h2 class="panel-title">Integrasi Kalender & Email</h2>
                                    <p class="panel-subtitle">Sinkronisasikan booking ruangan secara real-time dengan aplikasi kalender kerja pribadi Anda.</p>
                                </div>
                            </div>

                            <div class="settings-items-list">
                                <!-- Google Calendar -->
                                <div class="integration-item-card">
                                    <div class="integration-brand">
                                        <div class="integration-logo-badge google">
                                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                                                <rect x="3" y="4" width="18" height="18" rx="2" stroke="#EA4335" stroke-width="2"></rect>
                                                <line x1="16" y1="2" x2="16" y2="6" stroke="#4285F4" stroke-width="2"></line>
                                                <line x1="8" y1="2" x2="8" y2="6" stroke="#FBBC05" stroke-width="2"></line>
                                                <line x1="3" y1="10" x2="21" y2="10" stroke="#34A853" stroke-width="2"></line>
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="integration-title">Google Calendar</div>
                                            <div class="integration-desc">whyuravi.2008@gmail.com • Terhubung & Sinkron Otomatis</div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn-outline-pill-sm danger" @onclick='() => ToastService.Info("Integrasi", "Koneksi Google Calendar dikelola.")'>
                                        Putuskan
                                    </button>
                                </div>

                                <!-- Microsoft Outlook -->
                                <div class="integration-item-card">
                                    <div class="integration-brand">
                                        <div class="integration-logo-badge outlook">
                                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                                                <rect x="3" y="3" width="18" height="18" rx="3" stroke="#0078D4" stroke-width="2"></rect>
                                                <path d="M8 8h8v8H8z" fill="#0078D4"></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="integration-title">Microsoft Outlook / 365</div>
                                            <div class="integration-desc">Sinkronisasi kalender rapat dengan akun kerja Microsoft Anda.</div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn-outline-pill-sm primary" @onclick='() => ToastService.Success("Integrasi Outlook", "Mengarahkan ke otentikasi Microsoft 365.")'>
                                        Hubungkan
                                    </button>
                                </div>

                                <div class="toggle-card" style="margin-top: 6px;">
                                    <div class="toggle-info">
                                        <div class="toggle-name">Sinkronisasi Otomatis Reservasi</div>
                                        <div class="toggle-desc">Setiap pemesanan yang disetujui akan langsung ditambahkan ke jadwal kalender kerja Anda.</div>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="_autoSyncCalendar" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                            </div>

                            <div class="panel-action-footer">
                                <button type="button" class="btn-save-user" @onclick='() => ToastService.Success("Integrasi Tersimpan", "Konfigurasi sinkronisasi kalender telah diperbarui.")'>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span>Simpan Pengaturan Integrasi</span>
                                </button>
                            </div>
                        </div>
                        break;
                }
            }
        </main>
    </div>
</div>

<style>
    .settings-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px;
        display: flex;
        flex-direction: column;
