@code {
    // Default active item per specification: "notifikasi"
    private string activeTab = "notifikasi";
    private bool _isLoadingTab = false;
    private bool _disposed;

    // Notification Toggles
    private bool _notifBookingConfirmation = true;
    private bool _notifReminderH1 = true;
    private bool _notifCancellation = true;
    private bool _notifNoShowLate = true;
    private bool _notifInApp = true;

    // Password Form
    private string _oldPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";

    // 2FA & PIN
    private bool _is2faActive = true;

    // Language & Timezone
    private string _selectedLanguage = "id";
    private string _selectedTimezone = "WIB";
    private string _timeFormat = "24";

    // Calendar Integration
    private bool _autoSyncCalendar = true;

    private async Task SelectTab(string tabKey)
    {
        if (activeTab == tabKey) return;
        
        _isLoadingTab = true;
        activeTab = tabKey;
        StateHasChanged();

        // Skeleton transition duration (~650ms per V46 standard)
        await Task.Delay(650);
        
        if (!_disposed)
        {
            _isLoadingTab = false;
            StateHasChanged();
        }
    }

    private void SaveNotificationSettings()
    {
        ToastService.Success("Preferensi Notifikasi Disimpan", "Pengaturan saluran dan jenis notifikasi Anda berhasil diperbarui.");
    }

    private void SavePasswordSettings()
    {
        if (string.IsNullOrWhiteSpace(_oldPassword))
        {
            ToastService.Error("Gagal Memperbarui", "Kata sandi saat ini wajib diisi.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 8)
        {
            ToastService.Error("Gagal Memperbarui", "Kata sandi baru minimal 8 karakter.");
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            ToastService.Error("Gagal Memperbarui", "Konfirmasi kata sandi baru tidak sesuai.");
            return;
        }

        _oldPassword = "";
        _newPassword = "";
        _confirmPassword = "";
        ToastService.Success("Kata Sandi Diperbarui", "Kata sandi baru Anda berhasil disimpan.");
    }

    private class UserDeviceSession
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Meta { get; set; } = "";
        public bool IsCurrent { get; set; }
        public string IconType { get; set; } = "desktop";
        public bool IsRemoving { get; set; }
    }

    private List<UserDeviceSession> _devices = new()
    {
        new UserDeviceSession
        {
            Id = "dev-1",
            Name = "Windows PC — Google Chrome",
            Meta = "Jakarta, Indonesia • Aktif Sekarang (IP: 182.253.xx.xx)",
            IsCurrent = true,
            IconType = "desktop"
        },
        new UserDeviceSession
        {
            Id = "dev-2",
            Name = "iPhone 14 Pro — Safari Mobile",
            Meta = "Jakarta, Indonesia • Terakhir aktif 2 jam yang lalu",
            IsCurrent = false,
            IconType = "mobile"
        },
        new UserDeviceSession
        {
            Id = "dev-3",
            Name = "MacBook Air — Mozilla Firefox",
            Meta = "Bandung, Indonesia • Terakhir aktif 3 hari yang lalu",
            IsCurrent = false,
            IconType = "desktop"
        }
    };

    private async Task LogoutDevice(UserDeviceSession dev)
    {
        if (dev.IsCurrent || dev.IsRemoving) return;
        dev.IsRemoving = true;
        StateHasChanged();
        await Task.Delay(300);
        _devices.Remove(dev);
        ToastService.Success("Sesi Dikeluarkan", $"Akses dari {dev.Name} telah dihentikan.");
        StateHasChanged();
    }

    private async Task LogoutAllOtherDevices()
    {
        var others = _devices.Where(d => !d.IsCurrent).ToList();
        if (!others.Any())
        {
            ToastService.Info("Info Sesi", "Tidak ada sesi perangkat lain yang aktif.");
            return;
        }
        foreach (var d in others)
        {
            d.IsRemoving = true;
        }
        StateHasChanged();
        await Task.Delay(300);
        _devices.RemoveAll(d => !d.IsCurrent);
        ToastService.Success("Semua Sesi Dikeluarkan", "Semua perangkat lain telah berhasil di-logout.");
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
    }
}
