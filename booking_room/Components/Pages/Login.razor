@page "/login"
@layout booking_room.Components.Layout.AuthLayout
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using System.ComponentModel.DataAnnotations

<PageTitle>Masuk — Persada Ruangan</PageTitle>

<div class="auth-container">
    <!-- Panel Kiri: Form Login -->
    <div class="auth-form-panel">
        <div class="auth-form-content">
            <div class="brand-header">
                <img src="/icons/logoo_psd-removebg-preview.svg" alt="Persada Logo" class="brand-logo" />
            </div>
            
            <h1 class="auth-title">Selamat Datang</h1>
            <p class="auth-subtitle">Silakan masuk untuk mengakses sistem manajemen pemesanan ruangan.</p>

            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert-error">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                        @errorMessage
                    </div>
                }

                <div class="form-group">
                    <label class="form-label">Alamat Email</label>
                    <div class="input-with-icon">
                        <span class="input-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                        </span>
                        <InputText @bind-Value="loginModel.Email" class="form-control-icon" placeholder="nama@perusahaan.com" />
                    </div>
                    <ValidationMessage For="@(() => loginModel.Email)" class="validation-msg" />
                </div>

                <div class="form-group">
                    <div class="d-flex justify-content-between">
                        <label class="form-label">Kata Sandi</label>
                        <a href="javascript:void(0)" class="link-forgot" @onclick="ShowForgotPassword">Lupa Sandi?</a>
                    </div>
                    <div class="input-with-icon">
                        <span class="input-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        </span>
                        @if (showPassword)
                        {
                            <InputText @bind-Value="loginModel.Password" class="form-control-icon" placeholder="••••••••" />
                        }
                        else
                        {
                            <InputText type="password" @bind-Value="loginModel.Password" class="form-control-icon" placeholder="••••••••" />
                        }
                        <button type="button" class="btn-toggle-password" @onclick="TogglePassword">
                            @if (showPassword)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            }
                        </button>
                    </div>
                    <ValidationMessage For="@(() => loginModel.Password)" class="validation-msg" />
                </div>

                <div class="form-group form-check-group">
                    <label class="custom-checkbox">
                        <InputCheckbox @bind-Value="loginModel.RememberMe" />
                        <span class="checkmark"></span>
                        Ingat perangkat ini
                    </label>
                </div>

                <button type="submit" class="btn-auth-primary">
                    Masuk
                </button>
                
                <div class="auth-divider">
                    <span>ATAU</span>
                </div>
                
                <div class="auth-register-link">
                    Belum punya akun? <a href="/register">Daftar sekarang</a>
                </div>
            </EditForm>
        </div>
        
        <div class="auth-footer">
            &copy; 2026 PT Personel Alih Daya Tbk. Sistem Manajemen Pemesanan.
        </div>
    </div>
    
    <!-- Panel Kanan: Branding Langsung di Atas Foto (Tanpa Glass Box) -->
    <div class="auth-brand-panel">
        <div class="brand-overlay"></div>
        <div class="brand-hero-content">
            <span class="brand-badge-solid">FASILITAS KORPORAT</span>
            <h2 class="brand-title">Meningkatkan Infrastruktur Perusahaan.</h2>
            <p class="brand-desc">Protokol manajemen pemesanan ruangan dan akses fasilitas yang mulus serta aman untuk lingkungan kerja modern.</p>
        </div>
        <div class="brand-logo-large-container">
            <img src="/icons/logoo_psd-removebg-preview.svg" alt="Persada" class="brand-logo-large" />
            <div class="brand-tagline">Helping Your Business Grow</div>
        </div>
    </div>
</div>

@if (showForgotModal)
{
    <div class="modal-backdrop-custom">
        <div class="modal-content-custom">
            <h3 style="margin-top:0; color:var(--persada-navy-900);">Reset Kata Sandi</h3>
            <p style="color:var(--persada-text-secondary); font-size:0.9rem; margin-bottom:1.5rem;">Masukkan alamat email Anda untuk menerima tautan reset kata sandi.</p>
            
            @if (resetSent)
            {
                <div class="alert-success-custom">Tautan reset telah dikirim ke email Anda.</div>
                <button class="btn-modal-primary" style="width:100%; margin-top:1rem;" @onclick="CloseForgotPassword">Tutup</button>
            }
            else
            {
                <div class="form-group">
                    <input type="email" @bind="forgotEmail" class="form-control-icon" style="padding-left:12px;" placeholder="nama@perusahaan.com" />
                </div>
                <div style="display:flex; gap:12px; margin-top:20px;">
                    <button class="btn-modal-outline" @onclick="CloseForgotPassword">Tutup</button>
                    <button class="btn-modal-primary" @onclick="SendResetLink">Kirim Tautan</button>
                </div>
            }
        </div>
    </div>
}

<style>
    .auth-container {
        display: flex;
        min-height: 100vh;
        width: 100%;
    }
    
    .auth-form-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background-color: var(--persada-white);
        padding: 40px;
        max-width: 500px;
        min-width: 320px;
    }
    
    .auth-form-content {
        margin: auto 0;
        width: 100%;
        max-width: 400px;
        align-self: center;
    }
    
    .brand-header {
        margin-bottom: 40px;
    }
    
    .brand-logo {
        height: 40px;
        width: auto;
    }
    
    .auth-title {
        font-size: 2rem;
        font-weight: 800;
        color: var(--persada-accent-blue);
        margin-bottom: 8px;
    }
    
    .auth-subtitle {
        color: var(--persada-text-secondary);
        font-size: 0.95rem;
        margin-bottom: 32px;
        line-height: 1.5;
    }
    
    .form-group {
        margin-bottom: 20px;
    }
    
    .form-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--persada-navy-900);
        margin-bottom: 8px;
    }
    
    .input-with-icon {
        position: relative;
        display: flex;
        align-items: center;
    }
    
    .input-icon {
        position: absolute;
        left: 14px;
        color: #9CA3AF;
        display: flex;
    }
    
    .form-control-icon {
        width: 100%;
        padding: 12px 14px 12px 40px;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.2s;
    }
    
    .form-control-icon:focus {
        outline: none;
        border-color: var(--persada-accent-blue);
        box-shadow: 0 0 0 3px rgba(31, 93, 154, 0.1);
    }
    
    .btn-toggle-password {
        position: absolute;
        right: 14px;
        background: none;
        border: none;
        color: #9CA3AF;
        cursor: pointer;
        padding: 0;
        display: flex;
    }
    
    .btn-toggle-password:hover {
        color: var(--persada-navy-900);
    }
    
    .link-forgot {
        font-size: 0.8rem;
        color: var(--persada-accent-blue);
        text-decoration: none;
        font-weight: 600;
    }
    
    .link-forgot:hover {
        text-decoration: underline;
    }
    
    .custom-checkbox {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        color: var(--persada-text-secondary);
        cursor: pointer;
    }
    
    .btn-auth-primary {
        width: 100%;
        padding: 14px;
        background: linear-gradient(135deg, #F5A623 0%, #E09010 100%);
        color: #0F172A;
        border: none;
        border-radius: 999px;
        font-weight: 700;
        font-size: 1rem;
        margin-top: 12px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 4px 14px rgba(245, 166, 35, 0.3);
    }
    
    .btn-auth-primary:hover {
        background: linear-gradient(135deg, #FFB834 0%, #F5A623 100%);
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(245, 166, 35, 0.45);
    }

    .btn-auth-primary:active {
        transform: translateY(0);
    }
    
    .auth-divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 24px 0;
    }
    
    .auth-divider::before,
    .auth-divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #E5E7EB;
    }
    
    .auth-divider span {
        padding: 0 16px;
        color: #9CA3AF;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.5px;
    }
    
    .auth-register-link {
        text-align: center;
        font-size: 0.9rem;
        color: var(--persada-text-secondary);
    }
    
    .auth-register-link a {
        color: var(--persada-accent-blue);
        font-weight: 600;
        text-decoration: none;
    }
    
    .auth-register-link a:hover {
        text-decoration: underline;
    }
    
    .auth-footer {
        text-align: center;
        font-size: 0.75rem;
        color: #9CA3AF;
        margin-top: 40px;
    }
    
    /* Panel Kanan: Hero Text Langsung di Atas Foto (Tanpa Glass Box) */
    .auth-brand-panel {
        flex: 1.2;
        background-image: url('/images/poto 3.png');
        background-size: cover;
        background-position: center;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 56px 60px;
        overflow: hidden;
    }
    
    .brand-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            135deg, 
            rgba(10, 15, 29, 0.45) 0%, 
            rgba(10, 15, 29, 0.82) 100%
        );
        pointer-events: none;
    }
    
    .brand-hero-content {
        position: relative;
        z-index: 2;
        color: white;
        max-width: 520px;
    }
    
    .brand-badge-solid {
        display: inline-block;
        background: #F5A623;
        color: #0F172A;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1.2px;
        margin-bottom: 24px;
        text-transform: uppercase;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }
    
    .brand-title {
        font-size: 2.8rem;
        font-weight: 800;
        line-height: 1.18;
        margin-bottom: 18px;
        letter-spacing: -0.025em;
        text-shadow: 0 2px 14px rgba(0, 0, 0, 0.65);
    }
    
    .brand-desc {
        font-size: 1.1rem;
        line-height: 1.65;
        color: rgba(255, 255, 255, 0.9);
        margin: 0;
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
    }
    
    .brand-logo-large-container {
        position: relative;
        z-index: 2;
        align-self: flex-end;
        text-align: right;
    }
    
    .brand-logo-large {
        height: 52px;
        width: auto;
        margin-bottom: 4px;
        filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.5));
    }
    
    .brand-tagline {
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.8px;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    }

    .alert-error {
        background-color: #FEF2F2;
        border-left: 4px solid #EF4444;
        color: #991B1B;
        padding: 12px 16px;
        border-radius: 6px;
        font-size: 0.85rem;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .validation-msg {
        color: #EF4444;
        font-size: 0.75rem;
        margin-top: 4px;
        display: block;
    }

    .modal-backdrop-custom {
        position: fixed;
        inset: 0;
        background: rgba(15, 31, 61, 0.5);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }
    
    .modal-content-custom {
        background: white;
        padding: 24px;
        border-radius: 16px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    }
    
    .alert-success-custom {
        background-color: #F0FDF4;
        color: #166534;
        padding: 12px;
        border-radius: 8px;
        font-size: 0.9rem;
        text-align: center;
    }

    @@media (max-width: 992px) {
        .auth-brand-panel {
            display: none;
        }
        .auth-form-panel {
            max-width: 100%;
            padding: 24px;
        }
        .auth-form-content {
            margin: 0 auto;
        }
    }
</style>

@code {
    private LoginModel loginModel = new();
    private bool showPassword = false;
    private string errorMessage = "";
    
    private bool showForgotModal = false;
    private string forgotEmail = "";
    private bool resetSent = false;

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLogin()
    {
        errorMessage = "";
        
        // Simulating validation / auth process
        if (loginModel.Email.Contains("admin", StringComparison.OrdinalIgnoreCase))
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "isLoggedIn", "true");
            await JS.InvokeVoidAsync("localStorage.setItem", "userRole", "Admin");
            await JS.InvokeVoidAsync("localStorage.setItem", "playSplitAnimation", "true");
            Navigation.NavigateTo("/dashboard");
        }
        else if (loginModel.Password == "password123" || loginModel.Password.Length > 0)
        {
            // For now, accept any non-empty password as success for demo purposes (User role)
            await JS.InvokeVoidAsync("localStorage.setItem", "isLoggedIn", "true");
            await JS.InvokeVoidAsync("localStorage.setItem", "userRole", "User");
            await JS.InvokeVoidAsync("localStorage.setItem", "playSplitAnimation", "true");
            Navigation.NavigateTo("/beranda");
        }
        else
        {
            errorMessage = "Email atau kata sandi salah.";
        }
    }
    
    private void ShowForgotPassword()
    {
        showForgotModal = true;
        resetSent = false;
        forgotEmail = loginModel.Email;
    }
    
    private void CloseForgotPassword()
    {
        showForgotModal = false;
    }
    
    private void SendResetLink()
    {
        if (!string.IsNullOrWhiteSpace(forgotEmail) && forgotEmail.Contains("@"))
        {
            resetSent = true;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Alamat email wajib diisi.")]
        [EmailAddress(ErrorMessage = "Format email tidak valid.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Kata sandi wajib diisi.")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
