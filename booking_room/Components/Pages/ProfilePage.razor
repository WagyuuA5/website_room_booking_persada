@page "/profil"
@using booking_room.Components.Models

<PageTitle>Profil Saya - PADA Management</PageTitle>

<div class="profile-page-modern">
    <div class="profile-card-center">
        <!-- Top Indicator -->
        <div class="profile-pill-label">Profil</div>
        <p class="profile-sub-label">Data identitas @UserProfile.Name</p>
        
        <hr class="profile-divider-top" />

        <!-- Avatar Section -->
        <div class="profile-avatar-section">
            <div class="avatar-circle-large" @onclick="ToggleActionSheet">
                @GetInitials(UserProfile.Name)
                <div class="camera-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2v11zM12 17a4 4 0 100-8 4 4 0 000 8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
            </div>
            <button class="btn-change-photo" @onclick="ToggleActionSheet">KETUK FOTO UNTUK GANTI</button>
        </div>

        <!-- Fields List -->
        <div class="profile-fields-list">
            
            <div class="profile-field-item" @onclick='() => EditField("NAMA LENGKAP")'>
                <div class="field-icon-circle">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2M12 11a4 4 0 100-8 4 4 0 000 8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div class="field-content">
                    <span class="field-label">NAMA LENGKAP</span>
                    <span class="field-value">@UserProfile.Name</span>
                </div>
                <div class="field-arrow">›</div>
            </div>

            <div class="profile-field-item" @onclick='() => EditField("EMAIL")'>
                <div class="field-icon-circle">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 6l-10 7L2 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div class="field-content">
                    <span class="field-label">EMAIL</span>
                    <span class="field-value">@UserProfile.Email</span>
                </div>
                <div class="field-arrow">›</div>
            </div>

            <div class="profile-field-item" @onclick='() => EditField("NOMOR TELEPON")'>
                <div class="field-icon-circle">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div class="field-content">
                    <span class="field-label">NOMOR TELEPON</span>
                    <span class="field-value">@UserProfile.Phone</span>
                </div>
                <div class="field-arrow">›</div>
            </div>

            <hr class="profile-divider-mid" />

            <div class="profile-field-item" @onclick='() => EditField("JABATAN & DEPARTEMEN")'>
                <div class="field-icon-circle">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2zM16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div class="field-content">
                    <span class="field-label">JABATAN & DEPARTEMEN</span>
                    <span class="field-value">@UserProfile.Title, @UserProfile.Department</span>
                </div>
                <div class="field-arrow">›</div>
            </div>

            <div class="profile-field-item" @onclick='() => EditField("LOKASI KANTOR")'>
                <div class="field-icon-circle">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div class="field-content">
                    <span class="field-label">LOKASI KANTOR</span>
                    <span class="field-value">@UserProfile.OfficeLocation</span>
                </div>
                <div class="field-arrow">›</div>
            </div>

            <div class="profile-field-item readonly">
                <div class="field-icon-circle">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div class="field-content">
                    <span class="field-label">RIWAYAT LOGIN TERAKHIR</span>
                    <span class="field-value">@UserProfile.LastLogin</span>
                </div>
            </div>
            
        </div>
    </div>
</div>

<!-- Camera Action Sheet (Bottom Sheet Simulation) -->
@if (isActionSheetVisible)
{
    <div class="action-sheet-overlay" @onclick="ToggleActionSheet">
        <div class="action-sheet" @onclick:stopPropagation="true">
            <button class="sheet-btn">Ambil Foto</button>
            <button class="sheet-btn">Pilih dari Galeri</button>
            <button class="sheet-btn btn-cancel" @onclick="ToggleActionSheet">Batal</button>
        </div>
    </div>
}

<!-- Toast Notification -->
@if (isToastVisible)
{
    <div class="toast-notification">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M22 11.08V12a10 10 0 11-5.93-9.14M22 4L12 14.01l-3-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Perubahan berhasil disimpan
    </div>
}

<style>
    .profile-page-modern {
        min-height: 100vh;
        background-color: #F8FAFC;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        font-family: 'Inter', sans-serif;
        background-image: radial-gradient(circle at top right, rgba(22, 48, 92, 0.05) 0%, transparent 40%),
                          radial-gradient(circle at bottom left, rgba(234, 182, 60, 0.05) 0%, transparent 40%);
    }

    .profile-card-center {
        width: 100%;
        max-width: 420px;
        background-color: rgba(22, 48, 92, 0.92);
        backdrop-filter: blur(12px);
        border-radius: 24px;
        padding: 32px 24px;
        box-shadow: inset 0 1px 1px rgba(255,255,255,0.1), 0 20px 40px rgba(16, 48, 92, 0.15);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .profile-pill-label {
        background-color: #1A3A63;
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 600;
        padding: 6px 16px;
        border-radius: 999px;
        margin-bottom: 8px;
    }

    .profile-sub-label {
        color: rgba(255, 255, 255, 0.6);
        font-size: 13px;
        margin: 0 0 24px 0;
    }

    .profile-divider-top {
        width: 100%;
        border: none;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        margin: 0 0 32px 0;
    }

    .profile-divider-mid {
        width: 100%;
        border: none;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        margin: 8px 0;
    }

    .profile-avatar-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 32px;
    }

    .avatar-circle-large {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background-color: #16305C;
        border: 2px solid rgba(255, 255, 255, 0.15);
        display: flex;
        justify-content: center;
        align-items: center;
        color: #FFFFFF;
        font-size: 36px;
        font-weight: 700;
        position: relative;
        cursor: pointer;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }

    .camera-badge {
        position: absolute;
        bottom: 4px;
        right: 4px;
        width: 32px;
        height: 32px;
        background-color: #EAB63C;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #16305C;
        border: 2px solid #16305C;
    }

    .btn-change-photo {
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.5);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        margin-top: 12px;
        cursor: pointer;
        transition: color 0.2s;
    }

    .btn-change-photo:hover {
        color: #FFFFFF;
    }

    .profile-fields-list {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .profile-field-item {
        display: flex;
        align-items: center;
        background-color: rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        padding: 16px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .profile-field-item:not(.readonly):hover {
        background-color: rgba(255, 255, 255, 0.08);
    }

    .profile-field-item.readonly {
        cursor: default;
        opacity: 0.8;
    }

    .field-icon-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: rgba(22, 48, 92, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9CA3AF;
        margin-right: 16px;
        flex-shrink: 0;
    }

    .field-content {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .field-label {
        font-size: 11px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.5);
        letter-spacing: 0.05em;
    }

    .field-value {
        font-size: 14px;
        font-weight: 600;
        color: #FFFFFF;
    }

    .field-arrow {
        color: rgba(255, 255, 255, 0.3);
        font-size: 20px;
    }

    /* Action Sheet */
    .action-sheet-overlay {
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    .action-sheet {
        width: 100%;
        max-width: 420px;
        background-color: #FFFFFF;
        border-radius: 24px 24px 0 0;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sheet-btn {
        width: 100%;
        padding: 16px;
        border: none;
        background-color: #F8FAFC;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        color: #16305C;
        cursor: pointer;
    }

    .sheet-btn:hover {
        background-color: #F1F5F9;
    }

    .sheet-btn.btn-cancel {
        background-color: transparent;
        color: #6B7280;
        margin-top: 8px;
    }

    @@keyframes slideUp {
        from { transform: translateY(100%); }
        to { transform: translateY(0); }
    }

    /* Toast Notification */
    .toast-notification {
        position: fixed;
        bottom: 32px;
        left: 50%;
        transform: translateX(-50%);
        background-color: #10B981;
        color: #FFFFFF;
        padding: 12px 24px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 10px 25px rgba(16, 185, 129, 0.3);
        z-index: 1000;
        animation: toastFade 3s forwards;
    }

    @@keyframes toastFade {
        0% { opacity: 0; transform: translate(-50%, 20px); }
        10% { opacity: 1; transform: translate(-50%, 0); }
        90% { opacity: 1; transform: translate(-50%, 0); }
        100% { opacity: 0; transform: translate(-50%, -20px); }
    }
</style>

@code {
    private UserProfileData UserProfile { get; set; } = BookingDataStore.CurrentUser;
    private bool isActionSheetVisible = false;
    private bool isToastVisible = false;

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return $"{parts[0].Substring(0, 1)}{parts[1].Substring(0, 1)}".ToUpper();
    }

    private void ToggleActionSheet()
    {
        isActionSheetVisible = !isActionSheetVisible;
    }

    private async Task EditField(string fieldName)
    {
        // Simulate inline edit & save
        isToastVisible = false;
        StateHasChanged();
        await Task.Delay(50);
        isToastVisible = true;
        StateHasChanged();

        // Auto-hide toast
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            isToastVisible = false;
            await InvokeAsync(StateHasChanged);
        });
    }
}
