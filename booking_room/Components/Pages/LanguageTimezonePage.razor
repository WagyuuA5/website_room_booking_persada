@page "/pengaturan/bahasa"
@page "/language"
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Bahasa & Zona Waktu — Persada</PageTitle>

<div class="content-fade-in" style="padding: 24px; max-width: 800px; margin: 0 auto;">
    <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--persada-navy-900, #0F1F3D); margin-bottom: 20px;">Bahasa & Zona Waktu</h2>
    
    <div style="background: var(--surface-card, #FFFFFF); border: 1.5px solid var(--color-brand-gray-border, #E5E7EB); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 16px;">
        <div>
            <label style="font-size: 0.8125rem; font-weight: 700; color: var(--persada-text-primary, #374151); display: block; margin-bottom: 6px;">Bahasa Tampilan</label>
            <select class="form-control" style="width: 100%; height: 42px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 12px; font-weight: 600;">
                <option value="id" selected>Bahasa Indonesia (ID)</option>
                <option value="en">English (US)</option>
            </select>
        </div>

        <div>
            <label style="font-size: 0.8125rem; font-weight: 700; color: var(--persada-text-primary, #374151); display: block; margin-bottom: 6px;">Zona Waktu</label>
            <select class="form-control" style="width: 100%; height: 42px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 12px; font-weight: 600;">
                <option value="WIB" selected>Waktu Indonesia Barat (WIB) - UTC+07:00</option>
                <option value="WITA">Waktu Indonesia Tengah (WITA) - UTC+08:00</option>
                <option value="WIT">Waktu Indonesia Timur (WIT) - UTC+09:00</option>
            </select>
        </div>

        <button class="btn btn-primary" style="height: 42px; border-radius: 999px; font-weight: 700; background: #1F5D9A; border: none; margin-top: 10px;" @onclick="SaveAndNavigateBack">
            Simpan Perubahan
        </button>
    </div>
</div>

@code {
    private bool _disposed;
    private CancellationTokenSource? _cts;

    private async Task SaveAndNavigateBack()
    {
        if (_disposed) return;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        try
        {
            await Task.Delay(500, token);
            if (!_disposed && !token.IsCancellationRequested)
            {
                Navigation.NavigateTo("/settings");
            }
        }
        catch { }
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
