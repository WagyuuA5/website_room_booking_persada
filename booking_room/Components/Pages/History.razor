@page "/history"
@using booking_room.Components.Models
@using booking_room.Components.Shared

<PageTitle>Riwayat Pemesanan - PT PERSADA</PageTitle>

<div class="content-fade-in">
    <div class="history-page-header">
        <div>
            <h1 class="history-title">Riwayat Pemesanan</h1>
            <p class="history-subtitle">Tinjau reservasi yang telah lewat maupun yang akan datang.</p>
        </div>
        
        <div class="history-filters">
            <!-- Filter Tanggal -->
            <button class="filter-btn @(_isDatePickerOpen ? "active" : "")" @onclick="ToggleDatePicker">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span>@(_selectedDate?.ToString("dd/MM/yyyy") ?? "Semua Tanggal")</span>
            </button>

            <!-- Filter Status -->
            <div class="dropdown-wrapper">
                <button class="filter-btn @(_isStatusOpen ? "active" : "")" @onclick="ToggleStatusDropdown">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                    </svg>
                    <span>@_selectedStatus</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 4px;">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>
                @if (_isStatusOpen)
                {
                    <div class="dropdown-menu">
                        @foreach (var status in _statusOptions)
                        {
                            <button class="dropdown-item @(_selectedStatus == status ? "selected" : "")" @onclick="() => SelectStatus(status)">@status</button>
                        }
                    </div>
                    <div class="dropdown-backdrop" @onclick="() => _isStatusOpen = false"></div>
                }
            </div>
        </div>
    </div>

    @if (FilteredBookings.Any())
    {
        <div class="history-list">
            @foreach (var item in FilteredBookings)
            {
                <div class="history-card" style="cursor: pointer;" @onclick="() => OpenDetail(item)">
                    <img src="@item.PhotoUrl" alt="@item.RoomName" class="history-thumb" onerror="this.src='/images/placeholder.jpg'" />
                    <div class="history-info">
                        <div class="history-room-name">@item.RoomName</div>
                        <div class="history-meta">
                            <span class="meta-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                @item.Date
                            </span>
                            <span class="meta-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                @item.TimeSlot
                            </span>
                            <span class="meta-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                @item.Attendees Peserta
                            </span>
                        </div>
                    </div>
                    <div class="history-status-wrap">
                        <StatusBadge Status="@item.Status" />
                        <svg class="chevron-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: #9CA3AF; margin-bottom: 16px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <h3 style="color: #374151; margin: 0 0 8px 0;">Belum Ada Riwayat</h3>
            <p style="color: #6B7280; margin: 0; font-size: 0.875rem;">Riwayat pemesanan ruangan Anda akan muncul di sini.</p>
        </div>
    }
</div>

@if (_isDatePickerOpen)
{
    <DatePickerModal 
        Visible="true"
        SelectedDate="_selectedDate"
        OnDateSelected="HandleDateSelected"
        OnCancel="() => _isDatePickerOpen = false" />
}

@if (_selectedBooking != null)
{
    <HistoryBookingDetailModal 
        Visible="true"
        Booking="_selectedBooking"
        OnClose="() => _selectedBooking = null" />
}

<style>
    .history-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 32px;
        flex-wrap: wrap;
        gap: 16px;
    }
    .history-title {
        font-size: 1.875rem;
        font-weight: 800;
        color: var(--color-brand-navy, #0F1F3D);
        margin: 0 0 8px 0;
        letter-spacing: -0.02em;
    }
    .history-subtitle {
        color: var(--color-brand-text-muted, #6B7280);
        margin: 0;
        font-size: 1rem;
    }
    .history-filters {
        display: flex;
        gap: 12px;
        align-items: center;
    }
    .filter-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #FFFFFF;
        border: 1px solid #E5E7EB;
        border-radius: 999px;
        padding: 10px 16px;
        font-size: 0.875rem;
        font-weight: 600;
        color: #374151;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }
    .filter-btn:hover, .filter-btn.active {
        background: #F9FAFB;
        border-color: #D1D5DB;
        color: var(--color-brand-navy, #0F1F3D);
    }
    .dropdown-wrapper {
        position: relative;
    }
    .dropdown-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        background: #FFFFFF;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -4px rgba(0,0,0,0.1);
        padding: 8px;
        min-width: 200px;
        z-index: 50;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .dropdown-item {
        padding: 8px 12px;
        border: none;
        background: none;
        text-align: left;
        width: 100%;
        border-radius: 6px;
        font-size: 0.875rem;
        color: #374151;
        cursor: pointer;
        transition: background 0.2s;
    }
    .dropdown-item:hover {
        background: #F3F4F6;
    }
    .dropdown-item.selected {
        background: #EEF2FF;
        color: #1F5D9A;
        font-weight: 600;
    }
    .dropdown-backdrop {
        position: fixed;
        inset: 0;
        z-index: 40;
        background: transparent;
    }

    .history-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .history-card {
        background: #FFFFFF;
        border: 1px solid #E5E7EB;
        border-radius: 16px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 20px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .history-card:hover {
        border-color: #CBD5E1;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        transform: translateY(-2px);
    }
    .history-thumb {
        width: 80px;
        height: 80px;
        border-radius: 12px;
        object-fit: cover;
        flex-shrink: 0;
    }
    .history-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .history-room-name {
        font-size: 1.125rem;
        font-weight: 700;
        color: #111827;
    }
    .history-meta {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }
    .meta-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8125rem;
        color: #6B7280;
    }
    .history-status-wrap {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .chevron-icon {
        color: #9CA3AF;
        transition: color 0.2s;
    }
    .history-card:hover .chevron-icon {
        color: var(--color-brand-navy, #0F1F3D);
    }
    .empty-state {
        padding: 64px 20px;
        text-align: center;
        background: #F9FAFB;
        border: 2px dashed #E5E7EB;
        border-radius: 16px;
    }

    @@media (max-width: 640px) {
        .history-card {
            flex-direction: column;
            align-items: stretch;
            position: relative;
        }
        .history-thumb {
            width: 100%;
            height: 160px;
        }
        .history-status-wrap {
            position: absolute;
            top: 24px;
            right: 24px;
        }
        .chevron-icon {
            display: none;
        }
    }
</style>

<HistoryBookingDetailModal Visible="@(_selectedBooking != null)" VisibleChanged="v => { if(!v) _selectedBooking = null; }" Booking="_selectedBooking" />


@code {
    private DateTime? _selectedDate;
    private string _selectedStatus = "Semua Status";
    private readonly string[] _statusOptions = { "Semua Status", "Disetujui", "Menunggu Persetujuan", "Ditolak", "Selesai" };
    private bool _isStatusOpen = false;
    private bool _isDatePickerOpen = false;
    private BookingItem? _selectedBooking;

    private IEnumerable<BookingItem> FilteredBookings
    {
        get
        {
            var query = BookingDataStore.AllBookings.AsEnumerable();
            
            if (_selectedStatus != "Semua Status")
            {
                var mappedStatus = _selectedStatus switch {
                    "Disetujui" => "approved",
                    "Menunggu Persetujuan" => "pending",
                    "Ditolak" => "rejected",
                    "Selesai" => "completed",
                    _ => ""
                };
                query = query.Where(b => b.Status == mappedStatus);
            }

            if (_selectedDate.HasValue)
            {
                var dateStr = _selectedDate.Value.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"));
                query = query.Where(b => b.Date == dateStr);
            }

            return query;
        }
    }

    private void ToggleStatusDropdown() => _isStatusOpen = !_isStatusOpen;
    private void SelectStatus(string status)
    {
        _selectedStatus = status;
        _isStatusOpen = false;
    }

    private void ToggleDatePicker() => _isDatePickerOpen = !_isDatePickerOpen;
    private void HandleDateSelected(DateTime? date)
    {
        _selectedDate = date;
        _isDatePickerOpen = false;
    }

    private void OpenDetail(BookingItem item) => _selectedBooking = item;
}
