@page "/history"
@page "/bookings/history"
@using booking_room.Components.Models
@using booking_room.Components.Shared

<PageTitle>Riwayat Pemesanan — Persada Room</PageTitle>

<div class="history-page">
    <div class="page-header">
        <h1 class="page-title">Riwayat Pemesanan</h1>
        <p class="page-subtitle">Lihat reservasi Anda sebelumnya beserta hasilnya.</p>
    </div>

    <div class="history-toolbar">
        <div class="toolbar-left">
            <div class="search-bar-history">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="search-icon"><path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.134 17 3 13.866 3 10C3 6.134 6.134 3 10 3C13.866 3 17 6.134 17 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <input type="text" placeholder="Cari berdasarkan nama ruangan..." @bind="searchQuery" @bind:event="oninput" />
            </div>
        </div>
        <div class="toolbar-right">
            <div class="toolbar-btn-group">
                <button class="btn-toolbar" @onclick="ToggleDatePicker">
                    Rentang Tanggal
                </button>
                
                <button class="btn-toolbar" @onclick="ToggleFilter">
                    Filter
                </button>

                <button class="btn-toolbar">
                    Ekspor CSV
                </button>
            </div>

            @if (isFilterOpen)
            {
                <div class="popup-anchor right">
                    <FilterByStatusPopup CurrentStatus="@activeFilter" ShowHeader="true" OnApply="ApplyFilter" OnClose="CloseFilter" />
                </div>
            }

            @if (isDatePickerOpen)
            {
                <div class="popup-anchor center">
                    <DatePickerPopup OnApply="ApplyDateRange" OnClose="CloseDatePicker" />
                </div>
            }
        </div>
    </div>

    <!-- Data Table -->
    <div class="history-table-container">
        <table class="history-table">
            <thead>
                <tr>
                    <th class="sortable-header" @onclick="ToggleSort">
                        NAMA RUANGAN
                        <svg class="sort-icon @(sortAscending ? "asc" : "desc")" width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M7 15l5-5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </th>
                    <th>TANGGAL</th>
                    <th>DURASI</th>
                    <th>STATUS</th>
                    <th>AKSI</th>
                </tr>
            </thead>
            <tbody>
                @if (_isLoading)
                {
                    @for (int i = 0; i < 5; i++)
                    {
                        <tr>
                            <td data-label="NAMA RUANGAN" colspan="5">
                                <div style="display: flex; align-items: center; gap: 12px; padding: 12px 0;">
                                    <div class="skeleton-shimmer" style="width: 40px; height: 40px; border-radius: 8px; flex-shrink: 0;"></div>
                                    <div style="flex: 1; display: flex; flex-direction: column; gap: 8px;">
                                        <div class="skeleton-shimmer" style="height: 14px; width: 50%;"></div>
                                        <div class="skeleton-shimmer" style="height: 12px; width: 30%;"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else if (!PagedBookings.Any())
                {
                    <tr>
                        <td colspan="5" class="empty-row">Tidak ada catatan riwayat ditemukan.</td>
                    </tr>
                }
                else
                {
                    @foreach (var booking in PagedBookings)
                    {
                        <tr>
                            <td data-label="NAMA RUANGAN">
                                <div class="room-cell">
                                    <img src="@booking.PhotoUrl" alt="@booking.RoomName" class="room-thumb" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                                    <div class="room-thumb-placeholder" style="display:none; width:40px; height:40px; border-radius:8px; align-items:center; justify-content:center; background:#f3f4f6; flex-shrink:0;">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                                    </div>
                                    <div>
                                        <span class="room-name-text">@booking.RoomName</span>
                                        <span class="room-floor-text">@booking.Floor</span>
                                    </div>
                                </div>
                            </td>
                            <td data-label="TANGGAL" class="date-text">@booking.Date</td>
                            <td data-label="DURASI" class="duration-text">@booking.Duration</td>
                            <td data-label="STATUS">
                                <span class="status-pill @BookingDataStore.GetStatusBadgeClass(booking.Status)">
                                    @BookingDataStore.GetStatusLabel(booking.Status)
                                </span>
                            </td>
                            <td data-label="AKSI">
                                <button class="btn-view-details" @onclick="() => OpenDetail(booking)">Lihat Detail</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="pagination-bar">
        <span class="page-info">Menampilkan @((currentPage - 1) * pageSize + 1)–@Math.Min(currentPage * pageSize, FilteredBookings.Count()) dari @FilteredBookings.Count()</span>
        <div class="page-buttons">
            <button class="page-btn" disabled="@(currentPage <= 1)" @onclick="PrevPage">← Seb</button>
            @for (int i = 1; i <= TotalPages; i++)
            {
                var pg = i;
                <button class="page-btn @(pg == currentPage ? "active" : "")" @onclick="() => GoToPage(pg)">@pg</button>
            }
            <button class="page-btn" disabled="@(currentPage >= TotalPages)" @onclick="NextPage">Lanjut →</button>
        </div>
    </div>
</div>

<ModalOverlayBlur Visible="isDetailOpen" OnClose="CloseDetail" Size="default">
    <HistoryDetailModal Booking="selectedBooking" OnClose="CloseDetail" />
</ModalOverlayBlur>

<style>
    .history-page {
        padding: 32px;
        font-family: 'Inter', sans-serif;
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
    }
    .topbar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 24px;
    }
    .topbar-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .notification-btn {
        background: none;
        border: none;
        position: relative;
        color: #6B7280;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .notification-badge {
        position: absolute;
        top: 0;
        right: 0;
        background-color: #EF4444;
        color: white;
        font-size: 10px;
        font-weight: bold;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
    }
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #16305C;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 14px;
    }
    .page-header {
        margin-bottom: 32px;
    }
    .page-title {
        color: #16305C;
        font-size: 32px;
        font-weight: 700;
        margin: 0 0 8px 0;
    }
    .page-subtitle {
        color: #6B7280;
        font-size: 15px;
        margin: 0;
    }
    .history-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        gap: 16px;
        flex-wrap: wrap;
    }
    .search-bar-history {
        position: relative;
        display: flex;
        align-items: center;
    }
    .search-bar-history .search-icon {
        position: absolute;
        left: 14px;
        color: #9CA3AF;
    }
    .search-bar-history input {
        padding: 10px 16px 10px 42px;
        border: 1px solid #E5E7EB;
        border-radius: 999px;
        font-size: 14px;
        width: 320px;
        background: #FFFFFF;
        transition: border-color 0.2s;
    }
    .search-bar-history input:focus {
        outline: none;
        border-color: #16305C;
    }
    .toolbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
    }
    .toolbar-btn-group {
        display: flex;
        gap: 12px;
    }
    .btn-toolbar {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 20px;
        border: 1px solid #E5E7EB;
        border-radius: 999px;
        background: transparent;
        color: #16305C;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s, border-color 0.2s;
    }
    .btn-toolbar:hover {
        background-color: #F9FAFB;
        border-color: #D1D5DB;
    }
    .popup-anchor {
        position: absolute;
        top: 50px;
        z-index: 100;
    }
    .popup-anchor.right { right: 0; }
    .popup-anchor.center { right: 80px; }

    /* Table Styles */
    .history-table-container {
        background: #FFFFFF;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #E5E7EB;
        box-shadow: 0 4px 24px rgba(16,48,92,0.04);
        width: 100%;
    }
    .history-table {
        width: 100%;
        border-collapse: collapse;
    }
    .history-table thead tr {
        background-color: #F9FAFB;
        border-bottom: 1px solid #E5E7EB;
    }
    .history-table th {
        padding: 16px 20px;
        text-align: left;
        color: #6B7280;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .sortable-header {
        cursor: pointer;
        user-select: none;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .sort-icon {
        transition: transform 0.2s;
    }
    .sort-icon.desc {
        transform: rotate(180deg);
    }
    .history-table td {
        padding: 16px 20px;
        border-bottom: 1px solid #E5E7EB;
        vertical-align: middle;
    }
    .history-table tbody tr:nth-child(even) {
        background-color: #FFFFFF;
    }
    .history-table tbody tr:hover {
        background-color: #F0F4FF;
    }
    .room-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .room-thumb {
        width: 40px;
        height: 40px;
        border-radius: 40px;
        object-fit: cover;
    }
    .room-name-text {
        display: block;
        font-weight: 700;
        color: #16305C;
        font-size: 14px;
    }
    .room-floor-text {
        display: block;
        color: #6B7280;
        font-size: 12px;
        margin-top: 2px;
    }
    .date-text, .duration-text {
        color: #16305C;
        font-size: 14px;
    }
    .status-pill {
        display: inline-flex;
        align-items: center;
        padding: 6px 16px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }
    .badge-pending {
        background-color: #FEF3C7;
        color: #92400E;
    }
    .badge-approved {
        background-color: #D1FAE5;
        color: #065F46;
    }
    .badge-rejected {
        background-color: #FEE2E2;
        color: #991B1B;
    }
    .badge-completed {
        background-color: #DBEAFE;
        color: #1E40AF;
    }
    .btn-view-details {
        background: none;
        border: none;
        color: #EAB63C;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        padding: 0;
        text-decoration: none;
        transition: color 0.2s;
    }
    .btn-view-details:hover {
        color: #16305C;
        text-decoration: underline;
    }
    .empty-row {
        text-align: center;
        color: #9CA3AF;
        padding: 40px 20px !important;
    }

    /* Pagination */
    .pagination-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 24px;
    }
    .page-info {
        color: #6B7280;
        font-size: 14px;
    }
    .page-buttons {
        display: flex;
        gap: 8px;
    }
    .page-btn {
        padding: 8px 16px;
        border: 1px solid #E5E7EB;
        border-radius: 999px;
        background: #FFFFFF;
        color: #16305C;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .page-btn:hover:not(:disabled):not(.active) {
        background-color: #F9FAFB;
    }
    .page-btn.active {
        background-color: #16305C;
        color: white;
        border-color: #16305C;
    }
    .page-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .history-table thead {
            display: none;
        }
        .history-table, .history-table tbody, .history-table tr, .history-table td {
            display: block;
            width: 100%;
        }
        .history-table tr {
            margin-bottom: 16px;
            border: 1px solid #E5E7EB;
            border-radius: 12px;
            padding: 16px;
        }
        .history-table td {
            text-align: right;
            padding: 8px 0;
            border-bottom: none;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .history-table td::before {
            content: attr(data-label);
            font-size: 12px;
            color: #6B7280;
            font-weight: 600;
            text-transform: uppercase;
        }
        .room-cell {
            text-align: left;
        }
        .history-toolbar {
            flex-direction: column;
            align-items: stretch;
        }
        .search-bar-history input {
            width: 100%;
        }
        .toolbar-btn-group {
            flex-wrap: wrap;
        }
    }
</style>

@code {
    private string searchQuery = "";
    private string activeFilter = "Semua Status";
    private bool isFilterOpen = false;
    private bool isDatePickerOpen = false;
    private bool isDetailOpen = false;
    private BookingItem? selectedBooking;
    private int currentPage = 1;
    private int pageSize = 10;
    private bool sortAscending = true;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(400);
        _isLoading = false;
    }

    private IEnumerable<BookingItem> FilteredBookings
    {
        get
        {
            var query = BookingDataStore.AllBookings.AsEnumerable();
            
            if (activeFilter != "Semua Status")
                query = query.Where(b => b.Status.Equals(activeFilter, StringComparison.OrdinalIgnoreCase));
            
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.ToLower();
                query = query.Where(b => b.RoomName.ToLower().Contains(q));
            }
            
            if (sortAscending)
                query = query.OrderBy(b => b.RoomName);
            else
                query = query.OrderByDescending(b => b.RoomName);
                
            return query;
        }
    }

    private IEnumerable<BookingItem> PagedBookings =>
        FilteredBookings.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredBookings.Count() / pageSize));

    private void ToggleSort()
    {
        sortAscending = !sortAscending;
    }

    private void ToggleFilter() { isFilterOpen = !isFilterOpen; isDatePickerOpen = false; }
    private void CloseFilter() { isFilterOpen = false; }
    private void ApplyFilter(string status) { activeFilter = status; isFilterOpen = false; currentPage = 1; }

    private void ToggleDatePicker() { isDatePickerOpen = !isDatePickerOpen; isFilterOpen = false; }
    private void CloseDatePicker() { isDatePickerOpen = false; }
    private void ApplyDateRange(string range) { isDatePickerOpen = false; /* Placeholder */ }

    private void OpenDetail(BookingItem booking) { selectedBooking = booking; isDetailOpen = true; }
    private void CloseDetail() { isDetailOpen = false; }

    private void PrevPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void GoToPage(int page) { currentPage = page; }
}

