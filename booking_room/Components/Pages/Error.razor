@page "/Error"
@using System.Diagnostics

<PageTitle>Kesalahan</PageTitle>

<h1 class="text-danger">Kesalahan.</h1>
<h2 class="text-danger">Terjadi kesalahan saat memproses permintaan Anda.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>ID Permintaan:</strong> <code>@RequestId</code>
    </p>
}

<h3>Mode Pengembangan</h3>
<p>
    Beralih ke lingkungan <strong>Pengembangan</strong> akan menampilkan informasi lebih detail tentang kesalahan yang terjadi.
</p>
<p>
    <strong>Lingkungan Pengembangan tidak boleh diaktifkan untuk aplikasi yang diterapkan.</strong>
    Ini dapat mengakibatkan penampilan informasi sensitif dari exception kepada pengguna akhir.
    Untuk debug lokal, aktifkan lingkungan <strong>Pengembangan</strong> dengan mengatur variabel lingkungan <strong>ASPNETCORE_ENVIRONMENT</strong> menjadi <strong>Development</strong>
    dan jalankan ulang aplikasi.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
