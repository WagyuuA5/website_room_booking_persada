@page "/"
@using booking_room.Components.Models
@using booking_room.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Dashboard - PADA Management</PageTitle>

@if (showReminderBanner)
{
    <NotificationBanner ReminderText="Upcoming: Alpha Room at 09:00 AM (in 15 min)" IsActionRequired="false" OnDismiss="DismissReminder" />
}

@if (showActionRequiredBanner)
{
    <NotificationBanner IsActionRequired="true" TargetTime="@actionRequiredTarget" OnCheckIn="HandleCheckInClick" />
}

<div class="hero-card">
    <h1 class="hero-title">Selamat Datang, Admin User</h1>
    <p class="hero-subtitle">Kelola pemesanan ruangan perusahaan Anda secara efisien. Pantau penggunaan ruangan, reservasi mendatang, dan analitik sistem dalam satu tempat.</p>
</div>

<div class="summary-cards">
    <!-- Card Ruangan Tersedia -->
    <div class="summary-card" @onclick='() => ShowPopup("RoomAvailable")'>
        <div class="summary-card-icon icon-green">
            <InlineSvg Src="/icons/icon_room_available.svg" Class="icon-main" />
            <InlineSvg Src="/icons/Container_1.svg" Class="icon-bg-pattern" />
        </div>
        <div class="summary-card-content">
            <div class="summary-card-label">Ruangan Tersedia</div>
            <div class="summary-card-value">@DashboardData.AvailableRooms.Available <span>/ @DashboardData.AvailableRooms.Total</span></div>
        </div>
        <div class="summary-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
    </div>

    <!-- Card Persetujuan Tertunda -->
    <div class="summary-card" style="border-left: 4px solid var(--accent-amber);" @onclick='() => ShowPopup("PendingApproval")'>
        <div class="summary-card-icon icon-amber">
            <InlineSvg Src="/icons/icon_pending.svg" Class="icon-main" />
            <InlineSvg Src="/icons/Container_3.svg" Class="icon-bg-pattern" />
        </div>
        <div class="summary-card-content">
            <div class="summary-card-label">Persetujuan Tertunda</div>
            <div class="summary-card-value">@DashboardData.PendingApprovals</div>
        </div>
        <div class="summary-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
    </div>

    <!-- Card Segera Tersedia -->
    @if (nextRoom is not null)
    {
        <div class="summary-card next-available-card" @onclick='() => ShowPopup("QuickBook")'>
            <div class="next-available-header">
                <div class="next-available-title">Segera Tersedia</div>
                <svg class="next-available-bolt" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                </svg>
            </div>
            <div class="next-available-icon">
                <InlineSvg Src="/icons/icon_quick_book.svg" Class="icon-main" />
                <InlineSvg Src="/icons/Container_3.svg" Class="icon-bg-pattern" />
            </div>
            <div class="next-available-room">@nextRoom.RoomName</div>
            <div class="next-available-meta">
                Tersedia dalam @nextRoom.AvailableInMinutes menit
                <span style="margin: 0 0.35rem;">•</span>
                Kapasitas: @nextRoom.Capacity
            </div>
            <button class="next-available-btn">
                <InlineSvg Src="/icons/icon_quick_book.svg" Class="icon-svg" style="width: 16px; height: 16px; margin-right: 4px;" />
                Pesan Cepat
            </button>
        </div>
    }
    else
    {
        <div class="summary-card next-available-card" style="align-items: center; text-align: center;">
            <div class="next-available-room" style="font-size: 1.1rem;">Semua ruangan tersedia sekarang</div>
            <div class="next-available-meta" style="margin-bottom: 1rem;">Tidak ada ruangan yang sedang terpakai saat ini</div>
            <button class="next-available-btn" @onclick:stopPropagation="true" @onclick="ViewAllRooms">
                Lihat Semua Ruangan
            </button>
        </div>
    }
</div>

<div class="analytics-card" style="cursor: pointer;" @onclick='() => ShowPopup("AnalyticsDetail")'>
    <div class="analytics-header">
        <div>
            <h2 class="analytics-title">Analitik Penggunaan Ruangan</h2>
            <p class="analytics-subtitle">5 ruangan yang paling sering dipesan</p>
        </div>
        <div class="period-toggle">
            @foreach (var period in periods)
            {
                <button class="@(selectedPeriod == period ? "active" : "")" @onclick:stopPropagation="true" @onclick="() => SelectPeriod(period)">@period</button>
            }
        </div>
    </div>

    <div class="utilization-list">
        @{ int rank = 0; }
        @foreach (var room in analyticsData.Rooms)
        {
            rank++;
            var maxHours = analyticsData.Rooms.Max(r => r.HoursUsed);
            var percentage = maxHours > 0 ? (double)room.HoursUsed / maxHours * 100 : 0;
            var barClass = rank switch
            {
                1 => "bar-1",
                2 => "bar-2",
                3 => "bar-3",
                4 => "bar-4",
                _ => "bar-5"
            };
            var rankClass = rank switch
            {
                1 => "rank-1",
                2 => "rank-2",
                3 => "rank-3",
                4 => "rank-4",
                _ => "rank-5"
            };

            <div class="utilization-item">
                <div class="utilization-item-header">
                    <div class="utilization-room-info">
                        <div class="utilization-rank @rankClass">@rank</div>
                        <div class="utilization-room-name">@room.RoomName</div>
                    </div>
                    <div class="utilization-hours">@room.HoursUsed jam</div>
                </div>
                <div class="utilization-bar-bg">
                    <div class="utilization-bar-fill @barClass" style="width: @percentage.ToString("0.0")%;">
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Pop-ups -->
<ModalOverlayBlur Visible="@(activePopup == "RoomAvailable")" OnClose="ClosePopup" Size="default">
    <RoomAvailablePopup OnClose="ClosePopup" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "PendingApproval")" OnClose="ClosePopup" Size="default">
    <PendingApprovalPopup OnClose="ClosePopup" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "QuickBook")" OnClose="ClosePopup" Size="default">
    @if (nextRoom != null)
    {
        <QuickBookPopup OnClose="ClosePopup" RoomName="@nextRoom.RoomName" AvailableInMinutes="nextRoom.AvailableInMinutes" Capacity="nextRoom.Capacity" />
    }
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "AnalyticsDetail")" OnClose="ClosePopup" Size="lg">
    <AnalyticsDetailPopup OnClose="ClosePopup" SelectedPeriod="@selectedPeriod" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "CheckInConfirmation")" OnClose="ClosePopup" Size="sm">
    <CheckInConfirmationModal 
        RoomName="Alpha Boardroom"
        TimeSlot="09:00 - 11:00 AM"
        Location="Floor 2, Wing A"
        Capacity="12"
        TargetTime="@actionRequiredTarget"
        OnConfirm="HandleConfirmCheckIn"
        OnCancel="ClosePopup" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "CheckInSuccess")" OnClose="HandleSuccessClose" Size="sm">
    <CheckInSuccessModal 
        Timestamp="@checkInTimestamp"
        OnClose="HandleSuccessClose" />
</ModalOverlayBlur>


@code {
    private NextAvailableRoom? nextRoom;
    private AnalyticsData analyticsData = DashboardData.WeeklyData;
    private string selectedPeriod = "Minggu";
    private readonly string[] periods = { "Minggu", "Bulan", "Tahun" };
    private bool showReminderBanner = true;
    private bool showActionRequiredBanner = true;
    private DateTime actionRequiredTarget = DateTime.Now.AddMinutes(15);
    private DateTime checkInTimestamp;

    private string activePopup = ""; // "", "RoomAvailable", "PendingApproval", "QuickBook", "AnalyticsDetail"

    protected override void OnInitialized()
    {
        nextRoom = DashboardData.NextAvailableRooms.FirstOrDefault();
    }

    private void SelectPeriod(string period)
    {
        selectedPeriod = period;
        analyticsData = DashboardData.GetAnalytics(period);
    }

    private void ViewAllRooms()
    {
        Navigation.NavigateTo("/bookings");
    }

    private void DismissReminder()
    {
        showReminderBanner = false;
    }

    private void HandleCheckInClick()
    {
        activePopup = "CheckInConfirmation";
    }

    private void HandleConfirmCheckIn()
    {
        checkInTimestamp = DateTime.Now;
        activePopup = "CheckInSuccess";
    }

    private void HandleSuccessClose()
    {
        showActionRequiredBanner = false;
        activePopup = "";
    }

    private void ShowPopup(string popupName)
    {
        activePopup = popupName;
    }

    private void ClosePopup()
    {
        activePopup = "";
    }
}
