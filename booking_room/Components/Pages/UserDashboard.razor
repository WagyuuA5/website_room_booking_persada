    // Data model for ApexCharts
    public class RoomUsagePoint
    {
        public string Label { get; set; } = "";
        public decimal Value { get; set; }
    }

    public class ApexChartSeries
    {
        public string Name { get; set; } = "";
        public string Color { get; set; } = "";
        public bool Show { get; set; } = true;
        public List<RoomUsagePoint> Points { get; set; } = new();
    }

    private string? _highlightedRoom = null;

    private void ToggleSeries(string seriesName)
    {
        if (_highlightedRoom == seriesName)
        {
            ClearDrillDown();
        }
        else
        {
            _highlightedRoom = seriesName;
            foreach (var s in _apexChartSeries)
            {
                s.Show = s.Name == seriesName;
            }
        }
        StateHasChanged();
    }

    private void ClearDrillDown()
    {
        _highlightedRoom = null;
        foreach (var s in _apexChartSeries)
        {
            s.Show = true;
        }
        StateHasChanged();
    }

    private void ExportCSV()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Ruangan," + string.Join(",", _apexChartSeries.FirstOrDefault()?.Points.Select(p => p.Label) ?? Enumerable.Empty<string>()));
        foreach (var series in _apexChartSeries)
        {
            csv.AppendLine($"{series.Name}," + string.Join(",", series.Points.Select(p => p.Value)));
        }
        DownloadFile(csv.ToString(), $"analytics-{selectedPeriod}.csv", "text/csv");
    }

    private void ExportJSON()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(new { Period = selectedPeriod, Series = _apexChartSeries.Select(s => new { s.Name, s.Points }) });
        DownloadFile(json, $"analytics-{selectedPeriod}.json", "application/json");
    }

    private void DownloadFile(string content, string fileName, string contentType)
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes(content);
        var base64 = Convert.ToBase64String(bytes);
        var dataUrl = $"data:{contentType};base64,{base64}";
        var js = $"var a=document.createElement('a');a.href='{dataUrl}';a.download='{fileName}';document.body.appendChild(a);a.click();document.body.removeChild(a);";
        JS.InvokeVoidAsync("eval", js);
    }
}

