@page "/"
@using booking_room.Components.Models
@inject NavigationManager Navigation

<PageTitle>Dashboard - PADA Management</PageTitle>

<div class="hero-card">
    <h1 class="hero-title">Selamat Datang, Admin User</h1>
    <p class="hero-subtitle">Kelola pemesanan ruangan perusahaan Anda secara efisien. Pantau penggunaan ruangan, reservasi mendatang, dan analitik sistem dalam satu tempat.</p>
</div>

<div class="summary-cards">
    <div class="summary-card">
        <div class="summary-card-icon" style="background-color: var(--accent-green-light);">
            <svg class="container-svg" width="16" height="20" viewBox="0 0 16 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.55 16.2L11.725 10H7.725L8.45 4.325L3.825 11H7.3L6.55 16.2ZM4 20L5 13H0L9 0H11L10 8H16L6 20H4Z" fill="white" fill-opacity="0.5"/>
            </svg>
            <svg class="icon-svg" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 18V16H2V0H12V1H16V16H18V18H14V3H12V18H0ZM4 2V16V2ZM8 10C8.28333 10 8.52083 9.90417 8.7125 9.7125C8.90417 9.52083 9 9.28333 9 9C9 8.71667 8.90417 8.47917 8.7125 8.2875C8.52083 8.09583 8.28333 8 8 8C7.71667 8 7.47917 8.09583 7.2875 8.2875C7.09583 8.47917 7 8.71667 7 9C7 9.28333 7.09583 9.52083 7.2875 9.7125C7.47917 9.90417 7.71667 10 8 10ZM4 16H10V2H4V16Z" fill="#059669"/>
            </svg>
        </div>
        <div class="summary-card-content">
            <div class="summary-card-label">Ruangan Tersedia</div>
            <div class="summary-card-value">@DashboardData.AvailableRooms.Available <span>/ @DashboardData.AvailableRooms.Total</span></div>
        </div>
    </div>

    <div class="summary-card" style="border-left: 4px solid var(--accent-amber);">
        <div class="summary-card-icon" style="background-color: #fef3c7;">
            <svg class="container-svg" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 18V16H2V0H12V1H16V16H18V18H14V3H12V18H0ZM4 2V16V2ZM8 10C8.28333 10 8.52083 9.90417 8.7125 9.7125C8.90417 9.52083 9 9.28333 9 9C9 8.71667 8.90417 8.47917 8.7125 8.2875C8.52083 8.09583 8.28333 8 8 8C7.71667 8 7.47917 8.09583 7.2875 8.2875C7.09583 8.47917 7 8.71667 7 9C7 9.28333 7.09583 9.52083 7.2875 9.7125C7.47917 9.90417 7.71667 10 8 10ZM4 16H10V2H4V16Z" fill="#E8B400"/>
            </svg>
            <svg class="icon-svg" width="19" height="21" viewBox="0 0 19 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M14 21C12.6167 21 11.4375 20.5125 10.4625 19.5375C9.4875 18.5625 9 17.3833 9 16C9 14.6167 9.4875 13.4375 10.4625 12.4625C11.4375 11.4875 12.6167 11 14 11C15.3833 11 16.5625 11.4875 17.5375 12.4625C18.5125 13.4375 19 14.6167 19 16C19 17.3833 18.5125 18.5625 17.5375 19.5375C16.5625 20.5125 15.3833 21 14 21ZM15.675 18.375L16.375 17.675L14.5 15.8V13H13.5V16.2L15.675 18.375ZM2 20C1.45 20 0.979167 19.8042 0.5875 19.4125C0.195833 19.0208 0 18.55 0 18V4C0 3.45 0.195833 2.97917 0.5875 2.5875C0.979167 2.19583 1.45 2 2 2H6.175C6.35833 1.41667 6.71667 0.9375 7.25 0.5625C7.78333 0.1875 8.36667 0 9 0C9.66667 0 10.2625 0.1875 10.7875 0.5625C11.3125 0.9375 11.6667 1.41667 11.85 2H16C16.55 2 17.0208 2.19583 17.4125 2.5875C17.8042 2.97917 18 3.45 18 4V10.25C17.7 10.0333 17.3833 9.85 17.05 9.7C16.7167 9.55 16.3667 9.41667 16 9.3V4H14V7H4V4H2V18H7.3C7.41667 18.3667 7.55 18.7167 7.7 19.05C7.85 19.3833 8.03333 19.7 8.25 20H2ZM9 4C9.28333 4 9.52083 3.90417 9.7125 3.7125C9.90417 3.52083 10 3.28333 10 3C10 2.71667 9.90417 2.47917 9.7125 2.2875C9.52083 2.09583 9.28333 2 9 2C8.71667 2 8.47917 2.09583 8.2875 2.2875C8.09583 2.47917 8 2.71667 8 3C8 3.28333 8.09583 3.52083 8.2875 3.7125C8.47917 3.90417 8.71667 4 9 4Z" fill="#D97706"/>
            </svg>
        </div>
        <div class="summary-card-content">
            <div class="summary-card-label">Persetujuan Tertunda</div>
            <div class="summary-card-value">@DashboardData.PendingApprovals</div>
        </div>
    </div>

    @if (nextRoom is not null)
    {
        <div class="summary-card next-available-card">
            <div class="next-available-header">
                <div class="next-available-title">Segera Tersedia</div>
                <svg class="next-available-bolt" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                </svg>
            </div>
            <div class="next-available-icon">
                <svg class="container-svg" width="16" height="20" viewBox="0 0 16 20" fill="none" xmlns="http://www.w3.org/2000/svg" style="position: absolute; opacity: 0.15;">
                    <path d="M0 17V15H2V8C2 6.61667 2.41667 5.3875 3.25 4.3125C4.08333 3.2375 5.16667 2.53333 6.5 2.2V1.5C6.5 1.08333 6.64583 0.729167 6.9375 0.4375C7.22917 0.145833 7.58333 0 8 0C8.41667 0 8.77083 0.145833 9.0625 0.4375C9.35417 0.729167 9.5 1.08333 9.5 1.5V2.2C10.8333 2.53333 11.9167 3.2375 12.75 4.3125C13.5833 5.3875 14 6.61667 14 8V15H16V17H0ZM8 20C7.45 20 6.97917 19.8042 6.5875 19.4125C6.19583 19.0208 6 18.55 6 18H10C10 18.55 9.80417 19.0208 9.4125 19.4125C9.02083 19.8042 8.55 20 8 20ZM4 15H12V8C12 6.9 11.6083 5.95833 10.825 5.175C10.0417 4.39167 9.1 4 8 4C6.9 4 5.95833 4.39167 5.175 5.175C4.39167 5.95833 4 6.9 4 8V15Z" fill="#76777D"/>
                </svg>
                <svg class="icon-svg" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: #e2e8f0;">
                    <path d="M0 18V16H2V0H12V1H16V16H18V18H14V3H12V18H0ZM4 2V16V2ZM8 10C8.28333 10 8.52083 9.90417 8.7125 9.7125C8.90417 9.52083 9 9.28333 9 9C9 8.71667 8.90417 8.47917 8.7125 8.2875C8.52083 8.09583 8.28333 8 8 8C7.71667 8 7.47917 8.09583 7.2875 8.2875C7.09583 8.47917 7 8.71667 7 9C7 9.28333 7.09583 9.52083 7.2875 9.7125C7.47917 9.90417 7.71667 10 8 10ZM4 16H10V2H4V16Z" fill="currentColor"/>
                </svg>
            </div>
            <div class="next-available-room">@nextRoom.RoomName</div>
            <div class="next-available-meta">
                Tersedia dalam @nextRoom.AvailableInMinutes menit
                <span style="margin: 0 0.35rem;">•</span>
                Kapasitas: @nextRoom.Capacity
            </div>
            <button class="next-available-btn" @onclick="BookNow">
                Pesan Sekarang
            </button>
        </div>
    }
    else
    {
        <div class="summary-card next-available-card" style="align-items: center; text-align: center;">
            <div class="next-available-room" style="font-size: 1.1rem;">Semua ruangan tersedia sekarang</div>
            <div class="next-available-meta" style="margin-bottom: 1rem;">Tidak ada ruangan yang sedang terpakai saat ini</div>
            <button class="next-available-btn" @onclick="ViewAllRooms">
                Lihat Semua Ruangan
            </button>
        </div>
    }
</div>

<div class="analytics-card">
    <div class="analytics-header">
        <div>
            <h2 class="analytics-title">Analitik Penggunaan Ruangan</h2>
            <p class="analytics-subtitle">5 ruangan yang paling sering dipesan</p>
        </div>
        <div class="period-toggle">
            @foreach (var period in periods)
            {
                <button class="@(selectedPeriod == period ? "active" : "")" @onclick="() => SelectPeriod(period)">@period</button>
            }
        </div>
    </div>

    <div class="utilization-list">
        @foreach (var room in analyticsData.Rooms)
        {
            var maxHours = analyticsData.Rooms.Max(r => r.HoursUsed);
            var percentage = maxHours > 0 ? (double)room.HoursUsed / maxHours * 100 : 0;

            <div class="utilization-item">
                <div class="utilization-room-name">@room.RoomName</div>
                <div class="utilization-bar-bg">
                    <div class="utilization-bar-fill" style="width: @percentage.ToString("0.0")%;">
                        <span class="utilization-bar-label">@room.HoursUsed jam</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private NextAvailableRoom? nextRoom;
    private AnalyticsData analyticsData = DashboardData.WeeklyData;
    private string selectedPeriod = "Minggu";
    private readonly string[] periods = { "Minggu", "Bulan", "Tahun" };

    protected override void OnInitialized()
    {
        nextRoom = DashboardData.NextAvailableRooms.FirstOrDefault();
    }

    private void SelectPeriod(string period)
    {
        selectedPeriod = period;
        analyticsData = DashboardData.GetAnalytics(period);
    }

    private void BookNow()
    {
        if (nextRoom is not null)
        {
            Navigation.NavigateTo($"/bookings?room={Uri.EscapeDataString(nextRoom.RoomName)}");
        }
    }

    private void ViewAllRooms()
    {
        Navigation.NavigateTo("/bookings");
    }
}
