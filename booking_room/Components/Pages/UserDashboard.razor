@page "/dashboard"
@using booking_room.Components.Models
@using booking_room.Components.Shared
@inject NavigationManager Navigation
@inject booking_room.Services.NotificationState NotificationState
@inject booking_room.Services.LoadingStateService LoadingState
@inject IJSRuntime JS
@implements IDisposable
<PageTitle>Beranda — Persada Ruangan</PageTitle>

@if (NotificationState.CurrentBannerType != booking_room.Services.NotificationState.BannerType.None)
{
    <NotificationBanner TargetTime="@NotificationState.NextBookingTime" 
                        BannerType="@NotificationState.CurrentBannerType"
                        OnCheckIn="HandleCheckInClick" 
                        OnDismiss="DismissReminder" />
}

@if (LoadingState.IsLoading)
{
    <div class="content-fade-in">
        <div class="skeleton-shimmer" style="height: 100px; border-radius: 1rem; margin-bottom: 1.5rem;"></div>
        <div class="skeleton-stat-grid">
            <div class="skeleton-stat-card"><div class="skeleton-shimmer skeleton-title"></div><div class="skeleton-shimmer skeleton-text"></div></div>
            <div class="skeleton-stat-card"><div class="skeleton-shimmer skeleton-title"></div><div class="skeleton-shimmer skeleton-text"></div></div>
            <div class="skeleton-stat-card"><div class="skeleton-shimmer skeleton-title"></div><div class="skeleton-shimmer skeleton-text"></div></div>
        </div>
        <div class="skeleton-grid">
            <div class="skeleton-card" style="grid-column: span 2;"><div class="skeleton-shimmer" style="height: 250px;"></div></div>
            <div class="skeleton-card"><div class="skeleton-shimmer" style="height: 250px;"></div></div>
        </div>
    </div>
}
else
{
<div class="content-fade-in">
<div class="hero-card">
    <h1 class="hero-title">Selamat Datang, Admin User</h1>
    <p class="hero-subtitle">Kelola pemesanan ruangan perusahaan Anda dengan efisien. Pantau penggunaan ruangan, reservasi mendatang, dan analitik sistem dalam satu tempat.</p>
</div>

<div class="summary-cards">
    <!-- Card Segera Tersedia (Now First) -->
    @if (nextRoom is not null)
    {
        <StatHighlightCard Title="Ruangan Segera Tersedia"
                           Value="@nextRoom.RoomName"
                           Subtitle="@($"Kapasitas: {nextRoom.Capacity} Orang")"
                           BadgeText="@($"Tersedia Dalam {nextRoom.AvailableInMinutes} Menit")"
                           ButtonText="Pemesanan Instan"
                           Variant="success"
                           OnClick='() => ShowPopup("QuickBook")'>
            <Icon>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
                </svg>
            </Icon>
        </StatHighlightCard>
    }
    else
    {
        <StatHighlightCard Title="Status Ruangan"
                           Value="Semua Tersedia"
                           Subtitle="Tidak ada ruangan yang sedang terpakai saat ini"
                           ButtonText="Lihat Semua Ruangan"
                           Variant="info"
                           OnClick="ViewAllRooms" />
    }

    @if (DashboardData.CurrentUserRole == "Admin")
    {
        <!-- Card Persetujuan Tertunda -->
        <StatHighlightCard Title="Persetujuan Tertunda"
                           Value="@DashboardData.PendingApprovals.ToString()"
                           Subtitle="Permintaan pemesanan menunggu tindakan"
                           Variant="warning"
                           ShowArrow="true"
                           OnClick='() => ShowPopup("PendingApproval")'>
            <Icon>
                <InlineSvg Src="/icons/Icon_clndr.svg" Class="icon-main" />
            </Icon>
        </StatHighlightCard>
    }
</div>

</div>

<div class="dashboard-lower-layout">
    <!-- Jadwal Saya Hari Ini (moved above analytics) -->
    @if (DashboardData.CurrentUserRole == "Admin")
    {
        @if (IsWidgetVisible("TodaySchedule"))
        {
            <div class="dashboard-widget upcoming-bookings-panel">
                <div class="upcoming-header">
                    <h2 class="upcoming-title">Jadwal Saya Hari Ini</h2>
                    <span class="upcoming-badge">@DashboardData.TodaySchedule.Count Agenda</span>
                </div>
                <div class="upcoming-list">
                    @foreach (var item in DashboardData.TodaySchedule)
                    {
                        <div class="upcoming-card" style="cursor: pointer;" @onclick="() => NavigateToBookingDetail(item)">
                            <div class="upcoming-accent" style="background-color: @item.AccentColor;"></div>
                            <div class="upcoming-content">
                                <div class="upcoming-top">
                                    <div>
                                        <h3 class="upcoming-room-name">@item.RoomName</h3>
                                        <p class="upcoming-location">@item.Title</p>
                                    </div>
                                    <StatusBadge Status="@item.Status" CustomLabel="@item.StatusLabel" />
                                </div>
                                <div class="upcoming-bottom">
                                    <div class="upcoming-schedule">
                                        <span>
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="currentColor"/></svg>
                                            @item.TimeSlot
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (!DashboardData.TodaySchedule.Any())
                {
                    <div style="text-align: center; padding: 2rem; color: #94a3b8;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" style="margin-bottom: 1rem; opacity: 0.5;"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        <p style="font-weight: 600; margin-bottom: 0.5rem;">Tidak ada jadwal hari ini</p>
                        <p style="font-size: 0.85rem; margin-bottom: 1rem;">Ayo pesan ruangan!</p>
                        <button class="btn btn-primary" style="border-radius: 999px; padding: 0.5rem 1.25rem; font-size: 0.85rem;" @onclick="ViewAllRooms">Cari Ruangan</button>
                    </div>
                }
            </div>
        }
    }
    else
    {
        @if (IsWidgetVisible("TodaySchedule"))
        {
            <div class="dashboard-widget upcoming-bookings-panel">
                <div class="upcoming-header">
                    <h2 class="upcoming-title">Jadwal Saya Hari Ini</h2>
                    <span class="upcoming-badge">@DashboardData.TodaySchedule.Count Agenda</span>
                </div>
                <div class="upcoming-list">
                    @foreach (var item in DashboardData.TodaySchedule)
                    {
                        <div class="upcoming-card" style="cursor: pointer;" @onclick="() => NavigateToBookingDetail(item)">
                            <div class="upcoming-accent" style="background-color: @item.AccentColor;"></div>
                            <div class="upcoming-content">
                                <div class="upcoming-top">
                                    <div>
                                        <h3 class="upcoming-room-name">@item.RoomName</h3>
                                        <p class="upcoming-location">@item.Title</p>
                                    </div>
                                    <span class="upcoming-status-badge" style="background: @(item.Status == "sedang-berlangsung" ? "#F0FDF4" : "#F8FAFC"); color: @(item.Status == "sedang-berlangsung" ? "#166534" : "#4B5563");">
                                        @item.StatusLabel
                                    </span>
                                </div>
                                <div class="upcoming-bottom">
                                    <div class="upcoming-schedule">
                                        <span>
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="currentColor"/></svg>
                                            @item.TimeSlot
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (!DashboardData.TodaySchedule.Any())
                {
                    <div style="text-align: center; padding: 2rem; color: #94a3b8;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" style="margin-bottom: 1rem; opacity: 0.5;"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        <p style="font-weight: 600; margin-bottom: 0.5rem;">Tidak ada jadwal hari ini</p>
                        <p style="font-size: 0.85rem; margin-bottom: 1rem;">Ayo pesan ruangan!</p>
                        <button class="btn btn-primary" style="border-radius: 999px; padding: 0.5rem 1.25rem; font-size: 0.85rem;" @onclick="ViewAllRooms">Cari Ruangan</button>
                    </div>
                }
            </div>
        }
    }
</div>

<div class="analytics-inline-panel" style="margin-top: 24px;">
    <div class="analytics-inline-header">
        <div>
            <h2 class="analytics-inline-title">Analitik Utilisasi Ruangan</h2>
            <p class="analytics-inline-subtitle">5 Ruangan Paling Sering Dipesan</p>
        </div>
        <div style="display: flex; align-items: center; gap: 12px;">
            <div class="analytics-toggle">
                @foreach (var period in periods)
                {
                    <button class="@(selectedPeriod == period ? "active" : "")" @onclick="() => SelectPeriod(period)">@period</button>
                }
            </div>
            <div class="analytics-export-btns">
                <button class="btn-export" @onclick="ExportCSV" title="Download CSV">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    CSV
                </button>
                <button class="btn-export" @onclick="ExportJSON" title="Download JSON">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    JSON
                </button>
            </div>
        </div>
    </div>

    <div style="width: 100%; min-height: 280px; position: relative;">
        @if (_apexChartSeries != null && _apexChartSeries.Count > 0)
        {
            <div class="chart-legend-chips">
                @foreach (var series in _apexChartSeries)
                {
                    <button class="legend-chip @(series.Show ? "active" : "")" 
                            style="border-color: @series.Color; @(series.Show ? $"background: {series.Color}15; color: {series.Color};" : $"color: {series.Color};")"
                            @onclick="() => ToggleSeries(series.Name)">
                        <span class="legend-dot" style="background: @series.Color;"></span>
                        @series.Name
                    </button>
                }
            </div>
            <ApexChart TItem="RoomUsagePoint"
                       Options="_apexChartOptions"
                       @ref="_apexChartRef"
                       Height="280">
                @foreach (var series in _apexChartSeries.Where(s => s.Show))
                {
                     <ApexPointSeries TItem="RoomUsagePoint"
                                      Items="series.Points"
                                      Name="@series.Name"
                                      SeriesType="SeriesType.Area"
                                      XValue="@(p => p.Label)"
                                      YValue="@(p => p.Value)"
                                      Stroke="@(new SeriesStroke { Width = 2, Color = series.Color })" />
                }
            </ApexChart>
        }
    </div>

    @if (_highlightedRoom != null)
    {
        <div class="drilldown-banner">
            <span>Menampilkan: <strong>@_highlightedRoom</strong></span>
            <button class="drilldown-clear" @onclick="ClearDrillDown">Tampilkan Semua</button>
        </div>
    }

    <div class="analytics-inline-footer">
        <button class="btn btn-outline-primary" style="border-radius: 999px; font-weight: 600; padding: 0.5rem 1.25rem;" @onclick='() => ShowPopup("AnalyticsDetail")'>
            Lihat Detail
        </button>
    </div>
</div>

}

<!-- Pop-ups -->
<AppModal Visible="@(activePopup == "RoomAvailable")" VisibleChanged="VisibleChanged" OnClose="ClosePopup" ShowCloseButton="false">
    <HeaderContent>
        <div class="modal-header-custom" style="padding: 0;">
            <div class="modal-header-left">
                <div class="modal-header-icon icon-green">
                    <svg width="20" height="20" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0 18V16H2V0H12V1H16V16H18V18H14V3H12V18H0ZM4 2V16V2ZM8 10C8.28333 10 8.52083 9.90417 8.7125 9.7125C8.90417 9.52083 9 9.28333 9 9C9 8.71667 8.90417 8.47917 8.7125 8.2875C8.52083 8.09583 8.28333 8 8 8C7.71667 8 7.47917 8.09583 7.2875 8.2875C7.09583 8.47917 7 8.71667 7 9C7 9.28333 7.09583 9.52083 7.2875 9.7125C7.47917 9.90417 7.71667 10 8 10ZM4 16H10V2H4V16Z" fill="#059669"/>
                    </svg>
                </div>
                <div class="modal-header-info">
                    <h3>Ruangan Tersedia</h3>
                    <p>Pilih ruangan untuk rapat Anda berikutnya.</p>
                </div>
            </div>
        </div>
    </HeaderContent>
    <BodyContent>
        <RoomAvailablePopup OnClose="ClosePopup" />
    </BodyContent>
    <FooterContent>
        <div class="modal-footer-custom" style="justify-content: flex-end;">
            <button class="popup-footer-btn btn-close-gray" @onclick="ClosePopup">Tutup</button>
        </div>
    </FooterContent>
</AppModal>

<AppModal Visible="@(activePopup == "PendingApproval" && DashboardData.CurrentUserRole == "Admin")" VisibleChanged="VisibleChanged" OnClose="ClosePopup" ShowCloseButton="false">
    <HeaderContent>
        <div class="modal-header-custom" style="padding: 0;">
            <div class="modal-header-left">
                <div class="modal-header-icon icon-amber">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" fill="#D97706"/>
                    </svg>
                </div>
                <div class="modal-header-info">
                    <h3>Menunggu Persetujuan</h3>
                    <p>Tinjau permintaan pemesanan terbaru Anda.</p>
                </div>
            </div>
        </div>
    </HeaderContent>
    <BodyContent>
        <PendingApprovalPopup OnClose="ClosePopup" />
    </BodyContent>
    <FooterContent>
        <div class="modal-footer-custom" style="justify-content: flex-start; display: flex; gap: 0.5rem; border-top: none;">
            <button class="popup-footer-btn btn-close-gray" style="flex: 1;" @onclick="ClosePopup">Tutup</button>
            <button class="popup-footer-btn btn-amber" style="flex: 1;" @onclick="GoToStatusPage">Lihat Semua Detail</button>
        </div>
    </FooterContent>
</AppModal>

<AppModal Visible="@(activePopup == "QuickBook")" VisibleChanged="VisibleChanged" OnClose="ClosePopup" ShowCloseButton="false">
    <HeaderContent>
        <div class="modal-header-custom" style="padding: 0;">
            <div class="modal-header-left">
                <div class="modal-header-icon icon-navy">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M11 21H5C3.9 21 3 20.1 3 19V5C3 3.9 3.9 3 5 3H19C20.1 3 21 3.9 21 5V11.5" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M7 7H17M7 11H13M7 15H11" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                        <circle cx="18" cy="18" r="4" fill="#f59e0b"/>
                        <path d="M16.5 18L17.5 19L19.5 17" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="modal-header-info">
                    <h3>Pesan Ruangan — @(nextRoom?.RoomName ?? "")</h3>
                    <p>Tersedia dalam @(nextRoom?.AvailableInMinutes ?? 0) menit • Kapasitas @(nextRoom?.Capacity ?? 0) orang</p>
                </div>
            </div>
        </div>
    </HeaderContent>
    <BodyContent>
        <QuickBookPopup OnClose="ClosePopup" RoomName="@(nextRoom?.RoomName ?? "")" AvailableInMinutes="nextRoom?.AvailableInMinutes ?? 0" Capacity="nextRoom?.Capacity ?? 0" />
    </BodyContent>
</AppModal>

<AppModal Visible="@(activePopup == "AnalyticsDetail")" VisibleChanged="VisibleChanged" OnClose="ClosePopup" ShowCloseButton="false">
    <HeaderContent>
        <div class="modal-header-custom" style="padding: 0;">
            <div class="modal-header-left">
                <div class="modal-header-icon icon-blue">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="14" width="4" height="7" rx="1" fill="#1e40af"/>
                        <rect x="8.5" y="10" width="4" height="11" rx="1" fill="#3b82f6"/>
                        <rect x="14" y="6" width="4" height="15" rx="1" fill="#60a5fa"/>
                        <path d="M2 21H23" stroke="#94a3b8" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="modal-header-info">
                    <h3>Analitik Penggunaan Detail</h3>
                    <p>Data periode: @selectedPeriod</p>
                </div>
            </div>
        </div>
    </HeaderContent>
    <BodyContent>
        <AnalyticsDetailPopup OnClose="ClosePopup" SelectedPeriod="@selectedPeriod" />
    </BodyContent>
    <FooterContent>
        <div class="modal-footer-custom">
            <button class="popup-btn popup-btn-secondary" @onclick="ClosePopup">Tutup</button>
        </div>
    </FooterContent>
</AppModal>

<AppModal Visible="@(activePopup == "CheckInConfirmation")" VisibleChanged="VisibleChanged" OnClose="ClosePopup">
    <HeaderContent>
        <div class="modal-header-custom" style="padding: 0;">
            <div class="modal-header-left">
                <div class="modal-header-icon icon-navy">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M11 21H5C3.9 21 3 20.1 3 19V5C3 3.9 3.9 3 5 3H19C20.1 3 21 3.9 21 5V11.5" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M7 7H17M7 11H13M7 15H11" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                        <circle cx="18" cy="18" r="4" fill="#f59e0b"/>
                        <path d="M16.5 18L17.5 19L19.5 17" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="modal-header-info">
                    <h3>Konfirmasi Kehadiran</h3>
                    <p>Pastikan Anda berada di lokasi yang benar.</p>
                </div>
            </div>
        </div>
    </HeaderContent>
    <BodyContent>
        <CheckInCountdownCard 
            RoomName="Alpha Boardroom"
            TimeSlot="09:00 - 11:00"
            Location="Lantai 2, Sayap A"
            Capacity="12"
            TargetTime="@(NotificationState.NextBookingTime ?? DateTime.Now)"
            OnConfirm="HandleConfirmCheckIn"
            OnCancel="ClosePopup"
            OnAutoReleased="HandleBookingAutoReleased" />
    </BodyContent>
</AppModal>

<AppModal Visible="@(activePopup == "BookingAutoReleased")" VisibleChanged="VisibleChanged" OnClose="ClosePopup" ShowCloseButton="false">
    <HeaderContent>
        <div class="modal-header-custom" style="padding: 0;">
            <div class="modal-header-left">
                <div class="modal-header-icon icon-red">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="12" r="10" stroke="#EF4444" stroke-width="2"/>
                        <path d="M12 6v6l4 2" stroke="#EF4444" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="modal-header-info">
                    <h3>Booking Otomatis Dibatalkan</h3>
                    <p>Ruangan telah dilepas karena tidak ada check-in.</p>
                </div>
            </div>
        </div>
    </HeaderContent>
    <BodyContent>
        <BookingAutoReleasedModal RoomName="Alpha Boardroom" OnClose="ClosePopup" OnBookAnother="HandleBookAnother" />
    </BodyContent>
    <FooterContent>
        <div class="modal-footer-custom">
            <button class="popup-btn popup-btn-secondary" @onclick="GoToBookingsPage">Pilih Ruangan Lain</button>
        </div>
    </FooterContent>
</AppModal>

<AppModal Visible="@(activePopup == "CheckInSuccess")" VisibleChanged="VisibleChanged" OnClose="HandleSuccessClose" ShowCloseButton="false">
    <HeaderContent>
        <div class="modal-header-custom" style="padding: 0;">
            <div class="modal-header-left">
                <div class="modal-header-icon icon-green">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9 12l2 2 4-4" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="12" cy="12" r="10" stroke="#10B981" stroke-width="2"/>
                    </svg>
                </div>
                <div class="modal-header-info">
                    <h3>Check-in Berhasil</h3>
                    <p>Selamat menikmati ruangan.</p>
                </div>
            </div>
        </div>
    </HeaderContent>
    <BodyContent>
        <CheckInSuccessModal 
            Timestamp="@checkInTimestamp"
            OnClose="HandleSuccessClose" />
    </BodyContent>
</AppModal>

<!-- Schedule Detail Popup -->
@if (_scheduleDetailPopupVisible && _selectedScheduleItem != null)
{
    <AppModal Visible="true" VisibleChanged="ScheduleDetailVisibleChanged" OnClose="CloseScheduleDetail" ShowCloseButton="true">
        <HeaderContent>
            <div>
                <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: var(--text-navy);">@_selectedScheduleItem.RoomName</h3>
                <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: #64748b;">@_selectedScheduleItem.TimeSlot · @_selectedScheduleItem.Title</p>
            </div>
        </HeaderContent>
        <BodyContent>
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem; color: #4B5563;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    Lantai 3, Sayap Utara, Persada HQ
                </div>
                <div style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem; color: #4B5563;">
