@page "/dashboard"
@using booking_room.Components.Models
@using booking_room.Components.Shared
@inject NavigationManager Navigation
@inject booking_room.Services.NotificationState NotificationState
@inject booking_room.Services.LoadingStateService LoadingState
@inject IJSRuntime JS
@implements IDisposable
<PageTitle>Beranda — Persada Ruangan</PageTitle>

@if (NotificationState.CurrentBannerType != booking_room.Services.NotificationState.BannerType.None)
{
    <NotificationBanner TargetTime="@NotificationState.NextBookingTime" 
                        BannerType="@NotificationState.CurrentBannerType"
                        OnCheckIn="HandleCheckInClick" 
                        OnDismiss="DismissReminder" />
}

@if (LoadingState.IsLoading)
{
    <div class="content-fade-in">
        <div class="skeleton-shimmer" style="height: 100px; border-radius: 1rem; margin-bottom: 1.5rem;"></div>
        <div class="skeleton-stat-grid">
            <div class="skeleton-stat-card"><div class="skeleton-shimmer skeleton-title"></div><div class="skeleton-shimmer skeleton-text"></div></div>
            <div class="skeleton-stat-card"><div class="skeleton-shimmer skeleton-title"></div><div class="skeleton-shimmer skeleton-text"></div></div>
            <div class="skeleton-stat-card"><div class="skeleton-shimmer skeleton-title"></div><div class="skeleton-shimmer skeleton-text"></div></div>
        </div>
        <div class="skeleton-grid">
            <div class="skeleton-card" style="grid-column: span 2;"><div class="skeleton-shimmer" style="height: 250px;"></div></div>
            <div class="skeleton-card"><div class="skeleton-shimmer" style="height: 250px;"></div></div>
        </div>
    </div>
}
else
{
<div class="content-fade-in">
<div class="hero-card">
    <h1 class="hero-title">Selamat Datang, Admin User</h1>
    <p class="hero-subtitle">Kelola pemesanan ruangan perusahaan Anda dengan efisien. Pantau penggunaan ruangan, reservasi mendatang, dan analitik sistem dalam satu tempat.</p>
</div>

<div class="summary-cards">
    <!-- Card Segera Tersedia (Now First) -->
    @if (nextRoom is not null)
    {
        <div class="summary-card action-oriented-card" @onclick='() => ShowPopup("QuickBook")'>
            <div class="action-card-bg"></div>
            <div class="action-card-content">
                <div class="action-header">
                    <span class="action-badge">TERSEDIA DALAM @nextRoom.AvailableInMinutes MENIT</span>
                </div>
                <div class="action-main">
                    <div class="action-icon-wrapper">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
                    </div>
                    <div>
                        <div class="action-room">@nextRoom.RoomName</div>
                        <div class="action-meta">Kapasitas: @nextRoom.Capacity Orang</div>
                    </div>
                </div>
                <button class="btn-action-primary">
                    Pemesanan Instan
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="summary-card next-available-card" style="align-items: center; text-align: center;">
            <div class="next-available-room" style="font-size: 1.1rem;">Semua ruangan tersedia sekarang</div>
            <div class="next-available-meta" style="margin-bottom: 1rem;">Tidak ada ruangan yang sedang terpakai saat ini</div>
            <button class="next-available-btn" @onclick:stopPropagation="true" @onclick="ViewAllRooms">
                Lihat Semua Ruangan
            </button>
        </div>
    }

    <!-- Card Persetujuan Tertunda -->
    <div class="summary-card" style="border-left: 4px solid var(--accent-amber);" @onclick='() => ShowPopup("PendingApproval")'>
        <div class="summary-card-icon icon-amber">
            <InlineSvg Src="/icons/Icon_clndr.svg" Class="icon-main" />
        </div>
        <div class="summary-card-content">
            <div class="summary-card-label">Persetujuan Tertunda</div>
            <div class="summary-card-value">@DashboardData.PendingApprovals</div>
        </div>
        <div class="summary-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
    </div>
</div>

</div>

<div class="clock-standalone">
    <div class="clock-time">
        @currentTime.ToString("HH")<span class="colon-blink">:</span>@currentTime.ToString("mm")<span style="font-size:0.5em; opacity:0.7; margin-left:4px;">@currentTime.ToString("ss")</span>
    </div>
    <div class="clock-date">@currentTime.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))</div>
</div>

<div class="dashboard-lower-layout">
    <!-- Jadwal Saya Hari Ini (moved above analytics) -->
    @if (DashboardData.CurrentUserRole == "Admin")
    {
        @if (IsWidgetVisible("TodaySchedule"))
        {
            <div class="dashboard-widget upcoming-bookings-panel">
                <div class="upcoming-header">
                    <h2 class="upcoming-title">Jadwal Saya Hari Ini</h2>
                    <span class="upcoming-badge">@DashboardData.TodaySchedule.Count Agenda</span>
                </div>
                <div class="upcoming-list">
                    @foreach (var item in DashboardData.TodaySchedule)
                    {
                        <div class="upcoming-card" style="cursor: pointer;" @onclick="() => NavigateToBookingDetail(item)">
                            <div class="upcoming-accent" style="background-color: @item.AccentColor;"></div>
                            <div class="upcoming-content">
                                <div class="upcoming-top">
                                    <div>
                                        <h3 class="upcoming-room-name">@item.RoomName</h3>
                                        <p class="upcoming-location">@item.Title</p>
                                    </div>
                                    <span class="upcoming-status-badge" style="background: @(item.Status == "sedang-berlangsung" ? "#F0FDF4" : "#F8FAFC"); color: @(item.Status == "sedang-berlangsung" ? "#166534" : "#4B5563");">
                                        @item.StatusLabel
                                    </span>
                                </div>
                                <div class="upcoming-bottom">
                                    <div class="upcoming-schedule">
                                        <span>
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="currentColor"/></svg>
                                            @item.TimeSlot
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (!DashboardData.TodaySchedule.Any())
                {
                    <div style="text-align: center; padding: 2rem; color: #94a3b8;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" style="margin-bottom: 1rem; opacity: 0.5;"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        <p style="font-weight: 600; margin-bottom: 0.5rem;">Tidak ada jadwal hari ini</p>
                        <p style="font-size: 0.85rem; margin-bottom: 1rem;">Ayo pesan ruangan!</p>
                        <button class="btn btn-primary" style="border-radius: 999px; padding: 0.5rem 1.25rem; font-size: 0.85rem;" @onclick="ViewAllRooms">Cari Ruangan</button>
                    </div>
                }
            </div>
        }
    }
    else
    {
        @if (IsWidgetVisible("TodaySchedule"))
        {
            <div class="dashboard-widget upcoming-bookings-panel">
                <div class="upcoming-header">
                    <h2 class="upcoming-title">Jadwal Saya Hari Ini</h2>
                    <span class="upcoming-badge">@DashboardData.TodaySchedule.Count Agenda</span>
                </div>
                <div class="upcoming-list">
                    @foreach (var item in DashboardData.TodaySchedule)
                    {
                        <div class="upcoming-card" style="cursor: pointer;" @onclick="() => NavigateToBookingDetail(item)">
                            <div class="upcoming-accent" style="background-color: @item.AccentColor;"></div>
                            <div class="upcoming-content">
                                <div class="upcoming-top">
                                    <div>
                                        <h3 class="upcoming-room-name">@item.RoomName</h3>
                                        <p class="upcoming-location">@item.Title</p>
                                    </div>
                                    <span class="upcoming-status-badge" style="background: @(item.Status == "sedang-berlangsung" ? "#F0FDF4" : "#F8FAFC"); color: @(item.Status == "sedang-berlangsung" ? "#166534" : "#4B5563");">
                                        @item.StatusLabel
                                    </span>
                                </div>
                                <div class="upcoming-bottom">
                                    <div class="upcoming-schedule">
                                        <span>
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="currentColor"/></svg>
                                            @item.TimeSlot
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (!DashboardData.TodaySchedule.Any())
                {
                    <div style="text-align: center; padding: 2rem; color: #94a3b8;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" style="margin-bottom: 1rem; opacity: 0.5;"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        <p style="font-weight: 600; margin-bottom: 0.5rem;">Tidak ada jadwal hari ini</p>
                        <p style="font-size: 0.85rem; margin-bottom: 1rem;">Ayo pesan ruangan!</p>
                        <button class="btn btn-primary" style="border-radius: 999px; padding: 0.5rem 1.25rem; font-size: 0.85rem;" @onclick="ViewAllRooms">Cari Ruangan</button>
                    </div>
                }
            </div>
        }
    }
</div>

<div class="analytics-inline-panel" style="margin-top: 24px;">
    <div class="analytics-inline-header">
        <div>
            <h2 class="analytics-inline-title">Analitik Utilisasi Ruangan</h2>
            <p class="analytics-inline-subtitle">5 Ruangan Paling Sering Dipesan</p>
        </div>
        <div style="display: flex; align-items: center; gap: 12px;">
            <div class="analytics-toggle">
                @foreach (var period in periods)
                {
                    <button class="@(selectedPeriod == period ? "active" : "")" @onclick="() => SelectPeriod(period)">@period</button>
                }
            </div>
            <div class="analytics-export-btns">
                <button class="btn-export" @onclick="ExportCSV" title="Download CSV">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    CSV
                </button>
                <button class="btn-export" @onclick="ExportJSON" title="Download JSON">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    JSON
                </button>
            </div>
        </div>
    </div>

    <div style="width: 100%; min-height: 280px; position: relative;">
        @if (_apexChartSeries != null && _apexChartSeries.Count > 0)
        {
            <div class="chart-legend-chips">
                @foreach (var series in _apexChartSeries)
                {
                    <button class="legend-chip @(series.Show ? "active" : "")" 
                            style="border-color: @series.Color; @(series.Show ? $"background: {series.Color}15; color: {series.Color};" : $"color: {series.Color};")"
                            @onclick="() => ToggleSeries(series.Name)">
                        <span class="legend-dot" style="background: @series.Color;"></span>
                        @series.Name
                    </button>
                }
            </div>
            <ApexChart TItem="RoomUsagePoint"
                       Options="_apexChartOptions"
                       @ref="_apexChartRef"
                       Height="280">
                @foreach (var series in _apexChartSeries.Where(s => s.Show))
                {
                     <ApexPointSeries TItem="RoomUsagePoint"
                                      Items="series.Points"
                                      Name="@series.Name"
                                      SeriesType="SeriesType.Area"
                                      XValue="@(p => p.Label)"
                                      YValue="@(p => p.Value)"
                                      Stroke="@(new SeriesStroke { Width = 2, Color = series.Color })" />
                }
            </ApexChart>
        }
    </div>

    @if (_highlightedRoom != null)
    {
        <div class="drilldown-banner">
            <span>Menampilkan: <strong>@_highlightedRoom</strong></span>
            <button class="drilldown-clear" @onclick="ClearDrillDown">Tampilkan Semua</button>
        </div>
    }

    <div class="analytics-inline-footer">
        <button class="btn btn-outline-primary" style="border-radius: 999px; font-weight: 600; padding: 0.5rem 1.25rem;" @onclick='() => ShowPopup("AnalyticsDetail")'>
            Lihat Detail
        </button>
    </div>
</div>

}

<!-- Pop-ups -->
<ModalOverlayBlur Visible="@(activePopup == "RoomAvailable")" OnClose="ClosePopup" Size="default" ShowCloseButton="false">
    <RoomAvailablePopup OnClose="ClosePopup" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "PendingApproval")" OnClose="ClosePopup" Size="default" ShowCloseButton="false">
    <PendingApprovalPopup OnClose="ClosePopup" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "QuickBook")" OnClose="ClosePopup" Size="default" ShowCloseButton="false">
    @if (nextRoom != null)
    {
        <QuickBookPopup OnClose="ClosePopup" RoomName="@nextRoom.RoomName" AvailableInMinutes="nextRoom.AvailableInMinutes" Capacity="nextRoom.Capacity" />
    }
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "AnalyticsDetail")" OnClose="ClosePopup" Size="lg" ShowCloseButton="false">
    <AnalyticsDetailPopup OnClose="ClosePopup" SelectedPeriod="@selectedPeriod" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "CheckInConfirmation")" OnClose="ClosePopup" Size="sm">
    <CheckInConfirmationModal 
        RoomName="Alpha Boardroom"
        TimeSlot="09:00 - 11:00"
        Location="Lantai 2, Sayap A"
        Capacity="12"
        TargetTime="@(NotificationState.NextBookingTime ?? DateTime.Now)"
        OnConfirm="HandleConfirmCheckIn"
        OnCancel="ClosePopup"
        OnAutoReleased="HandleBookingAutoReleased" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "BookingAutoReleased")" OnClose="ClosePopup" Size="default" ShowCloseButton="false">
    <BookingAutoReleasedModal RoomName="Alpha Boardroom" OnClose="ClosePopup" OnBookAnother="HandleBookAnother" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "CheckInSuccess")" OnClose="HandleSuccessClose" Size="sm" ShowCloseButton="false">
    <CheckInSuccessModal 
        Timestamp="@checkInTimestamp"
        OnClose="HandleSuccessClose" />
</ModalOverlayBlur>


@code {
    private NextAvailableRoom? nextRoom;
    private AnalyticsData analyticsData = DashboardData.WeeklyData;
    private string selectedPeriod = "Minggu";
    private readonly string[] periods = { "Minggu", "Bulan", "Tahun" };
    private DateTime checkInTimestamp;
    
    // State for upcoming bookings & clock
    private bool showAllUpcoming = false;
    private DateTime currentTime = DateTime.Now;
    private PeriodicTimer? clockTimer;

    private List<RoomItem> _allRooms = new()
    {
        new("1", "Executive Boardroom A", 12, "Ruang rapat unggulan.", "available", new() { "AC" }, "Lantai 3", ""),
        new("2", "Training Ruangan B", 30, "Ruang pelatihan kapasitas besar.", "booked", new() { "AC" }, "Lantai 2", ""),
        new("3", "Huddle Space C", 6, "Ruang kolaborasi kecil.", "available", new() { "AC" }, "Lantai 1", ""),
        new("4", "Studio Webinar", 15, "Ruang siaran.", "unavailable", new() { "AC" }, "Lantai 4", ""),
        new("5", "Focus Ruangan Alpha", 4, "Ruang sunyi.", "available", new() { "AC" }, "Lantai 1", ""),
        new("6", "Meeting Ruangan Prime", 8, "Ruang rapat standar.", "booked", new() { "AC" }, "Lantai 2", ""),
    };

    // ApexChart state
    private ApexChart<RoomUsagePoint>? _apexChartRef;
    private ApexChartOptions<RoomUsagePoint> _apexChartOptions = new();
    private List<ApexChartSeries> _apexChartSeries = new();

    private string activePopup = "";

    protected override void OnInitialized()
    {
        nextRoom = DashboardData.NextAvailableRooms.FirstOrDefault();
        NotificationState.OnChange += StateHasChanged;
        LoadingState.OnChange += StateHasChanged;

        ConfigureApexChartOptions();
        LoadApexChartData(selectedPeriod);
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("document.body.classList.add", "page-slide-in-left");
            
            clockTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await clockTimer.WaitForNextTickAsync())
            {
                currentTime = DateTime.Now;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void ConfigureApexChartOptions()
    {
        _apexChartOptions = new ApexChartOptions<RoomUsagePoint>
        {
            Markers = new Markers
            {
                Size = 4,
                Colors = new List<string> { "#0f1f3d", "#1e40af", "#3b82f6", "#60a5fa", "#93c5fd" }
            },
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Animations = new Animations
                {
                    Enabled = true,
                    Speed = 600,
                    AnimateGradually = new AnimateGradually { Enabled = true, Delay = 150 }
                },
                FontFamily = "'Inter', 'Poppins', sans-serif"
            },
            Stroke = new Stroke
            {
                Curve = Curve.Smooth,
                Width = 2
            },
            Fill = new Fill
            {
                Type = FillType.Gradient,
                Gradient = new FillGradient
                {
                    ShadeIntensity = 1,
                    OpacityFrom = 0.35,
                    OpacityTo = 0.05,
                    Stops = new List<double> { 0, 90, 100 }
                }
            },
            Xaxis = new XAxis
            {
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { FontSize = "11px", Colors = "#94a3b8" }
                }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle { FontSize = "11px", Colors = "#94a3b8" }
                    }
                }
            },
            Grid = new Grid
            {
                BorderColor = "#f1f5f9",
                StrokeDashArray = 4
            },
            Legend = new Legend
            {
                Position = LegendPosition.Top,
                HorizontalAlign = ApexCharts.Align.Left,
                FontSize = "12px",
                Labels = new LegendLabels { Colors = "#64748b" }
            },
            Tooltip = new Tooltip
            {
                Enabled = true,
                Theme = Mode.Light
            },
            Colors = new List<string> { "#0f1f3d", "#1e40af", "#3b82f6", "#60a5fa", "#93c5fd" }
        };
    }

    private void LoadApexChartData(string period)
    {
        var chartData = DashboardData.GetChartData(period);
        _apexChartSeries = chartData.Datasets.Select(ds =>
        {
            var points = chartData.Labels.Select((label, i) => new RoomUsagePoint
            {
                Label = label,
                Value = (decimal)ds.Data[i]
            }).ToList();

            return new ApexChartSeries
            {
                Name = ds.Label,
                Color = ds.BorderColor,
                Points = points
            };
        }).ToList();
    }

    public void Dispose()
    {
        NotificationState.OnChange -= StateHasChanged;
        LoadingState.OnChange -= StateHasChanged;
        clockTimer?.Dispose();
    }

    private void ToggleShowAllUpcoming()
    {
        showAllUpcoming = !showAllUpcoming;
    }

    private void NavigateToBookingDetail(TodayScheduleItem item)
    {
        Navigation.NavigateTo("/bookings");
    }

    private RenderFragment GetActivityIcon(string iconType) => iconType switch
    {
        "approval" => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>,
        "cancel" => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>,
        "alert" => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>,
        "booking" => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>,
        "checkin" => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"></path><circle cx="12" cy="12" r="10"></circle></svg>,
        _ => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle></svg>,
    };

    private bool IsWidgetVisible(string widgetName)
    {
        var role = DashboardData.CurrentUserRole;
        if (DashboardData.RoleWidgetPriority.TryGetValue(role, out var widgets))
        {
            return widgets.Contains(widgetName);
        }
        return true;
    }

    private void OpenModifyModal(UpcomingBookingItem booking)
    {
        Navigation.NavigateTo("/bookings");
    }

    private void OpenCancelModal(UpcomingBookingItem booking)
    {
        Navigation.NavigateTo("/status");
    }

    private async Task SelectPeriod(string period)
    {
        selectedPeriod = period;
        analyticsData = DashboardData.GetAnalytics(period);
        LoadApexChartData(period);
        StateHasChanged();
    }

    private void ViewAllRooms()
    {
        Navigation.NavigateTo("/bookings");
    }

    private void DismissReminder()
    {
        NotificationState.DismissBanner();
    }

    private void HandleCheckInClick()
    {
        activePopup = "CheckInConfirmation";
    }

    private void HandleConfirmCheckIn()
    {
        activePopup = "CheckInSuccess";
        checkInTimestamp = DateTime.Now;
    }

    private void HandleBookingAutoReleased()
    {
        activePopup = "BookingAutoReleased";
        StateHasChanged();
    }

    private void HandleBookAnother()
    {
        Navigation.NavigateTo("/bookings");
    }

    private void HandleSuccessClose()
    {
        NotificationState.DismissBanner();
        activePopup = "";
    }

    private void ShowPopup(string popupName)
    {
        activePopup = popupName;
    }

    private void ClosePopup()
    {
        activePopup = "";
    }

    // Data model for ApexCharts
    public class RoomUsagePoint
    {
        public string Label { get; set; } = "";
        public decimal Value { get; set; }
    }

    public class ApexChartSeries
    {
        public string Name { get; set; } = "";
        public string Color { get; set; } = "";
        public bool Show { get; set; } = true;
        public List<RoomUsagePoint> Points { get; set; } = new();
    }

    private string? _highlightedRoom = null;

    private void ToggleSeries(string seriesName)
    {
        if (_highlightedRoom == seriesName)
        {
            ClearDrillDown();
        }
        else
        {
            _highlightedRoom = seriesName;
            foreach (var s in _apexChartSeries)
            {
                s.Show = s.Name == seriesName;
            }
        }
        StateHasChanged();
    }

    private void ClearDrillDown()
    {
        _highlightedRoom = null;
        foreach (var s in _apexChartSeries)
        {
            s.Show = true;
        }
        StateHasChanged();
    }

    private void ExportCSV()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Ruangan," + string.Join(",", _apexChartSeries.FirstOrDefault()?.Points.Select(p => p.Label) ?? Enumerable.Empty<string>()));
        foreach (var series in _apexChartSeries)
        {
            csv.AppendLine($"{series.Name}," + string.Join(",", series.Points.Select(p => p.Value)));
        }
        DownloadFile(csv.ToString(), $"analytics-{selectedPeriod}.csv", "text/csv");
    }

    private void ExportJSON()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(new { Period = selectedPeriod, Series = _apexChartSeries.Select(s => new { s.Name, s.Points }) });
        DownloadFile(json, $"analytics-{selectedPeriod}.json", "application/json");
    }

    private void DownloadFile(string content, string fileName, string contentType)
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes(content);
        var base64 = Convert.ToBase64String(bytes);
        var dataUrl = $"data:{contentType};base64,{base64}";
        var js = $"var a=document.createElement('a');a.href='{dataUrl}';a.download='{fileName}';document.body.appendChild(a);a.click();document.body.removeChild(a);";
        JS.InvokeVoidAsync("eval", js);
    }
}

