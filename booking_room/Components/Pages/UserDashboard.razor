@page "/"
@using booking_room.Components.Models
@using booking_room.Components.Shared
@inject NavigationManager Navigation
@inject booking_room.Services.NotificationState NotificationState
@inject booking_room.Services.LoadingStateService LoadingState
@implements IDisposable
<PageTitle>Beranda — Persada Room</PageTitle>

@if (NotificationState.CurrentBannerType != booking_room.Services.NotificationState.BannerType.None)
{
    <NotificationBanner TargetTime="@NotificationState.NextBookingTime" 
                        BannerType="@NotificationState.CurrentBannerType"
                        OnCheckIn="HandleCheckInClick" 
                        OnDismiss="DismissReminder" />
}

@if (LoadingState.IsLoading)
{
    <div class="content-fade-in">
        <div class="skeleton-shimmer" style="height: 100px; border-radius: 1rem; margin-bottom: 1.5rem;"></div>
        <div class="skeleton-stat-grid">
            <div class="skeleton-stat-card"><div class="skeleton-shimmer skeleton-title"></div><div class="skeleton-shimmer skeleton-text"></div></div>
            <div class="skeleton-stat-card"><div class="skeleton-shimmer skeleton-title"></div><div class="skeleton-shimmer skeleton-text"></div></div>
            <div class="skeleton-stat-card"><div class="skeleton-shimmer skeleton-title"></div><div class="skeleton-shimmer skeleton-text"></div></div>
        </div>
        <div class="skeleton-grid">
            <div class="skeleton-card" style="grid-column: span 2;"><div class="skeleton-shimmer" style="height: 250px;"></div></div>
            <div class="skeleton-card"><div class="skeleton-shimmer" style="height: 250px;"></div></div>
        </div>
    </div>
}
else
{
<div class="content-fade-in">
<div class="hero-card">
    <h1 class="hero-title">Selamat Datang, Admin User</h1>
    <p class="hero-subtitle">Kelola pemesanan ruangan perusahaan Anda dengan efisien. Pantau penggunaan ruangan, reservasi mendatang, dan analitik sistem dalam satu tempat.</p>
</div>

<div class="summary-cards">
    <!-- Card Ruangan Tersedia -->
    <div class="summary-card" @onclick='() => ShowPopup("RoomAvailable")'>
        <div class="summary-card-icon icon-green">
            <InlineSvg Src="/icons/Icon_1.svg" Class="icon-main" />
        </div>
        <div class="summary-card-content">
            <div class="summary-card-label">Ruangan Tersedia</div>
            <div class="summary-card-value">@DashboardData.AvailableRooms.Available <span>/ @DashboardData.AvailableRooms.Total</span></div>
        </div>
        <div class="summary-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
    </div>

    <!-- Card Persetujuan Tertunda -->
    <div class="summary-card" style="border-left: 4px solid var(--accent-amber);" @onclick='() => ShowPopup("PendingApproval")'>
        <div class="summary-card-icon icon-amber">
            <InlineSvg Src="/icons/Icon_clndr.svg" Class="icon-main" />
        </div>
        <div class="summary-card-content">
            <div class="summary-card-label">Persetujuan Tertunda</div>
            <div class="summary-card-value">@DashboardData.PendingApprovals</div>
        </div>
        <div class="summary-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
    </div>

    <!-- Card Segera Tersedia -->
    @if (nextRoom is not null)
    {
        <div class="summary-card next-available-card" @onclick='() => ShowPopup("QuickBook")'>
            <div class="next-available-header">
                <div class="next-available-title">Tersedia Berikutnya</div>
                <svg class="next-available-bolt" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                </svg>
            </div>
            <div class="next-available-icon">
                <InlineSvg Src="/icons/Icon_pnt.svg" Class="icon-main" />
            </div>
            <div class="next-available-room">@nextRoom.RoomName</div>
            <div class="next-available-meta">
                Tersedia dalam @nextRoom.AvailableInMinutes menit
                <span style="margin: 0 0.35rem;">•</span>
                Kapasitas: @nextRoom.Capacity Orang
            </div>
            <button class="next-available-btn">
                Booking Instan
            </button>
        </div>
    }
    else
    {
        <div class="summary-card next-available-card" style="align-items: center; text-align: center;">
            <div class="next-available-room" style="font-size: 1.1rem;">Semua ruangan tersedia sekarang</div>
            <div class="next-available-meta" style="margin-bottom: 1rem;">Tidak ada ruangan yang sedang terpakai saat ini</div>
            <button class="next-available-btn" @onclick:stopPropagation="true" @onclick="ViewAllRooms">
                Lihat Semua Ruangan
            </button>
        </div>
    }
</div>

<div class="analytics-inline-panel">
    <div class="analytics-inline-header">
        <div>
            <h2 class="analytics-inline-title">Analitik Utilisasi Ruangan</h2>
            <p class="analytics-inline-subtitle">5 Ruangan Paling Sering Dipesan</p>
        </div>
        <div class="analytics-toggle">
            @foreach (var period in periods)
            {
                <button class="@(selectedPeriod == period ? "active" : "")" @onclick="() => SelectPeriod(period)">@period</button>
            }
        </div>
    </div>

    <div style="width: 100%; min-height: 280px;">
        @if (_apexChartSeries != null && _apexChartSeries.Count > 0)
        {
            <ApexChart TItem="RoomUsagePoint"
                       Options="_apexChartOptions"
                       @ref="_apexChartRef"
                       Height="280">
                @foreach (var series in _apexChartSeries)
                {
                    <ApexPointSeries TItem="RoomUsagePoint"
                                     Items="series.Points"
                                     Name="@series.Name"
                                     SeriesType="SeriesType.Area"
                                     XValue="@(p => p.Label)"
                                     YValue="@(p => p.Value)"
                                     Stroke="@(new SeriesStroke { Width = 2, Color = series.Color })" />
                }
            </ApexChart>
        }
    </div>

    <div class="analytics-inline-footer">
        <button class="btn btn-outline-primary" style="border-radius: 999px; font-weight: 600; padding: 0.5rem 1.25rem;" @onclick='() => ShowPopup("AnalyticsDetail")'>
            Lihat Detail
        </button>
    </div>
</div>

</div>

}

<!-- Pop-ups -->
<ModalOverlayBlur Visible="@(activePopup == "RoomAvailable")" OnClose="ClosePopup" Size="default" ShowCloseButton="false">
    <RoomAvailablePopup OnClose="ClosePopup" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "PendingApproval")" OnClose="ClosePopup" Size="default" ShowCloseButton="false">
    <PendingApprovalPopup OnClose="ClosePopup" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "QuickBook")" OnClose="ClosePopup" Size="default" ShowCloseButton="false">
    @if (nextRoom != null)
    {
        <QuickBookPopup OnClose="ClosePopup" RoomName="@nextRoom.RoomName" AvailableInMinutes="nextRoom.AvailableInMinutes" Capacity="nextRoom.Capacity" />
    }
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "AnalyticsDetail")" OnClose="ClosePopup" Size="lg" ShowCloseButton="false">
    <AnalyticsDetailPopup OnClose="ClosePopup" SelectedPeriod="@selectedPeriod" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "CheckInConfirmation")" OnClose="ClosePopup" Size="sm">
    <CheckInConfirmationModal 
        RoomName="Alpha Boardroom"
        TimeSlot="09:00 - 11:00"
        Location="Lantai 2, Wing A"
        Capacity="12"
        TargetTime="@(NotificationState.NextBookingTime ?? DateTime.Now)"
        OnConfirm="HandleConfirmCheckIn"
        OnCancel="ClosePopup"
        OnAutoReleased="HandleBookingAutoReleased" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "BookingAutoReleased")" OnClose="ClosePopup" Size="default" ShowCloseButton="false">
    <BookingAutoReleasedModal RoomName="Alpha Boardroom" OnClose="ClosePopup" OnBookAnother="HandleBookAnother" />
</ModalOverlayBlur>

<ModalOverlayBlur Visible="@(activePopup == "CheckInSuccess")" OnClose="HandleSuccessClose" Size="sm" ShowCloseButton="false">
    <CheckInSuccessModal 
        Timestamp="@checkInTimestamp"
        OnClose="HandleSuccessClose" />
</ModalOverlayBlur>


@code {
    private NextAvailableRoom? nextRoom;
    private AnalyticsData analyticsData = DashboardData.WeeklyData;
    private string selectedPeriod = "Minggu";
    private readonly string[] periods = { "Minggu", "Bulan", "Tahun" };
    private DateTime checkInTimestamp;

    // ApexChart state
    private ApexChart<RoomUsagePoint>? _apexChartRef;
    private ApexChartOptions<RoomUsagePoint> _apexChartOptions = new();
    private List<ApexChartSeries> _apexChartSeries = new();

    private string activePopup = "";

    protected override void OnInitialized()
    {
        nextRoom = DashboardData.NextAvailableRooms.FirstOrDefault();
        NotificationState.OnChange += StateHasChanged;
        LoadingState.OnChange += StateHasChanged;

        ConfigureApexChartOptions();
        LoadApexChartData(selectedPeriod);
    }

    private void ConfigureApexChartOptions()
    {
        _apexChartOptions = new ApexChartOptions<RoomUsagePoint>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Animations = new Animations
                {
                    Enabled = true,
                    Speed = 600,
                    AnimateGradually = new AnimateGradually { Enabled = true, Delay = 150 }
                },
                FontFamily = "'Inter', 'Poppins', sans-serif"
            },
            Stroke = new Stroke
            {
                Curve = Curve.Smooth,
                Width = 2
            },
            Fill = new Fill
            {
                Type = FillType.Gradient,
                Gradient = new FillGradient
                {
                    ShadeIntensity = 1,
                    OpacityFrom = 0.35,
                    OpacityTo = 0.05,
                    Stops = new List<double> { 0, 90, 100 }
                }
            },
            Xaxis = new XAxis
            {
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { FontSize = "11px", Colors = "#94a3b8" }
                }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle { FontSize = "11px", Colors = "#94a3b8" }
                    }
                }
            },
            Grid = new Grid
            {
                BorderColor = "#f1f5f9",
                StrokeDashArray = 4
            },
            Legend = new Legend
            {
                Position = LegendPosition.Top,
                HorizontalAlign = ApexCharts.Align.Left,
                FontSize = "12px",
                Labels = new LegendLabels { Colors = "#64748b" }
            },
            Tooltip = new Tooltip
            {
                Enabled = true,
                Theme = Mode.Light
            },
            Colors = new List<string> { "#0f1f3d", "#1e40af", "#3b82f6", "#60a5fa", "#93c5fd" }
        };
    }

    private void LoadApexChartData(string period)
    {
        var chartData = DashboardData.GetChartData(period);
        _apexChartSeries = chartData.Datasets.Select(ds =>
        {
            var points = chartData.Labels.Select((label, i) => new RoomUsagePoint
            {
                Label = label,
                Value = (decimal)ds.Data[i]
            }).ToList();

            return new ApexChartSeries
            {
                Name = ds.Label,
                Color = ds.BorderColor,
                Points = points
            };
        }).ToList();
    }

    public void Dispose()
    {
        NotificationState.OnChange -= StateHasChanged;
        LoadingState.OnChange -= StateHasChanged;
    }

    private async Task SelectPeriod(string period)
    {
        selectedPeriod = period;
        analyticsData = DashboardData.GetAnalytics(period);
        LoadApexChartData(period);
        StateHasChanged();
    }

    private void ViewAllRooms()
    {
        Navigation.NavigateTo("/bookings");
    }

    private void DismissReminder()
    {
        NotificationState.DismissBanner();
    }

    private void HandleCheckInClick()
    {
        activePopup = "CheckInConfirmation";
    }

    private void HandleConfirmCheckIn()
    {
        activePopup = "CheckInSuccess";
        checkInTimestamp = DateTime.Now;
    }

    private void HandleBookingAutoReleased()
    {
        activePopup = "BookingAutoReleased";
        StateHasChanged();
    }

    private void HandleBookAnother()
    {
        Navigation.NavigateTo("/bookings");
    }

    private void HandleSuccessClose()
    {
        NotificationState.DismissBanner();
        activePopup = "";
    }

    private void ShowPopup(string popupName)
    {
        activePopup = popupName;
    }

    private void ClosePopup()
    {
        activePopup = "";
    }

    // Data model for ApexCharts
    public class RoomUsagePoint
    {
        public string Label { get; set; } = "";
        public decimal Value { get; set; }
    }

    public class ApexChartSeries
    {
        public string Name { get; set; } = "";
        public string Color { get; set; } = "";
        public List<RoomUsagePoint> Points { get; set; } = new();
    }
}
